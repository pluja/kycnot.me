# Database
DATABASE_URL="postgresql://kycnot:kycnot@localhost:3399/kycnot?schema=public"
# Emptied and rebuilt each time `npm run db-drift` replays the migrations, so it
# has to name a database of its own. Adding a suffix to DATABASE_URL does not
# give you one: the suffix lands in the query string and the shadow is the
# database you started from. The check refuses to run when the two name the same
# database, and giving the shadow a role that cannot reach the primary puts that
# beyond a typo.
SHADOW_DATABASE_URL="postgresql://kycnot:kycnot@localhost:3399/kycnot_shadow?schema=public"
DATABASE_UI_URL="http://localhost:5555"

# Redis
REDIS_URL="redis://localhost:6379"

# Public URLs
SITE_URL="http://localhost:4321"
SOURCE_CODE_URL="https://github.com"
ONION_ADDRESS="http://kycnotmezdiftahfmc34pqbpicxlnx3jbf5p7jypge7gdvduu7i6qjqd.onion"
I2P_ADDRESS="http://nti3rj4j4disjcm2kvp4eno7otcejbbxv3ggxwr5tpfk4jucah7q.b32.i2p"

