{
  "name": "kycnot.me",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run db-gen && npm run build:astro && npm run build:server-init",
    "build:astro": "astro build --remote",
    "build:server-init": "esbuild src/server-init.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/server-init.js",
    "preview": "node dist/server/server-init.js & astro preview",
    "astro": "astro",
    "db-admin": "prisma studio --browser=none",
    "db-gen": "prisma generate",
    "db-push": "prisma migrate dev",
    "db-triggers": "just import-triggers",
    "db-update": "prisma migrate dev && just import-triggers",
    "db-reset": "prisma migrate reset -f && prisma migrate dev",
    "db-seed": "prisma db seed",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix && prettier --write .",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "gen-proto": "mkdir -p src/generated && protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/generated --ts_proto_opt=outputServices=grpc-js,esModuleInterop=true,useExactTypes=false,useOptionals=messages,importSuffix=.js --proto_path=proto proto/aggregator/v1/aggregator.proto"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "4.3.14",
    "@astrojs/node": "9.5.5",
    "@astrojs/rss": "4.0.18",
    "@astrojs/sitemap": "3.7.3",
    "@bufbuild/protobuf": "2.11.0",
    "@fontsource/inter": "5.2.8",
    "@fontsource/space-grotesk": "5.2.10",
    "@grpc/grpc-js": "1.14.3",
    "@napi-rs/canvas": "0.1.97",
    "@prisma/client": "6.11.1",
    "@tailwindcss/vite": "4.2.2",
    "@vercel/og": "0.11.1",
    "astro": "5.18.2",
    "astro-icon": "1.1.5",
    "astro-loading-indicator": "0.7.1",
    "astro-seo-schema": "5.2.0",
    "clsx": "2.1.1",
    "countries-list": "3.3.0",
    "country-flag-icons": "1.6.15",
    "date-fns": "4.1.0",
    "he": "1.2.0",
    "htmx.org": "2.0.8",
    "javascript-time-ago": "2.6.4",
    "libphonenumber-js": "1.12.41",
    "lodash-es": "4.18.1",
    "mime-types": "3.0.2",
    "object-to-formdata": "4.5.1",
    "pg": "8.20.0",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "redis": "5.11.0",
    "rehype-external-links": "3.0.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-rehype": "11.1.2",
    "schema-dts": "1.1.5",
    "seedrandom": "3.0.5",
    "sharp": "0.34.5",
    "slugify": "1.6.9",
    "tailwind-merge": "3.5.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.2.2",
    "unique-username-generator": "1.5.1",
    "unist-util-visit": "5.1.0",
    "web-push": "3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@eslint/js": "9.39.4",
    "@faker-js/faker": "10.4.0",
    "@iconify-json/cryptocurrency": "1.2.3",
    "@iconify-json/material-symbols": "1.2.65",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/ri": "1.2.10",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.19",
    "@types/eslint__js": "9.14.0",
    "@types/he": "1.2.3",
    "@types/lodash-es": "4.17.12",
    "@types/mime-types": "3.0.1",
    "@types/pg": "8.20.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/seedrandom": "3.0.8",
    "@types/web-push": "3.6.4",
    "@typescript-eslint/parser": "8.58.0",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vite-pwa/astro": "1.2.0",
    "astro-eslint-parser": "1.4.0",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-astro": "1.6.0",
    "eslint-plugin-better-tailwindcss": "4.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.4.0",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
