---
import { Icon } from 'astro-icon/components'

import BlogPostCard from '../../../components/BlogPostCard.astro'
import Breadcrumbs from '../../../components/Breadcrumbs.astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import {
  getAllTags,
  getPublishedPosts,
  postUrl,
  setBlogCacheHeaders,
  slugToTag,
  tagToSlug,
} from '../../../lib/blog'
import { absoluteSiteUrl } from '../../../lib/urls'

import type { BreadcrumArray } from '../../../components/BaseHead.astro'
import type { CollectionPage, ItemList, ListItem, WithContext } from 'schema-dts'

const isAdmin = Astro.locals.user?.admin ?? false

const { tag: tagSlug } = Astro.params
if (!tagSlug) return Astro.rewrite('/404')

// Resolve the tag from the published-only set so machine-driven URLs only
// expose tags that have at least one published post.
const publishedPosts = await getPublishedPosts()
const publishedTags = getAllTags(publishedPosts)
const tag = slugToTag(tagSlug, publishedTags)
if (!tag) return Astro.rewrite('/404')

// Cache headers go AFTER the existence check so 404 rewrites don't inherit
// the public cache and end up cached at the CDN.
setBlogCacheHeaders(Astro.response.headers, { isAuthenticated: Astro.locals.user !== null })

const allPosts = isAdmin ? await getPublishedPosts({ includeDrafts: true }) : publishedPosts
const posts = allPosts.filter((post) => post.data.tags.includes(tag))

const tagPath = `/blog/tag/${tagToSlug(tag)}`
const tagPageUrl = absoluteSiteUrl(tagPath)

const collectionPageSchema: WithContext<CollectionPage> = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Posts tagged: ${tag}`,
  description: `All KYCnot.me blog posts tagged "${tag}".`,
  url: tagPageUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: 'KYCnot.me',
    url: absoluteSiteUrl('/'),
  },
}

const itemListSchema: WithContext<ItemList> = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Posts tagged: ${tag}`,
  itemListElement: posts.map(
    (post, index) =>
      ({
        '@type': 'ListItem',
        position: index + 1,
        url: absoluteSiteUrl(postUrl(post)),
        name: post.data.title,
      }) satisfies ListItem
  ),
}

const breadcrumbs: BreadcrumArray = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: tag },
]
---

<BaseLayout
  pageTitle={`Posts tagged: ${tag}`}
  description={`All KYCnot.me blog posts tagged "${tag}". ${posts.length} ${posts.length === 1 ? 'post' : 'posts'}.`}
  canonical={tagPath}
  ogImage={{
    template: 'generic',
    title: `#${tag}`,
    description: `${posts.length} ${posts.length === 1 ? 'post' : 'posts'} tagged on the KYCnot.me blog`,
    icon: 'ri:price-tag-3-line',
  }}
  schemas={[collectionPageSchema, itemListSchema]}
  breadcrumbs={breadcrumbs}
  widthClassName="max-w-5xl"
>
  <header class="mt-6 mb-8">
    <Breadcrumbs items={breadcrumbs} class="mb-3" />

    <h1 class="font-title text-3xl font-bold text-balance text-white sm:text-4xl">
      <span class="text-day-500">#</span>{tag}
    </h1>
    <p class="mt-3 text-lg text-day-300">
      {posts.length} {posts.length === 1 ? 'post' : 'posts'} tagged with{' '}
      <code class="rounded-sm bg-night-700 px-1.5 py-0.5 text-day-200">{tag}</code>
    </p>
  </header>

  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      posts.map((post) => (
        <li>
          <BlogPostCard post={post} />
        </li>
      ))
    }
  </ul>

  <div class="mt-10">
    <a
      href="/blog"
      class="inline-flex items-center gap-1 text-sm text-day-400 transition-colors hover:text-day-100 hover:underline"
    >
      <Icon name="ri:arrow-left-s-line" class="size-4" />
      Back to all posts
    </a>
  </div>
</BaseLayout>
