---
import { Icon } from 'astro-icon/components'
import { actions } from 'astro:actions'

import AdminOnly from '../../components/AdminOnly.astro'
import BadgeSmall from '../../components/BadgeSmall.astro'
import InputSubmitButton from '../../components/InputSubmitButton.astro'
import InputTextArea from '../../components/InputTextArea.astro'
import Markdown from '../../components/Markdown.astro'
import MyPicture from '../../components/MyPicture.astro'
import TimeFormatted from '../../components/TimeFormatted.astro'
import Tooltip from '../../components/Tooltip.astro'
import { getCommentStatusInfo } from '../../constants/commentStatus'
import { getServiceSuggestionStatusInfo } from '../../constants/serviceSuggestionStatus'
import { getServiceSuggestionTypeInfo } from '../../constants/serviceSuggestionType'
import { getServiceUserRoleInfo } from '../../constants/serviceUserRoles'
import { verificationStatusesByValue } from '../../constants/verificationStatus'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { cn } from '../../lib/cn'
import { makeCommentUrl } from '../../lib/commentsWithReplies'
import { safeHttpUrl } from '../../lib/exchange/safeUrl'
import { publishedCommentStatuses } from '../../lib/experiences'
import { isStaff, staffBadgeLabel } from '../../lib/permissions'
import { prisma } from '../../lib/prisma'
import { KYCNOTME_SCHEMA_MINI } from '../../lib/schema'
import { formatDateShort } from '../../lib/timeAgo'
import { commentsDisabledMessage, makeUserWithTrust, trustRecord } from '../../lib/trust'
import { absoluteSiteUrl, urlDomain } from '../../lib/urls'
import { isUserProfileIndexable, profileServiceWhere } from '../../lib/userProfileSeo'

import type { CommentStatus } from '@prisma/client'
import type { ProfilePage, WithContext } from 'schema-dts'

const username = Astro.params.username
if (!username) return Astro.rewrite('/404')
const viewerIsOwner = Astro.locals.user?.name === username
// The owner also sees their withdrawn posts, to restore them.
const listedStatuses: CommentStatus[] = viewerIsOwner
  ? [...publishedCommentStatuses, 'WITHDRAWN']
  : publishedCommentStatuses

const user = await Astro.locals.banners.try('user', async () => {
  return makeUserWithTrust(
    await prisma.user.findUnique({
      where: { name: Astro.params.username },
      select: {
        id: true,
        name: true,
        displayName: true,
        link: true,
        picture: true,
        spammer: true,
        verified: true,
        scheduledDeletionAt: true,
        admin: true,
        capabilities: true,
        verifiedLink: true,
        createdAt: true,
        lastLoginAt: true,
        _count: {
          select: {
            comments: { where: { status: { in: listedStatuses }, service: profileServiceWhere } },
          },
        },
        suggestions: {
          select: {
            id: true,
            type: true,
            status: true,
            createdAt: true,
            service: {
              select: {
                id: true,
                name: true,
                slug: true,
              },
            },
          },
          where: { service: profileServiceWhere },
          orderBy: { createdAt: 'desc' },
          take: 5,
        },
        comments: {
          where: {
            status: { in: listedStatuses },
            service: profileServiceWhere,
          },
          select: {
            id: true,
            content: true,
            createdAt: true,
            status: true,
            service: {
              select: {
                id: true,
                name: true,
                slug: true,
              },
            },
          },
          orderBy: { createdAt: 'desc' },
          take: 5,
        },
        serviceAffiliations: {
          where: { service: profileServiceWhere },
          select: {
            role: true,
            service: {
              select: {
                id: true,
                name: true,
                slug: true,
                imageUrl: true,
                verificationStatus: true,
              },
            },
          },
          orderBy: [{ role: 'asc' }, { service: { name: 'asc' } }],
        },
        internalNotes: {
          select: {
            id: true,
            content: true,
            createdAt: true,
            addedByUser: {
              select: {
                name: true,
                displayName: true,
                picture: true,
              },
            },
          },
          orderBy: { createdAt: 'desc' },
        },
      },
    })
  )
})

if (!user) return Astro.rewrite('/404')
const website = safeHttpUrl(user.link)

const staffLabel = staffBadgeLabel(user)

const isCurrentUser = !!Astro.locals.user && user.id === Astro.locals.user.id
const viewerIsStaff = isStaff(Astro.locals.user)

const publicTrustFacts = trustRecord(user.trust).filter((fact) => fact.count > 0)
---

<BaseLayout
  pageTitle={`${user.displayName ?? user.name} - User Profile`}
  description={`User profile page of ${user.displayName ?? user.name} in KYCnot.me`}
  noindex={!isUserProfileIndexable(user)}
  ogImage={{
    template: 'generic',
    // eslint-disable-next-line @typescript-eslint/prefer-nullish-coalescing
    title: user.displayName || user.name,
    description: 'User profile page',
    icon: 'ri:user-3-line',
  }}
  widthClassName="max-w-3xl"
  classNames={{
    main: 'space-y-6',
  }}
  htmx
  schemas={[
    {
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      url: absoluteSiteUrl(`/u/${user.name}`),
      name: `${user.displayName ?? user.name}'s Profile`,
      dateCreated: user.createdAt.toISOString(),

      mainEntity: {
        '@type': 'Person',
        name: user.displayName ?? user.name,
        alternateName: user.displayName ? user.name : undefined,
        image: user.picture ?? undefined,
        url: absoluteSiteUrl(`/u/${user.name}`),
        sameAs: website ? [website] : undefined,
        description: `User profile page for ${user.displayName ?? user.name} on KYCnot.me`,
        identifier: [user.name, user.id.toString()],
        jobTitle: user.admin ? 'Administrator' : (staffLabel ?? undefined),
        memberOf: KYCNOTME_SCHEMA_MINI,
        interactionStatistic: [
          {
            '@type': 'InteractionCounter',
            interactionType: { '@type': 'WriteAction' },
            userInteractionCount: user._count.comments,
          },
          {
            '@type': 'InteractionCounter',
            interactionType: { '@type': 'CommentAction' },
            userInteractionCount: user._count.comments,
          },
        ],
      },
    } satisfies WithContext<ProfilePage>,
  ]}
  breadcrumbs={[
    {
      name: user.displayName ?? user.name,
      url: `/u/${user.name}`,
    },
  ]}
>
  <section class="rounded-lg border border-night-400 bg-night-400/5 p-6 shadow-sm backdrop-blur-xs">
    <header class="flex flex-wrap items-center justify-center gap-4">
      <div class="flex grow flex-wrap items-center justify-center gap-4">
        {
          user.picture ? (
            <MyPicture
              src={user.picture}
              alt=""
              class="size-12 rounded-full object-cover ring-2 ring-day-500/30 xs:size-14 sm:size-16"
              width={64}
              height={64}
            />
          ) : (
            <div class="flex size-16 items-center justify-center rounded-full bg-day-500/10 text-day-400 ring-2 ring-day-500/30">
              <Icon name="ri:user-3-line" class="size-8" />
            </div>
          )
        }
        <div class="grow">
          <h1 class="font-title text-lg font-bold tracking-wider text-white">
            {user.displayName ?? user.name}
            {isCurrentUser && <span class="font-normal text-day-500">(You)</span>}
          </h1>
          {user.displayName && <p class="font-title text-day-200">{user.name}</p>}
          <div class="mt-1 flex gap-2">
            {
              user.admin && (
                <span class="rounded-full border border-red-500/50 bg-red-500/20 px-2 py-0.5 text-xs text-red-400">
                  admin
                </span>
              )
            }
            {
              user.verified && (
                <span class="rounded-full border border-blue-500/50 bg-blue-500/20 px-2 py-0.5 text-xs text-blue-400">
                  verified
                </span>
              )
            }
            {
              staffLabel && (
                <span class="rounded-full border border-green-500/50 bg-green-500/20 px-2 py-0.5 text-xs text-green-400">
                  {staffLabel}
                </span>
              )
            }
            {
              user.trust.unlocks.veteranBadge && (
                <span class="rounded-full border border-amber-500/50 bg-amber-500/20 px-2 py-0.5 text-xs text-amber-400">
                  veteran
                </span>
              )
            }
          </div>
        </div>
      </div>
      <nav class="flex items-center gap-2">
        <AdminOnly>
          <Tooltip
            as="a"
            href={`/account/impersonate?targetUserId=${user.id}&redirect=${encodeURIComponent(absoluteSiteUrl(Astro.url.pathname))}`}
            data-astro-prefetch="tap"
            class="inline-flex items-center gap-1 rounded-md border border-amber-500/30 bg-amber-500/10 p-2 text-sm text-amber-400 shadow-xs transition-colors duration-200 hover:bg-amber-500/20 focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 focus:ring-offset-black focus:outline-hidden"
            text="Impersonate (admin)"
          >
            <Icon name="ri:spy-line" class="size-4" />
          </Tooltip>
        </AdminOnly>
        <AdminOnly>
          <Tooltip
            as="a"
            href={`/admin/users/${user.name}`}
            class="inline-flex items-center gap-1 rounded-md border border-day-500/30 bg-day-500/10 p-2 text-sm text-day-400 shadow-xs transition-colors duration-200 hover:bg-day-500/20 focus:ring-2 focus:ring-day-500 focus:ring-offset-2 focus:ring-offset-black focus:outline-hidden"
            text="Edit user (admin)"
          >
            <Icon name="ri:edit-line" class="size-4" />
          </Tooltip>
        </AdminOnly>
        {
          isCurrentUser && (
            <Tooltip
              as="a"
              href="/account"
              class="inline-flex items-center gap-1 rounded-md border border-day-500/30 bg-day-500/10 p-2 text-sm text-day-400 shadow-xs transition-colors duration-200 hover:bg-day-500/20 focus:ring-2 focus:ring-day-500 focus:ring-offset-2 focus:ring-offset-black focus:outline-hidden"
              text="Go to my account"
            >
              <Icon name="ri:eye-off-line" class="size-4" />
            </Tooltip>
          )
        }
        <a
          href="/about#contact"
          class="inline-flex items-center gap-1 rounded-md border border-red-500/30 bg-red-500/10 px-3 py-1.5 text-sm text-red-400 shadow-xs transition-colors duration-200 hover:bg-red-500/20 focus:ring-2 focus:ring-red-500 focus:ring-offset-2 focus:ring-offset-black focus:outline-hidden"
        >
          <Icon name="ri:alert-line" class="size-4" /> Report
        </a>
      </nav>
    </header>

    <div class="mt-6 border-t border-night-400 pt-6">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <h3 class="mb-4 font-title text-sm text-day-200">Profile Information</h3>
          <ul class="flex flex-col items-start gap-2">
            <li class="flex items-start">
              <span class="mt-0.5 mr-2 text-day-500"><Icon name="ri:user-3-line" class="size-4" /></span>
              <div>
                <p class="text-xs text-day-500">Username</p>
                <p class="text-day-300">{user.name}</p>
              </div>
            </li>

            <li class="inline-flex items-start">
              <span class="mt-0.5 mr-2 text-day-500">
                <Icon name="ri:user-smile-line" class="size-4" />
              </span>
              <div>
                <p class="text-xs text-day-500">Display Name</p>

                <p class="text-day-300">
                  {user.displayName ?? <span class="text-sm italic">Not set</span>}
                </p>
              </div>
            </li>

            {
              !!website && (
                <li class="inline-flex items-start">
                  <span class="mt-0.5 mr-2 text-day-500">
                    <Icon name="ri:link" class="size-4" />
                  </span>
                  <div>
                    <p class="text-xs text-day-500">Website</p>
                    <a
                      href={website}
                      target="_blank"
                      rel="nofollow noopener"
                      class="text-blue-400 hover:underline"
                    >
                      {website}
                    </a>
                  </div>
                </li>
              )
            }

            {
              publicTrustFacts.map((fact) => (
                <li class="flex items-start">
                  <span class="mt-0.5 mr-2 text-day-500">
                    <Icon name={fact.icon} class="size-4" />
                  </span>
                  <div>
                    <p class="text-xs text-day-500">{fact.label}</p>
                    <p class="text-day-300">{fact.count.toLocaleString()}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div id="account-status">
          <h3 class="mb-4 font-title text-sm text-day-200">Account Status</h3>
          <ul class="space-y-3">
            <li class="flex items-start">
              <span class="mt-0.5 mr-2 text-day-500">
                <Icon name="ri:shield-check-line" class="size-4" />
              </span>
              <div>
                <p class="text-xs text-day-500">Account Type</p>
                <div class="mt-1 flex flex-wrap gap-2">
                  {
                    user.admin && (
                      <span class="rounded-full border border-red-500/50 bg-red-500/20 px-2 py-0.5 text-xs text-red-400">
                        Admin
                      </span>
                    )
                  }
                  {
                    user.verified && (
                      <span class="rounded-full border border-blue-500/50 bg-blue-500/20 px-2 py-0.5 text-xs text-blue-400">
                        Verified User
                      </span>
                    )
                  }
                  {
                    staffLabel && (
                      <span class="rounded-full border border-green-500/50 bg-green-500/20 px-2 py-0.5 text-xs text-green-400">
                        {staffLabel}
                      </span>
                    )
                  }
                  {
                    !user.admin && !user.verified && !staffLabel && (
                      <span class="rounded-full border border-day-700/50 bg-day-700/20 px-2 py-0.5 text-xs text-day-400">
                        Standard User
                      </span>
                    )
                  }
                </div>
              </div>
            </li>

            <li class="flex items-start">
              <span class="mt-0.5 mr-2 text-day-500">
                <Icon name="ri:spam-2-line" class="size-4" />
              </span>
              <div>
                <p class="text-xs text-day-500">Spam Status</p>
                {
                  user.spammer ? (
                    <span class="rounded-full border border-red-500/50 bg-red-500/20 px-2 py-0.5 text-xs text-red-400">
                      Spammer
                    </span>
                  ) : (
                    <span class="rounded-full border border-green-500/50 bg-green-500/20 px-2 py-0.5 text-xs text-green-400">
                      Not Flagged
                    </span>
                  )
                }
              </div>
            </li>

            {
              viewerIsStaff && (user.trust.untrusted || user.trust.commentsDisabled) && (
                <li class="flex items-start">
                  <span class="mt-0.5 mr-2 text-day-500">
                    <Icon name="ri:shield-user-line" class="size-4" />
                  </span>
                  <div>
                    <p class="text-xs text-day-500">Trust (staff only)</p>
                    {user.trust.untrusted && (
                      <p class="text-sm text-yellow-400">Comments are reviewed before publishing</p>
                    )}
                    {user.trust.commentsDisabled && (
                      <p class="text-sm text-red-400">{commentsDisabledMessage}</p>
                    )}
                  </div>
                </li>
              )
            }

            <li class="flex items-start">
              <span class="mt-0.5 mr-2 text-day-500"><Icon name="ri:calendar-line" class="size-4" /></span>
              <div>
                <p class="text-xs text-day-500">Joined</p>
                <p class="text-day-300">
                  {
                    formatDateShort(user.createdAt, {
                      prefix: false,
                      hourPrecision: true,
                      caseType: 'sentence',
                    })
                  }
                </p>
              </div>
            </li>

            <AdminOnly>
              <li class="flex items-start">
                <span class="mt-0.5 mr-2 text-day-500"><Icon name="ri:calendar-line" class="size-4" /></span>
                <div>
                  <p class="text-xs text-day-500">Last login</p>
                  <p class="text-day-300">
                    {
                      formatDateShort(user.lastLoginAt, {
                        prefix: false,
                        hourPrecision: true,
                        caseType: 'sentence',
                      })
                    }
                  </p>
                </div>
              </li>
            </AdminOnly>

            {
              user.verifiedLink && (
                <li class="flex items-start">
                  <span class="mt-0.5 mr-2 text-day-500">
                    <Icon name="ri:check-double-line" class="size-4" />
                  </span>
                  <div>
                    <p class="text-xs text-day-500">Verified as related to</p>
                    <a
                      href={user.verifiedLink}
                      target="_blank"
                      rel="nofollow noopener"
                      class="text-blue-400 hover:underline"
                    >
                      {urlDomain(user.verifiedLink)}
                    </a>
                  </div>
                </li>
              )
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <AdminOnly>
    <section class="rounded-lg border border-night-400 bg-night-400/5 p-6 shadow-sm backdrop-blur-xs">
      <header>
        <h2 class="mb-6 text-center font-title text-2xl font-bold text-day-200">
          Internal Notes <span class="text-sm font-normal text-day-400">(Admin only)</span>
        </h2>
      </header>
      {
        user.internalNotes.length === 0 ? (
          <p class="text-center text-day-400">No internal notes yet.</p>
        ) : (
          <div class="space-y-4">
            {user.internalNotes.map((note) => (
              <div class="rounded-lg border border-night-400 bg-night-600 p-4">
                <div class="mb-2 flex items-center gap-2">
                  {!!note.addedByUser?.picture && (
                    <img
                      src={note.addedByUser.picture}
                      alt=""
                      width={24}
                      height={24}
                      class="size-6 rounded-full"
                    />
                  )}
                  <span class="font-bold text-day-100">
                    {note.addedByUser ? (note.addedByUser.displayName ?? note.addedByUser.name) : 'System'}
                  </span>
                  <span class="text-sm text-day-400">
                    <TimeFormatted date={note.createdAt} hourPrecision />
                  </span>
                </div>
                <div class="prose prose-sm max-w-none text-pretty text-day-200 prose-invert">
                  <Markdown content={note.content} />
                </div>
              </div>
            ))}
          </div>
        )
      }

      <form
        method="POST"
        action={actions.admin.user.internalNotes.add}
        data-note-edit-form
        class="mt-4 space-y-4"
      >
        <input type="hidden" name="userId" value={user.id} />

        <InputTextArea label="Add a note" name="content" inputProps={{ class: 'bg-night-700' }} />
        <InputSubmitButton label="Save" icon="ri:save-line" hideCancel />
      </form>
    </section>
  </AdminOnly>

  {
    !user.admin && !isStaff(user) && (
      <section class="rounded-lg border border-night-400 bg-night-400/5 p-6 shadow-sm backdrop-blur-xs">
        <header>
          <h2 class="mb-4 font-title text-xl font-bold text-day-200">
            <Icon name="ri:building-4-line" class="mr-2 inline-block size-5" />
            Service Affiliations
          </h2>
        </header>

        {user.serviceAffiliations.length > 0 ? (
          <ul class="grid gap-4 2xs:grid-cols-[repeat(auto-fit,minmax(200px,1fr))]">
            {user.serviceAffiliations.map((affiliation) => {
              const roleInfo = getServiceUserRoleInfo(affiliation.role)
              const statusIcon = {
                ...verificationStatusesByValue,
                APPROVED: undefined,
              }[affiliation.service.verificationStatus]

              return (
                <li class="shrink-0">
                  <a
                    href={`/service/${affiliation.service.slug}`}
                    class="group flex min-w-32 items-center gap-2 text-sm text-day-300"
                  >
                    <MyPicture
                      src={affiliation.service.imageUrl}
                      fallback="service"
                      alt={affiliation.service.name}
                      width={40}
                      height={40}
                      class="size-10 shrink-0 rounded-lg object-contain"
                    />
                    <div class="flex min-w-0 flex-1 flex-col justify-center">
                      <div class="flex items-center gap-1.5">
                        <BadgeSmall color={roleInfo.color} text={roleInfo.label} icon={roleInfo.icon} />
                        <span class="text-day-500">of</span>
                      </div>

                      <div class="flex items-center gap-1 font-semibold text-day-300">
                        <span class="min-w-0 truncate group-hover:underline">{affiliation.service.name}</span>
                        {statusIcon && (
                          <Tooltip text={statusIcon.label} position="right" class="-m-1 shrink-0">
                            <Icon
                              name={statusIcon.icon}
                              class={cn(
                                'inline-block size-6 shrink-0 rounded-lg p-1',
                                statusIcon.classNames.icon
                              )}
                            />
                          </Tooltip>
                        )}
                        <Icon name="ri:external-link-line" class="size-4 shrink-0" />
                      </div>
                    </div>
                  </a>
                </li>
              )
            })}
          </ul>
        ) : (
          <p class="mb-6 text-day-400">No service affiliations yet.</p>
        )}
      </section>
    )
  }

  <div class="space-y-6">
    <section class="rounded-lg border border-night-400 bg-night-400/5 p-6 shadow-sm backdrop-blur-xs">
      <header class="flex items-center justify-between">
        <h2 class="mb-4 font-title text-xl font-bold text-day-200">
          <Icon name="ri:chat-3-line" class="mr-2 inline-block size-5" />
          Recent Comments
        </h2>
        <span class="text-day-500">{user._count.comments.toLocaleString()} comments</span>
      </header>

      {
        user.comments.length === 0 ? (
          <p class="text-day-400">No comments yet.</p>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full min-w-full divide-y divide-night-400/20">
              <thead>
                <tr>
                  <th class="px-4 py-3 text-left text-xs text-day-400">Service</th>
                  <th class="px-4 py-3 text-left text-xs text-day-400">Comment</th>
                  <th class="px-4 py-3 text-center text-xs text-day-400">Status</th>
                  <th class="px-4 py-3 text-right text-xs text-day-400">Date</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-night-400/10">
                {user.comments.map((comment) => (
                  <tr class="hover:bg-night-500/5">
                    <td class="px-4 py-3 text-xs whitespace-nowrap text-day-300">
                      <a href={`/service/${comment.service.slug}`} class="text-blue-400 hover:underline">
                        {comment.service.name}
                      </a>
                    </td>
                    <td class="px-4 py-3 text-day-300">
                      <a
                        href={makeCommentUrl({
                          serviceSlug: comment.service.slug,
                          commentId: comment.id,
                          ...(comment.status === 'WITHDRAWN' ? { tool: 'edit', section: 'withdraw' } : {}),
                        })}
                        class="line-clamp-1 hover:underline"
                      >
                        {comment.content}
                      </a>
                    </td>
                    <td class="px-4 py-3 text-center">
                      <span class="inline-flex rounded-full border border-day-700/20 bg-night-800/30 px-2 py-0.5 text-xs text-day-300">
                        {getCommentStatusInfo(comment.status).publicLabel}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-right text-xs whitespace-nowrap text-day-400">
                      <TimeFormatted
                        date={comment.createdAt}
                        prefix={false}
                        hourPrecision
                        caseType="sentence"
                      />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>

    {
      !user.admin && !isStaff(user) && (
        <section class="rounded-lg border border-night-400 bg-night-400/5 p-6 shadow-sm backdrop-blur-xs">
          <header class="flex items-center justify-between">
            <h2 class="mb-4 font-title text-xl font-bold text-day-200">
              <Icon name="ri:lightbulb-line" class="mr-2 inline-block size-5" />
              Recent Suggestions
            </h2>
          </header>

          {user.suggestions.length === 0 ? (
            <p class="text-day-400">No suggestions yet.</p>
          ) : (
            <div class="overflow-x-auto">
              <table class="w-full min-w-full divide-y divide-night-400/20">
                <thead>
                  <tr>
                    <th class="px-4 py-3 text-left text-xs text-day-400">Service</th>
                    <th class="px-4 py-3 text-left text-xs text-day-400">Type</th>
                    <th class="px-4 py-3 text-center text-xs text-day-400">Status</th>
                    <th class="px-4 py-3 text-right text-xs text-day-400">Date</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-night-400/10">
                  {user.suggestions.map((suggestion) => {
                    const typeInfo = getServiceSuggestionTypeInfo(suggestion.type)
                    const statusInfo = getServiceSuggestionStatusInfo(suggestion.status)

                    return (
                      <tr class="hover:bg-night-500/5">
                        <td class="px-4 py-3 text-xs whitespace-nowrap text-day-300">
                          <a
                            href={`/service-suggestion/${suggestion.id}`}
                            class="text-blue-400 hover:underline"
                          >
                            {suggestion.service.name}
                          </a>
                        </td>
                        <td class="px-4 py-3 text-xs whitespace-nowrap text-day-300">
                          <span class="inline-flex items-center">
                            <Icon name={typeInfo.icon} class="mr-1 size-4" />
                            {typeInfo.label}
                          </span>
                        </td>
                        <td class="px-4 py-3 text-center">
                          <span class="inline-flex items-center rounded-full border border-night-500/20 bg-night-800/10 px-2 py-0.5 text-xs">
                            <Icon name={statusInfo.icon} class="mr-1 size-3" />
                            {statusInfo.label}
                          </span>
                        </td>
                        <td class="px-4 py-3 text-right text-xs whitespace-nowrap text-day-400">
                          <TimeFormatted
                            date={suggestion.createdAt}
                            prefix={false}
                            hourPrecision
                            caseType="sentence"
                          />
                        </td>
                      </tr>
                    )
                  })}
                </tbody>
              </table>
            </div>
          )}
        </section>
      )
    }
  </div>
</BaseLayout>
