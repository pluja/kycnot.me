            </p>
          ) : (
            <div class="space-y-2">
              {service.verificationSteps.map((step) => {
                const verificationStepStatusInfo = getVerificationStepStatusInfo(step.status)
                return (
                  <div class="rounded-md border border-night-600 bg-night-800 p-3">
                    <div class="flex items-start justify-between gap-3">
                      <div class="grow space-y-1">
                        <div class="flex flex-wrap items-center gap-2">
                          <span class="font-semibold text-day-100">{step.title}</span>
                          <BadgeSmall
                            text={verificationStepStatusInfo.label}
