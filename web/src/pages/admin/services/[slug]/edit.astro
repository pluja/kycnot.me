---
import { Prisma } from '@prisma/client'
import { Icon } from 'astro-icon/components'
import { actions, isInputError } from 'astro:actions'

import AdminPageNav from '../../../../components/admin/AdminPageNav.astro'
import ApiSection from '../../../../components/admin/services/edit/Api.astro'
import ContactMethodsSection from '../../../../components/admin/services/edit/ContactMethods.astro'
import DetailsSection from '../../../../components/admin/services/edit/Details.astro'
import EventsSection from '../../../../components/admin/services/edit/Events.astro'
import EvidenceImagesSection from '../../../../components/admin/services/edit/EvidenceImages.astro'
import InternalNotesSection from '../../../../components/admin/services/edit/InternalNotes.astro'
import TasksSection from '../../../../components/admin/services/edit/Tasks.astro'
import TosHighlightsSection from '../../../../components/admin/services/edit/TosHighlights.astro'
import VerificationRequestsSection from '../../../../components/admin/services/edit/VerificationRequests.astro'
import VerificationStepsSection from '../../../../components/admin/services/edit/VerificationSteps.astro'
import Button from '../../../../components/Button.astro'
import MyPicture from '../../../../components/MyPicture.astro'
import ServiceCard from '../../../../components/ServiceCard.astro'
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import { listImageFiles } from '../../../../lib/fileStorage'
import { makeAdminApiCallInfo } from '../../../../lib/makeAdminApiCallInfo'
import { prisma } from '../../../../lib/prisma'

const { slug } = Astro.params

if (!slug) return Astro.rewrite('/404')

const errorsOf = <T extends { error?: unknown } | undefined>(result: T) =>
  isInputError(result?.error) ? result.error.fields : {}

const serviceResult = Astro.getActionResult(actions.admin.service.update)
Astro.locals.banners.addIfSuccess(serviceResult, 'Service updated successfully')
const serviceInputErrors = errorsOf(serviceResult)

if (serviceResult && !serviceResult.error && slug !== serviceResult.data.service.slug) {
  return Astro.redirect(`/admin/services/${serviceResult.data.service.slug}/edit#details`)
}

const eventCreateResult = Astro.getActionResult(actions.admin.event.create)
Astro.locals.banners.addIfSuccess(eventCreateResult, 'Event created successfully')

const eventUpdateResult = Astro.getActionResult(actions.admin.event.update)
Astro.locals.banners.addIfSuccess(eventUpdateResult, 'Event updated successfully')

const eventToggleResult = Astro.getActionResult(actions.admin.event.toggle)
Astro.locals.banners.addIfSuccess(eventToggleResult, 'Event visibility updated successfully')

const eventDeleteResult = Astro.getActionResult(actions.admin.event.delete)
Astro.locals.banners.addIfSuccess(eventDeleteResult, 'Event deleted successfully')

const verificationStepCreateResult = Astro.getActionResult(actions.admin.verificationStep.create)
Astro.locals.banners.addIfSuccess(verificationStepCreateResult, 'Verification step added successfully')

const verificationStepUpdateResult = Astro.getActionResult(actions.admin.verificationStep.update)
Astro.locals.banners.addIfSuccess(verificationStepUpdateResult, 'Verification step updated successfully')

const verificationStepDeleteResult = Astro.getActionResult(actions.admin.verificationStep.delete)
Astro.locals.banners.addIfSuccess(verificationStepDeleteResult, 'Verification step deleted successfully')

const internalNoteCreateResult = Astro.getActionResult(actions.admin.service.internalNote.add)
Astro.locals.banners.addIfSuccess(internalNoteCreateResult, 'Internal note added successfully')

const internalNoteUpdateResult = Astro.getActionResult(actions.admin.service.internalNote.update)
Astro.locals.banners.addIfSuccess(internalNoteUpdateResult, 'Internal note updated successfully')

const internalNoteDeleteResult = Astro.getActionResult(actions.admin.service.internalNote.delete)
Astro.locals.banners.addIfSuccess(internalNoteDeleteResult, 'Internal note deleted successfully')

const contactMethodAddResult = Astro.getActionResult(actions.admin.service.contactMethod.add)
Astro.locals.banners.addIfSuccess(contactMethodAddResult, 'Contact method added successfully')

const contactMethodUpdateResult = Astro.getActionResult(actions.admin.service.contactMethod.update)
Astro.locals.banners.addIfSuccess(contactMethodUpdateResult, 'Contact method updated successfully')

const contactMethodDeleteResult = Astro.getActionResult(actions.admin.service.contactMethod.delete)
Astro.locals.banners.addIfSuccess(contactMethodDeleteResult, 'Contact method deleted successfully')

const tosHighlightAddResult = Astro.getActionResult(actions.admin.service.tosHighlight.add)
Astro.locals.banners.addIfSuccess(tosHighlightAddResult, 'ToS highlight added successfully')

const tosHighlightUpdateResult = Astro.getActionResult(actions.admin.service.tosHighlight.update)
Astro.locals.banners.addIfSuccess(tosHighlightUpdateResult, 'ToS highlight updated successfully')

const tosHighlightDeleteResult = Astro.getActionResult(actions.admin.service.tosHighlight.delete)
Astro.locals.banners.addIfSuccess(tosHighlightDeleteResult, 'ToS highlight deleted successfully')

const evidenceImageAddResult = Astro.getActionResult(actions.admin.service.evidenceImage.add)
if (evidenceImageAddResult?.data?.imageUrl) {
  Astro.locals.banners.add({
    uiMessage: 'Evidence image added successfully',
    type: 'success',
    origin: 'action',
  })
}

const evidenceImageDeleteResult = Astro.getActionResult(actions.admin.service.evidenceImage.delete)
Astro.locals.banners.addIfSuccess(evidenceImageDeleteResult, 'Evidence image deleted successfully')

const deepScanRequestResult = Astro.getActionResult(actions.admin.service.deepScan.request)
Astro.locals.banners.addIfSuccess(deepScanRequestResult, 'Deep scan queued')

const deepScanApplyResult = Astro.getActionResult(actions.admin.service.deepScan.apply)
Astro.locals.banners.addIfSuccess(deepScanApplyResult, 'Proposed edits applied')

const deepScanDismissResult = Astro.getActionResult(actions.admin.service.deepScan.dismiss)
Astro.locals.banners.addIfSuccess(deepScanDismissResult, 'Proposed edits dismissed')

const [service, categories, attributes] = await Astro.locals.banners.tryMany([
  [
    'Error fetching service',
    () =>
      prisma.service.findUnique({
        where: { slug },
        include: {
          attributes: {
            select: {
              attribute: {
                select: {
                  id: true,
                },
              },
            },
          },
          categories: {
            select: {
              id: true,
              name: true,
              icon: true,
            },
          },
          events: {
            orderBy: {
              startedAt: 'desc',
            },
          },
          verificationRequests: {
            select: {
              id: true,
              user: {
                select: {
                  name: true,
                  displayName: true,
                  picture: true,
                },
              },
              createdAt: true,
            },
            orderBy: {
              createdAt: 'desc',
            },
          },
          verificationSteps: {
            orderBy: {
              createdAt: 'desc',
            },
          },
          contactMethods: {
            orderBy: {
              label: 'asc',
            },
          },
          internalNotes: {
            include: {
              addedByUser: {
                select: {
                  name: true,
                  displayName: true,
                  picture: true,
                },
              },
            },
            orderBy: {
              createdAt: 'desc',
            },
          },
          _count: {
            select: {
              verificationRequests: true,
            },
          },
        },
      }),
  ],
  [
    'Error fetching categories',
    () =>
      prisma.category.findMany({
        orderBy: { name: 'asc' },
      }),
    [] as [],
  ],
  [
    'Error fetching attributes',
    () =>
      prisma.attribute.findMany({
        orderBy: { category: 'asc' },
      }),
    [] as [],
  ],
])

if (!service) {
  try {
    const serviceWithOldSlug = await prisma.service.findFirst({
      where: { previousSlugs: { has: slug } },
      select: { slug: true },
    })
    if (serviceWithOldSlug) {
      return Astro.redirect(`/admin/services/${serviceWithOldSlug.slug}/edit`, 301)
    }
  } catch (error) {
    console.error(error)
  }

  return Astro.rewrite('/404')
}

const evidenceImages = await Astro.locals.banners.try(
  'Error listing evidence files',
  () => listImageFiles(`evidence/${service.slug}`),
  []
)

const [scanJob, pendingDeepScanSuggestion] = await Astro.locals.banners.tryMany([
  [
    'Error fetching scan job',
    () =>
      prisma.serviceScanJob.findUnique({
        where: { serviceId: service.id },
        select: {
          id: true,
          createdAt: true,
          claimedAt: true,
          processedAt: true,
          error: true,
        },
      }),
    null,
  ],
  [
    'Error fetching deep scan suggestion',
    () =>
      prisma.serviceSuggestion.findFirst({
        where: {
          serviceId: service.id,
          status: { in: ['PENDING', 'UNDER_REVIEW'] },
          proposedEdits: { not: Prisma.AnyNull },
        },
        select: {
          id: true,
          status: true,
          createdAt: true,
          proposedEdits: true,
        },
        orderBy: { createdAt: 'desc' },
      }),
    null,
  ],
])

const apiCalls = await Astro.locals.banners.try(
  'Error fetching api calls',
  () =>
    Promise.all([
      makeAdminApiCallInfo({
        method: 'QUERY',
        path: '/service/get',
        input: { slug: service.slug },
        baseUrl: Astro.url,
      }),
    ]),
  []
)

const isScanning = !!scanJob && scanJob.processedAt === null
const tasksBadge = pendingDeepScanSuggestion ? '!' : isScanning ? '...' : undefined

const navItems = [
  { id: 'details', label: 'Service Details', icon: 'ri:settings-3-line' },
  {
    id: 'tasks',
    label: 'Tasks',
    icon: 'ri:sparkling-2-line',
    badge: tasksBadge,
  },
  {
    id: 'tos-highlights',
    label: 'ToS Highlights',
    icon: 'ri:file-list-3-line',
    badge: service.tosReview?.highlights.length,
  },
  {
    id: 'internal-notes',
    label: 'Internal Notes',
    icon: 'ri:sticky-note-line',
    badge: service.internalNotes.length,
  },
  {
    id: 'events',
    label: 'Events',
    icon: 'ri:calendar-event-line',
    badge: service.events.length,
  },
  {
    id: 'verification-steps',
    label: 'Verification Steps',
    icon: 'ri:list-check-2',
    badge: service.verificationSteps.length,
  },
  {
    id: 'verification-requests',
    label: 'Verification Requests',
    icon: 'ri:user-received-line',
    badge: service._count.verificationRequests,
  },
  {
    id: 'contact-methods',
    label: 'Contact Methods',
    icon: 'ri:contacts-line',
    badge: service.contactMethods.length,
  },
  { id: 'api', label: 'API', icon: 'ri:terminal-box-line' },
  {
    id: 'evidence-images',
    label: 'Evidence Images',
    icon: 'ri:image-line',
    badge: evidenceImages.length,
  },
]
---

<BaseLayout pageTitle={`Edit Service: ${service.name}`} htmx>
  <div class="mx-auto max-w-7xl px-4">
    <div class="mt-12 flex flex-wrap items-center justify-center gap-6">
      <div class="grow">
        {
          !!service.imageUrl && (
            <MyPicture
              src={service.imageUrl}
              alt=""
              width={80}
              height={80}
              class="mx-auto mb-2 block size-20 rounded-xl object-contain"
            />
          )
        }
        <h1 class="mb-2 flex items-center justify-center gap-2 text-center font-title text-3xl font-bold">
          {service.name}
        </h1>

        <div class="flex justify-center gap-2">
          <Button
            as="a"
            href={`/service/${service.slug}`}
            icon="ri:external-link-line"
            color="success"
            shadow
            size="sm"
            label="View"
          />
          <Button
            as="a"
            href="/admin/services"
            icon="ri:arrow-left-line"
            color="gray"
            size="sm"
            label="Back"
          />
        </div>
      </div>
      <ServiceCard service={service} class="flex-1 grow-2 basis-64" withoutLink />
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-[14rem_1fr]">
      <AdminPageNav items={navItems} class="lg:py-2" />

      <div class="max-w-3xl min-w-0 space-y-24">
        <DetailsSection
          service={service}
          categories={categories}
          attributes={attributes}
          inputErrors={serviceInputErrors}
        />

        <TasksSection
          service={service}
          scanJob={scanJob}
          pendingSuggestion={pendingDeepScanSuggestion}
          attributes={attributes}
        />

        <TosHighlightsSection
          serviceId={service.id}
          tosReview={service.tosReview}
          addInputErrors={errorsOf(tosHighlightAddResult)}
          updateInputErrors={errorsOf(tosHighlightUpdateResult)}
        />

        <InternalNotesSection
          serviceId={service.id}
          notes={service.internalNotes}
          addInputErrors={errorsOf(internalNoteCreateResult)}
        />

        <EventsSection
          serviceId={service.id}
          events={service.events}
          createInputErrors={errorsOf(eventCreateResult)}
          updateInputErrors={errorsOf(eventUpdateResult)}
        />

        <VerificationStepsSection
          serviceId={service.id}
          verificationSteps={service.verificationSteps}
          createInputErrors={errorsOf(verificationStepCreateResult)}
          updateInputErrors={errorsOf(verificationStepUpdateResult)}
        />

        <VerificationRequestsSection
          total={service._count.verificationRequests}
          requests={service.verificationRequests}
        />

        <ContactMethodsSection
          serviceId={service.id}
          contactMethods={service.contactMethods}
          addInputErrors={errorsOf(contactMethodAddResult)}
          updateInputErrors={errorsOf(contactMethodUpdateResult)}
        />

        <ApiSection apiCalls={apiCalls} />

        <EvidenceImagesSection
          serviceId={service.id}
          evidenceImages={evidenceImages}
          addInputErrors={errorsOf(evidenceImageAddResult)}
        />
      </div>
    </div>
  </div>

  <div
    id="evidence-lightbox"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm"
    data-lightbox-overlay
  >
    <button
      type="button"
      class="absolute inset-0 cursor-default"
      data-lightbox-close
      aria-label="Close"
    ></button>
    <button
      type="button"
      class="absolute top-4 right-4 z-10 flex size-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
      data-lightbox-close
      aria-label="Close"
    >
      <Icon name="ri:close-line" class="size-6" />
    </button>
    <img
      src=""
      alt="Evidence at full size"
      class="relative max-h-[90vh] max-w-[90vw] rounded-lg object-contain"
      data-lightbox-img
    />
  </div>

  <script>
    ////////////////////////////////////////////////////////////
    // Optional script for the "Clear" buttons next to        //
    // datetime-local inputs.                                 //
    //                                                        //
    // HTML5 datetime-local inputs can get stuck in a         //
    // "badInput" state when the user partially deletes the   //
    // value, blocking form submission even when the field is //
    // not required. Clicking Clear resets the value and      //
    // dispatches input/change events so any listeners and    //
    // the browser's validation state see a clean reset.      //
    ////////////////////////////////////////////////////////////
    document.addEventListener('astro:page-load', () => {
      document.querySelectorAll<HTMLButtonElement>('[data-clear-datetime]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetName = btn.dataset.clearDatetime
          if (!targetName) return
          const form = btn.closest('form')
          if (!form) return
          const input = form.querySelector<HTMLInputElement>(`input[name="${targetName}"]`)
          if (!input) return
          input.value = ''
          input.dispatchEvent(new Event('input', { bubbles: true }))
          input.dispatchEvent(new Event('change', { bubbles: true }))
        })
      })
    })
  </script>

  <script>
    ////////////////////////////////////////////////////////////
    // Optional script for the evidence image lightbox.       //
    ////////////////////////////////////////////////////////////
    document.addEventListener('astro:page-load', () => {
      const overlay = document.querySelector<HTMLDivElement>('[data-lightbox-overlay]')
      const img = document.querySelector<HTMLImageElement>('[data-lightbox-img]')
      if (!overlay || !img) return

      document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const src = btn.dataset.lightboxSrc
          if (!src) return
          img.src = src
          overlay.classList.remove('hidden')
          overlay.classList.add('flex')
          document.body.style.overflow = 'hidden'
        })
      })

      const close = () => {
        overlay.classList.add('hidden')
        overlay.classList.remove('flex')
        img.src = ''
        document.body.style.overflow = ''
      }

      overlay.querySelectorAll('[data-lightbox-close]').forEach((el) =>
        el.addEventListener('click', close)
      )
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !overlay.classList.contains('hidden')) close()
      })
    })
  </script>
</BaseLayout>
