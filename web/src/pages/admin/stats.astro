---
import { Icon } from 'astro-icon/components'

import BaseLayout from '../../layouts/BaseLayout.astro'
import { cn } from '../../lib/cn'
import { prisma } from '../../lib/prisma'

if (!Astro.locals.userCan('stats:view')) return Astro.rewrite('/404')

const RANGE_OPTIONS = [
  { id: 'today', label: 'Today', days: 1 },
  { id: '7d', label: '7 days', days: 7 },
  { id: '30d', label: '30 days', days: 30 },
  { id: 'all', label: 'All time', days: null },
] as const

const selectedRangeId = Astro.url.searchParams.get('range') ?? '7d'
const selectedRange = RANGE_OPTIONS.find((range) => range.id === selectedRangeId) ?? RANGE_OPTIONS[1]

const getUtcDayStart = (days: number | null): Date | null => {
  if (days === null) return null

  const date = new Date()
  date.setUTCHours(0, 0, 0, 0)
  date.setUTCDate(date.getUTCDate() - days + 1)
  return date
}

const cutoff = getUtcDayStart(selectedRange.days)
const dayWhere = cutoff ? { day: { gte: cutoff } } : {}

const [topServices, topPairs, topRefs, totals] = await Promise.all([
  Astro.locals.banners.try(
    'Failed to fetch top services',
    () =>
      prisma.stat.groupBy({
        by: ['serviceId'],
        where: { ...dayWhere, kind: 'swap.clickout' },
        _sum: { count: true },
        orderBy: { _sum: { count: 'desc' } },
        take: 20,
      }),
    []
  ),
  Astro.locals.banners.try(
    'Failed to fetch top pairs',
    () =>
      prisma.stat.groupBy({
        by: ['fromCurrency', 'toCurrency'],
        where: {
          ...dayWhere,
          kind: 'swap.quote-fetched',
          fromCurrency: { not: null },
          toCurrency: { not: null },
        },
        _sum: { count: true },
        orderBy: { _sum: { count: 'desc' } },
        take: 20,
      }),
    []
  ),
  Astro.locals.banners.try(
    'Failed to fetch top referrals',
    () =>
      prisma.stat.groupBy({
        by: ['serviceId', 'refCode'],
        where: { ...dayWhere, kind: 'swap.clickout', refCode: { not: null } },
        _sum: { count: true },
        orderBy: { _sum: { count: 'desc' } },
        take: 20,
      }),
    []
  ),
  Astro.locals.banners.try(
    'Failed to fetch totals',
    () =>
      prisma.stat.groupBy({
        by: ['kind'],
        where: dayWhere,
        _sum: { count: true },
      }),
    []
  ),
])

const serviceIds = [
  ...new Set(
    [...topServices, ...topRefs].map((row) => row.serviceId).filter((id): id is number => id !== null)
  ),
]
const referralServiceIds = [
  ...new Set(topRefs.map((row) => row.serviceId).filter((id): id is number => id !== null)),
]

const services =
  serviceIds.length === 0
    ? []
    : await Astro.locals.banners.try(
        'Failed to resolve service names',
        () =>
          prisma.service.findMany({
            where: { id: { in: serviceIds } },
            select: { id: true, name: true, slug: true },
          }),
        []
      )
const referralServiceClickouts =
  referralServiceIds.length === 0
    ? []
    : await Astro.locals.banners.try(
        'Failed to fetch referral service clickouts',
        () =>
          prisma.stat.groupBy({
            by: ['serviceId'],
            where: { ...dayWhere, kind: 'swap.clickout', serviceId: { in: referralServiceIds } },
            _sum: { count: true },
          }),
        []
      )

const serviceById = new Map(services.map((service) => [service.id, service]))
const clickoutsByReferralServiceId = new Map(
  referralServiceClickouts
    .filter((row) => row.serviceId !== null)
    .map((row) => [row.serviceId, row._sum.count ?? 0])
)
const totalsByKind = new Map(totals.map((row) => [row.kind, row._sum.count ?? 0]))

const totalCards = [
  {
    label: 'Quote fetches',
    value: totalsByKind.get('swap.quote-fetched') ?? 0,
    icon: 'ri:exchange-dollar-line',
  },
  {
    label: 'Visits',
    value: totalsByKind.get('swap.view') ?? 0,
    icon: 'ri:eye-line',
  },
  {
    label: 'Clickouts',
    value: totalsByKind.get('swap.clickout') ?? 0,
    icon: 'ri:external-link-line',
  },
]

const formatCount = (value: number): string => new Intl.NumberFormat('en').format(value)
const formatPercent = (value: number): string =>
  new Intl.NumberFormat('en', { maximumFractionDigits: 1 }).format(value) + '%'

const formatPair = (from: string | null, to: string | null): string => {
  const f = from ?? '?'
  const t = to ?? '?'
  return `${f.toUpperCase()} → ${t.toUpperCase()}`
}
---

<BaseLayout pageTitle="Stats" widthClassName="max-w-7xl">
  <header class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <div class="flex items-center gap-3">
        <Icon name="ri:bar-chart-2-line" class="size-8 text-teal-300" />
        <h1 class="font-title text-3xl font-bold text-day-100">Stats</h1>
      </div>
      <p class="mt-3 max-w-4xl text-sm text-day-500">
        Aggregate counters only. Rows track activity, not visitors. No IP, User-Agent, session, cookie, user
        id, or sub-day timestamp is stored.
      </p>
    </div>

    <nav
      class="flex w-full gap-1 rounded-xl border border-night-700/60 bg-night-900/50 p-1 sm:w-auto"
      aria-label="Stats range"
    >
      {
        RANGE_OPTIONS.map((range) => {
          const active = range.id === selectedRange.id
          return (
            <a
              href={`/admin/stats?range=${range.id}`}
              class={cn(
                'flex-1 rounded-lg px-3 py-2 text-center text-sm font-semibold whitespace-nowrap transition-colors sm:flex-none',
                active ? 'bg-teal-400 text-night-950' : 'text-day-400 hover:bg-night-800 hover:text-day-100'
              )}
              aria-current={active ? 'page' : undefined}
            >
              {range.label}
            </a>
          )
        })
      }
    </nav>
  </header>

  <section class="mb-8 grid grid-cols-1 gap-3 sm:grid-cols-3">
    {
      totalCards.map((card) => (
        <div class="rounded-xl border border-night-700/50 bg-night-800/40 p-4 shadow-sm shadow-black/10">
          <div class="flex items-center justify-between gap-3">
            <div class="text-sm font-semibold text-day-400">{card.label}</div>
            <Icon name={card.icon} class="size-5 text-teal-300" />
          </div>
          <div class="mt-3 font-mono text-3xl font-bold text-day-100 tabular-nums">
            {formatCount(card.value)}
          </div>
        </div>
      ))
    }
  </section>

  <div class="grid gap-5 lg:grid-cols-3">
    <section class="rounded-xl border border-night-700/50 bg-night-800/30">
      <div class="border-b border-night-700/50 px-4 py-3">
        <h2 class="font-title text-lg font-semibold text-day-100">Top services</h2>
        <p class="text-xs text-day-500">Clickouts in {selectedRange.label.toLowerCase()}</p>
      </div>
      {
        topServices.length === 0 ? (
          <p class="px-4 py-6 text-sm text-day-500">No clickouts in this range.</p>
        ) : (
          <ol class="divide-y divide-night-700/40">
            {topServices.map((row, index) => {
              const service = row.serviceId !== null ? (serviceById.get(row.serviceId) ?? null) : null
              const label = service ? service.name : '(deleted)'
              const href = service ? `/service/${service.slug}` : null
              return (
                <li class="flex items-center justify-between gap-3 px-4 py-2.5 text-sm">
                  <div class="flex min-w-0 items-center gap-3">
                    <span class="w-5 shrink-0 text-right font-mono text-xs text-day-600 tabular-nums">
                      {index + 1}
                    </span>
                    {href ? (
                      <a class="truncate text-day-200 hover:underline" href={href}>
                        {label}
                      </a>
                    ) : (
                      <span class="truncate text-day-500 italic">{label}</span>
                    )}
                  </div>
                  <span class="font-mono text-day-300 tabular-nums">{formatCount(row._sum.count ?? 0)}</span>
                </li>
              )
            })}
          </ol>
        )
      }
    </section>

    <section class="rounded-xl border border-night-700/50 bg-night-800/30">
      <div class="border-b border-night-700/50 px-4 py-3">
        <h2 class="font-title text-lg font-semibold text-day-100">Top pairs</h2>
        <p class="text-xs text-day-500">Quote fetches in {selectedRange.label.toLowerCase()}</p>
      </div>
      {
        topPairs.length === 0 ? (
          <p class="px-4 py-6 text-sm text-day-500">No quote fetches in this range.</p>
        ) : (
          <ol class="divide-y divide-night-700/40">
            {topPairs.map((row, index) => (
              <li class="flex items-center justify-between gap-3 px-4 py-2.5 text-sm">
                <div class="flex min-w-0 items-center gap-3">
                  <span class="w-5 shrink-0 text-right font-mono text-xs text-day-600 tabular-nums">
                    {index + 1}
                  </span>
                  <span class="truncate font-mono text-day-200">
                    {formatPair(row.fromCurrency, row.toCurrency)}
                  </span>
                </div>
                <span class="font-mono text-day-300 tabular-nums">{formatCount(row._sum.count ?? 0)}</span>
              </li>
            ))}
          </ol>
        )
      }
    </section>

    <section class="rounded-xl border border-night-700/50 bg-night-800/30">
      <div class="border-b border-night-700/50 px-4 py-3">
        <h2 class="font-title text-lg font-semibold text-day-100">Top referrals</h2>
        <p class="text-xs text-day-500">Referral clickouts and share of that service's clickouts</p>
      </div>
      {
        topRefs.length === 0 ? (
          <p class="px-4 py-6 text-sm text-day-500">No referrals tracked in this range.</p>
        ) : (
          <ol class="divide-y divide-night-700/40">
            {topRefs.map((row, index) => {
              const service = row.serviceId !== null ? (serviceById.get(row.serviceId) ?? null) : null
              const label = service?.name ?? 'Unknown service'
              const code = row.refCode ?? '(none)'
              const referralCount = row._sum.count ?? 0
              const serviceClickouts =
                row.serviceId !== null ? (clickoutsByReferralServiceId.get(row.serviceId) ?? 0) : 0
              const referralPercent = serviceClickouts > 0 ? (referralCount / serviceClickouts) * 100 : null
              return (
                <li class="flex items-center justify-between gap-3 px-4 py-2.5 text-sm">
                  <div class="flex min-w-0 items-center gap-3">
                    <span class="w-5 shrink-0 text-right font-mono text-xs text-day-600 tabular-nums">
                      {index + 1}
                    </span>
                    <div class="min-w-0">
                      {service ? (
                        <a
                          class="block truncate text-day-200 hover:underline"
                          href={`/service/${service.slug}`}
                        >
                          {label}
                        </a>
                      ) : (
                        <span class="block truncate text-day-500 italic">{label}</span>
                      )}
                      <span class="block truncate font-mono text-xs text-day-600">{code}</span>
                    </div>
                  </div>
                  <div class="shrink-0 text-right">
                    <div class="font-mono text-day-300 tabular-nums">{formatCount(referralCount)}</div>
                    <div class="font-mono text-xs text-day-600 tabular-nums">
                      {referralPercent === null ? '-' : formatPercent(referralPercent)}
                    </div>
                  </div>
                </li>
              )
            })}
          </ol>
        )
      }
    </section>
  </div>
</BaseLayout>
