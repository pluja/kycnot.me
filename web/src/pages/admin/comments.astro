---
import { z } from 'astro/zod'
import { Icon } from 'astro-icon/components'

import AdminCommentContext from '../../components/admin/comments/AdminCommentContext.astro'
import BadgeSmall from '../../components/BadgeSmall.astro'
import CommentModeration from '../../components/CommentModeration.astro'
import MyPicture from '../../components/MyPicture.astro'
import Pagination from '../../components/Pagination.astro'
import SortArrowIcon from '../../components/SortArrowIcon.astro'
import TimeFormatted from '../../components/TimeFormatted.astro'
import Tooltip from '../../components/Tooltip.astro'
import UserBadge from '../../components/UserBadge.astro'
import {
  adminCommentSortOptions,
  adminCommentSortOptionsZodEnum,
  getAdminCommentSortOptionInfo,
} from '../../constants/adminCommentSortOptions'
import {
  commentStatusFilters,
  commentStatusFiltersZodEnum,
  getCommentStatusFilterInfo,
  getCommentStatusFilterValue,
} from '../../constants/commentStatusFilters'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { cn } from '../../lib/cn'
import { zodParseQueryParamsStoringErrors } from '../../lib/parseUrlFilters'
import { prisma } from '../../lib/prisma'
import { urlWithParams } from '../../lib/urls'

import type { CommentStatus, VerificationStatus } from '@prisma/client'

const user = Astro.locals.user
if (!user || (!user.admin && !user.moderator)) {
  return Astro.rewrite('/404')
}

const DEFAULT_SORT_ORDER = 'desc'

const { data: params } = zodParseQueryParamsStoringErrors(
  {
    status: commentStatusFiltersZodEnum.default('all'),
    page: z.coerce.number().int().positive().default(1),
    'priority-page': z.coerce.number().int().positive().default(1),
    'sort-by': adminCommentSortOptionsZodEnum.default('createdAt'),
    'sort-order': z.enum(['asc', 'desc']).default(DEFAULT_SORT_ORDER),
  },
  Astro
)
const PAGE_SIZE = 20
const PRIORITY_PAGE_SIZE = 20

const statusFilter = getCommentStatusFilterInfo(params.status)
const sortBy = getAdminCommentSortOptionInfo(params['sort-by'])

const listedServiceStatuses = ['APPROVED', 'VERIFICATION_SUCCESS'] satisfies VerificationStatus[]
const pendingCommentStatuses = ['PENDING'] satisfies CommentStatus[]

const priorityWhere = {
  ...statusFilter.whereClause,
  status: { in: pendingCommentStatuses },
  service: { verificationStatus: { in: [...listedServiceStatuses] } },
}

const regularWhere = {
  ...statusFilter.whereClause,
  NOT: {
    AND: [
      { status: { in: pendingCommentStatuses } },
      { service: { verificationStatus: { in: [...listedServiceStatuses] } } },
    ],
  },
}

const commentInclude = {
  author: {
    select: {
      name: true,
      displayName: true,
      picture: true,
      createdAt: true,
      lastLoginAt: true,
      totalKarma: true,
      verified: true,
      spammer: true,
      _count: {
        select: {
          comments: true,
        },
      },
    },
  },
  service: {
    select: {
      name: true,
      slug: true,
      imageUrl: true,
      verificationStatus: true,
    },
  },
  humanDecidedBy: {
    select: {
      name: true,
      displayName: true,
      picture: true,
    },
  },
  parent: {
    include: {
      author: true,
    },
  },
  votes: true,
} as const

const commentOrderBy = [
  {
    [sortBy.value]: sortBy.hasNulls ? { sort: params['sort-order'], nulls: 'last' } : params['sort-order'],
  },
  { id: 'asc' as const },
]

const [priorityComments = [], totalPriorityComments = 0] = await Astro.locals.banners.try(
  'Error fetching priority comments',
  async () =>
    prisma.comment.findManyAndCount({
      where: priorityWhere,
      include: commentInclude,
      orderBy: commentOrderBy,
      skip: (params['priority-page'] - 1) * PRIORITY_PAGE_SIZE,
      take: PRIORITY_PAGE_SIZE,
    }),
  []
)

const [comments = [], totalComments = 0] = await Astro.locals.banners.try(
  'Error fetching comments',
  async () =>
    prisma.comment.findManyAndCount({
      where: regularWhere,
      include: commentInclude,
      orderBy: commentOrderBy,
      skip: (params.page - 1) * PAGE_SIZE,
      take: PAGE_SIZE,
    }),
  []
)

const totalPages = Math.ceil(totalComments / PAGE_SIZE)
const priorityTotalPages = Math.ceil(totalPriorityComments / PRIORITY_PAGE_SIZE)
const priorityCurrentPage = Math.min(Math.max(1, params['priority-page']), priorityTotalPages || 1)

const makePriorityPageUrl = (page: number) => {
  const searchParams = new URLSearchParams(Astro.url.search)
  searchParams.set('priority-page', page.toString())
  return `${Astro.url.pathname}?${searchParams.toString()}`
}
---

<BaseLayout pageTitle="Comment Moderation" widthClassName="max-w-7xl">
  <div class="mb-8">
    <div class="mb-4 flex items-center gap-4">
      <h1 class="font-title text-2xl text-green-500">&gt; comments.moderate</h1>
      {
        totalPriorityComments > 0 && (
          <span class="text-sm text-amber-400">({totalPriorityComments} priority)</span>
        )
      }
    </div>

    <!-- Status Filters -->
    <div class="flex flex-wrap gap-2">
      {
        commentStatusFilters.map((filter) => (
          <a
            href={urlWithParams(Astro.url, { status: filter.value })}
            class={cn([
              'flex items-center gap-2 rounded-md border px-3 py-1 font-title text-sm',
              params.status === filter.value
                ? filter.classNames.filter
                : 'border-zinc-700 transition-colors hover:border-green-500/50',
            ])}
          >
            <Icon name={filter.icon} class="size-4 shrink-0" />
            {filter.label}
          </a>
        ))
      }
    </div>

    <!-- Sorting Options -->
    <div class="mt-4 flex flex-col gap-2">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-sm text-zinc-400">Sort by:</span>
        {
          adminCommentSortOptions.map((o) => (
            <a
              href={urlWithParams(Astro.url, {
                'sort-by': o.value,
                'sort-order':
                  sortBy.value === o.value
                    ? params['sort-order'] === 'asc'
                      ? 'desc'
                      : 'asc'
                    : DEFAULT_SORT_ORDER,
              })}
              class={cn([
                'flex items-center gap-1 rounded-md border px-3 py-1 font-title text-sm transition-colors',
                sortBy.value === o.value
                  ? 'border-blue-500 bg-blue-500/10 text-blue-400'
                  : 'border-zinc-700 hover:border-blue-500/50',
              ])}
            >
              {o.label}
              <SortArrowIcon active={sortBy.value === o.value} sortOrder={params['sort-order']} />
            </a>
          ))
        }
        <span class="text-xs text-zinc-500">
          {params['sort-order'] === 'desc' ? 'Newest' : 'Oldest'} first
        </span>
      </div>
    </div>
  </div>

  {/* Priority: pending comments from listed services */}
  {
    totalPriorityComments > 0 && (
      <div class="mb-6 rounded-lg border border-amber-600/50 bg-linear-to-br from-amber-900/20 to-orange-900/20 shadow-xl">
        <div class="sticky top-0 z-10 border-b border-amber-700/50 bg-linear-to-r from-amber-800/90 to-orange-800/90 px-4 py-3 backdrop-blur-sm">
          <div class="flex items-center gap-2">
            <Icon name="ri:star-fill" class="size-5 text-amber-400" />
            <h2 class="font-title font-semibold text-amber-300">
              Priority: Pending Comments on Listed Services
            </h2>
            <span class="rounded-full bg-amber-500 px-2 py-0.5 text-xs font-bold text-amber-950">
              {totalPriorityComments}
            </span>
          </div>
          <div class="mt-1 text-xs text-amber-200/80">
            Comments awaiting review on APPROVED or VERIFIED services — Review these first!
          </div>
        </div>
        <div class="space-y-6 p-4">
          {priorityComments
            .map((comment) => ({
              ...comment,
              statusFilterInfo: getCommentStatusFilterInfo(getCommentStatusFilterValue(comment)),
            }))
            .map((comment) => (
              <div
                id={`priority-comment-${comment.id.toString()}`}
                class="rounded-lg border border-amber-700/30 bg-amber-950/10 p-6"
              >
                <div class="mb-4 flex flex-wrap items-center gap-2">
                  <UserBadge user={comment.author} size="md" />

                  <span class="text-xs text-zinc-500">•</span>
                  <a
                    href={`/service/${comment.service.slug}#comment-${comment.id.toString()}`}
                    class="text-sm text-amber-400 transition-colors hover:text-amber-300"
                  >
                    {!!comment.service.imageUrl && (
                      <MyPicture
                        src={comment.service.imageUrl}
                        height={16}
                        width={16}
                        class="inline-block size-4 rounded-full object-contain align-[-0.2em]"
                        alt=""
                      />
                    )}
                    {comment.service.name}
                  </a>

                  <span class="text-xs text-zinc-500">•</span>
                  <TimeFormatted
                    date={comment.createdAt}
                    hourPrecision
                    caseType="sentence"
                    class="text-sm text-zinc-400"
                  />

                  {comment.approvedAt && (
                    <>
                      <span class="text-xs text-zinc-500">•</span>
                      <Tooltip
                        as="span"
                        class="inline-flex items-center gap-1 text-zinc-500"
                        text="Approved at"
                      >
                        <Icon name="ri:check-line" class="size-4" />
                        <TimeFormatted
                          date={comment.approvedAt}
                          hourPrecision
                          caseType="sentence"
                          class="text-sm"
                        />
                      </Tooltip>
                    </>
                  )}

                  <span class="text-xs text-zinc-500">•</span>

                  <BadgeSmall
                    color={comment.statusFilterInfo.color}
                    text={comment.statusFilterInfo.label}
                    icon={comment.statusFilterInfo.icon}
                    inlineIcon
                  />

                  <span class="text-xs text-zinc-500">•</span>

                  <a
                    href={`/service/${comment.service.slug}?showPending=true#comment-${comment.id.toString()}`}
                    class="flex items-center gap-1 text-sm text-white/50 transition-colors hover:underline"
                  >
                    <Icon name="ri:link" class="size-4" />
                    Open
                  </a>
                </div>

                <AdminCommentContext comment={comment} class="mb-4" />

                {comment.parent && (
                  <div class="mb-4 border-l-2 border-zinc-700 pl-4">
                    <div class="mb-1 text-sm opacity-50">
                      Replying to <UserBadge user={comment.parent.author} size="md" />
                    </div>
                    <div class="text-sm text-zinc-400">{comment.parent.content}</div>
                  </div>
                )}

                <div class="mb-4 text-sm">{comment.content}</div>

                {comment.publicNote && (
                  <div class="mt-2">
                    <div class="text-sm font-medium text-green-500">Public Note</div>
                    <p class="text-sm text-gray-300">{comment.publicNote}</p>
                  </div>
                )}
                {comment.adminNote && (
                  <div class="mt-2">
                    <div class="text-sm font-medium text-yellow-500">Admin Note</div>
                    <p class="text-sm text-gray-300">{comment.adminNote}</p>
                  </div>
                )}
                {comment.authorNote && (
                  <div class="mt-2">
                    <div class="text-sm font-medium text-blue-500">Author Note</div>
                    <p class="text-sm text-gray-300">{comment.authorNote}</p>
                  </div>
                )}

                {comment.privateProof && (
                  <div class="mt-2">
                    <div class="text-sm font-medium text-purple-500">Private proof</div>
                    <div class="flex items-center gap-2">
                      <p class="text-sm text-gray-300">{comment.privateProof}</p>
                      {comment.privateProofStatus && (
                        <span
                          class={cn(
                            'rounded-sm px-1.5 py-0.5 text-xs',
                            comment.privateProofStatus === 'APPROVED' && 'bg-green-500/20 text-green-400',
                            comment.privateProofStatus === 'REJECTED' && 'bg-red-500/20 text-red-400',
                            comment.privateProofStatus === 'PENDING' && 'bg-blue-500/20 text-blue-400',
                            comment.privateProofStatus === 'WITHDRAWN' && 'bg-zinc-500/20 text-zinc-400'
                          )}
                        >
                          {comment.privateProofStatus}
                        </span>
                      )}
                    </div>
                  </div>
                )}

                {comment.issues.length > 0 && (
                  <div class="mt-2">
                    <div class="text-sm font-medium text-red-500">Issue Flags</div>
                    <div class="flex flex-wrap gap-2">
                      {comment.issues.map((issue) => (
                        <span class="rounded-sm bg-red-500/20 px-1.5 py-0.5 text-xs text-red-400">
                          {issue.replace('_', ' ')}
                        </span>
                      ))}
                    </div>
                  </div>
                )}

                <CommentModeration class="mt-2" comment={comment} />
              </div>
            ))}
        </div>
        {priorityTotalPages > 1 && (
          <div class="border-t border-amber-700/50 bg-amber-950/20 px-4 py-3">
            <div class="flex items-center justify-between">
              <div class="text-xs text-amber-200/80">
                Showing {(priorityCurrentPage - 1) * PRIORITY_PAGE_SIZE + 1} to{' '}
                {Math.min(priorityCurrentPage * PRIORITY_PAGE_SIZE, totalPriorityComments)} of{' '}
                {totalPriorityComments} priority comments
              </div>
              <div class="flex gap-1">
                {priorityCurrentPage > 1 && (
                  <a
                    href={makePriorityPageUrl(priorityCurrentPage - 1)}
                    class="rounded-md bg-amber-800 px-3 py-1.5 text-sm font-medium text-amber-200 transition-colors hover:bg-amber-700"
                  >
                    <Icon name="ri:arrow-left-s-line" class="inline-block size-4 align-[-0.125em]" />
                    Previous
                  </a>
                )}
                <div class="flex gap-1">
                  {Array.from({ length: priorityTotalPages }, (_, i) => i + 1)
                    .filter(
                      (page) =>
                        page === 1 ||
                        page === priorityTotalPages ||
                        (page >= priorityCurrentPage - 1 && page <= priorityCurrentPage + 1)
                    )
                    .map((page, index, array) => (
                      <>
                        {index > 0 && array[index - 1] !== page - 1 && (
                          <span class="flex items-center px-2 text-amber-400">...</span>
                        )}
                        <a
                          href={makePriorityPageUrl(page)}
                          class={`rounded-md px-3 py-1.5 text-sm font-medium transition-colors ${
                            page === priorityCurrentPage
                              ? 'bg-amber-500 text-amber-950'
                              : 'bg-amber-800 text-amber-200 hover:bg-amber-700'
                          }`}
                        >
                          {page}
                        </a>
                      </>
                    ))}
                </div>
                {priorityCurrentPage < priorityTotalPages && (
                  <a
                    href={makePriorityPageUrl(priorityCurrentPage + 1)}
                    class="rounded-md bg-amber-800 px-3 py-1.5 text-sm font-medium text-amber-200 transition-colors hover:bg-amber-700"
                  >
                    Next
                    <Icon name="ri:arrow-right-s-line" class="inline-block size-4 align-[-0.125em]" />
                  </a>
                )}
              </div>
            </div>
          </div>
        )}
      </div>
    )
  }

  {
    totalPriorityComments === 0 && (
      <div class="mb-4 rounded-md border border-zinc-700/60 bg-zinc-900/40 px-4 py-2 text-xs text-zinc-400">
        No pending comments on listed services
      </div>
    )
  }

  <div class="space-y-6">
    {
      comments
        .map((comment) => ({
          ...comment,
          statusFilterInfo: getCommentStatusFilterInfo(getCommentStatusFilterValue(comment)),
        }))
        .map((comment) => (
          <div
            id={`comment-${comment.id.toString()}`}
            class="rounded-lg border border-zinc-800 bg-black/40 p-6 backdrop-blur-xs"
          >
            <div class="mb-4 flex flex-wrap items-center gap-2">
              {/* Author Info */}
              <UserBadge user={comment.author} size="md" />

              {/* Service Link */}
              <span class="text-xs text-zinc-500">•</span>
              <a
                href={`/service/${comment.service.slug}#comment-${comment.id.toString()}`}
                class="text-sm text-blue-400 transition-colors hover:text-blue-300"
              >
                {!!comment.service.imageUrl && (
                  <MyPicture
                    src={comment.service.imageUrl}
                    height={16}
                    width={16}
                    class="inline-block size-4 rounded-full object-contain align-[-0.2em]"
                    alt=""
                  />
                )}
                {comment.service.name}
              </a>

              {/* Date */}
              <span class="text-xs text-zinc-500">•</span>
              <TimeFormatted
                date={comment.createdAt}
                hourPrecision
                caseType="sentence"
                class="text-sm text-zinc-400"
              />

              {/* Approved Date */}
              {comment.approvedAt && (
                <>
                  <span class="text-xs text-zinc-500">•</span>
                  <Tooltip as="span" class="inline-flex items-center gap-1 text-zinc-500" text="Approved at">
                    <Icon name="ri:check-line" class="size-4" />
                    <TimeFormatted
                      date={comment.approvedAt}
                      hourPrecision
                      caseType="sentence"
                      class="text-sm"
                    />
                  </Tooltip>
                </>
              )}

              <span class="text-xs text-zinc-500">•</span>

              {/* Status Badges */}
              <BadgeSmall
                color={comment.statusFilterInfo.color}
                text={comment.statusFilterInfo.label}
                icon={comment.statusFilterInfo.icon}
                inlineIcon
              />

              <span class="text-xs text-zinc-500">•</span>

              {/* Link to Comment */}
              <a
                href={`/service/${comment.service.slug}?showPending=true#comment-${comment.id.toString()}`}
                class="flex items-center gap-1 text-sm text-white/50 transition-colors hover:underline"
              >
                <Icon name="ri:link" class="size-4" />
                Open
              </a>
            </div>

            <AdminCommentContext comment={comment} class="mb-4" />

            {/* Parent Comment Context */}
            {comment.parent && (
              <div class="mb-4 border-l-2 border-zinc-700 pl-4">
                <div class="mb-1 text-sm opacity-50">
                  Replying to <UserBadge user={comment.parent.author} size="md" />
                </div>
                <div class="text-sm text-zinc-400">{comment.parent.content}</div>
              </div>
            )}

            {/* Comment Content */}
            <div class="mb-4 text-sm">{comment.content}</div>

            {/* Notes */}
            {comment.publicNote && (
              <div class="mt-2">
                <div class="text-sm font-medium text-green-500">Public Note</div>
                <p class="text-sm text-gray-300">{comment.publicNote}</p>
              </div>
            )}
            {comment.adminNote && (
              <div class="mt-2">
                <div class="text-sm font-medium text-yellow-500">Admin Note</div>
                <p class="text-sm text-gray-300">{comment.adminNote}</p>
              </div>
            )}
            {comment.authorNote && (
              <div class="mt-2">
                <div class="text-sm font-medium text-blue-500">Author Note</div>
                <p class="text-sm text-gray-300">{comment.authorNote}</p>
              </div>
            )}

            {comment.privateProof && (
              <div class="mt-2">
                <div class="text-sm font-medium text-purple-500">Private proof</div>
                <div class="flex items-center gap-2">
                  <p class="text-sm text-gray-300">{comment.privateProof}</p>
                  {comment.privateProofStatus && (
                    <span
                      class={cn(
                        'rounded-sm px-1.5 py-0.5 text-xs',
                        comment.privateProofStatus === 'APPROVED' && 'bg-green-500/20 text-green-400',
                        comment.privateProofStatus === 'REJECTED' && 'bg-red-500/20 text-red-400',
                        comment.privateProofStatus === 'PENDING' && 'bg-blue-500/20 text-blue-400',
                        comment.privateProofStatus === 'WITHDRAWN' && 'bg-zinc-500/20 text-zinc-400'
                      )}
                    >
                      {comment.privateProofStatus}
                    </span>
                  )}
                </div>
              </div>
            )}

            {comment.issues.length > 0 && (
              <div class="mt-2">
                <div class="text-sm font-medium text-red-500">Issue Flags</div>
                <div class="flex flex-wrap gap-2">
                  {comment.issues.map((issue) => (
                    <span class="rounded-sm bg-red-500/20 px-1.5 py-0.5 text-xs text-red-400">
                      {issue.replace('_', ' ')}
                    </span>
                  ))}
                </div>
              </div>
            )}

            <CommentModeration class="mt-2" comment={comment} />
          </div>
        ))
    }
  </div>

  <!-- Pagination -->
  {totalPages > 1 && <Pagination currentPage={params.page} totalPages={totalPages} class="mt-8" />}
</BaseLayout>
