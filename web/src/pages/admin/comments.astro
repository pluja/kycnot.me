---
import { CommentStatus, type Prisma } from '@prisma/client'
import { z } from 'astro/zod'
import { Icon } from 'astro-icon/components'
import { mapValues } from 'lodash-es'

import ModerationQueueItem from '../../components/admin/comments/ModerationQueueItem.astro'
import Lightbox from '../../components/Lightbox.astro'
import Pagination from '../../components/Pagination.astro'
import { commentStatus } from '../../constants/commentStatus'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  adminCommentReviewSelect,
  aiGraceHours,
  compareTodo,
  moderatorTodoReasons,
  oldProofWhere,
  proofsToCheck,
  todoRank,
  todoRankSelect,
} from '../../lib/adminCommentReview'
import { cn } from '../../lib/cn'
import { conflictedCommentWhere } from '../../lib/experiences'
import { authorHistory } from '../../lib/moderationSignals'
import { zodParseQueryParamsStoringErrors } from '../../lib/parseUrlFilters'
import { prisma } from '../../lib/prisma'

import type { AdminCommentReview, TodoReason } from '../../lib/adminCommentReview'

if (!Astro.locals.userCan('comments:moderate')) return Astro.rewrite('/404')
Astro.response.headers.set('Cache-Control', 'private, no-store')

const todoReasons = moderatorTodoReasons()
const notWithdrawn = { status: { not: CommentStatus.WITHDRAWN } }
const queueWheres = {
  todo: { ...notWithdrawn, OR: Object.values(todoReasons) },
  ...mapValues(todoReasons, (reason) => ({ ...notWithdrawn, ...reason })),
  oldProof: oldProofWhere,
  ai: { moderationState: 'AWAITING_AI' },
  all: {},
} satisfies Record<string, Prisma.CommentWhereInput>
type QueueId = keyof typeof queueWheres

const { data: params } = zodParseQueryParamsStoringErrors(
  {
    queue: z
      .enum(Object.keys(queueWheres) as [QueueId, ...QueueId[]])
      .catch('todo')
      .default('todo'),
    serviceId: z.coerce.number().int().positive().optional(),
    status: z.nativeEnum(CommentStatus).optional().catch(undefined),
    search: z.string().trim().max(200).optional().catch(undefined),
    page: z.coerce.number().int().positive().default(1),
  },
  Astro
)
const pageSize = 25
const userId = Astro.locals.user?.id ?? -1
const serviceWhere: Prisma.CommentWhereInput = {
  ...(params.serviceId ? { serviceId: params.serviceId } : {}),
  NOT: conflictedCommentWhere({ id: userId, admin: !!Astro.locals.user?.admin }),
}
const allFilters: Prisma.CommentWhereInput[] =
  params.queue === 'all'
    ? [
        ...(params.status ? [{ status: params.status }] : []),
        ...(params.search
          ? [
              {
                OR: [
                  { content: { contains: params.search, mode: 'insensitive' as const } },
                  { author: { name: { equals: params.search } } },
                ],
              },
            ]
          : []),
      ]
    : []
const where: Prisma.CommentWhereInput = { AND: [serviceWhere, queueWheres[params.queue], ...allFilters] }
// rankedReasons are the reasons that order a queue; the AI queue and All keep a plain date order.
const rankedReasons: Partial<Record<QueueId, TodoReason[]>> = {
  todo: ['reports', 'posts', 'edits', 'proof'],
  reports: ['reports'],
  posts: ['posts'],
  edits: ['edits'],
  proof: ['proof'],
  oldProof: ['oldProof'],
}
const reasonWheres: Record<TodoReason, Prisma.CommentWhereInput> = { ...todoReasons, oldProof: oldProofWhere }

const [result, counts, service] = await Astro.locals.banners.tryMany([
  [
    'Failed to load the moderation queue',
    async () => {
      const offset = (params.page - 1) * pageSize
      const reasons = rankedReasons[params.queue]
      if (!reasons) {
        const [total, posts] = await Promise.all([
          prisma.comment.count({ where }),
          prisma.comment.findMany({
            where,
            select: adminCommentReviewSelect,
            orderBy:
              params.queue === 'all'
                ? [{ createdAt: 'desc' }, { id: 'desc' }]
                : [{ createdAt: 'asc' }, { id: 'asc' }],
            skip: offset,
            take: pageSize,
          }),
        ])
        return { posts, total, waitingSince: new Map<number, Date>() }
      }
      const candidates = await prisma.comment.findMany({ where, select: todoRankSelect })
      const candidateIds = candidates.map((post) => post.id)
      // A post can wait for several reasons; the most urgent one places it.
      const reasonsByPost = new Map<number, Set<TodoReason>>()
      for (const reason of reasons) {
        const matching =
          reasons.length === 1
            ? candidateIds
            : (
                await prisma.comment.findMany({
                  where: { AND: [{ id: { in: candidateIds } }, reasonWheres[reason]] },
                  select: { id: true },
                })
              ).map((post) => post.id)
        for (const id of matching) reasonsByPost.set(id, (reasonsByPost.get(id) ?? new Set()).add(reason))
      }
      const ranked = candidates
        .map((post) => ({ id: post.id, ...todoRank(post, reasonsByPost.get(post.id) ?? new Set()) }))
        .sort(compareTodo)
      const pageIds = ranked.slice(offset, offset + pageSize).map((post) => post.id)
      const pagePosts = await prisma.comment.findMany({
        where: { id: { in: pageIds } },
        select: adminCommentReviewSelect,
      })
      return {
        posts: pageIds.flatMap((id) => pagePosts.filter((post) => post.id === id)),
        total: ranked.length,
        waitingSince: new Map(ranked.map((post) => [post.id, post.since])),
      }
    },
    { posts: [] as AdminCommentReview[], total: 0, waitingSince: new Map<number, Date>() },
  ],
  [
    'Failed to count the queues',
    async () => {
      const ids = Object.keys(queueWheres) as QueueId[]
      const totals = await Promise.all(
        ids.map((id) =>
          id === 'all'
            ? Promise.resolve(null)
            : prisma.comment.count({ where: { AND: [serviceWhere, queueWheres[id]] } })
        )
      )
      return Object.fromEntries(ids.map((id, index) => [id, totals[index]])) as Record<QueueId, number | null>
    },
    null,
  ],
  [
    'Failed to load the service',
    () =>
      params.serviceId
        ? prisma.service.findUnique({ where: { id: params.serviceId }, select: { name: true } })
        : Promise.resolve(null),
    null,
  ],
])
const posts = result.posts
const historyFor = await Astro.locals.banners.try(
  'Failed to load author history',
  () => authorHistory(posts),
  () => ({ rejectedPosts: 0, postsOnService: 0 })
)
const queues = [
  {
    id: 'todo',
    label: 'To do',
    icon: 'ri:inbox-line',
    description:
      'Everything that needs a moderator, each comment once. Most urgent first: serious reports, other reports, held comments, held edits, then proof.',
  },
  {
    id: 'posts',
    label: 'Held',
    icon: 'ri:pause-circle-line',
    description: `New comments waiting for you to publish or reject them: the AI held them, or did not check them within ${String(aiGraceHours)} hours.`,
  },
  {
    id: 'proof',
    label: 'Proof',
    icon: 'ri:file-search-line',
    description: 'Proof authors attached, such as order IDs and screenshots, waiting for a check.',
  },
  {
    id: 'reports',
    label: 'Reports',
    icon: 'ri:flag-line',
    description: 'Comments readers reported. Serious reports first.',
  },
  {
    id: 'edits',
    label: 'Edits',
    icon: 'ri:git-pull-request-line',
    description: `Changes to published comments that the AI held, or did not check within ${String(aiGraceHours)} hours.`,
  },
  {
    id: 'oldProof',
    label: 'Old proof',
    icon: 'ri:archive-line',
    description:
      'Proof the old system never reviewed, on published comments. Nothing waits on it; work through it as time allows.',
  },
  {
    id: 'ai',
    label: 'Waiting for AI',
    icon: 'ri:robot-2-line',
    description: `New comments the AI has not checked yet. After ${String(aiGraceHours)} hours they also show in Held.`,
  },
  {
    id: 'all',
    label: 'All',
    icon: 'ri:search-line',
    description: 'Every comment, newest first.',
  },
] as const satisfies { id: QueueId; label: string; icon: string; description: string }[]
const activeQueue = queues.find((queue) => queue.id === params.queue)
const queueUrl = (queue: QueueId, serviceId = params.serviceId) => {
  const search = new URLSearchParams({ queue })
  if (serviceId) search.set('serviceId', serviceId.toString())
  return `/admin/comments?${search.toString()}`
}
// panelTabFor opens the tab a row most likely needs; a decision or a report needs no particular tab.
const panelTabFor = (comment: AdminCommentReview) =>
  params.queue === 'proof' || params.queue === 'oldProof'
    ? 'evidence'
    : params.queue === 'edits'
      ? 'edits'
      : comment.moderationState === 'AWAITING_HUMAN' || comment.contactThreads.length > 0
        ? undefined
        : proofsToCheck(comment) > 0
          ? 'evidence'
          : comment.revisions.length > 0
            ? 'edits'
            : undefined
const emptyMessages: Record<QueueId, string> = {
  todo: 'Nothing to do.',
  posts: 'No comments waiting for a decision.',
  proof: 'No proof to check.',
  reports: 'No open reports.',
  edits: 'No edits to review.',
  oldProof: 'The old proof backlog is done.',
  ai: 'Nothing is waiting for the AI.',
  all: 'No comments match.',
}
---

<BaseLayout
  pageTitle="Comment moderation"
  description="Decide on comments, check proof, and handle reports and edits."
  noindex
  widthClassName="max-w-5xl"
  htmx
>
  <header class="mt-8 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="font-title text-2xl font-bold">Comment moderation</h1>
      <p class="mt-1 text-sm text-day-400">
        {activeQueue?.description}
      </p>
    </div>
    {
      service && (
        <a
          href={queueUrl(params.queue, undefined)}
          class="inline-flex items-center gap-1.5 rounded-md border border-night-500 px-2.5 py-1 text-sm text-day-200 hover:border-night-400"
          aria-label={`Remove the filter for ${service.name}`}
        >
          {service.name}
          <Icon name="ri:close-line" class="size-4 text-day-400" />
        </a>
      )
    }
  </header>

  <nav class="mt-5 flex flex-wrap gap-1" aria-label="Moderation queues">
    {
      queues.map((queue) => {
        const count = counts?.[queue.id] ?? null
        const active = params.queue === queue.id
        if (queue.id === 'oldProof' && count === 0 && !active) return null
        return (
          <a
            href={queueUrl(queue.id)}
            title={queue.description}
            aria-current={active ? 'page' : undefined}
            class={cn(
              'inline-flex shrink-0 items-center gap-1.5 rounded-md border px-2.5 py-1.5 text-sm',
              active
                ? 'border-teal-500/60 bg-teal-500/10 text-day-100'
                : 'border-night-600 text-day-400 hover:border-night-500 hover:text-day-200'
            )}
          >
            <Icon name={queue.icon} class="size-4" />
            {queue.label}
            {count !== null && (
              <span
                class={cn(
                  'rounded-sm px-1 text-xs tabular-nums',
                  count > 0 ? 'bg-night-600 text-day-100' : 'text-day-600'
                )}
              >
                {count.toLocaleString()}
              </span>
            )}
          </a>
        )
      })
    }
  </nav>

  {
    params.queue === 'all' && (
      <form method="GET" action="/admin/comments" class="mt-3 flex flex-wrap items-center gap-2">
        <input type="hidden" name="queue" value="all" />
        {params.serviceId && <input type="hidden" name="serviceId" value={params.serviceId} />}
        <input
          type="search"
          name="search"
          value={params.search ?? ''}
          placeholder="Search text or exact username"
          class="min-w-0 flex-1 rounded-md border border-night-500 bg-night-800 px-2.5 py-1.5 text-sm text-day-100"
        />
        <select
          name="status"
          class="rounded-md border border-night-500 bg-night-800 px-2 py-1.5 text-sm text-day-100"
        >
          <option value="">Any status</option>
          {commentStatus.map((status) => (
            <option value={status.id} selected={params.status === status.id}>
              {status.label}
            </option>
          ))}
        </select>
        <button
          type="submit"
          class="rounded-md border border-night-500 px-3 py-1.5 text-sm text-day-200 hover:border-night-400"
        >
          Search
        </button>
      </form>
    )
  }

  <section class="mt-4" aria-label="Queue">
    {
      posts.map((comment) => (
        <ModerationQueueItem
          comment={comment}
          history={historyFor(comment)}
          panelTab={panelTabFor(comment)}
          waitingSince={result.waitingSince.get(comment.id)}
        />
      ))
    }
    {
      posts.length === 0 && (
        <p class="flex items-center gap-2 py-10 text-sm text-day-400">
          <Icon name="ri:checkbox-circle-line" class="size-5 text-green-400" />
          {emptyMessages[params.queue]}
        </p>
      )
    }
  </section>
  {
    result.total > pageSize && (
      <Pagination currentPage={params.page} totalPages={Math.ceil(result.total / pageSize)} />
    )
  }
  <Lightbox />
</BaseLayout>
