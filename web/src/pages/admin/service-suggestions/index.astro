---
import { Icon } from 'astro-icon/components'
import { z } from 'astro:content'
import { orderBy, uniq } from 'lodash-es'

import SuggestionsTable from '../../../components/admin/serviceSuggestions/SuggestionsTable.astro'
import Button from '../../../components/Button.astro'
import Pagination from '../../../components/Pagination.astro'
import {
  getServiceSuggestionStatusInfo,
  serviceSuggestionStatuses,
  serviceSuggestionStatusesZodEnumBySlug,
  serviceSuggestionStatusSlugToId,
} from '../../../constants/serviceSuggestionStatus'
import {
  getServiceSuggestionTypeInfo,
  serviceSuggestionTypes,
  serviceSuggestionTypeSlugToId,
  serviceSuggestionTypesZodEnumBySlug,
} from '../../../constants/serviceSuggestionType'
import { getVerificationStatusInfo } from '../../../constants/verificationStatus'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { cn } from '../../../lib/cn'
import { zodParseQueryParamsStoringErrors } from '../../../lib/parseUrlFilters'
import { canReviewSuggestion } from '../../../lib/permissions'
import { prisma } from '../../../lib/prisma'
import { makeLoginUrl } from '../../../lib/redirectUrls'
import { isStaleClaim, openSuggestionStatuses, staffMessageWhere } from '../../../lib/suggestionAssignment'

import type { Prisma } from '@prisma/client'

const user = Astro.locals.user
if (!user || !Astro.locals.userCan('suggestions:manage')) {
  return Astro.redirect(makeLoginUrl(Astro.url, { message: 'Admin access required' }))
}

const sortSlugs = ['service', 'status', 'type', 'user', 'createdAt', 'messageCount'] as const

const { data: filters } = zodParseQueryParamsStoringErrors(
  {
    search: z.string().optional(),
    status: serviceSuggestionStatusesZodEnumBySlug
      .or(z.literal('all'))
      .or(z.literal('pending-review'))
      .default('pending-review'),
    type: serviceSuggestionTypesZodEnumBySlug.or(z.literal('all')).optional(),
    // 'unassigned', 'me', 'assigned', 'all', or '@' and a moderator's username.
    assignee: z.string().max(64).default('unassigned'),
    'sort-by': z.enum(sortSlugs).default('createdAt'),
    'sort-order': z.enum(['asc', 'desc']).default('desc'),
    page: z.coerce.number().int().positive().default(1),
    'page-size': z.enum(['25', '50', '100']).default('25'),
    'priority-page': z.coerce.number().int().positive().default(1),
  },
  Astro
)

const statusFilter: Prisma.ServiceSuggestionWhereInput['status'] =
  filters.status === 'all'
    ? undefined
    : filters.status === 'pending-review'
      ? { in: openSuggestionStatuses }
      : serviceSuggestionStatusSlugToId(filters.status)

const typeFilter =
  !filters.type || filters.type === 'all' ? undefined : serviceSuggestionTypeSlugToId(filters.type)

let prismaOrderBy: Prisma.ServiceSuggestionOrderByWithRelationInput = { createdAt: 'desc' }
if (filters['sort-by'] === 'createdAt') {
  prismaOrderBy = { createdAt: filters['sort-order'] }
}

let suggestions = await prisma.serviceSuggestion.findMany({
  where: {
    ...(filters.search
      ? {
          OR: [
            { service: { name: { contains: filters.search, mode: 'insensitive' } } },
            { user: { name: { contains: filters.search, mode: 'insensitive' } } },
            { notes: { contains: filters.search, mode: 'insensitive' } },
          ],
        }
      : {}),
    status: statusFilter,
    type: typeFilter,
  },
  orderBy: prismaOrderBy,
  select: {
    id: true,
    type: true,
    status: true,
    userId: true,
    createdAt: true,
    assignedAt: true,
    user: {
      select: {
        displayName: true,
        name: true,
        picture: true,
      },
    },
    assignedTo: {
      select: {
        id: true,
        name: true,
        displayName: true,
        picture: true,
      },
    },
    service: {
      select: {
        name: true,
        slug: true,
        description: true,
        verificationStatus: true,
      },
    },
    messages: {
      where: staffMessageWhere,
      select: { createdAt: true },
      orderBy: { createdAt: 'desc' },
      take: 1,
    },
    _count: {
      select: {
        messages: true,
      },
    },
  },
})

const suggestionsWithAssignment = suggestions.map((s) => {
  const isOpen = openSuggestionStatuses.includes(s.status)
  const staleClaim = isStaleClaim({
    status: s.status,
    assignedAt: s.assignedAt,
    lastStaffMessageAt: s.messages[0]?.createdAt ?? null,
  })
  return {
    ...s,
    statusInfo: getServiceSuggestionStatusInfo(s.status),
    typeInfo: getServiceSuggestionTypeInfo(s.type),
    messageCount: s._count.messages,
    isOpen,
    staleClaim,
    canTake:
      isOpen && (!s.assignedTo || staleClaim) && canReviewSuggestion(s, user, { applyingFieldEdits: false }),
  }
})

// Claims only exist on open suggestions, so closed ones pass the Unassigned and Assigned views: filtering by a
// closed status never comes back empty because of the view.
const matchesAssignee = (s: (typeof suggestionsWithAssignment)[number], assignee: string) => {
  switch (assignee) {
    case 'all':
      return true
    case 'unassigned':
      return !s.isOpen || !s.assignedTo || s.staleClaim
    case 'me':
      return s.assignedTo?.id === user.id
    case 'assigned':
      return !s.isOpen || !!s.assignedTo
    default:
      return `@${s.assignedTo?.name ?? ''}` === assignee
  }
}

const moderatorNames = uniq(
  suggestionsWithAssignment.flatMap((s) => (s.assignedTo && s.isOpen ? [s.assignedTo.name] : []))
)
  .filter((name) => name !== user.name)
  .sort()
const assigneeTabs = [
  { value: 'unassigned', label: 'Unassigned', icon: 'ri:inbox-line' },
  { value: 'me', label: 'Mine', icon: 'ri:user-follow-line' },
  { value: 'assigned', label: 'Assigned', icon: 'ri:team-line' },
  { value: 'all', label: 'All', icon: 'ri:list-check' },
  ...moderatorNames.map((name) => ({ value: `@${name}`, label: `@${name}`, icon: 'ri:user-line' })),
].map((tab) => ({
  ...tab,
  count: suggestionsWithAssignment.filter((s) => matchesAssignee(s, tab.value)).length,
}))

const makeAssigneeUrl = (assignee: string) => {
  const searchParams = new URLSearchParams(Astro.url.search)
  searchParams.set('assignee', assignee)
  searchParams.delete('page')
  searchParams.delete('priority-page')
  return `/admin/service-suggestions?${searchParams.toString()}`
}

let suggestionsWithDetails = suggestionsWithAssignment.filter((s) => matchesAssignee(s, filters.assignee))

if (filters['sort-by'] === 'service') {
  suggestionsWithDetails = orderBy(
    suggestionsWithDetails,
    [(s) => s.service.name.toLowerCase()],
    [filters['sort-order']]
  )
} else if (filters['sort-by'] === 'status') {
  suggestionsWithDetails = orderBy(
    suggestionsWithDetails,
    [(s) => s.statusInfo.label],
    [filters['sort-order']]
  )
} else if (filters['sort-by'] === 'type') {
  suggestionsWithDetails = orderBy(suggestionsWithDetails, [(s) => s.typeInfo.label], [filters['sort-order']])
} else if (filters['sort-by'] === 'user') {
  suggestionsWithDetails = orderBy(
    suggestionsWithDetails,
    [(s) => s.user.name.toLowerCase()],
    [filters['sort-order']]
  )
} else if (filters['sort-by'] === 'messageCount') {
  suggestionsWithDetails = orderBy(suggestionsWithDetails, ['messageCount'], [filters['sort-order']])
}

// Edits to listed services that are still open come first.
const isPriority = (s: (typeof suggestionsWithDetails)[number]) =>
  s.typeInfo.slug === 'edit' && getVerificationStatusInfo(s.service.verificationStatus).listed && s.isOpen
const prioritySuggestions = suggestionsWithDetails.filter(isPriority)
const regularSuggestions = suggestionsWithDetails.filter((s) => !isPriority(s))

const suggestionCount = suggestionsWithDetails.length

// Pagination
const pageSize = parseInt(filters['page-size'])
const currentPage = filters.page
const priorityCurrentPage = filters['priority-page']

// Priority suggestions pagination
const priorityTotalPages = Math.ceil(prioritySuggestions.length / pageSize)
const priorityValidPage = Math.min(Math.max(1, priorityCurrentPage), priorityTotalPages || 1)
const priorityStartIndex = (priorityValidPage - 1) * pageSize
const priorityEndIndex = priorityStartIndex + pageSize
const paginatedPrioritySuggestions = prioritySuggestions.slice(priorityStartIndex, priorityEndIndex)

// Regular suggestions pagination
const regularTotalPages = Math.ceil(regularSuggestions.length / pageSize)
const regularValidPage = Math.min(Math.max(1, currentPage), regularTotalPages || 1)
const regularStartIndex = (regularValidPage - 1) * pageSize
const regularEndIndex = regularStartIndex + pageSize
const paginatedRegularSuggestions = regularSuggestions.slice(regularStartIndex, regularEndIndex)

const makeSortUrl = (slug: (typeof sortSlugs)[number]) => {
  const currentSortBy = filters['sort-by']
  const currentSortOrder = filters['sort-order']
  const newSortOrder = currentSortBy === slug && currentSortOrder === 'asc' ? 'desc' : 'asc'
  const searchParams = new URLSearchParams(Astro.url.search)
  searchParams.set('sort-by', slug)
  searchParams.set('sort-order', newSortOrder)
  return `/admin/service-suggestions?${searchParams.toString()}`
}

const sortUrls = Object.fromEntries(sortSlugs.map((slug) => [slug, makeSortUrl(slug)])) as Record<
  (typeof sortSlugs)[number],
  string
>

const makePageSizeUrl = (size: string) => {
  const searchParams = new URLSearchParams(Astro.url.search)
  searchParams.set('page-size', size)
  searchParams.set('page', '1')
  searchParams.set('priority-page', '1')
  return `/admin/service-suggestions?${searchParams.toString()}`
}
---

<BaseLayout pageTitle="Service Suggestions" widthClassName="max-w-7xl">
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <h1 class="font-title text-2xl font-bold text-white">Service Suggestions</h1>
    <div class="mt-2 flex items-center gap-4 sm:mt-0">
      <span class="text-sm text-zinc-400">
        {suggestionCount} suggestions
        {
          prioritySuggestions.length > 0 && (
            <span class="ml-2 text-amber-400">({prioritySuggestions.length} priority)</span>
          )
        }
      </span>
    </div>
  </div>

  <nav class="mb-4 flex flex-wrap gap-1" aria-label="Assigned to">
    {
      assigneeTabs.map((tab) => {
        const active = filters.assignee === tab.value
        return (
          <a
            href={makeAssigneeUrl(tab.value)}
            aria-current={active ? 'page' : undefined}
            class={cn(
              'inline-flex shrink-0 items-center gap-1.5 rounded-md border px-2.5 py-1.5 text-sm',
              active
                ? 'border-blue-500/60 bg-blue-500/10 text-zinc-100'
                : 'border-zinc-700 text-zinc-400 hover:border-zinc-600 hover:text-zinc-200'
            )}
          >
            <Icon name={tab.icon} class="size-4" />
            {tab.label}
            <span
              class={cn(
                'rounded-sm px-1 text-xs tabular-nums',
                tab.count > 0 ? 'bg-zinc-700 text-zinc-100' : 'text-zinc-500'
              )}
            >
              {tab.count.toLocaleString()}
            </span>
          </a>
        )
      })
    }
  </nav>

  <div class="mb-6 rounded-lg border border-zinc-700 bg-zinc-800/50 p-4 shadow-lg">
    <form method="GET" class="grid gap-3 md:grid-cols-2 lg:grid-cols-6" autocomplete="off">
      <div class="lg:col-span-2">
        <label for="search" class="block text-xs font-medium text-zinc-400">Search</label>
        <input
          type="text"
          name="search"
          id="search"
          value={filters.search}
          placeholder="Search by service, user, notes..."
          class="mt-1 w-full rounded-md border border-zinc-700 bg-zinc-900 px-3 py-2 text-sm text-zinc-200 placeholder-zinc-500 focus:border-blue-500 focus:ring-blue-500 focus:outline-hidden"
        />
      </div>
      <div>
        <label for="status-filter" class="block text-xs font-medium text-zinc-400">Status</label>
        <select
          name="status"
          id="status-filter"
          class="mt-1 w-full rounded-md border border-zinc-700 bg-zinc-900 px-3 py-2 text-sm text-zinc-200 focus:border-blue-500 focus:ring-blue-500 focus:outline-hidden"
        >
          <option value="pending-review" selected={filters.status === 'pending-review'}
            >Pending + Review</option
          >
          <option value="all" selected={filters.status === 'all'}>All Statuses</option>
          {
            serviceSuggestionStatuses.map((status) => (
              <option value={status.slug} selected={filters.status === status.slug}>
                {status.label}
              </option>
            ))
          }
        </select>
      </div>
      <div>
        <label for="type-filter" class="block text-xs font-medium text-zinc-400">Type</label>
        <select
          name="type"
          id="type-filter"
          class="mt-1 w-full rounded-md border border-zinc-700 bg-zinc-900 px-3 py-2 text-sm text-zinc-200 focus:border-blue-500 focus:ring-blue-500 focus:outline-hidden"
        >
          <option value="all" selected={!filters.type || filters.type === 'all'}>All Types</option>
          {
            serviceSuggestionTypes.map((type) => (
              <option value={type.slug} selected={filters.type === type.slug}>
                {type.label}
              </option>
            ))
          }
        </select>
      </div>
      <div>
        <label for="assignee-filter" class="block text-xs font-medium text-zinc-400">Assigned to</label>
        <select
          name="assignee"
          id="assignee-filter"
          class="mt-1 w-full rounded-md border border-zinc-700 bg-zinc-900 px-3 py-2 text-sm text-zinc-200 focus:border-blue-500 focus:ring-blue-500 focus:outline-hidden"
        >
          {
            assigneeTabs.map((tab) => (
              <option value={tab.value} selected={filters.assignee === tab.value}>
                {tab.label}
              </option>
            ))
          }
        </select>
      </div>
      <div class="flex items-end">
        <Button
          as="button"
          type="submit"
          color="info"
          variant="solid"
          size="md"
          iconOnly
          icon="ri:search-2-line"
          label="Search"
        />
      </div>
    </form>
    <div class="mt-3 flex items-center justify-between border-t border-zinc-700 pt-3">
      <span class="text-xs font-medium text-zinc-400">Page size:</span>
      <div class="flex gap-1">
        {
          ['25', '50', '100'].map((size) => (
            <a
              href={makePageSizeUrl(size)}
              class={`rounded-md px-3 py-1.5 text-sm font-medium transition-colors ${
                filters['page-size'] === size
                  ? 'bg-blue-600 text-white'
                  : 'bg-zinc-700 text-zinc-300 hover:bg-zinc-600'
              }`}
            >
              {size}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  {
    prioritySuggestions.length > 0 && (
      <div class="mb-6 rounded-lg border border-amber-600/50 bg-linear-to-br from-amber-900/20 to-orange-900/20 shadow-xl">
        <div class="sticky top-0 z-10 border-b border-amber-700/50 bg-linear-to-r from-amber-800/90 to-orange-800/90 px-4 py-3 backdrop-blur-sm">
          <div class="flex items-center gap-2">
            <Icon name="ri:star-fill" class="size-5 text-amber-400" />
            <h2 class="font-title font-semibold text-amber-300">
              Priority: Edit Suggestions for Listed Services
            </h2>
            <span class="rounded-full bg-amber-500 px-2 py-0.5 text-xs font-bold text-amber-950">
              {prioritySuggestions.length}
            </span>
          </div>
          <div class="mt-1 text-xs text-amber-200/80">
            Edit suggestions from APPROVED or VERIFIED services - Review these first!
          </div>
          <div class="mt-1 text-xs text-zinc-400 md:hidden">
            <span>Scroll horizontally to see more →</span>
          </div>
        </div>
        <div class="max-w-full overflow-x-auto">
          <div class="min-w-[900px]">
            <SuggestionsTable
              suggestions={paginatedPrioritySuggestions}
              priority
              sortBy={filters['sort-by']}
              sortOrder={filters['sort-order']}
              sortUrls={sortUrls}
            />
          </div>
        </div>
        {priorityTotalPages > 1 && (
          <div class="border-t border-amber-700/50 bg-amber-950/20 px-4 py-3">
            <div class="flex items-center justify-between">
              <div class="text-xs text-amber-200/80">
                Showing {priorityStartIndex + 1} to {Math.min(priorityEndIndex, prioritySuggestions.length)}{' '}
                of {prioritySuggestions.length} priority suggestions
              </div>
              <Pagination
                currentPage={priorityValidPage}
                totalPages={priorityTotalPages}
                pageParam="priority-page"
              />
            </div>
          </div>
        )}
      </div>
    )
  }

  {
    prioritySuggestions.length === 0 && (
      <div class="mb-4 rounded-md border border-zinc-700/60 bg-zinc-900/40 px-4 py-2 text-xs text-zinc-400">
        No edits for listed services
      </div>
    )
  }

  {
    regularSuggestions.length > 0 && (
      <div class="rounded-lg border border-zinc-700 bg-zinc-800/50 shadow-lg">
        <div class="sticky top-0 z-10 border-b border-zinc-700 bg-zinc-800/90 px-4 py-3 backdrop-blur-sm">
          <h2 class="font-title font-semibold text-blue-400">
            {prioritySuggestions.length > 0 ? 'Other Suggestions' : 'Suggestions List'}
          </h2>
          <div class="mt-1 text-xs text-zinc-400 md:hidden">
            <span>Scroll horizontally to see more →</span>
          </div>
        </div>
        <div class="max-w-full overflow-x-auto">
          <div class="min-w-[900px]">
            <SuggestionsTable
              suggestions={paginatedRegularSuggestions}
              priority={false}
              sortBy={filters['sort-by']}
              sortOrder={filters['sort-order']}
              sortUrls={sortUrls}
            />
          </div>
        </div>
        {regularTotalPages > 1 && (
          <div class="border-t border-zinc-700 bg-zinc-900/30 px-4 py-3">
            <div class="flex items-center justify-between">
              <div class="text-xs text-zinc-400">
                Showing {regularStartIndex + 1} to {Math.min(regularEndIndex, regularSuggestions.length)} of{' '}
                {regularSuggestions.length} suggestions
              </div>
              <Pagination currentPage={regularValidPage} totalPages={regularTotalPages} />
            </div>
          </div>
        )}
      </div>
    )
  }

  {
    suggestionsWithDetails.length === 0 && (
      <div class="rounded-lg border border-zinc-700 bg-zinc-800/50 p-12 text-center shadow-lg">
        <p class="text-zinc-400">No suggestions found matching your filters.</p>
      </div>
    )
  }
</BaseLayout>

<style>
  @keyframes highlight {
    0% {
      background-color: rgba(59, 130, 246, 0.1);
    }
    50% {
      background-color: rgba(59, 130, 246, 0.3);
    }
    100% {
      background-color: transparent;
    }
  }
</style>
