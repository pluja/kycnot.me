---
import { RELEASE_DATE, RELEASE_NUMBER } from 'astro:env/server'

import MiniLayout from '../../layouts/MiniLayout.astro'
import { timeAgo } from '../../lib/timeAgo'

const releaseDate =
  RELEASE_DATE && !isNaN(new Date(RELEASE_DATE).getTime()) ? new Date(RELEASE_DATE) : undefined
---

<MiniLayout
  pageTitle="Releases"
  description="Manage releases"
  layoutHeader={{
    icon: 'ri:rocket-2-line',
    title: 'Releases',
    subtitle: 'Current release',
  }}
>
  <p class="text-center font-title text-6xl font-medium tracking-wider text-day-200">
    {RELEASE_NUMBER ? `#${RELEASE_NUMBER}` : '???'}
  </p>
  <time class="mt-4 block text-center text-xl text-day-400" datetime={releaseDate?.toISOString()}>
    {
      releaseDate?.toLocaleString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      }) ?? 'Unknown release date'
    }
  </time>
  {
    !!releaseDate && (
      <p class="mt-2 text-center text-day-500">
        (<time datetime={releaseDate.toISOString()}>{timeAgo.format(releaseDate, 'round')}</time>)
      </p>
    )
  }
</MiniLayout>
