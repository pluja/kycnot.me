---
import { Icon } from 'astro-icon/components'
import { actions, isInputError } from 'astro:actions'
import { z } from 'astro/zod'

import AdminEventRow from '../../../components/admin/events/AdminEventRow.astro'
import EventTimingFields from '../../../components/admin/events/EventTimingFields.astro'
import IncidentFields from '../../../components/admin/services/edit/IncidentFields.astro'
import Button from '../../../components/Button.astro'
import InputSelect from '../../../components/InputSelect.astro'
import InputSubmitButton from '../../../components/InputSubmitButton.astro'
import InputText from '../../../components/InputText.astro'
import InputTextArea from '../../../components/InputTextArea.astro'
import { eventClassFilterFor, eventViews, eventViewsZodEnum } from '../../../constants/eventViews'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { cn } from '../../../lib/cn'
import { zodParseQueryParamsStoringErrors } from '../../../lib/parseUrlFilters'
import { prisma } from '../../../lib/prisma'
import { urlWithParams } from '../../../lib/urls'

import type { Prisma } from '@prisma/client'

const PAGE_SIZE = 60

const errorsOf = <T extends { error?: unknown } | undefined>(result: T) =>
  isInputError(result?.error) ? result.error.fields : {}

const createResult = Astro.getActionResult(actions.admin.event.create)
Astro.locals.banners.addIfSuccess(createResult, 'Event created')
const createInputErrors = errorsOf(createResult)

const toggleResult = Astro.getActionResult(actions.admin.event.toggle)
Astro.locals.banners.addIfSuccess(toggleResult, 'Event visibility updated')
const resolveResult = Astro.getActionResult(actions.admin.event.resolve)
Astro.locals.banners.addIfSuccess(resolveResult, 'Incident resolved')

const eventStates = [
  { value: 'live', label: 'Live (visible, not deleted)' },
  { value: 'ongoing', label: 'Ongoing only' },
  { value: 'ended', label: 'Ended only' },
  { value: 'hidden', label: 'Hidden' },
  { value: 'deleted', label: 'Deleted' },
] as const

const { data: filters, hasDefaultData } = zodParseQueryParamsStoringErrors(
  {
    view: eventViewsZodEnum.default('curated'),
    state: z.enum(['live', 'ongoing', 'ended', 'hidden', 'deleted']).default('live'),
    service: z.string().optional(),
    q: z.string().optional(),
    page: z.coerce.number().int().min(1).default(1),
  },
  Astro
)

const now = new Date()

const stateFilters: Record<(typeof eventStates)[number]['value'], Prisma.EventWhereInput> = {
  live: { visible: true, deletedAt: null },
  ongoing: {
    visible: true,
    deletedAt: null,
    OR: [{ endedAt: null }, { endedAt: { gte: now } }],
  },
  ended: { visible: true, deletedAt: null, endedAt: { lt: now } },
  hidden: { visible: false, deletedAt: null },
  deleted: { deletedAt: { not: null } },
}

const where: Prisma.EventWhereInput = {
  ...stateFilters[filters.state],
  class: eventClassFilterFor(filters.view),
  ...(filters.service ? { service: { slug: filters.service } } : {}),
  ...(filters.q
    ? {
        OR: [
          { title: { contains: filters.q, mode: 'insensitive' } },
          { content: { contains: filters.q, mode: 'insensitive' } },
        ],
      }
    : {}),
}

const [events, totalEvents] = await Astro.locals.banners.try(
  'Failed to load events',
  () =>
    prisma.event.findManyAndCount({
      where,
      // Most recently started first: what a moderator is looking for is almost
      // always the newest thing that happened.
      orderBy: [{ startedAt: 'desc' }, { id: 'desc' }],
      skip: (filters.page - 1) * PAGE_SIZE,
      take: PAGE_SIZE,
      select: {
        id: true,
        title: true,
        content: true,
        type: true,
        class: true,
        sentiment: true,
        origin: true,
        visible: true,
        deletedAt: true,
        startedAt: true,
        endedAt: true,
        incident: { select: { state: true, severity: true } },
        service: { select: { name: true, slug: true, imageUrl: true } },
      },
    }),
  [[], 0] as const
)

// Counts drive the triage shortcuts, so they ignore the current filters.
const [openIncidents, openWarnings, hiddenCount, deletedCount, services] = await Astro.locals.banners.tryMany(
  [
    [
      'Failed to count incidents',
      () =>
        prisma.event.count({
          where: { visible: true, deletedAt: null, class: 'INCIDENT', incident: { state: 'ONGOING' } },
        }),
      0,
    ],
    [
      'Failed to count warnings',
      () =>
        prisma.event.count({
          where: {
            visible: true,
            deletedAt: null,
            class: 'EVENT',
            sentiment: 'NEGATIVE',
            OR: [{ endedAt: null }, { endedAt: { gte: now } }],
          },
        }),
      0,
    ],
    [
      'Failed to count hidden events',
      () => prisma.event.count({ where: { visible: false, deletedAt: null } }),
      0,
    ],
    ['Failed to count deleted events', () => prisma.event.count({ where: { deletedAt: { not: null } } }), 0],
    [
      'Failed to load services',
      () =>
        prisma.service.findMany({
          select: {
            id: true,
            name: true,
            slug: true,
            _count: { select: { events: { where: { deletedAt: null } } } },
          },
          orderBy: { name: 'asc' },
        }),
      [] as [],
    ],
  ]
)

const selectedService = services.find((service) => service.slug === filters.service)
const totalPages = Math.max(1, Math.ceil(totalEvents / PAGE_SIZE))
const rangeStart = totalEvents === 0 ? 0 : (filters.page - 1) * PAGE_SIZE + 1
const rangeEnd = Math.min(filters.page * PAGE_SIZE, totalEvents)

const shortcuts = [
  {
    label: 'Open incidents',
    count: openIncidents,
    icon: 'ri:alarm-warning-line',
    color: 'text-red-300',
    params: { view: 'incidents', state: 'ongoing', service: undefined, q: undefined, page: undefined },
  },
  {
    label: 'Active warnings',
    count: openWarnings,
    icon: 'ri:alert-line',
    color: 'text-amber-300',
    params: { view: 'curated', state: 'ongoing', service: undefined, q: undefined, page: undefined },
  },
  {
    label: 'Hidden',
    count: hiddenCount,
    icon: 'ri:eye-off-line',
    color: 'text-day-300',
    params: { view: 'all', state: 'hidden', service: undefined, q: undefined, page: undefined },
  },
  {
    label: 'Deleted',
    count: deletedCount,
    icon: 'ri:delete-bin-line',
    color: 'text-day-400',
    params: { view: 'all', state: 'deleted', service: undefined, q: undefined, page: undefined },
  },
]

const fieldClass =
  'w-full rounded-md border border-night-500 bg-night-900 px-2.5 py-1.5 text-sm text-day-100 transition-colors [color-scheme:dark] focus:border-green-500/60 focus:outline-none'

const toLocalDateTime = (date: Date) =>
  new Date(date.getTime() - date.getTimezoneOffset() * 60000).toISOString().slice(0, 16)

// Reopen the form when a submission bounced, so the errors are not hidden.
const hasCreateErrors = Object.keys(createInputErrors).length > 0
---

<BaseLayout pageTitle="Manage events" widthClassName="max-w-6xl" noindex>
  <header class="mt-10 mb-5 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="font-title text-3xl font-bold text-white">Events</h1>
      <p class="mt-1 text-sm text-day-400">
        Create an event for any service, or filter the timeline below. Newest first.
      </p>
    </div>

    {
      selectedService && (
        <Button
          as="a"
          href={`/admin/events/${encodeURIComponent(selectedService.slug)}`}
          variant="faded"
          icon="ri:list-check-2"
          size="sm"
          label={`Open ${selectedService.name} timeline`}
        />
      )
    }
  </header>

  <details
    id="new-event"
    class="group/add mb-5 rounded-xl border border-night-600 bg-night-800/60 p-3"
    open={hasCreateErrors}
  >
    <summary
      class="flex cursor-pointer list-none items-center gap-2 text-sm font-medium text-day-100 [&::-webkit-details-marker]:hidden"
    >
      <Icon name="ri:add-circle-line" class="size-5 shrink-0 text-green-400" />
      <span class="grow">New event</span>
      <Icon
        name="ri:arrow-down-s-line"
        class="size-5 shrink-0 text-day-400 transition-transform group-open/add:rotate-180"
      />
    </summary>

    <form method="POST" action={`${actions.admin.event.create}#new-event`} class="mt-4 max-w-3xl space-y-3">
      <InputSelect
        name="serviceId"
        label="Service"
        options={services.map((service) => ({
          label: `${service.name} (${service._count.events.toString()})`,
          value: service.id.toString(),
        }))}
        selectedValue={selectedService?.id.toString()}
        selectProps={{ required: true }}
        error={createInputErrors.serviceId}
      />

      <InputText
        label="Title"
        name="title"
        inputProps={{ required: true, placeholder: 'Short, factual headline' }}
        error={createInputErrors.title}
      />

      <InputTextArea
        label="Content"
        name="content"
        inputProps={{ required: true, rows: 3 }}
        error={createInputErrors.content}
        description="Markdown supported. Say what happened and what it means for users."
      />

      <EventTimingFields startedAt={toLocalDateTime(new Date())} errors={createInputErrors} />

      <InputText
        label="Source URL"
        name="source"
        inputProps={{ type: 'url', placeholder: 'https://...' }}
        error={createInputErrors.source}
        description="Optional. Where this was reported, so readers can check it."
      />

      <IncidentFields errors={createInputErrors} />

      <InputSubmitButton label="Create event" icon="ri:add-line" hideCancel />
    </form>
  </details>

  <div class="mb-5 grid grid-cols-2 gap-2 sm:grid-cols-4">
    {
      shortcuts.map((shortcut) => (
        <a
          href={urlWithParams(Astro.url, shortcut.params)}
          class="rounded-lg border border-night-600 bg-night-800 px-3 py-2 transition-colors hover:border-night-400"
        >
          <span class="flex items-center gap-1.5 text-xs text-day-400">
            <Icon name={shortcut.icon} class={cn('size-3.5 shrink-0', shortcut.color)} />
            {shortcut.label}
          </span>
          <span class={cn('font-title text-xl font-bold tabular-nums', shortcut.color)}>
            {shortcut.count.toLocaleString()}
          </span>
        </a>
      ))
    }
  </div>

  <form method="GET" class="mb-4 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-[1fr_auto_auto_auto]">
    <div>
      <label for="q" class="sr-only">Search events</label>
      <input
        type="search"
        id="q"
        name="q"
        value={filters.q}
        placeholder="Search title or content..."
        class={fieldClass}
      />
    </div>

    <div>
      <label for="view" class="sr-only">Show</label>
      <select id="view" name="view" class={fieldClass}>
        {
          eventViews.map((view) => (
            <option value={view.value} selected={filters.view === view.value}>
              {view.label}
            </option>
          ))
        }
      </select>
    </div>

    <div>
      <label for="state" class="sr-only">State</label>
      <select id="state" name="state" class={fieldClass}>
        {
          eventStates.map((state) => (
            <option value={state.value} selected={filters.state === state.value}>
              {state.label}
            </option>
          ))
        }
      </select>
    </div>

    <div>
      <label for="service" class="sr-only">Service</label>
      <select id="service" name="service" class={fieldClass}>
        <option value="">All services</option>
        {
          services.map((service) => (
            <option value={service.slug} selected={filters.service === service.slug}>
              {service.name} ({service._count.events})
            </option>
          ))
        }
      </select>
    </div>

    <div class="flex gap-2 sm:col-span-2 lg:col-span-4">
      <Button type="submit" label="Apply filters" icon="ri:filter-3-line" size="sm" color="success" />
      {
        !hasDefaultData && (
          <Button as="a" href="/admin/events" label="Reset" icon="ri:close-line" size="sm" variant="faded" />
        )
      }
    </div>
  </form>

  <p class="mb-2 text-xs text-day-500">
    {
      totalEvents === 0
        ? 'No events match these filters.'
        : `Showing ${rangeStart.toLocaleString()} to ${rangeEnd.toLocaleString()} of ${totalEvents.toLocaleString()}`
    }
  </p>

  {
    events.length > 0 && (
      <ul class="space-y-2">
        {events.map((event) => (
          <li>
            <AdminEventRow event={event} now={now} />
          </li>
        ))}
      </ul>
    )
  }

  {
    totalPages > 1 && (
      <nav class="mt-5 flex items-center justify-between gap-3" aria-label="Pagination">
        {filters.page > 1 ? (
          <Button
            as="a"
            href={urlWithParams(Astro.url, { page: filters.page - 1 })}
            label="Previous"
            icon="ri:arrow-left-line"
            size="sm"
            variant="faded"
          />
        ) : (
          <span />
        )}
        <span class="text-xs text-day-500">
          Page {filters.page} of {totalPages}
        </span>
        {filters.page < totalPages ? (
          <Button
            as="a"
            href={urlWithParams(Astro.url, { page: filters.page + 1 })}
            label="Next"
            icon="ri:arrow-right-line"
            size="sm"
            variant="faded"
          />
        ) : (
          <span />
        )}
      </nav>
    )
  }
</BaseLayout>
