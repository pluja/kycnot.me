---
import { Icon } from 'astro-icon/components'
import { DATABASE_UI_URL, LOGS_UI_URL } from 'astro:env/server'

import BadgeSmall from '../../components/BadgeSmall.astro'
import { getCapabilityInfo } from '../../constants/capabilities'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { cn } from '../../lib/cn'
import { adminRouteRequiredCapability, userCanAccessAdmin } from '../../lib/permissions'

import type { ComponentProps } from 'astro/types'

type AdminLink = {
  icon: ComponentProps<typeof Icon>['name']
  title: string
  href: string
  classNames: {
    base?: string
  }
}

const adminLinks: AdminLink[] = [
  {
    icon: 'ri:box-3-line',
    title: 'Services',
    href: '/admin/services',
    classNames: {
      base: 'text-green-300',
    },
  },
  {
    icon: 'ri:user-3-line',
    title: 'Users',
    href: '/admin/users',
    classNames: {
      base: 'text-red-300',
    },
  },
  {
    icon: 'ri:chat-4-line',
    title: 'Comments',
    href: '/admin/comments',
    classNames: {
      base: 'text-yellow-300',
    },
  },
  {
    icon: 'ri:lightbulb-line',
    title: 'Suggestions',
    href: '/admin/service-suggestions',
    classNames: {
      base: 'text-purple-300',
    },
  },
  {
    icon: 'ri:mail-line',
    title: 'Contact',
    href: '/admin/contact',
    classNames: {
      base: 'text-rose-300',
    },
  },
  {
    icon: 'ri:scales-3-line',
    title: 'Cases',
    href: '/admin/cases',
    classNames: {
      base: 'text-orange-300',
    },
  },
  {
    icon: 'ri:price-tag-3-line',
    title: 'Attributes',
    href: '/admin/attributes',
    classNames: {
      base: 'text-blue-300',
    },
  },
  {
    icon: 'ri:megaphone-line',
    title: 'Announcements',
    href: '/admin/announcements',
    classNames: {
      base: 'text-pink-300',
    },
  },
  {
    icon: 'ri:notification-3-line',
    title: 'Notifications',
    href: '/admin/notifications',
    classNames: {
      base: 'text-indigo-300',
    },
  },
  {
    icon: 'ri:rocket-2-line',
    title: 'Releases',
    href: '/admin/releases',
    classNames: {
      base: 'text-orange-300',
    },
  },
  {
    icon: 'ri:bar-chart-2-line',
    title: 'Stats',
    href: '/admin/stats',
    classNames: {
      base: 'text-teal-300',
    },
  },
  {
    icon: 'ri:database-2-line',
    title: 'Database',
    href: DATABASE_UI_URL,
    classNames: {
      base: 'text-gray-300',
    },
  },
  ...(LOGS_UI_URL
    ? [
        {
          icon: 'ri:menu-search-line',
          title: 'Logs',
          href: LOGS_UI_URL,
          classNames: {
            base: 'text-cyan-300',
          },
        },
      ]
    : []),
]

const user = Astro.locals.user
if (!userCanAccessAdmin(user)) return Astro.rewrite('/404')

// Show only the sections the user can actually open: a mapped route needs its
// capability, an unmapped one is superuser-only. Mirrors the middleware guard.
const visibleLinks = adminLinks.filter((link) => {
  if (!link.href) return false
  const capability = adminRouteRequiredCapability(link.href)
  return capability ? Astro.locals.userCan(capability) : !!user?.admin
})

const grantedCapabilities = (user?.capabilities ?? []).map((capability) => getCapabilityInfo(capability))
---

<BaseLayout pageTitle="Admin Dashboard" widthClassName="max-w-7xl">
  <h1 class="mb-4 font-title text-3xl font-bold text-day-100">
    <Icon name="ri:home-gear-line" class="me-1 inline-block size-10 align-[-0.35em]" />
    Admin Dashboard
  </h1>

  <div class="mb-8 flex flex-wrap items-center gap-2">
    {
      user?.admin ? (
        <BadgeSmall color="green" variant="faded" icon="ri:shield-star-fill" text="Administrator: full access" />
      ) : (
        <Fragment>
          <span class="text-sm text-day-400">Your access:</span>
          {grantedCapabilities.map((capability) => (
            <BadgeSmall color="blue" variant="faded" icon={capability.icon} text={capability.label} />
          ))}
        </Fragment>
      )
    }
  </div>

  <nav>
    <ol class="grid grid-cols-[repeat(auto-fill,minmax(calc(var(--spacing)*40),1fr))] gap-4">
      {
        visibleLinks.map((link) => (
            <li
              class={cn(
                'group transition-transform duration-250 ease-out-back hover:-translate-y-0.5 hover:scale-105',
                link.classNames.base
              )}
            >
              <a
                href={link.href}
                class="flex min-h-24 flex-col items-center justify-around rounded-lg border border-current/4 bg-current/3 py-3 text-center transition-all duration-250 group-hover:border-current/10 group-hover:bg-current/10 group-hover:shadow-xl"
              >
                <Icon
                  name={link.icon}
                  class="size-8 text-current opacity-50 transition-opacity duration-250 group-hover:opacity-100"
                />
                <span class="font-title text-xl leading-none font-semibold text-current">{link.title}</span>
              </a>
            </li>
          ))
      }
    </ol>
  </nav>
</BaseLayout>
