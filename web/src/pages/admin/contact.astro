---
import { z } from 'astro/zod'

import BadgeSmall from '../../components/BadgeSmall.astro'
import TimeFormatted from '../../components/TimeFormatted.astro'
import UserBadge from '../../components/UserBadge.astro'
import { contactCategoryBadges, contactCategoryLabels } from '../../constants/contactCategories'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { cn } from '../../lib/cn'
import { zodParseQueryParamsStoringErrors } from '../../lib/parseUrlFilters'
import { prisma } from '../../lib/prisma'
import { urlWithParams } from '../../lib/urls'

import type { ContactStatus, Prisma } from '@prisma/client'

if (!Astro.locals.userCan('contact:manage')) {
  return Astro.rewrite('/404')
}

const filterValues = ['unread', 'open', 'replied', 'resolved', 'all'] as const

const { data: params } = zodParseQueryParamsStoringErrors(
  { filter: z.enum(filterValues).default('unread') },
  Astro
)

const whereByFilter: Record<(typeof filterValues)[number], Prisma.ContactThreadWhereInput> = {
  unread: { readAt: null },
  open: { status: 'AWAITING_STAFF' },
  replied: { status: 'AWAITING_USER' },
  resolved: { status: 'RESOLVED' },
  all: {},
}

const filterLabels: Record<(typeof filterValues)[number], string> = {
  unread: 'Unread',
  open: 'Awaiting reply',
  replied: 'Answered',
  resolved: 'Resolved',
  all: 'All',
}

const statusStyles: Record<ContactStatus, { label: string; color: 'rose' | 'green' | 'gray'; icon: string }> = {
  AWAITING_STAFF: { label: 'Awaiting reply', color: 'rose', icon: 'ri:time-line' },
  AWAITING_USER: { label: 'Answered', color: 'green', icon: 'ri:chat-1-line' },
  RESOLVED: { label: 'Resolved', color: 'gray', icon: 'ri:check-line' },
}

const [threads, counts] = await Astro.locals.banners.tryMany([
  [
    'Failed to fetch contact threads',
    () =>
      prisma.contactThread.findMany({
        where: whereByFilter[params.filter],
        orderBy: { lastMessageAt: 'desc' },
        take: 200,
        select: {
          id: true,
          category: true,
          status: true,
          readAt: true,
          lastMessageAt: true,
          author: { select: { id: true, name: true, displayName: true, picture: true } },
          messages: {
            orderBy: { createdAt: 'desc' },
            take: 1,
            select: { content: true, fromStaff: true },
          },
          _count: { select: { messages: true } },
        },
      }),
    [],
  ],
  [
    'Failed to count contact threads',
    async () => {
      const [unread, open, replied, resolved, all] = await Promise.all([
        prisma.contactThread.count({ where: whereByFilter.unread }),
        prisma.contactThread.count({ where: whereByFilter.open }),
        prisma.contactThread.count({ where: whereByFilter.replied }),
        prisma.contactThread.count({ where: whereByFilter.resolved }),
        prisma.contactThread.count({ where: whereByFilter.all }),
      ])
      return { unread, open, replied, resolved, all }
    },
    { unread: 0, open: 0, replied: 0, resolved: 0, all: 0 },
  ],
])
---

<BaseLayout pageTitle="Contact queue" widthClassName="max-w-screen-2xl">
  <h1 class="font-title mb-4 text-2xl text-rose-300">&gt; contact.queue</h1>

  <div class="mb-4 flex flex-wrap gap-1.5">
    {
      filterValues.map((value) => (
        <a
          href={urlWithParams(Astro.url, { filter: value })}
          class={cn(
            'inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1 text-xs',
            params.filter === value
              ? 'border-rose-500/40 bg-rose-500/10 text-rose-200'
              : 'border-zinc-700 hover:border-rose-500/40'
          )}
        >
          <span>{filterLabels[value]}</span>
          <span class="rounded-sm bg-night-700 px-1.5 py-0.5 text-[10px] text-day-400">
            {counts[value].toLocaleString()}
          </span>
        </a>
      ))
    }
  </div>

  {
    threads.length === 0 ? (
      <div class="rounded-md border border-zinc-800 bg-night-800/50 px-3 py-6 text-center text-sm text-zinc-500">
        No conversations in this view.
      </div>
    ) : (
      <ol class="space-y-2">
        {threads.map((t) => {
          const status = statusStyles[t.status]
          const category = contactCategoryBadges[t.category]
          const latest = t.messages[0]
          return (
            <li>
              <a
                href={`/admin/contact/${String(t.id)}`}
                class={cn(
                  'block rounded-md bg-night-700 p-3 transition-colors hover:border-rose-500/50',
                  // Unread (a new user message) gets a thick rose border; read
                  // threads a thin neutral one, so new ones pop in the All view.
                  t.readAt ? 'border border-zinc-800' : 'border-2 border-rose-500/60',
                  t.status === 'RESOLVED' && 'opacity-75'
                )}
              >
                <div class="mb-1.5 flex flex-wrap items-center gap-2 text-xs">
                  {!t.readAt && <span class="size-2 shrink-0 rounded-full bg-rose-400" title="Unread" />}
                  <BadgeSmall color={status.color} text={status.label} icon={status.icon} />
                  <BadgeSmall color={category.color} variant="faded" text={contactCategoryLabels[t.category]} icon={category.icon} />
                  {t.author ? (
                    <UserBadge user={t.author} size="sm" noLink />
                  ) : (
                    <span class="text-zinc-500">[deleted user]</span>
                  )}
                  <span class="ml-auto text-zinc-500">
                    {t._count.messages.toLocaleString()} msg ·{' '}
                    <TimeFormatted date={t.lastMessageAt} hourPrecision class="text-zinc-400" />
                  </span>
                </div>
                {latest && (
                  <p class="truncate text-sm text-day-300">
                    <span class="text-zinc-500">{latest.fromStaff ? 'Staff: ' : 'User: '}</span>
                    {latest.content}
                  </p>
                )}
              </a>
            </li>
          )
        })}
      </ol>
    )
  }
</BaseLayout>
