---
import { Icon } from 'astro-icon/components'

import BadgeSmall from '../../../components/BadgeSmall.astro'
import Button from '../../../components/Button.astro'
import TimeFormatted from '../../../components/TimeFormatted.astro'
import { getCaseIssueTypeInfo } from '../../../constants/caseIssueTypes'
import { caseStatuses, caseStatusesZodEnum, getCaseStatusInfo } from '../../../constants/caseStatus'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { cn } from '../../../lib/cn'
import { zodParseQueryParamsStoringErrors } from '../../../lib/parseUrlFilters'
import { prisma } from '../../../lib/prisma'
import { urlWithParams } from '../../../lib/urls'

if (!Astro.locals.userCan('cases:manage')) return Astro.rewrite('/404')

const { data: filters } = zodParseQueryParamsStoringErrors(
  { status: caseStatusesZodEnum.optional() },
  Astro
)

const where = filters.status ? { status: filters.status } : {}

const [cases, statusCounts] = await Astro.locals.banners.tryMany([
  [
    'Failed to fetch cases',
    () =>
      prisma.case.findMany({
        where,
        orderBy: { createdAt: 'desc' },
        take: 200,
        select: {
          id: true,
          title: true,
          status: true,
          issueType: true,
          amountText: true,
          createdAt: true,
          service: { select: { name: true, slug: true } },
          reportedBy: { select: { name: true } },
          _count: { select: { evidence: true } },
        },
      }),
    [],
  ],
  [
    'Failed to count cases',
    () => prisma.case.groupBy({ by: ['status'], _count: { _all: true } }),
    [],
  ],
])

const countByStatus = new Map(statusCounts.map((row) => [row.status, row._count._all]))
const totalCount = statusCounts.reduce((sum, row) => sum + row._count._all, 0)
---

<BaseLayout pageTitle="Cases" description="Manage service cases" widthClassName="max-w-7xl" noindex>
  <div class="mt-10 mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="font-title text-3xl font-bold">Cases</h1>
    <Button as="a" href="/admin/cases/new" color="success" icon="ri:add-line" label="New case" />
  </div>

  <div class="mb-5 flex flex-wrap gap-1.5">
    <a
      href={urlWithParams(Astro.url, { status: undefined })}
      class={cn(
        'inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1 text-xs transition-colors',
        !filters.status ? 'border-day-400/40 bg-day-500/10 text-day-100' : 'border-night-500 text-day-300'
      )}
    >
      <span>All</span>
      <span class="rounded-sm bg-night-700 px-1.5 py-0.5 text-[10px]">{totalCount.toLocaleString()}</span>
    </a>
    {
      caseStatuses.map((status) => (
        <a
          href={urlWithParams(Astro.url, { status: status.value })}
          class={cn(
            'inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1 text-xs transition-colors',
            filters.status === status.value
              ? 'border-day-400/40 bg-day-500/10 text-day-100'
              : 'border-night-500 text-day-300'
          )}
        >
          <Icon name={status.icon} class="size-3.5" />
          <span>{status.label}</span>
          <span class="rounded-sm bg-night-700 px-1.5 py-0.5 text-[10px]">
            {(countByStatus.get(status.value) ?? 0).toLocaleString()}
          </span>
        </a>
      ))
    }
  </div>

  {
    cases.length === 0 ? (
      <p class="rounded-xl border border-night-600 bg-night-800 p-10 text-center text-day-300">
        No cases{filters.status ? ` with status ${getCaseStatusInfo(filters.status).label}` : ''} yet.
      </p>
    ) : (
      <div class="space-y-2">
        {cases.map((caseRow) => {
          const statusInfo = getCaseStatusInfo(caseRow.status)
          const issueInfo = getCaseIssueTypeInfo(caseRow.issueType)
          return (
            <a
              href={`/admin/cases/${caseRow.id.toString()}`}
              class="flex flex-wrap items-center gap-x-4 gap-y-2 rounded-lg border border-night-600 bg-night-800 p-3 transition-colors hover:border-night-400"
            >
              <BadgeSmall text={statusInfo.label} variant="faded" color={statusInfo.color} icon={statusInfo.icon} />
              <div class="min-w-0 grow">
                <p class="truncate font-semibold text-day-100">{caseRow.title}</p>
                <p class="truncate text-xs text-day-400">{caseRow.service.name}</p>
              </div>
              <BadgeSmall text={issueInfo.label} variant="faded" color="gray" icon={issueInfo.icon} />
              {caseRow.amountText && <span class="text-xs text-day-400">{caseRow.amountText}</span>}
              <span class="flex items-center gap-1 text-xs text-day-500">
                <Icon name="ri:attachment-2" class="size-3.5" />
                {caseRow._count.evidence}
              </span>
              <TimeFormatted date={caseRow.createdAt} class="text-xs text-day-500" />
            </a>
          )
        })}
      </div>
    )
  }
</BaseLayout>
