---
import { Icon } from 'astro-icon/components'
import { actions, isInputError } from 'astro:actions'
import { format } from 'date-fns'

import AdminPageNav from '../../../components/admin/AdminPageNav.astro'
import CaseEvidenceGallery from '../../../components/admin/cases/CaseEvidenceGallery.astro'
import CaseUpdatesTimeline from '../../../components/admin/cases/CaseUpdatesTimeline.astro'
import ReporterField from '../../../components/admin/cases/ReporterField.astro'
import DeleteConfirmButton from '../../../components/admin/DeleteConfirmButton.astro'
import BadgeSmall from '../../../components/BadgeSmall.astro'
import Button from '../../../components/Button.astro'
import FormSection from '../../../components/FormSection.astro'
import InputSelect from '../../../components/InputSelect.astro'
import InputSubmitButton from '../../../components/InputSubmitButton.astro'
import InputText from '../../../components/InputText.astro'
import InputTextArea from '../../../components/InputTextArea.astro'
import Lightbox from '../../../components/Lightbox.astro'
import MyPicture from '../../../components/MyPicture.astro'
import TimeFormatted from '../../../components/TimeFormatted.astro'
import { caseIssueTypes, getCaseIssueTypeInfo } from '../../../constants/caseIssueTypes'
import { caseStatuses, getCaseStatusInfo } from '../../../constants/caseStatus'
import { getIncidentSeverityInfo } from '../../../constants/incidentSeverities'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { prisma } from '../../../lib/prisma'

import type { CaseStatus, Prisma } from '@prisma/client'
import type { ComponentProps } from 'astro/types'

if (!Astro.locals.userCan('cases:manage')) return Astro.rewrite('/404')

const caseId = Number(Astro.params.id)
if (!Number.isInteger(caseId) || caseId <= 0) return Astro.rewrite('/404')

const errorsOf = <T extends { error?: unknown } | undefined>(result: T) =>
  isInputError(result?.error) ? result.error.fields : {}

const deleteResult = Astro.getActionResult(actions.admin.case.delete)
if (deleteResult && !deleteResult.error) return Astro.redirect('/admin/cases')

const updateResult = Astro.getActionResult(actions.admin.case.update)
Astro.locals.banners.addIfSuccess(updateResult, 'Case updated')
const updateInputErrors = errorsOf(updateResult)

const linkIncidentResult = Astro.getActionResult(actions.admin.case.linkIncident)
Astro.locals.banners.addIfSuccess(linkIncidentResult, 'Incident link updated')
const linkIncidentInputErrors = errorsOf(linkIncidentResult)

const setStatusResult = Astro.getActionResult(actions.admin.case.setStatus)
Astro.locals.banners.addIfSuccess(setStatusResult, 'Case status updated')

const addEvidenceResult = Astro.getActionResult(actions.admin.case.evidence.add)
Astro.locals.banners.addIfSuccess(addEvidenceResult, 'Evidence added')

const deleteEvidenceResult = Astro.getActionResult(actions.admin.case.evidence.delete)
Astro.locals.banners.addIfSuccess(deleteEvidenceResult, 'Evidence removed')

const addUpdateResult = Astro.getActionResult(actions.admin.case.updates.add)
Astro.locals.banners.addIfSuccess(addUpdateResult, 'Update posted')

const editUpdateResult = Astro.getActionResult(actions.admin.case.updates.edit)
Astro.locals.banners.addIfSuccess(editUpdateResult, 'Update edited')

const deleteUpdateResult = Astro.getActionResult(actions.admin.case.updates.delete)
Astro.locals.banners.addIfSuccess(deleteUpdateResult, 'Update deleted')

const addParticipantResult = Astro.getActionResult(actions.admin.case.participants.add)
Astro.locals.banners.addIfSuccess(addParticipantResult, 'Participant added')
const removeParticipantResult = Astro.getActionResult(actions.admin.case.participants.remove)
Astro.locals.banners.addIfSuccess(removeParticipantResult, 'Participant removed')

const evidenceOrderBy = [
  { order: 'asc' },
  { createdAt: 'asc' },
] satisfies Prisma.CaseEvidenceOrderByWithRelationInput[]
const evidenceSelect = {
  id: true,
  type: true,
  description: true,
  bodyMd: true,
  imageUrl: true,
  visibility: true,
  createdAt: true,
} satisfies Prisma.CaseEvidenceSelect

const caseRow = await Astro.locals.banners.try(
  'Failed to load case',
  () =>
    prisma.case.findUnique({
      where: { id: caseId },
      select: {
        id: true,
        publicId: true,
        title: true,
        issueType: true,
        status: true,
        summaryMd: true,
        amountText: true,
        externalSource: true,
        occurredAt: true,
        incidentId: true,
        resolvedAt: true,
        resolutionMd: true,
        createdAt: true,
        serviceId: true,
        service: { select: { name: true, slug: true } },
        reportedBy: { select: { id: true, name: true, displayName: true, picture: true } },
        createdBy: { select: { name: true } },
        participants: {
          orderBy: { name: 'asc' },
          select: { id: true, name: true, displayName: true, picture: true },
        },
        evidence: { where: { caseUpdateId: null }, orderBy: evidenceOrderBy, select: evidenceSelect },
        updates: {
          orderBy: { createdAt: 'asc' },
          select: {
            id: true,
            bodyMd: true,
            visibility: true,
            createdAt: true,
            author: { select: { name: true } },
            evidence: { orderBy: evidenceOrderBy, select: evidenceSelect },
          },
        },
      },
    }),
  null
)

if (!caseRow) return Astro.rewrite('/404')

// Only this service's incidents can be linked, matching the action's own guard.
const incidents = await Astro.locals.banners.try(
  'Failed to load incidents',
  () =>
    prisma.incident.findMany({
      where: { event: { serviceId: caseRow.serviceId, deletedAt: null } },
      orderBy: { occurredAt: 'desc' },
      select: {
        id: true,
        severity: true,
        occurredAt: true,
        event: { select: { title: true } },
      },
    }),
  []
)

const statusInfo = getCaseStatusInfo(caseRow.status)
const issueInfo = getCaseIssueTypeInfo(caseRow.issueType)
const toDateInput = (date: Date | null) => (date ? format(date, 'yyyy-MM-dd') : '')

const navItems = [
  { id: 'details', label: 'Details', icon: 'ri:file-text-line' },
  {
    id: 'incident',
    label: 'Linked incident',
    icon: 'ri:alarm-warning-line',
    badge: caseRow.incidentId ? '1' : undefined,
  },
  {
    id: 'participants',
    label: 'Participants',
    icon: 'ri:group-line',
    badge: caseRow.participants.length,
  },
  { id: 'evidence', label: 'Evidence', icon: 'ri:attachment-2', badge: caseRow.evidence.length },
  { id: 'updates', label: 'Conversation', icon: 'ri:chat-3-line', badge: caseRow.updates.length },
  { id: 'danger', label: 'Danger zone', icon: 'ri:delete-bin-line' },
]

// One click per transition beats opening the details form to change a status.
const statusButtonColor: Record<CaseStatus, ComponentProps<typeof Button>['color']> = {
  DRAFT: 'gray',
  OPEN: 'warning',
  RESOLVED: 'success',
  DISPUTED: 'warning',
  REJECTED: 'danger',
}
const otherStatuses = caseStatuses.filter((status) => status.value !== caseRow.status)
---

<BaseLayout
  pageTitle={`Case: ${caseRow.title}`}
  description="Manage case"
  widthClassName="max-w-6xl"
  noindex
  htmx
>
  <div class="mt-10 flex flex-wrap items-center justify-between gap-2">
    <a
      href="/admin/cases"
      class="inline-flex items-center gap-1 text-sm text-day-400 transition-colors hover:text-day-200"
    >
      <Icon name="ri:arrow-left-line" class="size-4" />
      All cases
    </a>
    <Button
      as="a"
      href={`/service/${caseRow.service.slug}/case/${caseRow.publicId}`}
      size="sm"
      variant="faded"
      color="success"
      icon="ri:external-link-line"
      label="View public page"
    />
  </div>

  <div class="mt-3 mb-6">
    <div class="flex flex-wrap items-center gap-2">
      <BadgeSmall text={statusInfo.label} variant="faded" color={statusInfo.color} icon={statusInfo.icon} />
      <BadgeSmall text={issueInfo.label} variant="faded" color="gray" icon={issueInfo.icon} />
    </div>
    <h1 class="mt-2 font-title text-3xl font-bold">{caseRow.title}</h1>
    <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-day-400">
      <a href={`/service/${caseRow.service.slug}`} class="inline-flex items-center gap-1 hover:text-day-200">
        <Icon name="ri:box-3-line" class="size-4" />
        {caseRow.service.name}
      </a>
      <span>Created <TimeFormatted date={caseRow.createdAt} /></span>
      {caseRow.createdBy && <span>by {caseRow.createdBy.name}</span>}
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-1.5">
      <span class="text-xs text-day-500">Move to:</span>
      {
        otherStatuses.map((status) => (
          <form method="POST" action={`${actions.admin.case.setStatus}#details`} class="contents">
            <input type="hidden" name="caseId" value={caseRow.id} />
            <input type="hidden" name="status" value={status.value} />
            <Button
              type="submit"
              size="sm"
              variant="faded"
              color={statusButtonColor[status.value]}
              icon={status.icon}
              label={status.label}
            />
          </form>
        ))
      }
    </div>

    <p class="mt-2 text-xs text-day-500">
      Public id: <code class="rounded-sm bg-night-700 px-1.5 py-0.5">{caseRow.publicId}</code>
    </p>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[14rem_1fr]">
    <AdminPageNav items={navItems} class="lg:py-2" />

    <div class="max-w-3xl min-w-0">
      <FormSection title="Details" id="details">
        <form method="POST" action={`${actions.admin.case.update}#details`} class="space-y-4">
          <input type="hidden" name="caseId" value={caseRow.id} />

          <InputText
            label="Title"
            name="title"
            inputProps={{ required: true, maxlength: 200, value: caseRow.title }}
            error={updateInputErrors.title}
          />

          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <InputSelect
              name="issueType"
              label="Issue type"
              options={caseIssueTypes.map((issue) => ({ label: issue.label, value: issue.value }))}
              selectedValue={caseRow.issueType}
              selectProps={{ required: true }}
              error={updateInputErrors.issueType}
            />

            <InputSelect
              name="status"
              label="Status"
              options={caseStatuses.map((status) => ({ label: status.label, value: status.value }))}
              selectedValue={caseRow.status}
              selectProps={{ required: true }}
              error={updateInputErrors.status}
            />
          </div>

          <InputTextArea
            label="Summary"
            name="summaryMd"
            inputProps={{ required: true, rows: 8 }}
            value={caseRow.summaryMd}
            error={updateInputErrors.summaryMd}
            description="Markdown supported."
          />

          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <InputText
              label="Amount"
              name="amountText"
              inputProps={{ value: caseRow.amountText ?? '' }}
              error={updateInputErrors.amountText}
            />
            <InputText
              label="External source"
              name="externalSource"
              inputProps={{ type: 'url', value: caseRow.externalSource ?? '' }}
              error={updateInputErrors.externalSource}
            />
          </div>

          <InputText
            label="Occurred on"
            name="occurredAt"
            inputProps={{ type: 'date', value: toDateInput(caseRow.occurredAt) }}
            description="When the problem happened, if the reporter could date it. Leave empty if unknown."
            error={updateInputErrors.occurredAt}
          />

          <div>
            <span class="mb-1 block text-sm font-medium text-day-200">Reporter user</span>
            <p class="mb-2 text-xs text-day-400">Optional. The user who reported this case.</p>
            <ReporterField selected={caseRow.reportedBy} />
            {
              updateInputErrors.reportedById && (
                <p class="mt-1 text-sm text-red-400">{updateInputErrors.reportedById}</p>
              )
            }
          </div>

          <InputTextArea
            label="Resolution"
            name="resolutionMd"
            inputProps={{ rows: 3 }}
            value={caseRow.resolutionMd}
            error={updateInputErrors.resolutionMd}
            description="Shown when the case is resolved. Markdown supported."
          />

          <InputSubmitButton label="Save" icon="ri:save-line" hideCancel />
        </form>
      </FormSection>

      <FormSection title="Linked incident" id="incident" class="mt-12">
        <p class="mb-3 text-sm text-day-400">
          Link this report to a service-wide incident once you judge that it substantiates one. The trust
          penalty stays derived from the incident itself, so linking more reports never multiplies the score
          impact. Published linked reports are listed on the incident on the public service page.
        </p>

        {
          incidents.length === 0 ? (
            <p class="rounded-lg border border-night-600 bg-night-800 p-4 text-center text-sm text-day-400">
              {caseRow.service.name} has no incidents recorded yet. Create one from the service's events
              first.
            </p>
          ) : (
            <form method="POST" action={`${actions.admin.case.linkIncident}#incident`} class="space-y-4">
              <input type="hidden" name="caseId" value={caseRow.id} />

              <InputSelect
                name="incidentId"
                label="Incident"
                options={[
                  { label: 'Not linked', value: '' },
                  ...incidents.map((incident) => ({
                    label: `${getIncidentSeverityInfo(incident.severity).label} · ${format(incident.occurredAt, 'MMM yyyy')} · ${incident.event.title}`,
                    value: incident.id.toString(),
                  })),
                ]}
                selectedValue={caseRow.incidentId?.toString() ?? ''}
                error={linkIncidentInputErrors.incidentId}
              />

              <InputSubmitButton label="Save link" icon="ri:link" hideCancel />
            </form>
          )
        }
      </FormSection>

      <FormSection title="Participants" id="participants" class="mt-12">
        <p class="mb-3 text-sm text-day-400">
          Attached users, the reporter, and the service's affiliated accounts can read and post in the
          conversation once the case is published.
        </p>

        {
          caseRow.participants.length === 0 ? (
            <p class="rounded-lg border border-night-600 bg-night-800 p-4 text-center text-sm text-day-400">
              No participants attached yet.
            </p>
          ) : (
            <ul class="space-y-2">
              {caseRow.participants.map((participant) => (
                <li class="flex items-center gap-2 rounded-lg border border-night-600 bg-night-800 p-2">
                  <MyPicture
                    src={participant.picture}
                    fallback="service"
                    alt=""
                    class="size-7 shrink-0 rounded-full object-cover"
                    width={28}
                    height={28}
                  />
                  <span class="font-medium text-day-100">{participant.displayName ?? participant.name}</span>
                  <span class="text-xs text-day-500">
                    @{participant.name} · #{participant.id}
                  </span>
                  <form
                    method="POST"
                    action={`${actions.admin.case.participants.remove}#participants`}
                    class="contents"
                  >
                    <input type="hidden" name="caseId" value={caseRow.id} />
                    <input type="hidden" name="userId" value={participant.id} />
                    <Button
                      type="submit"
                      label="Remove participant"
                      icon="ri:close-line"
                      iconOnly
                      size="sm"
                      variant="faded"
                      color="danger"
                      class="ml-auto"
                    />
                  </form>
                </li>
              ))}
            </ul>
          )
        }

        <div class="mt-3">
          <input
            type="search"
            name="q"
            aria-label="Search users to add as participants"
            placeholder="Search users by name or id..."
            autocomplete="off"
            hx-get={`/admin/cases/participant-search?caseId=${caseRow.id}`}
            hx-trigger="input changed delay:300ms"
            hx-target="#participant-results"
            hx-swap="innerHTML"
            class="w-full rounded-md border border-night-600 bg-night-900 p-2 text-white placeholder-day-500 focus:border-green-500 focus:outline-hidden"
          />
          <div id="participant-results" class="mt-2"></div>
        </div>
      </FormSection>

      <FormSection title="Evidence" id="evidence" class="mt-12">
        <CaseEvidenceGallery
          caseId={caseRow.id}
          evidence={caseRow.evidence}
          canManage
          id="evidence"
          addOpen
          addInputErrors={errorsOf(addEvidenceResult)}
        />
      </FormSection>

      <FormSection title="Conversation" id="updates" class="mt-12">
        <CaseUpdatesTimeline
          caseId={caseRow.id}
          status={caseRow.status}
          updates={caseRow.updates}
          canManage
          addInputErrors={errorsOf(addUpdateResult)}
          editInputErrors={errorsOf(editUpdateResult)}
        />
      </FormSection>

      <FormSection title="Danger zone" id="danger" class="mt-12">
        <div
          class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-red-500/30 bg-red-950/20 p-4"
        >
          <p class="text-sm text-day-300">
            Deleting a case removes its updates and all evidence. This cannot be undone.
          </p>
          <DeleteConfirmButton action={actions.admin.case.delete} id="case" label="Delete case">
            <input type="hidden" name="caseId" value={caseRow.id} />
          </DeleteConfirmButton>
        </div>
      </FormSection>
    </div>
  </div>

  <Lightbox />
</BaseLayout>
