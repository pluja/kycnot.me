---
import { makeSafeRedirectUrl } from '../../lib/redirectUrls'
import { browserOriginForUrl } from '../../lib/urls'
import { logout } from '../../lib/userCookies'

await logout(Astro)

const redirect = Astro.url.searchParams.get('redirect') ?? Astro.request.headers.get('referer')
return Astro.redirect(makeSafeRedirectUrl(redirect, browserOriginForUrl(Astro.url)))
---
