---
import { Icon } from 'astro-icon/components'
import { actions, isInputError } from 'astro:actions'

import {
  SUGGESTION_NAME_MAX_LENGTH,
  SUGGESTION_NOTES_MAX_LENGTH,
  SUGGESTION_SLUG_MAX_LENGTH,
} from '../../actions/serviceSuggestion'
import Captcha from '../../components/Captcha.astro'
import FormReplay from '../../components/FormReplay.astro'
import InputCheckbox from '../../components/InputCheckbox.astro'
import InputHoneypotTrap from '../../components/InputHoneypotTrap.astro'
import InputImageFile from '../../components/InputImageFile.astro'
import InputSubmitButton from '../../components/InputSubmitButton.astro'
import InputText from '../../components/InputText.astro'
import InputTextArea from '../../components/InputTextArea.astro'
import ServiceSuggestionFields from '../../components/ServiceSuggestionFields.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getFormReplay } from '../../lib/formReplay'
import { prisma } from '../../lib/prisma'
import { makeLoginUrl } from '../../lib/redirectUrls'

const user = Astro.locals.user
if (!user) {
  return Astro.redirect(makeLoginUrl(Astro.url, { message: 'Login to suggest a new service' }))
}

const result = Astro.getActionResult(actions.serviceSuggestion.createService)
if (result && !result.error && !result.data.hasDuplicates) {
  return Astro.redirect(`/service-suggestion/${result.data.serviceSuggestion.id}`)
}
const inputErrors = isInputError(result?.error) ? result.error.fields : {}

// Replay the previous submission into the inputs so a failed validation does
// not wipe a long form. The image cannot be restored: browsers forbid setting
// a file input's value.
const replay = getFormReplay(Astro.locals.actionFormValues)

const [categories, attributes] = await Astro.locals.banners.tryMany([
  [
    'Failed to fetch categories',
    () =>
      prisma.category.findMany({
        orderBy: { name: 'asc' },
        select: {
          id: true,
          name: true,
          icon: true,
        },
      }),
    [],
  ],
  [
    'Failed to fetch attributes',
    () =>
      prisma.attribute.findMany({
        orderBy: { category: 'asc' },
        select: {
          id: true,
          title: true,
          category: true,
          type: true,
        },
      }),
    [],
  ],
])
---

<BaseLayout
  pageTitle="New service"
  description="Suggest a new service to be added to KYCnot.me"
  noindex
  ogImage={{
    template: 'generic',
    title: 'New service',
    description: 'Suggest a new service to be listed',
    icon: 'ri:add-circle-line',
  }}
  widthClassName="max-w-3xl"
  breadcrumbs={[
    {
      name: 'Service suggestions',
      url: '/service-suggestion',
    },
    {
      name: 'New service',
    },
  ]}
>
  <h1 class="mt-12 text-center font-title text-3xl font-bold">Service suggestion</h1>

  <p class="mb-6 text-center text-sm text-day-400">
    Suggestions are reviewed by moderators before being public.
  </p>

  <form
    method="POST"
    action={actions.serviceSuggestion.createService}
    enctype="multipart/form-data"
    class="space-y-6"
  >
    {
      result?.data?.hasDuplicates && (
        <>
          <div class="mb-16 sm:rounded-lg sm:border sm:border-night-300 sm:bg-night-500 sm:p-2 md:p-4">
            <input type="hidden" name="skipDuplicateCheck" value="true" />

            <h2 class="flex items-center justify-center gap-2 font-title text-2xl font-semibold text-red-500">
              Possible duplicates found
            </h2>

            <p class="text-center text-day-400">Is your service already listed below?</p>

            <div class="mt-4 space-y-2">
              {result.data.possibleDuplicates.map((duplicate) => {
                const editServiceUrl = new URL('/service-suggestion/edit', Astro.url)
                editServiceUrl.searchParams.set('serviceId', duplicate.id.toString())
                if (result.data.extraNotes) {
                  editServiceUrl.searchParams.set('notes', result.data.extraNotes)
                }
                const editServiceHref = editServiceUrl.pathname + editServiceUrl.search

                return (
                  <div class="flex gap-4 rounded-lg border border-night-400 bg-night-600 p-4 shadow-sm">
                    <div class="grow">
                      <p class="mb-1 text-lg font-medium text-day-100">{duplicate.name}</p>
                      <p class="mb-3 line-clamp-2 text-sm text-day-300">{duplicate.description}</p>
                    </div>
                    <div class="flex shrink-0 flex-col justify-center gap-2">
                      <a
                        href={`/service/${duplicate.slug}`}
                        target="_blank"
                        class="flex items-center gap-1 rounded-sm bg-night-300 px-2.5 py-1.5 text-sm font-medium text-day-300 transition-colors hover:bg-night-400"
                      >
                        <Icon name="ri:external-link-line" class="size-4 shrink-0" />
                        View
                      </a>

                      <a
                        href={editServiceHref}
                        target="_blank"
                        class="flex items-center gap-1 rounded-sm bg-green-600 px-2.5 py-1.5 text-sm font-medium text-white transition-colors hover:bg-green-700"
                      >
                        <Icon name="ri:edit-line" class="size-4 shrink-0" />
                        Submit as edit
                      </a>
                    </div>
                  </div>
                )
              })}
            </div>

            <div class="mt-4 hidden h-px w-full bg-night-400 sm:block" />

            <div class="mt-4 flex items-center gap-2 px-4">
              <p class="flex-1 text-day-200">None of these match?</p>
              <button
                type="submit"
                class="flex items-center gap-2 rounded-md bg-day-700 px-4 py-2 text-sm font-medium text-day-100 hover:bg-day-600"
              >
                <Icon name="ri:send-plane-2-line" class="size-4" />
                Submit anyway
              </button>
            </div>
          </div>
          <h1 class="mt-12 mb-6 block text-center font-title text-3xl font-bold sm:hidden">
            Review your suggestion
          </h1>
        </>
      )
    }

    <InputText
      label="Name"
      name="name"
      inputProps={{
        required: true,
        maxlength: SUGGESTION_NAME_MAX_LENGTH,
        'data-generate-slug': true,
        value: replay.text('name'),
      }}
      error={inputErrors.name}
    />
    <InputText
      label="Slug"
      name="slug"
      description="Auto-generated from name. Only lowercase letters, numbers, and hyphens."
      error={inputErrors.slug}
      inputProps={{
        required: true,
        pattern: '^[a-z0-9\\-]+$',
        placeholder: 'my-service-name',
        minlength: 1,
        maxlength: SUGGESTION_SLUG_MAX_LENGTH,
        'data-generate-slug': true,
        value: replay.text('slug'),
      }}
    />

    <ServiceSuggestionFields
      replay={replay}
      inputErrors={inputErrors}
      categories={categories}
      attributes={attributes}
    />

    <InputImageFile
      label="Service Image"
      name="imageFile"
      description={`Square image. At least 192x192px. Transparency supported.${replay.isReplay ? ' Please re-select your image; uploads cannot be restored automatically.' : ''}`}
      error={inputErrors.imageFile}
      square
      required
    />

    <InputTextArea
      label="Note for Moderators"
      name="notes"
      id="notes"
      value={replay.text('notes')}
      error={inputErrors.notes}
      inputProps={{
        maxlength: SUGGESTION_NOTES_MAX_LENGTH,
      }}
    />

    <Captcha action={actions.serviceSuggestion.createService} />

    <InputCheckbox
      name="rulesConfirm"
      required
      checked={replay.checked('rulesConfirm')}
      error={inputErrors.rulesConfirm}
    >
      I understand the
      <a class="underline" target="_blank" href="/about#listings">suggestion rules and process</a>
    </InputCheckbox>

    <FormReplay />

    <InputHoneypotTrap name="message" />

    <InputSubmitButton label={result?.data?.hasDuplicates ? 'Submit anyway' : 'Submit'} />
  </form>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const triggerInputs = document.querySelectorAll<HTMLInputElement>('input[data-generate-slug]')
    const slugInputs = document.querySelectorAll<HTMLInputElement>('input[name="slug"]')

    triggerInputs.forEach((triggerInput) => {
      triggerInput.addEventListener('input', (event) => {
        const target = event.target as HTMLInputElement
        slugInputs.forEach((slugInput) => {
          slugInput.value = target.value
            .toLowerCase()
            .replace(/[^a-z0-9\-]+/g, '-')
            .replace(/-+/g, '-')
            .replace(/^-+|-+$/g, '')
        })
      })
    })
  })
</script>
