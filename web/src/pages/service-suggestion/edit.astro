---
import { Icon } from 'astro-icon/components'
import { actions, isInputError } from 'astro:actions'
import { z } from 'astro:content'

import {
  SERVICE_NAME_MAX_LENGTH,
  SUGGESTION_EDIT_REASON_MIN_LENGTH,
  SUGGESTION_NOTES_MAX_LENGTH,
} from '../../actions/serviceSuggestion'
import Captcha from '../../components/Captcha.astro'
import FormReplay from '../../components/FormReplay.astro'
import InputHoneypotTrap from '../../components/InputHoneypotTrap.astro'
import InputSubmitButton from '../../components/InputSubmitButton.astro'
import InputText from '../../components/InputText.astro'
import InputTextArea from '../../components/InputTextArea.astro'
import ServiceCard from '../../components/ServiceCard.astro'
import ServiceSuggestionFields from '../../components/ServiceSuggestionFields.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getFormReplay } from '../../lib/formReplay'
import { zodParseQueryParamsStoringErrors } from '../../lib/parseUrlFilters'
import { prisma } from '../../lib/prisma'
import { makeLoginUrl } from '../../lib/redirectUrls'
import { serviceEditableSelect, serviceFieldValues } from '../../lib/serviceFieldEdits'

const user = Astro.locals.user
if (!user) {
  return Astro.redirect(makeLoginUrl(Astro.url, { message: 'Login to suggest an edit' }))
}

const result = Astro.getActionResult(actions.serviceSuggestion.editService)
if (result && !result.error) {
  return Astro.redirect(`/service-suggestion/${result.data.serviceSuggestion.id}`)
}
const inputErrors = isInputError(result?.error) ? result.error.fields : {}

// Replay the previous submission so a failed validation (e.g. a wrong captcha)
// does not wipe what the user changed.
const replay = getFormReplay(Astro.locals.actionFormValues)

const { data: params } = zodParseQueryParamsStoringErrors(
  {
    serviceId: z.coerce.number().int().positive(),
    notes: z.string().default(''),
  },
  Astro
)

if (!params.serviceId) return Astro.rewrite('/404')

const [service, categories, attributes] = await Astro.locals.banners.tryMany([
  [
    'Failed to fetch service',
    () =>
      prisma.service.findUnique({
        select: {
          ...serviceEditableSelect,
          id: true,
          slug: true,
          overallScore: true,
          privacyScore: true,
          trustScore: true,
          imageUrl: true,
          verificationStatus: true,
          serviceVisibility: true,
          categories: { select: { id: true, name: true, icon: true } },
        },
        where: { id: params.serviceId },
      }),
    null,
  ],
  [
    'Failed to fetch categories',
    () =>
      prisma.category.findMany({
        orderBy: { name: 'asc' },
        select: { id: true, name: true, icon: true },
      }),
    [],
  ],
  [
    'Failed to fetch attributes',
    () =>
      prisma.attribute.findMany({
        orderBy: { category: 'asc' },
        select: { id: true, title: true, category: true, type: true },
      }),
    [],
  ],
])

if (!service) return Astro.rewrite('/404')

const values = serviceFieldValues(service)
---

<BaseLayout
  pageTitle={`Suggest an edit to ${service.name}`}
  description={`Suggest a correction or update to the ${service.name} listing on KYCnot.me`}
  noindex
  ogImage={{
    template: 'generic',
    title: 'Edit service',
    description: 'Suggest an edit to service',
    icon: 'ri:edit-line',
  }}
  widthClassName="max-w-3xl"
  breadcrumbs={[
    {
      name: 'Service suggestions',
      url: '/service-suggestion',
    },
    {
      name: 'Edit service',
    },
  ]}
>
  <h1 class="mt-12 text-center font-title text-3xl font-bold">Suggest an edit</h1>

  <p class="mb-6 text-center text-sm text-day-400">
    Change what is wrong below and tell us why. Moderators review every edit before it goes live.
  </p>

  <ServiceCard service={service} withoutLink class="mb-6" />

  <form method="POST" action={actions.serviceSuggestion.editService} class="space-y-6">
    <input type="hidden" name="serviceId" value={service.id} />

    <InputTextArea
      label="Reason for the edit"
      name="notes"
      value={replay.text('notes', params.notes)}
      description="Required. Say what is wrong and how you know, with links to proof if you can. If you prefer not to use the form below, describe the full change here instead."
      inputProps={{
        rows: 5,
        required: true,
        minlength: SUGGESTION_EDIT_REASON_MIN_LENGTH,
        maxlength: SUGGESTION_NOTES_MAX_LENGTH,
        placeholder: 'Example: They accept Monero now, see their FAQ at example.com/faq.',
      }}
      error={inputErrors.notes}
    />

    <div class="flex items-center gap-3 pt-4" role="separator">
      <div class="h-px flex-1 bg-night-400"></div>
      <div class="text-center">
        <h2 class="inline-flex items-center gap-2 font-title text-lg font-semibold text-day-100">
          <Icon name="ri:edit-2-line" class="size-5 text-day-400" />
          Service details
        </h2>
        <p class="text-xs text-day-500">Change only what is wrong. Leave the rest as it is.</p>
      </div>
      <div class="h-px flex-1 bg-night-400"></div>
    </div>

    <InputText
      label="Name"
      name="name"
      inputProps={{
        required: true,
        maxlength: SERVICE_NAME_MAX_LENGTH,
        value: replay.text('name', values.name ?? undefined),
      }}
      error={inputErrors.name}
    />

    <ServiceSuggestionFields
      replay={replay}
      inputErrors={inputErrors}
      categories={categories}
      attributes={attributes}
      values={values}
    />

    <Captcha action={actions.serviceSuggestion.editService} />

    <FormReplay />

    <InputHoneypotTrap name="message" />

    <InputSubmitButton label="Submit edit" />
  </form>
</BaseLayout>
