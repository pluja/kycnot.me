---
import { actions } from 'astro:actions'

import type { BreadcrumArray } from '../../components/BaseHead.astro'
import SwapFormAndResults from '../../components/swap/SwapFormAndResults.astro'
import SwapPageFooter from '../../components/swap/SwapPageFooter.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  buildBreadcrumbs,
  buildCanonical,
  buildDescription,
  buildFaqSchema,
  buildHeading,
  buildOgImageProps,
  buildOrganizationSchema,
  buildTitle,
  buildWebApplicationSchema,
  resolveSwapPair,
} from '../../lib/exchange/swapPageInfo'
import { setPublicPageCacheHeaders } from '../../lib/pageCacheHeaders'
import { bump } from '../../lib/stats'

const isHtmxRequest = Astro.request.headers.get('hx-request') === 'true'
if (!isHtmxRequest) {
  void bump({ kind: 'swap.view' }).catch(() => null)
}

const quoteResult = Astro.getActionResult(actions.swap.quote)
const quoteData = quoteResult && !quoteResult.error ? quoteResult.data : null

// Post-action renders are personalized (via the action-session cookie),
// so they must not be cached. Anonymous landings render the same HTML
// for everyone and can sit on the CDN.
setPublicPageCacheHeaders(Astro.response.headers, {
  isAuthenticated: Astro.locals.user !== null || quoteData !== null,
  hasErrors: Astro.locals.banners.errors.length > 0,
})

// After POST the URL has no from/to; fall back to the action input so
// the title and canonical match the pair the user submitted.
const seoSearchParams = quoteData
  ? new URLSearchParams({ from: quoteData.input.from, to: quoteData.input.to })
  : Astro.url.searchParams

const curatedPair = resolveSwapPair(seoSearchParams)
const canonical = buildCanonical(curatedPair)
const pageTitle = buildTitle(curatedPair)
const heading = buildHeading(curatedPair)
const description = buildDescription(curatedPair)
const ogImage = buildOgImageProps(curatedPair)
const breadcrumbs = buildBreadcrumbs(curatedPair) as BreadcrumArray

const params = Astro.url.searchParams
const noindex =
  params.has('sendAmount') ||
  params.has('receiveAmount') ||
  params.has('sortBy') ||
  params.has('approvedOnly')
const schemas = [
  buildOrganizationSchema(),
  buildWebApplicationSchema(canonical, description),
  buildFaqSchema(),
]
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  schemas={schemas}
  breadcrumbs={breadcrumbs}
  noindex={noindex}
  htmx
>
  <div class="mx-auto max-w-5xl px-2 pb-12 sm:px-4">
    <header class="flex flex-col items-center pt-6 pb-2 text-center sm:pt-8 sm:pb-3">
      <div class="flex items-center gap-2">
        <h1 id="swap-page-heading" class="font-title text-2xl font-bold tracking-tight text-white sm:text-3xl">
          {heading}
        </h1>
        <span
          class="rounded-full border border-green-500/40 bg-green-500/10 px-2 py-0.5 text-[10px] font-semibold tracking-[0.15em] text-green-300 uppercase"
        >
          Beta
        </span>
      </div>
      <p id="swap-page-description" class="mt-1 text-sm text-day-400">
        {description}
      </p>
    </header>

    <SwapFormAndResults quoteData={quoteData} />

    <SwapPageFooter />
  </div>
</BaseLayout>
