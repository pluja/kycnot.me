---
import { Icon } from 'astro-icon/components'

import MiniLayout from '../../layouts/MiniLayout.astro'
import { takeCounts } from '../../lib/feeds'
import { siteOrigin } from '../../lib/urls'

const user = Astro.locals.user

type Feed = {
  title: string
  description: string
  rss: `/blog/${string}` | `/feeds/${string}`
  icon: string
  replacementDescription: string | null
  variants?: { label: string; rss: `/feeds/${string}` }[]
}

const feeds: Feed[] = [
  {
    title: user ? 'Your notifications' : 'User notifications',
    description: `Last ${takeCounts.userNotifications.toLocaleString()} of your notifications`,
    rss: user ? `/feeds/user/${user.feedId}/notifications.xml` : '/feeds/user/[feedId]/notifications.xml',
    icon: 'ri:notification-line',
    replacementDescription: user
      ? null
      : "Replace [feedId] with the user feed ID, found in the user's notifications page",
  },
  {
    title: 'Service comments',
    description: `Last ${takeCounts.serviceComments.toLocaleString()} comments (and reviews) from a specific service`,
    rss: '/feeds/service/[slug]/comments.xml',
    icon: 'ri:chat-3-line',
    replacementDescription: 'Replace [slug] with the actual service slug',
  },
  {
    title: 'Service events',
    description: `Last ${takeCounts.serviceEvents.toLocaleString()} events from a specific service`,
    rss: '/feeds/service/[slug]/events.xml',
    icon: 'ri:calendar-event-line',
    replacementDescription: 'Replace [slug] with the actual service slug',
  },
  {
    title: 'All events',
    description: `Last ${takeCounts.allEvents.toLocaleString()} events and incidents from all listed services`,
    rss: '/feeds/events.xml',
    icon: 'ri:calendar-2-line',
    replacementDescription: null,
    variants: [
      { label: 'Security incidents only', rss: '/feeds/events.xml?view=incidents' },
      { label: 'Alerts, warnings & incidents', rss: '/feeds/events.xml?view=alerts' },
      { label: 'Everything, including auto-recorded changes', rss: '/feeds/events.xml?view=all' },
    ],
  },
  {
    title: 'Blog',
    description: 'Articles, guides, and updates about no-KYC services and privacy',
    rss: '/blog/rss.xml',
    icon: 'ri:article-line',
    replacementDescription: null,
  },
]
---

<MiniLayout
  pageTitle="RSS Feeds"
  description="Subscribe to RSS feeds to stay updated with the latest comments and events on KYCnot.me"
  ogImage={{
    template: 'generic',
    title: 'RSS Feeds',
    description: 'Subscribe to stay updated',
    icon: 'ri:rss-line',
  }}
  layoutHeader={{
    icon: 'ri:rss-line',
    title: 'RSS Feeds',
    subtitle: 'Copy the feed URL to your RSS reader',
  }}
  size="md"
>
  <div class="space-y-8">
    {
      feeds.map((feed) => (
        <div>
          <div class="flex flex-row items-center justify-center gap-2">
            <Icon name={feed.icon} class="inline-block size-6 shrink-0 text-white" />
            <h2 class="text-left text-lg/tight font-bold text-white">{feed.title}</h2>
          </div>

          <p class="mt-1 text-center text-sm text-balance text-day-300">{feed.description}</p>

          <div
            class="relative mt-2 rounded-lg border border-night-500 bg-night-600 px-4 py-2 font-mono break-all text-white"
            set:text={`${siteOrigin}${feed.rss}`}
          />
          {!!feed.replacementDescription && (
            <p class="mt-1 text-center text-xs text-day-500 italic">{feed.replacementDescription}</p>
          )}
          {feed.variants && (
            <div class="mt-3 space-y-2">
              {feed.variants.map((variant) => (
                <div>
                  <p class="text-center text-xs font-medium text-day-400">{variant.label}</p>
                  <div
                    class="relative mt-1 rounded-lg border border-night-500/60 bg-night-700 px-4 py-1.5 font-mono text-xs break-all text-day-200"
                    set:text={`${siteOrigin}${variant.rss}`}
                  />
                </div>
              ))}
            </div>
          )}
        </div>
      ))
    }
  </div>
</MiniLayout>
