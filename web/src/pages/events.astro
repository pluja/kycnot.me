---
import { z } from 'astro/zod'
import { Icon } from 'astro-icon/components'
import { orderBy } from 'lodash-es'

import BadgeSmall from '../components/BadgeSmall.astro'
import Button from '../components/Button.astro'
import EventCard from '../components/events/EventCard.astro'
import EventServiceLink from '../components/events/EventServiceLink.astro'
import MyPicture from '../components/MyPicture.astro'
import TimeFormatted from '../components/TimeFormatted.astro'
import { getIncidentSeverityInfo } from '../constants/incidentSeverities'
import { getVerificationStatusInfo } from '../constants/verificationStatus'
import BaseLayout from '../layouts/BaseLayout.astro'
import { cn } from '../lib/cn'
import { getEventDisplay } from '../lib/eventKind'
import { zodParseQueryParamsStoringErrors } from '../lib/parseUrlFilters'
import { prisma } from '../lib/prisma'
import { formatDateShort } from '../lib/timeAgo'
import { createPageUrl } from '../lib/urls'

import type { Prisma } from '@prisma/client'

const PAGE_SIZE = 100

const { data: params, hasDefaultData: hasDefaultFilters } = zodParseQueryParamsStoringErrors(
  {
    page: z.coerce.number().int().min(1).default(1),
    now: z.coerce.date().default(new Date()),
    from: z.preprocess((val) => (val === '' ? undefined : val), z.coerce.date().optional()),
    to: z.preprocess((val) => (val === '' ? undefined : val), z.coerce.date().optional()),
    /** Service's slug */
    service: z.string().optional(),
    view: z.enum(['curated', 'incidents', 'changes', 'all']).default('curated'),
  },
  Astro
)

// The timeline defaults to curated entries (events + incidents); the ~2k
// auto-recorded service changes are hidden unless explicitly requested.
const eventViews = [
  { value: 'curated', label: 'Events & incidents' },
  { value: 'incidents', label: 'Incidents' },
  { value: 'changes', label: 'Service changes' },
  { value: 'all', label: 'Everything' },
] as const

const classFilter: Prisma.EventWhereInput['class'] =
  params.view === 'incidents'
    ? 'INCIDENT'
    : params.view === 'changes'
      ? 'CHANGE'
      : params.view === 'all'
        ? undefined
        : { in: ['EVENT', 'INCIDENT'] }

const fieldClass =
  'w-full rounded-md border border-night-400 bg-night-900 px-3 py-2 text-sm text-day-100 transition-colors [color-scheme:dark] focus:border-green-500/60 focus:ring-1 focus:ring-green-500/30 focus:outline-none'

const [services, [dbEvents, totalEvents]] = await Astro.locals.banners.tryMany([
  [
    'Error fetching services',
    async () =>
      prisma.service.findMany({
        where: {
          serviceVisibility: { in: ['PUBLIC', 'ARCHIVED'] },
        },
        select: {
          id: true,
          slug: true,
          name: true,
          imageUrl: true,
          verificationStatus: true,
        },
        orderBy: {
          name: 'asc',
        },
      }),
    [],
  ],
  [
    'Error fetching events',
    async () =>
      prisma.event.findManyAndCount({
        where: {
          visible: true,
          createdAt: {
            lte: params.now,
          },
          service: {
            slug: params.service ?? undefined,
            serviceVisibility: {
              in: params.service ? ['PUBLIC', 'ARCHIVED', 'UNLISTED'] : ['PUBLIC', 'ARCHIVED'],
            },
          },
          class: classFilter,

          ...(params.from || params.to
            ? {
                OR: [
                  ...(params.from
                    ? ([
                        { endedAt: null },
                        { endedAt: { gte: params.from } },
                      ] satisfies Prisma.EventWhereInput[])
                    : []),
                  ...(params.to
                    ? ([{ startedAt: { lte: params.to } }] satisfies Prisma.EventWhereInput[])
                    : []),
                ],
              }
            : {}),
        },
        select: {
          id: true,
          title: true,
          content: true,
          source: true,
          type: true,
          class: true,
          sentiment: true,
          origin: true,
          incident: {
            select: {
              severity: true,
              state: true,
            },
          },
          startedAt: true,
          endedAt: true,
          service: {
            select: {
              id: true,
              slug: true,
              name: true,
              imageUrl: true,
              verificationStatus: true,
              serviceVisibility: true,
            },
          },
        },
        orderBy: [{ startedAt: 'desc' }, { id: 'desc' }],
        skip: (params.page - 1) * PAGE_SIZE,
        take: PAGE_SIZE,
      }),
    [[], 0] as const,
  ],
])

// Surface what is current before history: active incidents, then other ongoing
// situations, then the dated timeline of everything else.
const GROUP_ORDER = { incident: 0, ongoing: 1, past: 2 } as const

const groupMeta = {
  incident: { label: 'Active incidents', icon: 'ri:alarm-warning-line', class: 'text-red-400' },
  ongoing: { label: 'Ongoing events', icon: 'ri:flashlight-line', class: 'text-amber-400' },
  past: { label: 'Earlier', icon: 'ri:history-line', class: 'text-day-500' },
} satisfies Record<keyof typeof GROUP_ORDER, { label: string; icon: string; class: string }>

const events = orderBy(
  dbEvents.map((event) => {
    // Grouping and the card badge read the same predicate, so a row cannot sit
    // under "Ongoing" while its badge says resolved.
    const isOngoing = !getEventDisplay(event, params.now).isResolved
    const group: keyof typeof GROUP_ORDER =
      event.class === 'INCIDENT' && isOngoing ? 'incident' : isOngoing ? 'ongoing' : 'past'
    return {
      ...event,
      actualEndedAt: event.endedAt ?? params.now,
      isOngoing,
      group,
      display: getEventDisplay(event, params.now),
      severityInfo: event.incident ? getIncidentSeverityInfo(event.incident.severity) : null,
      service: event.service,
    }
  }),
  [(event) => GROUP_ORDER[event.group], 'actualEndedAt', 'startedAt'],
  ['asc', 'desc', 'desc']
)
const totalPages = Math.ceil(totalEvents / PAGE_SIZE) || 1
const hasMorePages = params.page < totalPages

const createUrlWithoutFilter = (paramName: keyof typeof params) => {
  const url = new URL(Astro.url)
  url.searchParams.delete(paramName)
  url.searchParams.forEach((value, key) => {
    if (value === '') {
      url.searchParams.delete(key)
    }
  })
  return url.pathname + url.search
}
---

<BaseLayout
  pageTitle="Events"
  description="Discover important events, updates, and news about KYC-free services in chronological order."
  widthClassName="max-w-5xl"
  classNames={{ main: 'sm:flex sm:items-start sm:gap-6' }}
  ogImage={{
    template: 'generic',
    title: 'Events',
    description: 'Discover important events, updates, and news about KYC-free services',
    icon: 'ri:calendar-event-line',
  }}
  htmx
>
  <p class="mb-6 block text-center font-title text-2xl font-bold text-white sm:hidden" aria-hidden="true">
    Service Events Timeline
  </p>
  <form
    method="GET"
    class={cn(
      'w-full rounded-xl border border-night-400 bg-night-800/40 p-4 sm:sticky sm:top-20 sm:w-64 sm:shrink-0',
      '[&:has(~[data-has-default-filters="true"])_[data-clear-filters-button]]:hidden'
    )}
    hx-get={Astro.url.pathname}
    hx-trigger="change, keyup[key=='Enter']"
    hx-target="#events-list-container"
    hx-select="#events-list-container"
    hx-swap="outerHTML"
    hx-push-url="true"
    hx-indicator="#search-indicator"
  >
    <div class="mb-4 flex items-center justify-between">
      <h2 class="flex items-center gap-1.5 text-sm font-semibold tracking-wider text-day-200 uppercase">
        <Icon name="ri:filter-3-line" class="size-4 text-green-500" />
        Filters
        <Icon
          id="search-indicator"
          name="ri:loader-2-line"
          class="hidden size-4 animate-spin text-green-500 htmx-request:inline-block"
        />
      </h2>

      <a
        href="/events"
        class="text-xs text-day-500 transition-colors hover:text-day-200 hover:underline"
        data-clear-filters-button
      >
        Clear all
      </a>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:grid-cols-1">
      <div>
        <label for="from" class="mb-1 block text-xs font-medium text-day-400">From</label>
        <input
          type="date"
          id="from"
          name="from"
          value={params.from?.toISOString().split('T')[0]}
          class={fieldClass}
        />
      </div>

      <div>
        <label for="to" class="mb-1 block text-xs font-medium text-day-400">To</label>
        <input
          type="date"
          id="to"
          name="to"
          value={params.to?.toISOString().split('T')[0]}
          class={fieldClass}
        />
      </div>
    </div>

    <label for="view" class="mt-3 mb-1 block text-xs font-medium text-day-400">Show</label>
    <div class="relative">
      <select id="view" name="view" class={cn(fieldClass, 'appearance-none pr-9')}>
        {
          eventViews.map((view) => (
            <option value={view.value} selected={params.view === view.value}>
              {view.label}
            </option>
          ))
        }
      </select>
      <Icon
        name="ri:arrow-down-s-line"
        class="pointer-events-none absolute top-1/2 right-2.5 size-4 -translate-y-1/2 text-day-500"
      />
    </div>

    <label for="service" class="mt-3 mb-1 block text-xs font-medium text-day-400">Service</label>
    <div class="relative">
      <select id="service" name="service" class={cn(fieldClass, 'appearance-none pr-9')}>
        <option value="">All Services</option>
        {
          services.map((service) => (
            <option value={service.slug} selected={params.service === service.slug}>
              {service.name}
            </option>
          ))
        }
      </select>
      <Icon
        name="ri:arrow-down-s-line"
        class="pointer-events-none absolute top-1/2 right-2.5 size-4 -translate-y-1/2 text-day-500"
      />
    </div>

    <Button type="submit" label="Apply" size="lg" class="mt-5 w-full sm:js:hidden" color="success" shadow />
  </form>

  <div class="flex-1" id="events-list-container" data-has-default-filters={hasDefaultFilters}>
    <h1 class="mb-3 hidden font-title text-2xl font-bold text-white sm:block">Service Events Timeline</h1>

    <!-- Active filters -->
    {
      !hasDefaultFilters && (
        <div class="mt-8 mb-6 flex flex-wrap justify-center gap-2 sm:mt-0 sm:justify-start">
          {params.from && (
            <a
              href={createUrlWithoutFilter('from')}
              class="group flex h-8 items-center gap-2 rounded-full border border-green-500/30 bg-black/40 px-3 text-sm text-white"
            >
              <span>
                From <TimeFormatted date={params.from} prefix={false} />
              </span>
              <div class="text-gray-400 group-hover:text-white">
                <Icon name="ri:close-large-line" class="size-4" />
              </div>
            </a>
          )}

          {params.to && (
            <a
              href={createUrlWithoutFilter('to')}
              class="group flex h-8 items-center gap-2 rounded-full border border-green-500/30 bg-black/40 px-3 text-sm text-white"
            >
              <span>
                To <TimeFormatted date={params.to} prefix={false} />
              </span>
              <div class="text-gray-400 group-hover:text-white">
                <Icon name="ri:close-large-line" class="size-4" />
              </div>
            </a>
          )}

          {params.service &&
            (() => {
              const service = services.find((s) => s.slug === params.service)
              const verificationStatusInfo = service
                ? getVerificationStatusInfo(service.verificationStatus)
                : null

              return (
                <a
                  href={createUrlWithoutFilter('service')}
                  class="group flex h-8 items-center gap-2 rounded-full border border-green-500/30 bg-black/40 px-3 text-sm text-white"
                >
                  {service?.imageUrl && (
                    <MyPicture
                      src={service.imageUrl}
                      alt={service.name}
                      width={16}
                      height={16}
                      class="size-4 shrink-0 rounded-xs object-contain"
                    />
                  )}
                  <span>
                    {service?.name ?? params.service}
                    {service && service.verificationStatus !== 'APPROVED' && verificationStatusInfo && (
                      <Icon
                        name={verificationStatusInfo.icon}
                        class={cn(
                          'inline-block size-3 shrink-0 align-[-0.1em]',
                          verificationStatusInfo.classNames.icon
                        )}
                      />
                    )}
                  </span>
                  <div class="text-gray-400 group-hover:text-white">
                    <Icon name="ri:close-large-line" class="size-4" />
                  </div>
                </a>
              )
            })()}

          {params.view !== 'curated' && (
            <a
              href={createUrlWithoutFilter('view')}
              class="group flex h-8 items-center gap-2 rounded-full border border-green-500/30 bg-black/40 px-3 text-sm text-white"
            >
              <Icon name="ri:filter-3-line" class="size-4" />
              <span>{eventViews.find((view) => view.value === params.view)?.label}</span>
              <div class="text-gray-400 group-hover:text-white">
                <Icon name="ri:close-large-line" class="size-4" />
              </div>
            </a>
          )}
        </div>
      )
    }

    {
      events.length > 0 ? (
        <ol id="events-list" class="mx-auto mt-12 space-y-2.5 sm:mt-0">
          {events.map((event, i) => {
            const showHeader = i === 0 || events[i - 1]?.group !== event.group
            const section = groupMeta[event.group]
            return (
              <>
                {showHeader && (
                  <li class="mt-7 mb-3 flex items-center gap-2 first:mt-0">
                    <Icon name={section.icon} class={cn('size-4 shrink-0', section.class)} />
                    <h2 class="text-xs font-semibold tracking-wider text-day-400 uppercase">
                      {section.label}
                    </h2>
                    <span class="h-px flex-1 bg-day-800" />
                  </li>
                )}
                <li
                  data-hx-event-item
                  {...(i === events.length - 1 && hasMorePages
                    ? {
                        'hx-get': createPageUrl(params.page + 1, Astro.url, {
                          ...Object.fromEntries(Astro.url.searchParams.entries()),
                          now: params.now.toISOString(),
                        }),
                        'hx-trigger': 'revealed',
                        'hx-swap': 'afterend',
                        'hx-select': '[data-hx-event-item]',
                        'hx-indicator': '#infinite-scroll-indicator',
                      }
                    : {})}
                >
                  <EventCard
                    event={event}
                    now={params.now}
                    titleHref={`/service/${event.service.slug}#event-${event.id.toString()}`}
                  >
                    <Fragment slot="meta">
                      <span class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
                        <EventServiceLink service={event.service} />

                        {event.severityInfo && (
                          <BadgeSmall
                            text={`${event.severityInfo.label} severity`}
                            icon={event.severityInfo.icon}
                            color={event.severityInfo.color}
                            variant="faded"
                          />
                        )}
                      </span>
                    </Fragment>
                  </EventCard>
                </li>
              </>
            )
          })}

          {!hasMorePages && (
            <li class="flex items-center gap-2 pt-3" data-hx-event-item>
              <span class="h-px flex-1 bg-day-800" aria-hidden="true" />
              <span class="text-xs text-day-500 italic">
                {params.from
                  ? formatDateShort(params.from, { prefix: false, caseType: 'sentence' })
                  : events.length > 10
                    ? 'Big Bang'
                    : 'End of timeline'}
              </span>
              <span class="h-px flex-1 bg-day-800" aria-hidden="true" />
            </li>
          )}

          <li class="hidden pt-3 htmx-request:block no-js:hidden" id="infinite-scroll-indicator">
            <p class="animate-pulse text-center text-xs text-day-500 italic">Loading more events...</p>
          </li>

          <li class="hidden pt-3 no-js:block">
            <p class="text-center text-xs text-day-500 italic">Enable JavaScript to load more events</p>
          </li>
        </ol>
      ) : (
        <p class="my-12 text-center text-day-400">No events reported</p>
      )
    }
  </div>
</BaseLayout>
