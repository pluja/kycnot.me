---
import { z } from 'astro/zod'
import { Icon } from 'astro-icon/components'
import { orderBy } from 'lodash-es'

import BadgeSmall from '../components/BadgeSmall.astro'
import EventCard from '../components/events/EventCard.astro'
import EventServiceLink from '../components/events/EventServiceLink.astro'
import FilterPill from '../components/FilterPill.astro'
import ServicePicker from '../components/ServicePicker.astro'
import { eventClassFilterFor, eventViews, eventViewsZodEnum } from '../constants/eventViews'
import { getIncidentSeverityInfo } from '../constants/incidentSeverities'
import BaseLayout from '../layouts/BaseLayout.astro'
import { cn } from '../lib/cn'
import { getEventDisplay, isEventOpen } from '../lib/eventKind'
import { zodParseQueryParamsStoringErrors } from '../lib/parseUrlFilters'
import { prisma } from '../lib/prisma'
import { formatDateShort } from '../lib/timeAgo'
import { createPageUrl, makeFilterUrl } from '../lib/urls'

import type { Prisma } from '@prisma/client'

const PAGE_SIZE = 100

const { data: params, hasDefaultData: hasDefaultFilters } = zodParseQueryParamsStoringErrors(
  {
    page: z.coerce.number().int().min(1).default(1),
    now: z.coerce.date().default(new Date()),
    from: z.preprocess((val) => (val === '' ? undefined : val), z.coerce.date().optional()),
    to: z.preprocess((val) => (val === '' ? undefined : val), z.coerce.date().optional()),
    /** Service's slug */
    service: z.string().optional(),
    view: eventViewsZodEnum.default('curated'),
  },
  Astro
)

const classFilter = eventClassFilterFor(params.view)

const eventViewIcons: Record<string, string> = {
  curated: 'ri:stack-line',
  events: 'ri:calendar-event-line',
  incidents: 'ri:alarm-warning-line',
  changes: 'ri:edit-line',
  all: 'ri:apps-line',
}

// now pins the clock for a single render, so it is this page's own equivalent of
// a position in the feed and does not belong in a filter link either.
const filterUrl = (changes: Record<string, string | undefined>) =>
  makeFilterUrl(Astro.url, { now: undefined, ...changes })

const [services, [dbEvents, totalEvents]] = await Astro.locals.banners.tryMany([
  [
    'Error fetching services',
    async () =>
      prisma.service.findMany({
        where: {
          serviceVisibility: { in: ['PUBLIC', 'ARCHIVED'] },
        },
        select: {
          id: true,
          slug: true,
          name: true,
          imageUrl: true,
          verificationStatus: true,
          _count: { select: { events: true } },
        },
        orderBy: {
          name: 'asc',
        },
      }),
    [],
  ],
  [
    'Error fetching events',
    async () =>
      prisma.event.findManyAndCount({
        where: {
          visible: true,
          deletedAt: null,
          createdAt: {
            lte: params.now,
          },
          service: {
            // A slug when it came from a link, or a name when the reader typed
            // one into the picker, which is all a datalist can hand back.
            ...(params.service
              ? {
                  OR: [
                    { slug: params.service },
                    { name: { equals: params.service, mode: 'insensitive' as const } },
                  ],
                }
              : {}),
            serviceVisibility: {
              in: params.service ? ['PUBLIC', 'ARCHIVED', 'UNLISTED'] : ['PUBLIC', 'ARCHIVED'],
            },
          },
          class: classFilter,

          ...(params.from || params.to
            ? {
                OR: [
                  ...(params.from
                    ? ([
                        { endedAt: null },
                        { endedAt: { gte: params.from } },
                      ] satisfies Prisma.EventWhereInput[])
                    : []),
                  ...(params.to
                    ? ([{ startedAt: { lte: params.to } }] satisfies Prisma.EventWhereInput[])
                    : []),
                ],
              }
            : {}),
        },
        select: {
          id: true,
          title: true,
          content: true,
          source: true,
          type: true,
          class: true,
          sentiment: true,
          origin: true,
          incident: {
            select: {
              severity: true,
              state: true,
            },
          },
          startedAt: true,
          endedAt: true,
          service: {
            select: {
              id: true,
              slug: true,
              name: true,
              imageUrl: true,
              verificationStatus: true,
              serviceVisibility: true,
            },
          },
        },
        orderBy: [{ startedAt: 'desc' }, { id: 'desc' }],
        skip: (params.page - 1) * PAGE_SIZE,
        take: PAGE_SIZE,
      }),
    [[], 0] as const,
  ],
])

// Surface what is current before history: active incidents, then other ongoing
// situations, then the dated timeline of everything else.
const GROUP_ORDER = { incident: 0, ongoing: 1, past: 2 } as const

const groupMeta = {
  incident: { label: 'Active incidents', icon: 'ri:alarm-warning-line', class: 'text-red-400' },
  ongoing: { label: 'Ongoing events', icon: 'ri:flashlight-line', class: 'text-amber-400' },
  past: { label: 'Earlier', icon: 'ri:history-line', class: 'text-day-500' },
} satisfies Record<keyof typeof GROUP_ORDER, { label: string; icon: string; class: string }>

// Most eventful first, so the picker opens on the services worth reading about.
const servicesByActivity = [...services].sort((a, b) => b._count.events - a._count.events)

const events = orderBy(
  dbEvents.map((event) => {
    const isOngoing = isEventOpen(event, params.now)
    const group: keyof typeof GROUP_ORDER =
      event.class === 'INCIDENT' && isOngoing ? 'incident' : isOngoing ? 'ongoing' : 'past'
    return {
      ...event,
      actualEndedAt: event.endedAt ?? params.now,
      isOngoing,
      group,
      display: getEventDisplay(event, params.now),
      severityInfo: event.incident ? getIncidentSeverityInfo(event.incident.severity) : null,
      service: event.service,
    }
  }),
  [(event) => GROUP_ORDER[event.group], 'actualEndedAt', 'startedAt'],
  ['asc', 'desc', 'desc']
)
const totalPages = Math.ceil(totalEvents / PAGE_SIZE) || 1
const hasMorePages = params.page < totalPages
---

<BaseLayout
  pageTitle="Events"
  description="Discover important events, updates, and news about KYC-free services in chronological order."
  widthClassName="max-w-5xl"
  classNames={{ main: 'sm:flex sm:items-start sm:gap-6' }}
  ogImage={{
    template: 'generic',
    title: 'Events',
    description: 'Discover important events, updates, and news about KYC-free services',
    icon: 'ri:calendar-event-line',
  }}
  htmx
>
  <div>
    <h1 class="font-title text-2xl font-bold text-white sm:text-3xl">Events on KYCnot.me</h1>
    <p class="mt-1 mb-4 text-sm text-day-400">
      What has happened to KYC-free services, newest first.
      {totalEvents > 0 && ` ${totalEvents.toLocaleString()} events.`}
    </p>

    <div class="-mx-1 mb-2 flex items-center gap-1 overflow-x-auto px-1 pb-1">
      {
        eventViews.map((view) => (
          <FilterPill
            href={filterUrl({ view: view.value === 'curated' ? undefined : view.value })}
            label={view.label}
            icon={eventViewIcons[view.value]}
            active={params.view === view.value}
          />
        ))
      }
    </div>

    <div class="mb-5 flex flex-wrap items-center gap-2">
      <ServicePicker
        services={services}
        suggested={servicesByActivity}
        selected={params.service}
        keep={{
          view: params.view === 'curated' ? undefined : params.view,
          from: params.from?.toISOString().slice(0, 10),
          to: params.to?.toISOString().slice(0, 10),
        }}
        clearHref={filterUrl({ service: undefined })}
      />

      <form method="GET" class="flex flex-wrap items-center gap-1">
        {params.view !== 'curated' && <input type="hidden" name="view" value={params.view} />}
        {params.service && <input type="hidden" name="service" value={params.service} />}
        <label class="sr-only" for="from">From</label>
        <input
          id="from"
          type="date"
          name="from"
          value={params.from?.toISOString().slice(0, 10)}
          class="rounded-md border border-night-400 bg-night-900 px-2 py-1 text-sm text-day-100 [color-scheme:dark]"
        />
        <label class="sr-only" for="to">To</label>
        <input
          id="to"
          type="date"
          name="to"
          value={params.to?.toISOString().slice(0, 10)}
          class="rounded-md border border-night-400 bg-night-900 px-2 py-1 text-sm text-day-100 [color-scheme:dark]"
        />
        <button
          type="submit"
          class="rounded-md border border-night-400 px-2 py-1 text-sm text-day-200 hover:bg-night-700"
        >
          Apply dates
        </button>
      </form>

      {
        !hasDefaultFilters && (
          <a href="/events" class="text-sm text-day-500 hover:text-day-200 hover:underline">
            Clear all
          </a>
        )
      }
    </div>

    {
      events.length > 0 ? (
        <ol id="events-list" class="mx-auto mt-12 space-y-2.5 sm:mt-0">
          {events.map((event, i) => {
            const showHeader = i === 0 || events[i - 1]?.group !== event.group
            const section = groupMeta[event.group]
            return (
              <>
                {showHeader && (
                  <li class="mt-7 mb-3 flex items-center gap-2 first:mt-0">
                    <Icon name={section.icon} class={cn('size-4 shrink-0', section.class)} />
                    <h2 class="text-xs font-semibold tracking-wider text-day-400 uppercase">
                      {section.label}
                    </h2>
                    <span class="h-px flex-1 bg-day-800" />
                  </li>
                )}
                <li
                  data-hx-event-item
                  {...(i === events.length - 1 && hasMorePages
                    ? {
                        'hx-get': createPageUrl(params.page + 1, Astro.url, {
                          ...Object.fromEntries(Astro.url.searchParams.entries()),
                          now: params.now.toISOString(),
                        }),
                        'hx-trigger': 'revealed',
                        'hx-swap': 'afterend',
                        'hx-select': '[data-hx-event-item]',
                        'hx-indicator': '#infinite-scroll-indicator',
                      }
                    : {})}
                >
                  <EventCard
                    event={event}
                    now={params.now}
                    titleHref={
                      event.class === 'CHANGE'
                        ? `/service/${event.service.slug}#events`
                        : `/service/${event.service.slug}#event-${event.id.toString()}`
                    }
                  >
                    <Fragment slot="meta">
                      <span class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
                        <EventServiceLink service={event.service} />

                        {event.severityInfo && (
                          <BadgeSmall
                            text={`${event.severityInfo.label} severity`}
                            icon={event.severityInfo.icon}
                            color={event.severityInfo.color}
                            variant="faded"
                          />
                        )}
                      </span>
                    </Fragment>
                  </EventCard>
                </li>
              </>
            )
          })}

          {!hasMorePages && (
            <li class="flex items-center gap-2 pt-3" data-hx-event-item>
              <span class="h-px flex-1 bg-day-800" aria-hidden="true" />
              <span class="text-xs text-day-500 italic">
                {params.from
                  ? formatDateShort(params.from, { prefix: false, caseType: 'sentence' })
                  : events.length > 10
                    ? 'Big Bang'
                    : 'End of timeline'}
              </span>
              <span class="h-px flex-1 bg-day-800" aria-hidden="true" />
            </li>
          )}

          {hasMorePages && (
            <>
              <li class="hidden pt-3 htmx-request:block no-js:hidden" id="infinite-scroll-indicator">
                <p class="animate-pulse text-center text-xs text-day-500 italic">Loading more events...</p>
              </li>

              <li class="hidden pt-3 no-js:block">
                <p class="text-center text-xs text-day-500 italic">Enable JavaScript to load more events</p>
              </li>
            </>
          )}
        </ol>
      ) : (
        <p class="my-12 text-center text-day-400">No events reported</p>
      )
    }
  </div>
</BaseLayout>
