---
import { VerificationStepStatus } from '@prisma/client'
import { Icon } from 'astro-icon/components'
import { Schema } from 'astro-seo-schema'
import { actions } from 'astro:actions'
import { formatDistanceToNowStrict } from 'date-fns'
import { orderBy, pick } from 'lodash-es'

import AdminOnly from '../../components/AdminOnly.astro'
import AttributeCard from '../../components/AttributeCard.astro'
import BadgeStandard from '../../components/BadgeStandard.astro'
import Button from '../../components/Button.astro'
import CommentSection from '../../components/CommentSection.astro'
import CommentSummary from '../../components/CommentSummary.astro'
import DropdownButton from '../../components/DropdownButton.astro'
import DropdownButtonItemForm from '../../components/DropdownButtonItemForm.astro'
import DropdownButtonItemLink from '../../components/DropdownButtonItemLink.astro'
import InputSubmitButton from '../../components/InputSubmitButton.astro'
import InputTextArea from '../../components/InputTextArea.astro'
import Markdown from '../../components/Markdown.astro'
import MyPicture from '../../components/MyPicture.astro'
import RatingBadge from '../../components/RatingBadge.astro'
import ScoreGauge from '../../components/ScoreGauge.astro'
import SectionHeading from '../../components/SectionHeading.astro'
import ScoreSquare from '../../components/ScoreSquare.astro'
import AcceptedCurrencies from '../../components/service/AcceptedCurrencies.astro'
import ServiceAnswerPanel from '../../components/service/ServiceAnswerPanel.astro'
import ServiceRiskAlert from '../../components/service/ServiceRiskAlert.astro'
import ServiceTimeline from '../../components/service/ServiceTimeline.astro'
import TosReviewSection from '../../components/service/TosReviewSection.astro'
import TosSummaryCard from '../../components/service/TosSummaryCard.astro'
import ServiceLinkButton from '../../components/ServiceLinkButton.astro'
import SwapCTA from '../../components/swap/SwapCTA.astro'
import TimeFormatted from '../../components/TimeFormatted.astro'
import Tooltip from '../../components/Tooltip.astro'
import UserBadge from '../../components/UserBadge.astro'
import { getAttributeCategoryInfo } from '../../constants/attributeCategories'
import { baseScoreType, getAttributeTypeInfo } from '../../constants/attributeTypes'
import { formatContactMethod } from '../../constants/contactMethods'
import { getCountryInfo } from '../../constants/countries'
import { currencies, getCurrencyInfo } from '../../constants/currencies'
import { getKycLevelInfo } from '../../constants/kycLevels'
import { getServiceVisibilityInfo } from '../../constants/serviceVisibility'
import { getUserSentimentInfo } from '../../constants/userSentiment'
import { getVerificationStatusInfo } from '../../constants/verificationStatus'
import { getVerificationStepStatusInfo } from '../../constants/verificationStepStatus'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { someButNotAll, undefinedIfEmpty } from '../../lib/arrays'
import { makeNonDbAttributes, sortAttributes } from '../../lib/attributes'
import { cn } from '../../lib/cn'
import { eventToDisplayKind, getEventDisplay, isEventOpen, pickPrimaryEvent } from '../../lib/eventKind'
import { getSupportedProviderSlugs } from '../../lib/exchange/supportedProviders'
import { computeIncidentTrustPenalty, totalIncidentTrustPenalty } from '../../lib/incidentPenalty'
import { getOrCreateNotificationPreferences } from '../../lib/notificationPreferences'
import { formatNumber } from '../../lib/numbers'
import { makeOgImageUrl } from '../../lib/ogImageUrl'
import { setPublicPageCacheHeaders } from '../../lib/pageCacheHeaders'
import { fitPageTitle } from '../../lib/pageTitle'
import { pluralize } from '../../lib/pluralize'
import { prisma } from '../../lib/prisma'
import { makeLoginUrl } from '../../lib/redirectUrls'
import { KYCNOTME_SCHEMA_MINI } from '../../lib/schema'
import {
  checkAnchor,
  hasBeenReviewed,
  makeKycAnswer,
  makeSafetyAnswer,
  makeQuestions,
  pickCaveats,
} from '../../lib/serviceAnswers'
import { isEmbeddableBadgeStatus } from '../../lib/serviceBadges'
import { serviceDetailSelect } from '../../lib/serviceDetail'
import { makeServiceFaq } from '../../lib/serviceFaq'
import { getServiceVerificationOverview } from '../../lib/serviceVerification'
import { transformCase } from '../../lib/strings'
import { formatDateShort } from '../../lib/timeAgo'
import { absoluteSiteUrl, siteOrigin, urlDomain, urlWithParams } from '../../lib/urls'

import type { BreadcrumArray } from '../../components/BaseHead.astro'
import type { TailwindColor } from '../../lib/colors'
import type { OgImagePublicTemplateWithProps } from '../../lib/ogImageProps'
import type { Prisma, ServiceVisibility } from '@prisma/client'
import type { ContactPoint, FAQPage, ListItem, Organization, Review, WebPage, WithContext } from 'schema-dts'

const { slug } = Astro.params

const user = Astro.locals.user

const result = Astro.getActionResult(actions.service.requestVerification)

const now = new Date()

const canSeeHidden = Astro.locals.userCan('services:edit')
const visibleStatuses: ServiceVisibility[] = canSeeHidden
  ? ['PUBLIC', 'UNLISTED', 'ARCHIVED', 'HIDDEN']
  : ['PUBLIC', 'UNLISTED', 'ARCHIVED']

const [service, dbNotificationPreferences] = await Astro.locals.banners.tryMany([
  [
    'Error fetching service',
    async () =>
      prisma.service.findUnique({
        where: {
          slug,
          serviceVisibility: { in: visibleStatuses },
        },
        select: serviceDetailSelect(user?.id ?? -1),
      }),
    null,
  ],
  [
    'Error while fetching notification preferences',
    () =>
      user
        ? getOrCreateNotificationPreferences(user.id, {
            id: true,
            onRootCommentCreatedForServices: {
              where: { slug },
              select: { id: true },
            },
            onEventCreatedForServices: {
              where: { slug },
              select: { id: true },
            },
            onVerificationChangeForServices: {
              where: { slug },
              select: { id: true },
            },
          })
        : null,
    null,
  ],
])

if (!service) {
  try {
    const serviceWithOldSlug = await prisma.service.findFirst({
      where: {
        previousSlugs: { has: slug },
        serviceVisibility: { in: visibleStatuses },
      },
      select: { slug: true },
    })
    if (serviceWithOldSlug) {
      return Astro.redirect(`/service/${serviceWithOldSlug.slug}`, 301)
    }
  } catch (error) {
    console.error(error)
  }

  return Astro.rewrite('/404')
}

if (!visibleStatuses.includes(service.serviceVisibility)) {
  return Astro.rewrite('/404')
}

// Set after the 404/redirect returns above so only a real service page is
// cached. Signed-in visitors get `no-store`, which is also what keeps a
// HIDDEN service (visible only via `services:edit`) out of a shared cache.
setPublicPageCacheHeaders(Astro.response.headers, {
  isAuthenticated: user !== null,
  hasErrors: Astro.locals.banners.errors.length > 0,
})

const makeWatchingDetails = (
  dbNotificationPreferences: Prisma.NotificationPreferencesGetPayload<{
    select: {
      onRootCommentCreatedForServices: {
        select: { id: true }
      }
      onEventCreatedForServices: {
        select: { id: true }
      }
      onVerificationChangeForServices: {
        select: { id: true }
      }
    }
  }> | null,
  serviceId: number | undefined
) => {
  if (!dbNotificationPreferences || !serviceId) return null

  const comments = dbNotificationPreferences.onRootCommentCreatedForServices.some(
    ({ id }) => id === serviceId
  )
  const events = dbNotificationPreferences.onEventCreatedForServices.some(({ id }) => id === serviceId)
  const verification = dbNotificationPreferences.onVerificationChangeForServices.some(
    ({ id }) => id === serviceId
  )
  const all = comments && events && verification

  return {
    comments,
    events,
    verification,
    all: all ? true : someButNotAll(comments, events, verification) ? null : false,
  } as const
}

const watchingDetails = makeWatchingDetails(dbNotificationPreferences, service.id)

// Clearnet first, then the private networks, each in the order the listing has them.
const serviceLinks = [...service.serviceUrls, ...service.onionUrls, ...service.i2pUrls]

const kycLevelInfo = getKycLevelInfo(`${service.kycLevel}`)

const userSentiment = service.userSentiment
  ? (() => {
      return {
        ...service.userSentiment,
        whatUsersLike: Array.isArray(service.userSentiment.whatUsersLike)
          ? service.userSentiment.whatUsersLike
          : [],
        whatUsersDislike: Array.isArray(service.userSentiment.whatUsersDislike)
          ? service.userSentiment.whatUsersDislike
          : [],
        info: getUserSentimentInfo(service.userSentiment.sentiment),
      }
    })()
  : null

const attributes = sortAttributes([
  ...makeNonDbAttributes(service, { filter: true }),
  ...service.attributes.map(({ attribute, note }) => ({
    ...attribute,
    note,
    links:
      attribute.type === 'GOOD' || attribute.type === 'INFO'
        ? [
            {
              url: `/?attr-${attribute.id}=yes`,
              label: 'Search with this',
              icon: 'ri:search-line',
            },
          ]
        : [
            {
              url: `/?attr-${attribute.id}=yes`,
              label: 'With this',
              icon: 'ri:search-line',
            },
            {
              url: `/?attr-${attribute.id}=no`,
              label: 'Without this',
              icon: 'ri:search-line',
            },
          ],
  })),
]).map((attribute) => {
  return {
    ...attribute,
    categoryInfo: getAttributeCategoryInfo(attribute.category),
    typeInfo: getAttributeTypeInfo(attribute.type),
  }
})

const formatPoints = (value: number) =>
  formatNumber(value, { roundDigits: 2, showSign: true, removeTrailingZeros: true })

// The ledger groups by what a fact does to the score, not by its type badge:
// a reader adding things up wants to see what pulled the number down.
const pointsOf = (attribute: { privacyPoints: number; trustPoints: number }) =>
  attribute.privacyPoints + attribute.trustPoints
const subtotalOf = (rows: { privacyPoints: number; trustPoints: number }[]) => [
  { label: 'privacy', value: rows.reduce((sum, row) => sum + row.privacyPoints, 0) },
  { label: 'trust', value: rows.reduce((sum, row) => sum + row.trustPoints, 0) },
]

const isFlaggedScam = service.verificationStatus === 'VERIFICATION_FAILED'

const statusInfo = getVerificationStatusInfo(service.verificationStatus)

const hasRequestedVerification =
  !!user && service.verificationRequests.some((request) => request.userId === user.id)
const canEmbedServiceBadge =
  isEmbeddableBadgeStatus(service.verificationStatus) &&
  !!user &&
  (user.admin || service.affiliatedUsers.length > 0)

const VerificationRequestElement = user ? 'button' : 'a'

const pageUrl = absoluteSiteUrl(`/service/${service.slug}`)
const webPageId = `${pageUrl}#webpage`
const itemReviewedId = `${pageUrl}#service`

const primaryCategoryName = service.categories[0]?.name
const kycTitlePhrase = kycLevelInfo.value === 0 ? 'No-KYC' : `KYC Level ${kycLevelInfo.value}`
const categoryTitlePhrase = primaryCategoryName ? ` ${primaryCategoryName}` : ''
// Ordered most to least descriptive. The `${kycTitlePhrase}`-only rung matters
// for long service names: without it the ladder jumps straight to a bare
// "<name> Review" and drops every keyword.
const pageTitle = fitPageTitle([
  `${service.name} Review: ${kycTitlePhrase}${categoryTitlePhrase} & Privacy Score`,
  `${service.name} Review: ${kycTitlePhrase}${categoryTitlePhrase}`,
  `${service.name} Review: ${kycTitlePhrase}`,
  `${service.name} Review`,
])
const sentenceListFormatter = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' })
const formatRating = (rating: number) => {
  const rounded = Math.round(rating * 10) / 10
  return Number.isInteger(rounded) ? rounded.toLocaleString() : rounded.toFixed(1)
}
const formatLimitedList = (values: string[], maxVisible = 4) => {
  if (values.length <= maxVisible) return sentenceListFormatter.format(values)
  const hiddenCount = values.length - maxVisible
  return sentenceListFormatter.format([
    ...values.slice(0, maxVisible),
    `${hiddenCount.toLocaleString()} more`,
  ])
}
const getArticle = (text: string) => (/^[aeiou]/i.test(text) ? 'an' : 'a')
const getKycPolicySummary = (kycLevel: number) => {
  switch (kycLevel) {
    case 0:
      return 'has a guaranteed no-KYC policy'
    case 1:
      return 'has no mention of KYC policies'
    case 2:
      return 'may request KYC in rare cases'
    case 3:
      return 'may request KYC during risk checks'
    case 4:
      return 'requires KYC'
    default:
      return `has KYC Level ${kycLevel}`
  }
}

// Acronym category names (VPN, VPS, SMS, DEX) must survive the lowercasing
// that makes the rest read as prose.
const asProseCategory = (name: string) => (name === name.toUpperCase() ? name : name.toLowerCase())
const categorySummary = service.categories.length
  ? `${sentenceListFormatter.format(service.categories.map((category) => asProseCategory(category.name)))} service`
  : 'service'
const acceptedCurrencyNames = service.acceptedCurrencies.map((currency) => getCurrencyInfo(currency).name)
// A flagged service leads with the verdict. The neutral facts below otherwise
// read as a feature list, and this string is also the meta description, so a
// scam would advertise its own no-KYC policy in search results.
const serviceFactsSummary = [
  isFlaggedScam ? `${service.name} is flagged as a scam on KYCnot.me. ${statusInfo.headline}.` : null,
  `${service.name} is ${getArticle(categorySummary)} ${categorySummary}${acceptedCurrencyNames.length > 0 ? ` that accepts ${formatLimitedList(acceptedCurrencyNames)}` : ''}.`,
  isFlaggedScam
    ? `It has a score of ${formatRating(service.overallScore)}/10.`
    : `It ${getKycPolicySummary(kycLevelInfo.value)} and has a score of ${formatRating(service.overallScore)}/10.`,
  service.userRatingCount > 0 &&
    service.averageUserRating !== null &&
    `There ${service.userRatingCount === 1 ? 'is' : 'are'} ${service.userRatingCount.toLocaleString()} user ${pluralize('rating', service.userRatingCount)} averaging ${formatRating(service.averageUserRating)}/5.`,
]
  .filter((sentence): sentence is string => !!sentence)
  .join(' ')
const serviceSummary = transformCase(serviceFactsSummary, 'first-upper')

// The shorter fallbacks stay scam-led too: the meta description is what search
// results show, so a flagged service must never fall back to a neutral blurb.
const scamDescription = `${service.name} is flagged as a scam on KYCnot.me. ${statusInfo.headline}.`
const pageDescription = isFlaggedScam
  ? ([serviceSummary, `${scamDescription} See the scores, review history, and user reports.`].find(
      (description) => description.length <= 200
    ) ?? scamDescription)
  : ([
      serviceSummary,
      `${service.name} review: ${kycTitlePhrase}${categoryTitlePhrase}, KYC policy notes, ${Math.round(service.privacyScore).toLocaleString()}% privacy score, ${Math.round(service.trustScore).toLocaleString()}% trust score, supported currencies, and user feedback.`,
      `${service.name} review: ${kycTitlePhrase}${categoryTitlePhrase}, KYC policy notes, privacy score, trust score, supported currencies, and user feedback.`,
      `Review ${service.name} on KYCnot.me. Check KYC policy notes, privacy score, trust score, supported currencies, and user feedback.`,
    ].find((description) => description.length <= 200) ??
    `Review ${service.name} on KYCnot.me. Check KYC policy, privacy score, trust score, supported currencies, and user feedback.`)

const ogImageTemplateData = {
  template: 'service',
  title: service.name,
  description: service.description,
  categories: service.categories.map((category) => pick(category, ['name', 'icon'])),
  score: service.overallScore,
  imageUrl: service.imageUrl,
  verificationStatus: service.verificationStatus,
} satisfies OgImagePublicTemplateWithProps

const serviceVisibilityInfo = getServiceVisibilityInfo(service.serviceVisibility)

const activeAlertOrWarningEvents = service.events
  .map((event) => ({ ...event, display: getEventDisplay(event, now) }))
  .filter((event) => event.display.showBanner && (event.endedAt === null || event.endedAt >= now))
const activeEventToShow = pickPrimaryEvent(activeAlertOrWarningEvents, now)
const otherActiveEvents = activeAlertOrWarningEvents.filter((event) => event.id !== activeEventToShow?.id)
const moreActiveIncidents = otherActiveEvents.filter((event) => event.incident).length
const moreActiveWarnings = otherActiveEvents.length - moreActiveIncidents

// Incidents (trust-affecting) are shown in their own section and pulled out of
// the general events timeline below. Their current trust penalty mirrors the
// value baked into trustScore by 02_service_score.sql.
const incidents = service.events
  .flatMap((event) =>
    event.class === 'INCIDENT' && event.incident ? [{ ...event, incident: event.incident }] : []
  )
  .sort((a, b) => b.incident.occurredAt.getTime() - a.incident.occurredAt.getTime())

const incidentTrustPenalty = totalIncidentTrustPenalty(
  incidents.map((entry) => entry.incident),
  now
)

// Incidents whose penalty has decayed to zero no longer feed the verdict or the ledger.
const incidentsByImpact = incidents.map((entry) => ({
  ...entry,
  faded: computeIncidentTrustPenalty(entry.incident, now).points === 0,
}))
const activeIncidents = incidentsByImpact.filter((entry) => !entry.faded)

// The incident penalty is not an attribute row in the database, but it reads
// as one in the ledger: same card, same columns, linking to the incidents.
const incidentPenaltyAttribute = {
  slug: 'active-incidents',
  title: 'Active incidents',
  description:
    'Open incidents, and resolved ones still inside their decay window, cost trust until they fade.',
  privacyPoints: 0,
  trustPoints: incidentTrustPenalty,
  typeInfo: getAttributeTypeInfo('BAD'),
  links: [{ url: '#incidents', label: 'See the incidents', icon: 'ri:alarm-warning-line' }],
}

const baseScoreAttribute = {
  slug: baseScoreType.slug,
  title: baseScoreType.label,
  description: 'Every service starts at 50 privacy and 50 trust before its attributes are added.',
  privacyPoints: 50,
  trustPoints: 50,
  typeInfo: baseScoreType,
  links: [],
}

const hurtingRows = attributes.filter((attribute) => pointsOf(attribute) < 0)
const helpingRows = attributes.filter((attribute) => pointsOf(attribute) > 0)
const neutralRows = attributes.filter((attribute) => pointsOf(attribute) === 0)
const ledgerGroupCandidates = [
  {
    title: 'Negative',
    rows: hurtingRows,
    showIncidentPenalty: incidentTrustPenalty < 0,
    showBaseScore: false,
    subtotal: subtotalOf([...hurtingRows, { privacyPoints: 0, trustPoints: incidentTrustPenalty }]),
  },
  {
    title: 'Positive',
    rows: helpingRows,
    showIncidentPenalty: false,
    showBaseScore: false,
    subtotal: subtotalOf(helpingRows),
  },
  { title: 'Neutral', rows: neutralRows, showIncidentPenalty: false, showBaseScore: false, subtotal: [] },
]
const ledgerGroups = (
  ledgerGroupCandidates.filter((group) => group.rows.length > 0 || group.showIncidentPenalty).length > 0
    ? ledgerGroupCandidates.filter((group) => group.rows.length > 0 || group.showIncidentPenalty)
    : // A listing with no attributes at all still gets the base score, under Neutral.
      ledgerGroupCandidates.filter((group) => group.title === 'Neutral')
)
  // The base score closes the ledger under whatever group comes last. It is
  // the starting point, so it stays out of every subtotal.
  .map((group, index, groups) => ({ ...group, showBaseScore: index === groups.length - 1 }))

// Sort verification steps: failed first, then warnings, then others, newest first within each group
const getVerificationStepPriority = (status: VerificationStepStatus) => {
  switch (status) {
    case VerificationStepStatus.FAILED:
      return 0 // Highest priority
    case VerificationStepStatus.WARNING:
      return 1
    case VerificationStepStatus.IN_PROGRESS:
      return 2
    case VerificationStepStatus.PENDING:
      return 3
    case VerificationStepStatus.PASSED:
      return 4 // Lowest priority
    default:
      return 5
  }
}

// Timeline dots. Tailwind cannot build class names from data, so the status
// colours are spelled out once here.
const stepDotClass = {
  green: 'bg-green-400',
  red: 'bg-red-400',
  yellow: 'bg-yellow-400',
  blue: 'bg-blue-400',
  gray: 'bg-gray-400',
} satisfies Partial<Record<NonNullable<TailwindColor>, string>>

const sortedVerificationSteps = orderBy(
  service.verificationSteps,
  [(step) => getVerificationStepPriority(step.status), (step) => step.updatedAt],
  ['asc', 'desc'] // Priority ascending (failed first), date descending (newest first)
)

// `showBanner` is the moderator's call on whether a failed or warned check
// belongs in the verdict; the rest stay in the timeline only.
const flaggedChecks = sortedVerificationSteps
  .filter((step) => step.showBanner && (step.status === 'FAILED' || step.status === 'WARNING'))
  .map((step) => ({ title: step.title, href: `#${checkAnchor(step.id)}`, failed: step.status === 'FAILED' }))

const exchangeSlugs = ['exchange', 'cex', 'dex']
const isExchange = service.categories.some((c) => exchangeSlugs.includes(c.slug))

// Show swap CTA / compare section only when the aggregator can actually quote
// this provider. List is cached for 30 minutes server-side. In dev the aggregator
// is usually unreachable (empty set), so fall back to showing it for any exchange.
const supportedProviderSlugs = isExchange ? await getSupportedProviderSlugs() : null
const isSwapSupported =
  !!supportedProviderSlugs &&
  (supportedProviderSlugs.has(service.slug) || (import.meta.env.DEV && supportedProviderSlugs.size === 0))

const verificationOverview = getServiceVerificationOverview(service)

const needsAlternative =
  isFlaggedScam ||
  activeIncidents.some(
    (entry) =>
      entry.incident.state === 'ONGOING' &&
      (entry.incident.severity === 'HIGH' || entry.incident.severity === 'CRITICAL')
  )

// The two questions a visitor actually arrives with. Kept apart because
// `overallScore` averages privacy and trust, which hides the case that matters
// most: a service can refuse to ask for ID and still be sitting on your money.
const caveats = pickCaveats(attributes)
const kycAnswer = makeKycAnswer(service.kycLevel, caveats.kyc, service.kycPolicyMd, isFlaggedScam)
const openWarnings = service.events.filter((event) => {
  if (event.class !== 'EVENT' || !isEventOpen(event, now)) return false
  const kind = eventToDisplayKind(event)
  return kind === 'WARNING' || kind === 'ALERT'
})
const safetyAnswer = makeSafetyAnswer({
  verificationStatus: service.verificationStatus,
  incidents: activeIncidents.map((entry) => ({
    id: entry.id,
    title: entry.title,
    ...pick(entry.incident, ['severity', 'state', 'occurredAt', 'resolvedAt']),
  })),
  warnings: openWarnings.map((event) => ({ id: event.id, title: event.title, startedAt: event.startedAt })),
  hasBeenReviewed: hasBeenReviewed(service.verificationStatus),
  caveats: caveats.trust,
  checks: flaggedChecks,
  recentlyApprovedAt: service.isRecentlyApproved ? service.approvedAt : null,
})
const questions = makeQuestions(service.name, service.categories)
const serviceFaq = makeServiceFaq({
  name: service.name,
  description: service.description,
  summary: serviceSummary,
  questions,
  kyc: kycAnswer,
  safety: safetyAnswer,
  isFlaggedScam,
  statusLabel: statusInfo.label,
  statusDescription: statusInfo.description,
  currencyNames: acceptedCurrencyNames,
  onionHosts: service.onionUrls.map(urlDomain),
  i2pHosts: service.i2pUrls.map(urlDomain),
  ratingCount: service.userRatingCount,
  averageRating: service.averageUserRating,
  tosSummary: service.tosReview?.summary ?? null,
})
const registrationCountry = service.registrationCountryCode
  ? getCountryInfo(service.registrationCountryCode)
  : null
type ServiceFact = {
  text?: string
  href?: string
  icon?: string
  rating?: { value: number | null; count: number }
  /** Least important: on phones it is shown only when it fits the single row. */
  optional?: boolean
}
const serviceFactCandidates: (ServiceFact | false | null)[] = [
  registrationCountry && { text: registrationCountry.name, icon: 'ri:map-pin-line', optional: true },
  service.operatingSince && {
    text: formatDistanceToNowStrict(service.operatingSince, { roundingMethod: 'floor' }),
    icon: 'ri:cake-2-line',
  },
  service.userRatingCount > 0 && {
    href: '#comments',
    rating: {
      value: service.trustWeightedUserRating ?? service.averageUserRating,
      count: service.userRatingCount,
    },
  },
]
const serviceFacts = serviceFactCandidates.filter((fact): fact is ServiceFact => !!fact)
// Logo, name row and badge row share fixed heights so the logo's edges line up with
// the top of the name and the bottom of the badges: 28+4+24 on phones, 32+6+26 above.
const badgeSizeClass = 'h-6 px-2.5 py-0 text-xs whitespace-nowrap sm:h-6.5 sm:px-3 sm:text-[13px]'
// One size down from the default button, the way a repo header does it. Icon only on phones.
const compactButtonClass = 'h-7 text-xs max-sm:w-7 max-sm:px-0 sm:h-8 sm:px-2.5'
const compactButtonLabelClass = 'max-sm:sr-only'
const compactButtonArrowClass = 'max-sm:hidden'
const acceptedCurrencies = currencies.filter((currency) => service.acceptedCurrencies.includes(currency.id))

const checkSegments = [
  verificationOverview.counts.PASSED > 0 && {
    text: `${verificationOverview.counts.PASSED} passed`,
    icon: 'ri:check-double-line' as const,
    iconClass: 'text-green-400',
  },
  verificationOverview.counts.WARNING > 0 && {
    text: `${verificationOverview.counts.WARNING} warning${verificationOverview.counts.WARNING === 1 ? '' : 's'}`,
    icon: 'ri:alert-line' as const,
    iconClass: 'text-yellow-400',
  },
  verificationOverview.counts.FAILED > 0 && {
    text: `${verificationOverview.counts.FAILED} failed`,
    icon: 'ri:close-line' as const,
    iconClass: 'text-red-400',
    textClass: 'text-red-400',
  },
  verificationOverview.counts.IN_PROGRESS > 0 && {
    text: `${verificationOverview.counts.IN_PROGRESS} in progress`,
    icon: 'ri:hourglass-line' as const,
    iconClass: 'text-day-500',
  },
  verificationOverview.counts.PENDING > 0 && {
    text: `${verificationOverview.counts.PENDING} pending`,
    icon: 'ri:hourglass-line' as const,
    iconClass: 'text-day-500',
  },
].filter((s): s is Exclude<typeof s, false> => !!s)
const verificationStatusDateLabel =
  service.verificationStatus === 'VERIFICATION_SUCCESS'
    ? 'Verified'
    : service.verificationStatus === 'APPROVED'
      ? 'Approved'
      : 'Listed'

const verificationStatusDate =
  service.verificationStatus === 'VERIFICATION_SUCCESS'
    ? service.verifiedAt
    : service.verificationStatus === 'APPROVED'
      ? service.approvedAt
      : service.listedAt

// The thread below can be asked to include comments no moderator has seen yet.
// That view is worth offering a reader and not worth handing to a crawler.
const showsUnmoderatedComments = Astro.url.searchParams.get('showPending') === 'true'
---

<BaseLayout
  pageTitle={pageTitle}
  description={pageDescription}
  ogImage={ogImageTemplateData}
  widthClassName="max-w-5xl"
  noindex={serviceVisibilityInfo.value === 'UNLISTED' ||
    serviceVisibilityInfo.value === 'HIDDEN' ||
    showsUnmoderatedComments}
  htmx
  schemas={[
    {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      '@id': itemReviewedId,
      name: service.name,
      sameAs: undefinedIfEmpty([...service.serviceUrls, ...service.onionUrls, ...service.i2pUrls]),
      description: service.description || undefined,
      image: service.imageUrl ?? undefined,
      mainEntityOfPage: pageUrl,
      contactPoint: undefinedIfEmpty(
        service.contactMethods
          .map((method) => ({
            ...method,
            info: formatContactMethod(method.value),
          }))
          .map<ContactPoint | null>(({ info, label }) => {
            switch (info.type) {
              case 'telephone': {
                return {
                  '@type': 'ContactPoint',
                  telephone: info.formattedValue,
                  name: label ?? info.label,
                }
              }
              case 'email': {
                return {
                  '@type': 'ContactPoint',
                  email: info.formattedValue,
                  name: label ?? info.label,
                }
              }
              default: {
                return null
              }
            }
          })
          .filter((value) => value !== null)
      ),
    } satisfies WithContext<Organization>,

    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': webPageId,
      name: pageTitle,
      url: pageUrl,
      mainEntity: {
        '@id': itemReviewedId,
      },
      datePublished: service.listedAt?.toISOString(),
      dateCreated: service.createdAt.toISOString(),
      image: makeOgImageUrl(ogImageTemplateData, siteOrigin),
    } satisfies WithContext<WebPage>,
  ]}
  breadcrumbs={[
    ...service.categories.map(
      (category) =>
        [
          {
            name: 'Services',
            url: '/',
          },
          {
            name: category.name,
            url: `/?categories=${category.slug}`,
          },
          {
            name: service.name,
            url: `/service/${service.slug}`,
          },
        ] satisfies BreadcrumArray
    ),
    ...service.acceptedCurrencies.map((currency) => {
      const currencyInfo = getCurrencyInfo(currency)
      return [
        {
          name: 'Services',
          url: '/',
        },
        {
          name: currencyInfo.name,
          url: `/?currencies=${currencyInfo.slug}`,
        },
        {
          name: service.name,
          url: `/service/${service.slug}`,
        },
      ] satisfies BreadcrumArray
    }),
  ]}
>
  {
    (serviceVisibilityInfo.value === 'UNLISTED' || serviceVisibilityInfo.value === 'ARCHIVED') && (
      <div
        class={cn(
          'mb-3 rounded-lg border border-day-500/10 bg-yellow-900/50 px-3 py-2 text-sm text-yellow-400'
        )}
      >
        <Icon
          name={serviceVisibilityInfo.icon}
          class="me-1.5 inline-block size-4 align-[-0.15em] text-yellow-500"
        />
        {serviceVisibilityInfo.longDescription}
      </div>
    )
  }

  {
    !!activeEventToShow && (
      <div class="mb-4">
        <ServiceRiskAlert
          event={activeEventToShow}
          moreIncidents={moreActiveIncidents}
          moreWarnings={moreActiveWarnings}
        />
      </div>
    )
  }

  {
    serviceVisibilityInfo.value === 'HIDDEN' && (
      <div class="mb-3 rounded-lg border border-red-500/20 bg-red-900/40 px-3 py-2 text-sm text-red-300">
        <Icon name="ri:eye-off-line" class="me-1.5 inline-block size-4 align-[-0.15em] text-red-400" />
        This service is <span class="font-bold">hidden</span>. It is not publicly visible and can only be seen
        by admins and moderators.
      </div>
    )
  }

  <div class="flex items-start gap-4">
    {
      !!service.imageUrl && (
        <MyPicture
          src={service.imageUrl}
          alt={service.name || "Service's logo"}
          class="size-14 shrink-0 rounded-sm object-contain sm:size-16"
          width={64}
          height={64}
        />
      )
    }

    <div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-4 gap-y-1 sm:gap-y-1.5">
      <h1
        class="min-w-0 flex-1 font-title text-xl/tight font-bold tracking-wider text-white sm:text-2xl/tight"
      >
        {service.name}
      </h1>

      {
        /* Badges sit on their own row under the name; on phones the currencies share that row, under the buttons. */
      }
      <div class="order-last flex basis-full flex-wrap items-center gap-2">
        <div class="flex min-w-0 flex-1 flex-wrap items-center gap-2">
          {/* Outside the category list: it is a verdict, not a category. */}
          <Tooltip class="inline-flex" text={statusInfo.description} position="bottom">
            <BadgeStandard
              icon={statusInfo.icon}
              text={statusInfo.labelShort}
              class={cn('font-bold', badgeSizeClass, statusInfo.classNames.badgeBig)}
            />
          </Tooltip>

          <ul class="contents" aria-label="Categories">
            <li class="contents">
              {
                service.categories.map((category) => (
                  <BadgeStandard
                    as="a"
                    href={urlWithParams(new URL('/', Astro.url), { categories: [category.slug] })}
                    icon={category.icon}
                    text={category.name}
                    class={badgeSizeClass}
                  />
                ))
              }
            </li>
          </ul>
        </div>
      </div>

      <div class="ml-auto flex items-center justify-center gap-2">
        {
          user ? (
            <DropdownButton
              label="Watch"
              icon="ri:eye-line"
              classNames={{
                button: compactButtonClass,
                label: compactButtonLabelClass,
                arrow: compactButtonArrowClass,
              }}
            >
              <DropdownButtonItemForm
                action={actions.notification.preferences.watchService}
                method="post"
                data={{ serviceId: service.id, watchType: 'all', value: !watchingDetails?.all }}
                label="All"
                icon="ri:alert-line"
                class="font-bold"
              >
                {!!watchingDetails && (
                  <slot slot="end">
                    <input
                      type="checkbox"
                      disabled
                      checked={watchingDetails.all}
                      data-mark-indeterminate={watchingDetails.all === null ? 'true' : 'false'}
                      class="pointer-events-none"
                    />
                  </slot>
                )}
              </DropdownButtonItemForm>

              <DropdownButtonItemForm
                action={actions.notification.preferences.watchService}
                method="post"
                data={{ serviceId: service.id, watchType: 'comments', value: !watchingDetails?.comments }}
                label="Comments"
                icon="ri:chat-1-line"
              >
                {!!watchingDetails && (
                  <slot slot="end">
                    <input
                      type="checkbox"
                      disabled
                      checked={watchingDetails.comments}
                      class="pointer-events-none"
                    />
                  </slot>
                )}
              </DropdownButtonItemForm>

              <DropdownButtonItemForm
                action={actions.notification.preferences.watchService}
                method="post"
                data={{ serviceId: service.id, watchType: 'events', value: !watchingDetails?.events }}
                label="Events"
                icon="ri:calendar-line"
              >
                {!!watchingDetails && (
                  <slot slot="end">
                    <input
                      type="checkbox"
                      disabled
                      checked={watchingDetails.events}
                      class="pointer-events-none"
                    />
                  </slot>
                )}
              </DropdownButtonItemForm>

              <DropdownButtonItemForm
                action={actions.notification.preferences.watchService}
                method="post"
                data={{
                  serviceId: service.id,
                  watchType: 'verification',
                  value: !watchingDetails?.verification,
                }}
                label="Verification"
                icon="ri:check-line"
              >
                {!!watchingDetails && (
                  <slot slot="end">
                    <input
                      type="checkbox"
                      disabled
                      checked={watchingDetails.verification}
                      class="pointer-events-none"
                    />
                  </slot>
                )}
              </DropdownButtonItemForm>
            </DropdownButton>
          ) : (
            <Button
              as="a"
              href={makeLoginUrl(Astro.url)}
              dataAstroReload
              aria-label="Log in to watch this service"
              label="Watch"
              icon="ri:eye-line"
              class={compactButtonClass}
              classNames={{ label: compactButtonLabelClass }}
            />
          )
        }

        <DropdownButton
          label="Contribute"
          icon="ri:edit-line"
          classNames={{
            button: compactButtonClass,
            label: compactButtonLabelClass,
            arrow: compactButtonArrowClass,
          }}
        >
          <DropdownButtonItemLink
            href={`/service-suggestion/edit?serviceId=${service.id}`}
            label="Suggest changes"
            icon="ri:edit-line"
          />
          <DropdownButtonItemLink
            href={`/service/${service.slug}#comments`}
            label="Review"
            icon="ri:star-line"
          />
          <AdminOnly>
            <DropdownButtonItemLink
              href={`/admin/services/${service.slug}/edit`}
              label="Edit (Admin)"
              icon="ri:edit-box-line"
            />
          </AdminOnly>
        </DropdownButton>
      </div>
    </div>
  </div>

  <div class="flex flex-col">
    {
      isFlaggedScam ? (
        <p class="mt-4 max-w-[80ch] text-pretty text-red-200">
          {service.name} is flagged as a scam. We have evidence of serious, unresolved harm to users. Do not
          use it.
        </p>
      ) : (
        <div class="prose mt-4 max-w-[80ch] text-pretty text-day-300 prose-invert">
          <Markdown content={service.description} />
        </div>
      )
    }

    {
      (acceptedCurrencies.length > 0 || serviceFacts.length > 0) && (
        <ul
          class="order-first mt-3 flex max-h-6 flex-wrap items-center gap-y-6 overflow-hidden text-sm text-day-400 sm:order-none sm:max-h-none sm:gap-y-1.5 sm:overflow-visible [&>li]:before:mx-2.5 [&>li]:before:text-day-600 [&>li]:before:content-['·'] [&>li:first-child]:before:hidden"
          aria-label="Key facts"
        >
          <li class="flex shrink-0">
            <AcceptedCurrencies
              accepted={service.acceptedCurrencies}
              class="max-sm:gap-1.5 max-sm:[&_svg]:size-4"
            />
          </li>
          {serviceFacts.map((fact) => (
            <li class={cn('flex shrink-0 items-center gap-1.5', fact.optional && 'max-sm:order-last')}>
              {fact.icon && <Icon name={fact.icon} class="size-4 shrink-0 text-day-500" />}
              {fact.rating ? (
                <a
                  href={fact.href}
                  class="hover:text-day-200"
                  aria-label={`${fact.rating.value !== null ? fact.rating.value.toFixed(1) : '-'} out of 5 from ${fact.rating.count.toLocaleString()} ${pluralize('rating', fact.rating.count)}`}
                >
                  <RatingBadge rating={fact.rating.value} count={fact.rating.count} />
                </a>
              ) : fact.href ? (
                <a
                  href={fact.href}
                  class="underline decoration-day-700 underline-offset-4 hover:text-day-200"
                >
                  {fact.text}
                </a>
              ) : (
                fact.text
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>

  {
    serviceLinks.length > 0 && (
      <ul aria-label="Service links" class="mt-6 flex flex-wrap gap-2">
        {serviceLinks.map((url) => (
          <li>
            <ServiceLinkButton
              url={url}
              referral={service.referral}
              isScam={service.verificationStatus === 'VERIFICATION_FAILED'}
            />
          </li>
        ))}
      </ul>
    )
  }

  {
    service.contactMethods.length > 0 && (
      <div class="mt-4 flex flex-wrap items-center gap-y-1.5 pl-1 text-sm max-sm:gap-x-4 [&_li]:before:mx-2.5 [&_li]:before:text-day-600 [&_li]:before:content-['·'] max-sm:[&_li]:before:hidden">
        <span class="font-title text-xs leading-none font-bold tracking-wider text-day-500 uppercase">
          Support
        </span>
        <ul aria-label="Support and contact methods" class="contents">
          {service.contactMethods.map((method) => {
            const methodInfo = formatContactMethod(method.value)
            return (
              <li class="flex min-w-0 items-center">
                <a
                  href={method.value}
                  target="_blank"
                  rel="nofollow noopener"
                  class="inline-flex min-w-0 items-center gap-1.5 text-day-300 underline decoration-night-500 underline-offset-4 transition-colors hover:text-white hover:decoration-day-400"
                >
                  <Icon name={methodInfo.icon} class="size-4 shrink-0 text-day-500" />
                  <span class="truncate">{method.label ?? methodInfo.formattedValue}</span>
                </a>
              </li>
            )
          })}
        </ul>
      </div>
    )
  }

  <div class="mt-6 space-y-2 sm:mt-8">
    <ServiceAnswerPanel kyc={kycAnswer} safety={safetyAnswer} kycLevel={kycLevelInfo} />

    <TosSummaryCard service={service} />

    {
      /* On a scam or a service with a severe open incident the same ad answers a different question. */
      isSwapSupported && (
        <SwapCTA
          heading={needsAlternative ? 'Looking for an alternative?' : undefined}
          description={
            needsAlternative
              ? 'Our tool: compare live rates from listed exchanges with a clean record.'
              : undefined
          }
          action={needsAlternative ? 'Compare' : undefined}
        />
      )
    }
  </div>

  <Schema
    item={{
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: serviceFaq.map(({ question, answer }) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    } satisfies WithContext<FAQPage>}
  />

  <AdminOnly>
    <SectionHeading
      title="Internal Notes"
      link={{ href: `/admin/services/${service.slug}/edit#internal-notes`, text: 'Manage' }}
    />

    {
      service.internalNotes.length === 0 ? (
        <p class="mt-2 text-center text-xs text-day-400">No internal notes yet.</p>
      ) : (
        <div
          class={cn(
            'grid grid-cols-1 items-start gap-2',
            service.internalNotes.length > 1 && 'sm:grid-cols-2'
          )}
        >
          {service.internalNotes.map((note) => (
            <div class="rounded-lg border border-night-600 bg-night-800 p-3">
              <div class="prose prose-sm max-w-none text-pretty text-day-200 prose-invert">
                <Markdown content={note.content} />
              </div>

              <div class="mt-2 flex items-center gap-1 text-xs text-day-500">
                <TimeFormatted date={note.createdAt} hourPrecision />
                {note.addedByUser && (
                  <span class="flex items-center gap-1">
                    by <UserBadge user={note.addedByUser} size="sm" />
                  </span>
                )}
              </div>
            </div>
          ))}
        </div>
      )
    }

    <form
      method="POST"
      action={actions.admin.service.internalNote.add}
      data-note-edit-form
      class="mt-4 space-y-4"
    >
      <input type="hidden" name="serviceId" value={service.id} />

      <InputTextArea label="Add a note" name="content" />
      <InputSubmitButton label="Save" icon="ri:save-line" hideCancel />
    </form>
  </AdminOnly>

  <Schema
    item={{
      '@context': 'https://schema.org',
      '@type': 'Review',
      itemReviewed: { '@id': itemReviewedId },
      reviewAspect: 'KYC Level',
      name: kycLevelInfo.name,
      // No numeric rating here: on our scale 0 is the best level, which
      // schema.org would read as the worst. The privacy score carries the number.
      reviewBody: kycLevelInfo.description,
      author: KYCNOTME_SCHEMA_MINI,
    } satisfies WithContext<Review>}
  />

  <section id="scores" class="mt-8">
    <h2 class="mb-3 border-b border-day-500 font-title text-lg font-bold text-day-200">Score</h2>

    <div class="flex max-w-84 grow flex-row items-center justify-evenly gap-4">
      <ScoreSquare
        as="a"
        href="/about#service-scores"
        role="link"
        aria-label={`Overall score ${formatRating(service.overallScore)} out of 10. Learn how scores are calculated.`}
        score={service.overallScore}
        label="Overall"
        itemReviewedId={itemReviewedId}
        showInfo
      />

      <div class="h-12 w-px shrink-0 self-center bg-day-800"></div>

      <ScoreGauge
        as="a"
        href="/about#service-scores"
        role="link"
        aria-label={`Privacy score ${Math.round(service.privacyScore)} percent. Learn how scores are calculated.`}
        score={service.privacyScore}
        label="Privacy"
        itemReviewedId={itemReviewedId}
        showInfo
      />

      <ScoreGauge
        as="a"
        href="/about#service-scores"
        role="link"
        aria-label={`Trust score ${Math.round(service.trustScore)} percent. Learn how scores are calculated.`}
        score={service.trustScore}
        label="Trust"
        itemReviewedId={itemReviewedId}
        showInfo
      />
    </div>

    <div id="attributes" class="mt-6 space-y-4">
      {
        ledgerGroups.map((group) => (
          <div>
            <div class="mb-2 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-night-500 pb-1">
              <h3 class="font-title text-xs font-bold tracking-wider text-day-300 uppercase">
                {group.title}
              </h3>
              {group.subtotal.length > 0 && (
                <p class="text-xs text-day-400">
                  {group.subtotal.map((effect, index) => (
                    <>
                      {index > 0 && <span class="mx-1.5 text-day-600">·</span>}
                      <span class="font-bold text-day-200">
                        {effect.value === 0 ? '+0' : formatPoints(effect.value)}
                      </span>{' '}
                      {effect.label}
                    </>
                  ))}
                </p>
              )}
            </div>
            <ul class="grid items-start gap-1.5 sm:grid-cols-2 lg:grid-cols-3">
              {group.rows.map((attribute) => (
                <AttributeCard attribute={attribute} />
              ))}
              {group.showIncidentPenalty && <AttributeCard attribute={incidentPenaltyAttribute} />}
              {group.showBaseScore && <AttributeCard attribute={baseScoreAttribute} />}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-xs text-day-400">
      <span>
        Privacy <span class="font-semibold text-day-200">{service.privacyScore}</span> × 60%
      </span>
      <span class="text-day-500">+</span>
      <span>
        Trust <span class="font-semibold text-day-200">{service.trustScore}</span> × 40%
      </span>
      <span class="text-day-500">=</span>
      <span>
        Overall <span class="font-semibold text-day-200">{service.overallScore}</span>/10
      </span>
      {isFlaggedScam && <span class="text-red-400">capped at 3</span>}
    </div>
    <div class="mt-2 flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs xs:gap-x-6">
      <a
        href="/about#service-scores"
        class="inline-flex items-center gap-1 text-day-400 transition-colors hover:text-day-200 hover:underline"
      >
        <Icon name="ri:information-line" class="size-3" />
        Learn about scores
      </a>
      <a
        href="/attributes"
        class="inline-flex items-center gap-1 text-day-400 transition-colors hover:text-day-200 hover:underline"
      >
        <Icon name="ri:information-line" class="size-3" />
        All attributes list
      </a>
    </div>
  </section>

  <TosReviewSection service={service} itemReviewedId={itemReviewedId} statusLabel={statusInfo.label} />

  <ServiceTimeline events={service.events} serviceSlug={service.slug} now={now} />

  <SectionHeading
    id="verification"
    title="Evidence and Review History"
    info={{ href: '/about#listing-statuses', text: 'How statuses work' }}
    link={{ href: '/about#suggestion-review-process', text: 'Our review process' }}
  />

  <div
    class={cn(
      'mb-6 flex flex-col gap-3 rounded-lg border border-day-500/10 px-4 py-3 sm:flex-row sm:items-start sm:justify-between',
      statusInfo.classNames.containerBg
    )}
  >
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
        <div
          class={cn(
            'inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-sm font-medium',
            statusInfo.classNames.badgeBig
          )}
        >
          <Icon name={statusInfo.icon} class="size-4" />
          <span>{statusInfo.label}</span>
        </div>
        <p class="text-sm text-current/70">{statusInfo.description}</p>
      </div>

      {
        service.verificationSummary && (
          <div class="prose prose-sm mt-2 max-w-none prose-invert">
            <Markdown content={service.verificationSummary} />
          </div>
        )
      }

      <ul class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-day-300">
        <li class="inline-flex items-center gap-1.5">
          {
            checkSegments.length > 0 ? (
              checkSegments.map((seg, i) => (
                <>
                  {i > 0 && <span class="text-day-500">·</span>}
                  <Icon name={seg.icon} class={cn('size-3.5', seg.iconClass)} />
                  <span class={seg.textClass ?? ''}>{seg.text}</span>
                </>
              ))
            ) : (
              <>
                <Icon name="ri:check-double-line" class="size-3.5 text-day-500" />
                <span>{verificationOverview.checksSummary}</span>
              </>
            )
          }
        </li>
        <li class="inline-flex items-center gap-1.5">
          <Icon name="ri:history-line" class="size-3.5 text-day-500" />
          <span class="text-day-500">Last review</span>
          <span class="text-day-200">
            {
              verificationOverview.lastReviewAt
                ? formatDateShort(verificationOverview.lastReviewAt, {
                    prefix: false,
                    hourPrecision: false,
                  })
                : 'Unknown'
            }
          </span>
        </li>
        <li class="inline-flex items-center gap-1.5">
          <Icon name="ri:calendar-check-line" class="size-3.5 text-day-500" />
          <span class="text-day-500">{verificationStatusDateLabel}</span>
          <span class="text-day-200">
            {
              verificationStatusDate
                ? formatDateShort(verificationStatusDate, {
                    prefix: false,
                    hourPrecision: false,
                  })
                : 'Unknown'
            }
          </span>
        </li>
      </ul>
    </div>

    {
      service.verificationStatus !== 'VERIFICATION_SUCCESS' &&
        service.verificationStatus !== 'VERIFICATION_FAILED' &&
        service.serviceVisibility !== 'ARCHIVED' && (
          <form
            method="POST"
            action={actions.service.requestVerification}
            id="request-verification-form"
            class="shrink-0 sm:w-48"
            hx-post={`${Astro.url.pathname}${actions.service.requestVerification}`}
            hx-target="#request-verification-form"
            hx-select="#request-verification-form"
            hx-swap="outerHTML"
          >
            <input type="hidden" name="serviceId" value={service.id} />
            <input type="hidden" name="action" value={hasRequestedVerification ? 'withdraw' : 'request'} />
            <VerificationRequestElement
              type={VerificationRequestElement === 'button' ? 'submit' : undefined}
              href={
                VerificationRequestElement === 'a'
                  ? makeLoginUrl(
                      (() => {
                        const url = new URL(Astro.url)
                        url.hash = '#request-verification-form'
                        return url
                      })()
                    )
                  : undefined
              }
              class="flex w-full items-center justify-center gap-2 rounded-md border border-night-400 bg-night-800 px-3 py-1.5 text-sm shadow-sm transition-colors duration-200 hover:bg-night-900"
            >
              <Icon
                name={hasRequestedVerification ? 'ri:chat-delete-line' : 'ri:chat-check-line'}
                class="size-4 htmx-request:hidden"
              />
              <Icon name="ri:loader-4-line" class="hidden size-4 animate-spin htmx-request:block" />
              <span>{hasRequestedVerification ? 'Withdraw request' : 'Request verification'}</span>
            </VerificationRequestElement>

            <p class="mt-1 text-center text-xs text-day-500">
              {service.verificationRequests.length.toLocaleString()}{' '}
              {pluralize('request', service.verificationRequests.length)}
            </p>
            {result?.error && <p class="mt-1 text-center text-xs text-red-500">{result.error.message}</p>}
          </form>
        )
    }
  </div>
  {
    service.verificationProofMd && (
      <>
        <h3 class="mt-4 font-title text-lg font-semibold" id="verification-proof">
          Verification proof
        </h3>
        <div class="prose prose-sm max-w-none prose-invert">
          <Markdown content={service.verificationProofMd} />
        </div>
      </>
    )
  }
  {
    sortedVerificationSteps.length > 0 && (
      <>
        <h3 class="mt-6 mb-3 font-title font-semibold" id="verification-steps">
          Tests we ran
        </h3>
        <ol class="mb-8 ml-1.5 space-y-5 border-l border-night-500 pl-5">
          {sortedVerificationSteps.map((step) => {
            const statusInfo = getVerificationStepStatusInfo(step.status)
            return (
              <li class="relative scroll-mt-24" id={checkAnchor(step.id)}>
                <span
                  aria-hidden="true"
                  class={cn(
                    'absolute top-1 -left-[26px] size-3 rounded-full ring-4 ring-night-900',
                    stepDotClass[statusInfo.color]
                  )}
                />
                <p class="flex flex-wrap items-center gap-x-2 text-xs text-day-500">
                  <TimeFormatted date={step.updatedAt} prefix={false} />
                  <span aria-hidden="true" class="text-day-700">
                    ·
                  </span>
                  <span class={cn('inline-flex items-center gap-0.5', statusInfo.iconClass)}>
                    <Icon
                      name={statusInfo.icon}
                      class={cn('size-3.5', statusInfo.iconSpin && 'animate-spin')}
                    />
                    {statusInfo.label}
                  </span>
                </p>
                <p class="mt-0.5 font-title font-bold text-day-100">{step.title}</p>
                <p class="mt-0.5 text-sm text-day-300">{step.description}</p>
                {step.evidenceMd && (
                  <div class="prose prose-sm mt-1.5 max-w-none text-xs/relaxed prose-invert">
                    <Markdown content={step.evidenceMd} />
                  </div>
                )}
              </li>
            )
          })}
        </ol>
      </>
    )
  }
  <SectionHeading
    id="comments"
    title="Comments"
    link={{ href: `/comments?service=${service.slug}`, text: 'In the feed' }}
  />
  <div
    id="discuss"
    class='grid grid-cols-1 gap-8 [grid-template-areas:"about""rating""ai"] sm:grid-cols-[1fr_1fr] sm:gap-4 sm:[grid-template-areas:"about_ai""rating_ai"]'
  >
    <div class="relative rounded-md bg-orange-400/10 p-2 px-2.5 text-xs text-orange-100/70 [grid-area:about]">
      <p class="font-bold">About comments</p>
      <ul class="list-disc pl-4">
        <li>Comments are visible after approval.</li>
        <li>Moderation is light.</li>
        <li>Double-check before trusting.</li>
      </ul>

      {
        service.strictCommentingEnabled && (
          <p class="mt-2">
            <Icon
              name="ri:verified-badge-fill"
              class="me-0.5 inline-block size-4 align-[-0.3em] text-orange-100/95"
            />
            <span class="font-medium text-orange-100/95">Proof of being a client required</span>, for this
            service.
          </p>
        )
      }

      <div class="absolute inset-y-2 right-2 flex flex-col justify-center">
        <Icon name="ri:alert-line" class="h-full max-h-16 w-auto opacity-10 xs:opacity-20" />
      </div>
    </div>
    <CommentSummary
      serviceId={service.id}
      averageUserRating={service.averageUserRating}
      trustWeightedUserRating={service.trustWeightedUserRating}
      userRatingCount={service.userRatingCount}
      trustedUserRatingCount={service.trustedUserRatingCount}
      userRatingWeight={service.userRatingWeight}
      class="grow [grid-area:rating]"
      itemReviewedId={itemReviewedId}
    />

    {
      userSentiment && service.trustWeightedUserRating !== null && (
        <Schema
          item={
            {
              '@context': 'https://schema.org',
              '@type': 'Review',
              itemReviewed: { '@id': itemReviewedId },
              reviewAspect: 'AI Summary',
              name: 'AI Summary',
              reviewBody: userSentiment.summary,
              datePublished: service.userSentimentAt?.toISOString(),
              author: {
                '@type': 'Organization',
                name: 'KYCnot.me Community',
              },
              reviewRating: {
                '@type': 'Rating',
                ratingValue: service.trustWeightedUserRating,
                worstRating: 1,
                bestRating: 5,
              },
              positiveNotes: userSentiment.whatUsersLike.map(
                (item, index) =>
                  ({
                    '@type': 'ListItem',
                    position: index + 1,
                    name: item,
                  }) satisfies ListItem
              ),
              negativeNotes: userSentiment.whatUsersDislike.map(
                (item, index) =>
                  ({
                    '@type': 'ListItem',
                    position: index + 1,
                    name: item,
                  }) satisfies ListItem
              ),
            } satisfies WithContext<Review>
          }
        />
      )
    }

    <div class="flex flex-1 grow-3 basis-64 flex-col gap-2 rounded-lg bg-night-800 p-3 [grid-area:ai]">
      <div class="flex flex-row justify-between">
        <h3 class="font-title leading-none font-bold">
          <Icon name="ri:sparkling-2-line" class="me-1 inline-block size-4 align-[-0.1em]" />AI Summary
        </h3>
        {
          service.userSentimentAt && (
            <div class="text-right text-xs text-day-500">
              Updated
              <TimeFormatted date={service.userSentimentAt} hourPrecision />
            </div>
          )
        }
      </div>

      {
        userSentiment ? (
          <>
            <div class="prose prose-sm max-w-none text-sm prose-invert">
              <Markdown content={userSentiment.summary} />
            </div>

            <div class="flex grow items-center justify-evenly">
              <ul class="inline-grid list-inside list-disc place-items-center text-sm text-day-300 marker:text-green-400 marker:content-['+_']">
                {userSentiment.whatUsersLike.map((item) => (
                  <li class="w-full">
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <ul class="inline-grid list-inside list-disc place-items-center text-sm text-day-300 marker:text-red-400 marker:content-['-_']">
                {userSentiment.whatUsersDislike.map((item) => (
                  <li class="w-full">
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </>
        ) : (
          <p class="my-2 flex flex-1 items-center justify-center text-center text-xs text-day-400">
            Not reviewed yet
          </p>
        )
      }
    </div>
  </div>
  {
    canEmbedServiceBadge && (
      <div class="mt-8 mb-12 flex justify-center">
        <a
          href={`/service/${service.slug}/badge`}
          class="inline-flex items-center gap-2 rounded-md border border-day-500/10 px-3 py-1.5 text-xs text-day-500 transition-colors hover:border-day-500/20 hover:text-day-300"
        >
          <Icon name="ri:code-s-slash-line" class="size-3.5 shrink-0" />
          <span>Embed badge on your site</span>
          <Icon name="ri:arrow-right-s-line" class="size-3.5 shrink-0" />
        </a>
      </div>
    )
  }
  <CommentSection itemReviewedId={itemReviewedId} service={service} />
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const checkboxes = document.querySelectorAll<HTMLInputElement>('input[data-mark-indeterminate]')
    checkboxes.forEach((checkbox) => {
      checkbox.indeterminate = checkbox.dataset.markIndeterminate === 'true'
    })
  })
</script>
