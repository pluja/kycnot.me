        </li>
        <li class="inline-flex items-center gap-1.5">
          <Icon name="ri:history-line" class="size-3.5 text-day-500" />
          <span class="text-day-500">Last review</span>
          <span class="text-day-200">
            {
              verificationOverview.lastReviewAt
                ? formatDateShort(verificationOverview.lastReviewAt, {
                    prefix: false,
                    hourPrecision: false,
                  })
                : 'Unknown'
            }
          </span>
        </li>
        <li class="inline-flex items-center gap-1.5">
          <Icon name="ri:calendar-check-line" class="size-3.5 text-day-500" />
          <span class="text-day-500">{verificationStatusDateLabel}</span>
          <span class="text-day-200">
            {
              verificationStatusDate
                ? formatDateShort(verificationStatusDate, {
                    prefix: false,
                    hourPrecision: false,
                  })
                : 'Unknown'
            }
          </span>
        </li>
        {
          service.operatingSince && (
            <li class="inline-flex items-center gap-1.5">
              <Icon name="ri:rocket-2-line" class="size-3.5 text-day-500" />
              <span class="text-day-500">Operating since</span>
              <span class="text-day-200">
                {formatDateShort(service.operatingSince, {
                  prefix: false,
                  hourPrecision: false,
                })}
              </span>
            </li>
          )
        }
      </ul>
    </div>

    {
      service.verificationStatus !== 'VERIFICATION_SUCCESS' &&
        service.verificationStatus !== 'VERIFICATION_FAILED' &&
        service.serviceVisibility !== 'ARCHIVED' && (
          <form
            method="POST"
            action={actions.service.requestVerification}
            id="request-verification-form"
            class="shrink-0 sm:w-48"
            hx-post={`${Astro.url.pathname}${actions.service.requestVerification}`}
            hx-target="#request-verification-form"
            hx-select="#request-verification-form"
            hx-swap="outerHTML"
          >
            <input type="hidden" name="serviceId" value={service.id} />
            <input type="hidden" name="action" value={hasRequestedVerification ? 'withdraw' : 'request'} />
            <VerificationRequestElement
              type={VerificationRequestElement === 'button' ? 'submit' : undefined}
              href={
                VerificationRequestElement === 'a'
                  ? makeLoginUrl(
                      (() => {
                        const url = new URL(Astro.url)
                        url.hash = '#request-verification-form'
                        return url
                      })()
                    )
                  : undefined
              }
              class="flex w-full items-center justify-center gap-2 rounded-md border border-night-400 bg-night-800 px-3 py-1.5 text-sm shadow-sm transition-colors duration-200 hover:bg-night-900"
            >
              <Icon
                name={hasRequestedVerification ? 'ri:chat-delete-line' : 'ri:chat-check-line'}
                class="size-4 htmx-request:hidden"
              />
              <Icon name="ri:loader-4-line" class="hidden size-4 animate-spin htmx-request:block" />
              <span>{hasRequestedVerification ? 'Withdraw request' : 'Request verification'}</span>
            </VerificationRequestElement>

            <p class="mt-1 text-center text-xs text-day-500">
              {service.verificationRequests.length.toLocaleString()}{' '}
              {pluralize('request', service.verificationRequests.length)}
            </p>
            {result?.error && <p class="mt-1 text-center text-xs text-red-500">{result.error.message}</p>}
          </form>
        )
    }
  </div>
  {
    service.verificationProofMd && (
      <>
        <h3 class="mt-4 font-title text-lg font-semibold" id="verification-proof">
          Verification proof
        </h3>
        <div class="prose prose-sm max-w-none prose-invert">
          <Markdown content={service.verificationProofMd} />
        </div>
      </>
    )
  }
  {
    sortedVerificationSteps.length > 0 && (
      <>
        <h3 class="mt-6 mb-2 font-title font-semibold" id="verification-steps">
          Verification Steps
        </h3>
        <ul class="mb-8 space-y-2">
          {sortedVerificationSteps.map((step) => {
            const statusInfo = getVerificationStepStatusInfo(step.status)

            return (
              <li class="grow rounded-md border border-night-500 bg-night-700/50 p-2.5 shadow-sm">
                <div class="flex items-start justify-between gap-2">
                  <div class="flex flex-col">
                    <div class="text-sm/tight font-semibold text-white">
                      <BadgeSmall
                        text={statusInfo.label}
                        icon={statusInfo.icon}
                        color={statusInfo.color}
                        inlineIcon={statusInfo.iconSpin}
                        classNames={{
                          icon: cn(statusInfo.iconSpin && 'animate-spin'),
                        }}
                        class="me-1"
                      />

                      {step.title}
                    </div>
                    <p class="mt-1.5 text-xs text-day-300">{step.description}</p>
                  </div>
                  <p class="shrink-0 pt-0.5 text-2xs whitespace-nowrap text-day-400">
                    <TimeFormatted date={step.updatedAt} prefix={false} />
                  </p>
                </div>

                {step.evidenceMd && (
                  <div class="prose prose-sm mt-2 block max-w-none text-xs/relaxed prose-invert">
                    <Markdown content={step.evidenceMd} />
                  </div>
                )}
              </li>
            )
          })}
        </ul>
      </>
    )
  }

  <div class="mt-6 mb-3 flex items-center justify-between border-b border-day-500" id="comments">
    <h2 class="font-title text-lg font-bold text-day-200">Comments</h2>
    <a
      href={`/comments?service=${service.slug}`}
      class="inline-flex items-center gap-1 text-xs leading-none text-day-500 transition-colors hover:text-day-200 hover:underline"
    >
      In the feed
      <Icon name="ri:arrow-right-s-line" class="size-4" />
    </a>
  </div>
  <div
    id="discuss"
    class='grid grid-cols-1 gap-8 [grid-template-areas:"about""rating""ai"] sm:grid-cols-[1fr_1fr] sm:gap-4 sm:[grid-template-areas:"about_ai""rating_ai"]'
  >
    <div class="relative rounded-md bg-orange-400/10 p-2 px-2.5 text-xs text-orange-100/70 [grid-area:about]">
      <p class="font-bold">About comments</p>
      <ul class="list-disc pl-4">
        <li>Comments are visible after approval.</li>
        <li>Moderation is light.</li>
        <li>Double-check before trusting.</li>
      </ul>

      {
        service.strictCommentingEnabled && (
          <p class="mt-2">
            <Icon
              name="ri:verified-badge-fill"
              class="me-0.5 inline-block size-4 align-[-0.3em] text-orange-100/95"
            />
            <span class="font-medium text-orange-100/95">Proof of being a client required</span>, for this
            service.
          </p>
        )
      }

      <div class="absolute inset-y-2 right-2 flex flex-col justify-center">
        <Icon name="ri:alert-line" class="h-full max-h-16 w-auto opacity-10 xs:opacity-20" />
      </div>
    </div>
    <CommentSummary
      serviceId={service.id}
      averageUserRating={service.averageUserRating}
      trustWeightedUserRating={service.trustWeightedUserRating}
      userRatingCount={service.userRatingCount}
      trustedUserRatingCount={service.trustedUserRatingCount}
      userRatingWeight={service.userRatingWeight}
      class="grow [grid-area:rating]"
      itemReviewedId={itemReviewedId}
    />

    {
      userSentiment && service.trustWeightedUserRating !== null && (
        <Schema
          item={
            {
              '@context': 'https://schema.org',
              '@type': 'Review',
              itemReviewed: { '@id': itemReviewedId },
              reviewAspect: 'AI Summary',
              name: 'AI Summary',
              reviewBody: userSentiment.summary,
              datePublished: service.userSentimentAt?.toISOString(),
              author: {
                '@type': 'Organization',
                name: 'KYCnot.me Community',
              },
              reviewRating: {
                '@type': 'Rating',
                ratingValue: service.trustWeightedUserRating,
                worstRating: 1,
                bestRating: 5,
              },
              positiveNotes: userSentiment.whatUsersLike.map(
                (item, index) =>
                  ({
                    '@type': 'ListItem',
                    position: index + 1,
                    name: item,
                  }) satisfies ListItem
              ),
              negativeNotes: userSentiment.whatUsersDislike.map(
                (item, index) =>
                  ({
                    '@type': 'ListItem',
                    position: index + 1,
                    name: item,
                  }) satisfies ListItem
              ),
            } satisfies WithContext<Review>
          }
        />
      )
    }

    <div class="flex flex-1 grow-3 basis-64 flex-col gap-2 rounded-lg bg-night-800 p-3 [grid-area:ai]">
      <div class="flex flex-row justify-between">
        <h3 class="font-title leading-none font-bold">
          <Icon name="ri:sparkling-2-line" class="me-1 inline-block size-4 align-[-0.1em]" />AI Summary
        </h3>
        {
          service.userSentimentAt && (
            <div class="text-right text-xs text-day-500">
              Updated
              <TimeFormatted date={service.userSentimentAt} hourPrecision />
            </div>
          )
        }
      </div>

      {
        userSentiment ? (
          <>
            <div class="prose prose-sm max-w-none text-sm prose-invert">
              <Markdown content={userSentiment.summary} />
            </div>

            <div class="flex grow items-center justify-evenly">
              <ul class="inline-grid list-inside list-disc place-items-center text-sm text-day-300 marker:text-green-400 marker:content-['+_']">
                {userSentiment.whatUsersLike.map((item) => (
                  <li class="w-full">
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <ul class="inline-grid list-inside list-disc place-items-center text-sm text-day-300 marker:text-red-400 marker:content-['-_']">
                {userSentiment.whatUsersDislike.map((item) => (
                  <li class="w-full">
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </>
        ) : (
          <p class="my-2 flex flex-1 items-center justify-center text-center text-xs text-day-400">
            Not reviewed yet
          </p>
        )
      }
    </div>
  </div>
  {
    canEmbedServiceBadge && (
      <div class="mt-8 mb-12 flex justify-center">
        <a
          href={`/service/${service.slug}/badge`}
          class="inline-flex items-center gap-2 rounded-md border border-day-500/10 px-3 py-1.5 text-xs text-day-500 transition-colors hover:border-day-500/20 hover:text-day-300"
        >
          <Icon name="ri:code-s-slash-line" class="size-3.5 shrink-0" />
          <span>Embed badge on your site</span>
          <Icon name="ri:arrow-right-s-line" class="size-3.5 shrink-0" />
        </a>
      </div>
    )
  }
  <CommentSection itemReviewedId={itemReviewedId} service={service} />
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const checkboxes = document.querySelectorAll<HTMLInputElement>('input[data-mark-indeterminate]')
    checkboxes.forEach((checkbox) => {
      checkbox.indeterminate = checkbox.dataset.markIndeterminate === 'true'
    })
  })
</script>
