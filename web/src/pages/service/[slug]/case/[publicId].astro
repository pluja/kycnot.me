---
import { Icon } from 'astro-icon/components'
import { actions, isInputError } from 'astro:actions'

import CaseEvidenceGallery from '../../../../components/admin/cases/CaseEvidenceGallery.astro'
import CaseUpdatesTimeline from '../../../../components/admin/cases/CaseUpdatesTimeline.astro'
import BadgeSmall from '../../../../components/BadgeSmall.astro'
import Button from '../../../../components/Button.astro'
import CaseReportsStrip from '../../../../components/cases/CaseReportsStrip.astro'
import Lightbox from '../../../../components/Lightbox.astro'
import Markdown from '../../../../components/Markdown.astro'
import TimeFormatted from '../../../../components/TimeFormatted.astro'
import { getCaseIssueTypeInfo } from '../../../../constants/caseIssueTypes'
import { getCaseStatusInfo } from '../../../../constants/caseStatus'
import { getIncidentSeverityInfo } from '../../../../constants/incidentSeverities'
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import {
  canParticipateInCase,
  caseVisibilityTiersFor,
  isCasePublished,
  UNPUBLISHED_CASE_STATUSES,
} from '../../../../lib/caseAccess'
import { prisma } from '../../../../lib/prisma'

import type { Prisma } from '@prisma/client'

const { slug, publicId } = Astro.params
if (!slug || !publicId) return Astro.rewrite('/404')

const user = Astro.locals.user
const canManage = Astro.locals.userCan('cases:manage')

const errorsOf = <T extends { error?: unknown } | undefined>(result: T) =>
  isInputError(result?.error) ? result.error.fields : {}

const addEvidenceResult = Astro.getActionResult(actions.admin.case.evidence.add)
Astro.locals.banners.addIfSuccess(addEvidenceResult, 'Evidence added')

const deleteEvidenceResult = Astro.getActionResult(actions.admin.case.evidence.delete)
Astro.locals.banners.addIfSuccess(deleteEvidenceResult, 'Evidence removed')

const addUpdateResult = Astro.getActionResult(actions.admin.case.updates.add)
Astro.locals.banners.addIfSuccess(addUpdateResult, 'Update posted')

const editUpdateResult = Astro.getActionResult(actions.admin.case.updates.edit)
Astro.locals.banners.addIfSuccess(editUpdateResult, 'Update edited')

const deleteUpdateResult = Astro.getActionResult(actions.admin.case.updates.delete)
Astro.locals.banners.addIfSuccess(deleteUpdateResult, 'Update deleted')

const setStatusResult = Astro.getActionResult(actions.admin.case.setStatus)
Astro.locals.banners.addIfSuccess(setStatusResult, 'Case status updated')

const evidenceOrderBy = [
  { order: 'asc' },
  { createdAt: 'asc' },
] satisfies Prisma.CaseEvidenceOrderByWithRelationInput[]
const evidenceSelect = {
  id: true,
  type: true,
  description: true,
  bodyMd: true,
  imageUrl: true,
  visibility: true,
  createdAt: true,
} satisfies Prisma.CaseEvidenceSelect

// Load the case core and the data needed to decide who may see what.
const caseRow = await Astro.locals.banners.try(
  'Failed to load case',
  () =>
    prisma.case.findFirst({
      where: { publicId, service: { slug } },
      select: {
        id: true,
        title: true,
        issueType: true,
        status: true,
        summaryMd: true,
        amountText: true,
        externalSource: true,
        occurredAt: true,
        resolutionMd: true,
        createdAt: true,
        reportedById: true,
        incident: {
          select: {
            severity: true,
            state: true,
            event: { select: { id: true, title: true, visible: true, deletedAt: true } },
            cases: {
              where: { status: { notIn: UNPUBLISHED_CASE_STATUSES } },
              orderBy: { createdAt: 'desc' },
              select: { publicId: true, title: true, status: true },
            },
          },
        },
        participants: { select: { id: true } },
        service: { select: { name: true, slug: true, affiliatedUsers: { select: { userId: true } } } },
      },
    }),
  null
)

if (!caseRow) return Astro.rewrite('/404')

// Staff always reach the case. Everyone else needs it to be published.
if (!canManage && !isCasePublished(caseRow.status)) return Astro.rewrite('/404')

const canParticipate = canParticipateInCase(user, caseRow)
const visibleTiers = caseVisibilityTiersFor(user, caseRow)

const content = await Astro.locals.banners.try(
  'Failed to load case content',
  () =>
    prisma.case.findUnique({
      where: { id: caseRow.id },
      select: {
        evidence: {
          where: { caseUpdateId: null, visibility: { in: visibleTiers } },
          orderBy: evidenceOrderBy,
          select: evidenceSelect,
        },
        updates: {
          where: { visibility: { in: visibleTiers } },
          orderBy: { createdAt: 'asc' },
          select: {
            id: true,
            bodyMd: true,
            visibility: true,
            createdAt: true,
            author: { select: { name: true } },
            evidence: {
              where: { visibility: { in: visibleTiers } },
              orderBy: evidenceOrderBy,
              select: evidenceSelect,
            },
          },
        },
      },
    }),
  null
)

const evidence = content?.evidence ?? []
const updates = content?.updates ?? []

const statusInfo = getCaseStatusInfo(caseRow.status)
const issueInfo = getCaseIssueTypeInfo(caseRow.issueType)
// A hidden or soft-deleted write-up has been retracted from the service page, so
// its title must not survive here either.
const incidentEvent = caseRow.incident?.event
const incident =
  caseRow.incident && (canManage || (incidentEvent?.visible && !incidentEvent.deletedAt))
    ? caseRow.incident
    : null
const incidentSeverityInfo = incident ? getIncidentSeverityInfo(incident.severity) : null
// The report reading this page is already the page, so only the siblings matter.
const siblingReports = incident?.cases.filter((entry) => entry.publicId !== publicId) ?? []

// Only link out to http(s) sources; anything else (javascript:, data:, ...) is dropped.
const sourceUrl =
  caseRow.externalSource && /^https?:\/\//i.test(caseRow.externalSource) ? caseRow.externalSource : null
---

<BaseLayout
  pageTitle={`Case: ${caseRow.title}`}
  description={`Case against ${caseRow.service.name}`}
  widthClassName="max-w-3xl"
  noindex
>
  {
    canManage && (
      <div class="mt-8 flex flex-wrap items-center justify-between gap-2 rounded-lg border border-amber-500/30 bg-amber-950/20 p-2 text-xs text-amber-200">
        <span class="inline-flex items-center gap-1.5">
          <Icon name="ri:shield-user-line" class="size-4" />
          Staff view. You can see staff-only notes and private evidence.
        </span>
        <Button
          as="a"
          href={`/admin/cases/${caseRow.id.toString()}`}
          size="sm"
          variant="faded"
          color="gray"
          icon="ri:settings-3-line"
          label="Edit case"
        />
      </div>
    )
  }

  {
    canParticipate && !canManage && (
      <div class="mt-8 flex items-center gap-1.5 rounded-lg border border-blue-500/30 bg-blue-950/20 p-2 text-xs text-blue-200">
        <Icon name="ri:group-line" class="size-4" />
        You are a participant in this case. You can see private details and post in the conversation.
      </div>
    )
  }

  <article class="mt-6">
    <div class="flex flex-wrap items-center gap-2">
      <BadgeSmall text={statusInfo.label} variant="faded" color={statusInfo.color} icon={statusInfo.icon} />
      <BadgeSmall text={issueInfo.label} variant="faded" color="gray" icon={issueInfo.icon} />
    </div>

    <h1 class="mt-2 font-title text-3xl font-bold">{caseRow.title}</h1>

    <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-day-400">
      <a href={`/service/${caseRow.service.slug}`} class="inline-flex items-center gap-1 hover:text-day-200">
        <Icon name="ri:box-3-line" class="size-4" />
        {caseRow.service.name}
      </a>
      <span>Opened <TimeFormatted date={caseRow.createdAt} /></span>
      {
        caseRow.occurredAt && (
          <span>
            Happened <TimeFormatted date={caseRow.occurredAt} />
          </span>
        )
      }
      {caseRow.amountText && <span>Amount: {caseRow.amountText}</span>}
      {
        sourceUrl && (
          <a
            href={sourceUrl}
            rel="nofollow noopener"
            class="inline-flex items-center gap-1 hover:text-day-200"
          >
            <Icon name="ri:external-link-line" class="size-4" />
            Source
          </a>
        )
      }
    </div>

    <div class="prose prose-sm mt-4 max-w-none text-pretty wrap-anywhere text-day-200 prose-invert">
      <Markdown content={caseRow.summaryMd} />
    </div>

    {
      caseRow.resolutionMd && (
        <div class="mt-4 rounded-lg border border-green-500/30 bg-green-950/20 p-3">
          <p class="mb-1 text-xs font-semibold text-green-300">Resolution</p>
          <div class="prose prose-sm max-w-none text-pretty wrap-anywhere text-day-200 prose-invert prose-p:my-1 prose-p:first:mt-0 prose-p:last:mb-0">
            <Markdown content={caseRow.resolutionMd} />
          </div>
        </div>
      )
    }
  </article>

  {
    incident && incidentSeverityInfo && (
      <section class="mt-6 rounded-lg border border-red-500/25 bg-red-950/15 p-3">
        <h2 class="flex items-center gap-1.5 text-2xs font-semibold tracking-wide text-red-300 uppercase">
          <Icon name="ri:alarm-warning-line" class="size-3.5 shrink-0" />
          Part of a service-wide incident
        </h2>

        <a
          href={`/service/${encodeURIComponent(caseRow.service.slug)}#event-${incident.event.id.toString()}`}
          class="group mt-1.5 block"
        >
          <span class="font-title text-base font-semibold text-pretty wrap-anywhere text-day-100 group-hover:underline">
            {incident.event.title}
          </span>
        </a>

        <div class="mt-1.5 flex flex-wrap items-center gap-2">
          <BadgeSmall
            text={`${incidentSeverityInfo.label} severity`}
            variant="faded"
            color={incidentSeverityInfo.color}
            icon={incidentSeverityInfo.icon}
          />
          <BadgeSmall
            text={incident.state === 'RESOLVED' ? 'Resolved' : 'Ongoing'}
            variant="faded"
            color={incident.state === 'RESOLVED' ? 'green' : 'red'}
            icon={incident.state === 'RESOLVED' ? 'ri:checkbox-circle-line' : 'ri:time-line'}
          />
        </div>

        <p class="mt-2 text-xs text-day-400">
          Moderators found this report credible evidence for the incident above. The trust penalty applies
          once to the incident, not once per report.
        </p>

        <CaseReportsStrip
          serviceSlug={caseRow.service.slug}
          cases={siblingReports}
          heading={
            siblingReports.length === 1
              ? 'One other report in this incident'
              : `${siblingReports.length.toString()} other reports in this incident`
          }
          class="mt-3 border-red-500/20"
        />
      </section>
    )
  }

  <section class="mt-8">
    <h2 class="mb-3 font-title text-xl font-bold">Evidence</h2>
    <CaseEvidenceGallery
      caseId={caseRow.id}
      evidence={evidence}
      canManage={canManage}
      id="evidence"
      addInputErrors={errorsOf(addEvidenceResult)}
    />
  </section>

  <section class="mt-8">
    <h2 class="mb-3 font-title text-xl font-bold">Conversation</h2>
    <CaseUpdatesTimeline
      caseId={caseRow.id}
      status={caseRow.status}
      updates={updates}
      canManage={canManage}
      canPost={canManage || canParticipate}
      addInputErrors={errorsOf(addUpdateResult)}
      editInputErrors={errorsOf(editUpdateResult)}
    />
  </section>

  <Lightbox />
</BaseLayout>
