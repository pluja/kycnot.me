---
import { Icon } from 'astro-icon/components'
import { z } from 'astro:content'
import { orderBy } from 'lodash-es'

import Markdown from '../components/Markdown.astro'
import ServiceAvatarStack from '../components/ServiceAvatarStack.astro'
import SortArrowIcon from '../components/SortArrowIcon.astro'
import {
  attributeCategories,
  attributeCategoriesZodEnumBySlug,
  attributeCategorySlugToId,
  getAttributeCategoryInfo,
} from '../constants/attributeCategories'
import { attributeTypes, getAttributeTypeInfo } from '../constants/attributeTypes'
import BaseLayout from '../layouts/BaseLayout.astro'
import { nonDbAttributes, sortAttributes } from '../lib/attributes'
import { cn } from '../lib/cn'
import { listedServiceWhere } from '../lib/listedServices'
import { formatNumber } from '../lib/numbers'
import { setPublicPageCacheHeaders } from '../lib/pageCacheHeaders'
import { zodParseQueryParamsStoringErrors } from '../lib/parseUrlFilters'
import { pluralize } from '../lib/pluralize'
import { prisma } from '../lib/prisma'

const TOP_SERVICES_SHOWN = 5
const SORT_COLUMNS = ['name', 'privacy', 'trust', 'services'] as const
type SortColumn = (typeof SORT_COLUMNS)[number]

const { data: filters } = zodParseQueryParamsStoringErrors(
  {
    category: attributeCategoriesZodEnumBySlug.optional(),
    'sort-by': z.enum(SORT_COLUMNS).optional(),
    'sort-order': z.enum(['asc', 'desc']).optional(),
  },
  Astro
)

const dbAttributes = await Astro.locals.banners.try(
  'Error fetching attributes',
  () =>
    prisma.attribute.findMany({
      select: {
        id: true,
        slug: true,
        title: true,
        description: true,
        category: true,
        type: true,
        privacyPoints: true,
        trustPoints: true,
        _count: { select: { services: { where: { service: listedServiceWhere } } } },
        services: {
          where: { service: listedServiceWhere },
          orderBy: { service: { overallScore: 'desc' } },
          take: TOP_SERVICES_SHOWN,
          select: { service: { select: { slug: true, name: true, imageUrl: true } } },
        },
      },
    }),
  []
)

setPublicPageCacheHeaders(Astro.response.headers, {
  isAuthenticated: Astro.locals.user !== null,
  hasErrors: Astro.locals.banners.errors.length > 0,
})

const filterLabels: Record<string, string> = {
  'Search with this': 'With',
  'With this': 'With',
  'Without this': 'Without',
  'With this or better': 'With or better',
}

const allAttributes = [
  ...nonDbAttributes.map((attribute) => ({
    ...attribute,
    serviceCount: null,
    topServices: [],
    hiddenServiceCount: 0,
    withHref: null,
    filterLinks: attribute.links.map((link) => ({
      href: link.url,
      label: filterLabels[link.label] ?? link.label,
      isWithout: link.label === 'Without this',
    })),
  })),
  ...dbAttributes.map((attribute) => {
    const withHref = `/?attr-${attribute.id.toString()}=yes`
    return {
      ...attribute,
      serviceCount: attribute._count.services,
      topServices: attribute.services.map(({ service }) => service),
      hiddenServiceCount: attribute._count.services - attribute.services.length,
      withHref,
      filterLinks:
        attribute._count.services > 0
          ? [
              { href: withHref, label: 'With', isWithout: false },
              { href: `/?attr-${attribute.id.toString()}=no`, label: 'Without', isWithout: true },
            ]
          : [],
    }
  }),
].map((attribute) => ({
  ...attribute,
  typeInfo: getAttributeTypeInfo(attribute.type),
  categoryInfo: getAttributeCategoryInfo(attribute.category),
}))

const selectedCategory = filters.category ? attributeCategorySlugToId(filters.category) : null
const sortBy = filters['sort-by']
const defaultSortOrder = (column: SortColumn) => (column === 'name' ? 'asc' : 'desc')
const sortOrder = sortBy ? (filters['sort-order'] ?? defaultSortOrder(sortBy)) : null

const visibleAttributes = sortAttributes(
  allAttributes.filter((attribute) => !selectedCategory || attribute.category === selectedCategory)
)

const sortedAttributes = sortBy
  ? orderBy(
      visibleAttributes,
      {
        name: 'title',
        privacy: 'privacyPoints',
        trust: 'trustPoints',
        services: (attribute: (typeof visibleAttributes)[number]) => attribute.serviceCount ?? -1,
      }[sortBy],
      sortOrder ?? 'asc'
    )
  : visibleAttributes

// Unsorted, rows are grouped under category headings; once a column is
// sorted they form one list so values can be compared across categories.
const isGrouped = !sortBy && !selectedCategory
const rowGroups = isGrouped
  ? orderBy(attributeCategories, 'order')
      .map((category) => ({
        category,
        attributes: sortedAttributes.filter((attribute) => attribute.category === category.value),
      }))
      .filter((group) => group.attributes.length > 0)
  : [{ category: null, attributes: sortedAttributes }]
const showCategoryColumn = !isGrouped && !selectedCategory

const makeUrl = ({ category, column }: { category: string | undefined; column?: SortColumn }) => {
  const params = new URLSearchParams()
  if (category) params.set('category', category)
  if (column) {
    params.set('sort-by', column)
    const nextOrder = sortBy === column ? (sortOrder === 'asc' ? 'desc' : 'asc') : defaultSortOrder(column)
    if (nextOrder !== defaultSortOrder(column)) params.set('sort-order', nextOrder)
  }
  const query = params.toString()
  return query ? `/attributes?${query}` : '/attributes'
}

const categoryTabs = [
  { slug: undefined, label: 'All', icon: 'ri:list-check-3', count: allAttributes.length },
  ...orderBy(attributeCategories, 'order').map((category) => ({
    slug: category.slug,
    label: category.label,
    icon: category.icon,
    count: allAttributes.filter((attribute) => attribute.category === category.value).length,
  })),
].filter((tab) => tab.count > 0)

const sortableColumns = [
  { column: 'privacy', label: 'Privacy' },
  { column: 'trust', label: 'Trust' },
  { column: 'services', label: 'Services' },
] as const satisfies { column: SortColumn; label: string }[]

const pointsClass = (points: number) =>
  points > 0 ? 'text-green-400' : points < 0 ? 'text-red-400' : 'text-day-700'
---

<BaseLayout
  pageTitle="Privacy & Trust Attributes of No-KYC Services"
  description="Every attribute KYCnot.me tracks on no-KYC services, from IP logging to Monero support, and how many privacy and trust points each one adds to a score."
  ogImage={{
    template: 'generic',
    title: 'Service attributes',
    description: 'What we track on every no-KYC service, and how it moves the score',
    icon: 'ri:list-check-3',
  }}
  widthClassName="max-w-5xl"
>
  <header class="mt-4 mb-6">
    <h1 class="font-title text-3xl font-bold text-white">Service attributes</h1>
    <p class="mt-2 max-w-3xl text-pretty text-day-300">
      The facts we track on every no-KYC service, and the privacy and trust points each one adds to or removes
      from its score.
      <a href="/docs/scores" class="text-green-400 hover:text-green-300 hover:underline">How scores work</a>
    </p>
  </header>

  <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
    <nav
      aria-label="Filter by category"
      class="flex flex-wrap rounded-lg border border-night-600 bg-night-800 p-0.5 text-sm"
    >
      {
        categoryTabs.map((tab) => (
          <a
            href={makeUrl({ category: tab.slug, column: undefined })}
            aria-current={filters.category === tab.slug ? 'page' : undefined}
            class={cn(
              'flex items-center gap-1.5 rounded-md px-2.5 py-1 text-day-400 transition-colors hover:text-day-100',
              filters.category === tab.slug && 'bg-night-600 text-day-100'
            )}
          >
            <Icon name={tab.icon} class="size-4" />
            {tab.label}
            <span class="text-xs text-day-500 tabular-nums">{tab.count.toLocaleString()}</span>
          </a>
        ))
      }
    </nav>

    <ul class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-day-400" aria-label="Attribute types">
      {
        orderBy(attributeTypes, 'order').map((type) => (
          <li class="flex items-center gap-1">
            <Icon name={type.icon} class={cn('size-3.5', type.classNames.icon)} />
            {type.label}
          </li>
        ))
      }
    </ul>
  </div>

  <div
    class={cn(
      'grid grid-cols-[minmax(0,1fr)_auto_auto] gap-x-3 text-sm sm:gap-x-5 md:grid-cols-[minmax(0,1fr)_auto_auto_auto_auto]',
      showCategoryColumn && 'md:grid-cols-[minmax(0,1fr)_auto_auto_auto_auto_auto]'
    )}
  >
    <nav
      aria-label="Sort attributes"
      class="col-span-full grid grid-cols-subgrid border-b border-night-600 py-2 text-xs text-day-400"
    >
      <a href={makeUrl({ category: filters.category, column: 'name' })} class="hover:text-day-100">
        Attribute <SortArrowIcon active={sortBy === 'name'} sortOrder={sortOrder} />
      </a>
      {showCategoryColumn && <span class="hidden md:block">Category</span>}
      {
        sortableColumns.map(({ column, label }) => (
          <a
            href={makeUrl({ category: filters.category, column })}
            class={cn(
              'text-right whitespace-nowrap hover:text-day-100',
              column === 'services' && 'hidden md:block'
            )}
          >
            <SortArrowIcon active={sortBy === column} sortOrder={sortOrder} />
            {label}
          </a>
        ))
      }
      <span class="hidden items-center gap-1 md:flex">
        <Icon name="ri:filter-line" class="size-3.5" />
        Filter services
      </span>
    </nav>
    {
      rowGroups.map((group) => (
        <Fragment>
          {group.category && (
            <h2
              id={`category-${group.category.slug}`}
              class="col-span-full flex scroll-mt-24 items-center gap-1.5 pt-6 pb-2 font-title text-base text-green-500"
            >
              <Icon name={group.category.icon} class={cn('size-4', group.category.classNames.icon)} />
              {group.category.label}
            </h2>
          )}
          {group.attributes.map((attribute) => (
            <div
              id={attribute.slug}
              class="group col-span-full grid scroll-mt-24 grid-cols-subgrid gap-y-0.5 border-b border-night-700 py-2.5 transition-colors target:bg-green-500/10 hover:bg-night-800"
            >
              <h3 class={cn('flex items-start gap-1.5 font-semibold', attribute.typeInfo.classNames.text)}>
                <Icon
                  name={attribute.typeInfo.icon}
                  class={cn('mt-0.5 size-4 shrink-0', attribute.typeInfo.classNames.icon)}
                />
                <span class="sr-only">{attribute.typeInfo.label}:</span>
                {attribute.title}
              </h3>
              {showCategoryColumn && (
                <span class="hidden items-start gap-1.5 whitespace-nowrap text-day-400 md:flex">
                  <Icon
                    name={attribute.categoryInfo.icon}
                    class={cn('mt-0.5 size-4', attribute.categoryInfo.classNames.icon)}
                  />
                  {attribute.categoryInfo.label}
                </span>
              )}
              {[
                { label: 'Privacy points', points: attribute.privacyPoints },
                { label: 'Trust points', points: attribute.trustPoints },
              ].map(({ label, points }) => (
                <span class={cn('text-right font-medium tabular-nums', pointsClass(points))}>
                  <span class="sr-only">{label}:</span>
                  {formatNumber(points, { showSign: true })}
                </span>
              ))}
              <div class="order-last col-span-full flex items-center gap-3 pt-1.5 pl-5.5 text-xs whitespace-nowrap md:contents">
                <a
                  href={attribute.withHref ?? undefined}
                  class={cn(
                    'flex items-center justify-end gap-1.5 text-day-400',
                    attribute.withHref && 'transition-colors hover:text-day-100',
                    attribute.serviceCount === null && 'max-md:hidden'
                  )}
                  aria-label={
                    attribute.serviceCount === null
                      ? undefined
                      : `See ${attribute.serviceCount.toLocaleString()} ${pluralize('service', attribute.serviceCount)} with ${attribute.title}`
                  }
                >
                  <ServiceAvatarStack
                    services={attribute.topServices}
                    hiddenCount={attribute.hiddenServiceCount}
                    class="md:w-26 md:justify-end"
                  >
                    {attribute.serviceCount === 0 && <span class="text-day-700">0</span>}
                  </ServiceAvatarStack>
                </a>
                {attribute.filterLinks.length > 0 ? (
                  <span class="flex w-40 gap-px self-start overflow-hidden rounded-md">
                    {attribute.filterLinks.map((link) => (
                      <a
                        href={link.href}
                        title={`Show services ${link.isWithout ? 'without' : 'with'} ${attribute.title}`}
                        class={cn(
                          'group/filter flex flex-1 items-center justify-center gap-1 bg-night-600 px-2 py-0.5 font-medium text-day-200 transition-colors hover:text-white',
                          link.isWithout ? 'hover:bg-red-600' : 'hover:bg-green-600'
                        )}
                      >
                        <Icon
                          name={link.isWithout ? 'ri:filter-off-line' : 'ri:filter-line'}
                          class={cn(
                            'size-3.5 transition-colors group-hover/filter:text-white',
                            link.isWithout ? 'text-red-400' : 'text-green-400'
                          )}
                        />
                        {link.label}
                      </a>
                    ))}
                  </span>
                ) : (
                  <span class="hidden w-40 md:block" />
                )}
              </div>
              <div class="col-span-full prose prose-sm max-w-none pl-5.5 text-xs text-pretty text-day-400 prose-invert md:col-span-1 md:col-start-1 prose-p:my-0">
                <Markdown content={attribute.description} />
              </div>
            </div>
          ))}
        </Fragment>
      ))
    }
  </div>
</BaseLayout>
