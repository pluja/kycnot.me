---
import { z } from 'astro/zod'
import { Icon } from 'astro-icon/components'

import CommentFeedCard from '../components/CommentFeedCard.astro'
import FilterPill from '../components/FilterPill.astro'
import Pagination from '../components/Pagination.astro'
import ServicePicker from '../components/ServicePicker.astro'
import {
  commentIssueTypes,
  commentIssueTypesZodEnumByValue,
  getCommentIssueTypeInfo,
} from '../constants/commentIssueTypes'
import { experienceSentiments, experienceSentimentsZodEnumBySlug } from '../constants/experiences'
import BaseLayout from '../layouts/BaseLayout.astro'
import { commentFeedSelect } from '../lib/commentsWithReplies'
import { currentExperienceStates, experienceFeedPage } from '../lib/experienceQueries'
import { publishedCommentStatuses } from '../lib/experiences'
import { zodParseQueryParamsStoringErrors } from '../lib/parseUrlFilters'
import { prisma } from '../lib/prisma'
import { makeFilterUrl } from '../lib/urls'

import type { CommentForFeed } from '../lib/commentsWithReplies'
import type { ExperienceOutcome, Prisma } from '@prisma/client'

const PAGE_SIZE = 30

const { data: params, hasDefaultData: hasDefaultFilters } = zodParseQueryParamsStoringErrors(
  {
    page: z.coerce.number().int().min(1).default(1),
    service: z.string().optional(),
    issue: commentIssueTypesZodEnumByValue.optional(),
    rated: experienceSentimentsZodEnumBySlug.optional(),
    /** Day the previous page ended on, so its heading is not repeated. */
    after: z.string().optional(),
  },
  Astro
)

const where: Prisma.CommentWhereInput = {
  status: { in: publishedCommentStatuses },
  service: {
    serviceVisibility: 'PUBLIC',
    // The picker always writes a slug. A name is accepted too, so an address
    // written by hand or held over from an older link still resolves.
    ...(params.service
      ? { OR: [{ slug: params.service }, { name: { equals: params.service, mode: 'insensitive' } }] }
      : {}),
  },
  ...(params.issue ? { issues: { has: params.issue } } : {}),
}

const feedQuery = {
  select: commentFeedSelect,
  orderBy: [{ createdAt: 'desc' }, { id: 'desc' }],
  skip: (params.page - 1) * PAGE_SIZE,
  take: PAGE_SIZE,
} satisfies Prisma.CommentFindManyArgs
// The current sentiment depends on the latest published update, so that filter pages in SQL.
const loadRatedPage = async (rated: string) => {
  const page = await experienceFeedPage({
    sentiment: rated.toUpperCase(),
    service: params.service,
    issue: params.issue,
    skip: feedQuery.skip,
    take: feedQuery.take,
  })
  const posts = await prisma.comment.findMany({ select: commentFeedSelect, where: { id: { in: page.ids } } })
  const order = new Map(page.ids.map((id, index) => [id, index]))
  return [
    posts.sort((first, second) => (order.get(first.id) ?? 0) - (order.get(second.id) ?? 0)),
    page.total,
  ] as const
}

const filterUrl = (changes: Record<string, string | undefined>) => makeFilterUrl(Astro.url, changes)

const [services, [comments, totalComments]] = await Astro.locals.banners.tryMany([
  [
    'Error fetching services',
    () =>
      prisma.service.findMany({
        select: {
          id: true,
          name: true,
          slug: true,
          imageUrl: true,
          _count: { select: { comments: { where: { status: { in: publishedCommentStatuses } } } } },
        },
        where: {
          serviceVisibility: 'PUBLIC',
          comments: { some: { status: { in: publishedCommentStatuses } } },
        },
        orderBy: { name: 'asc' },
      }),
    [] as [],
  ],
  [
    'Error fetching comments',
    () =>
      params.rated ? loadRatedPage(params.rated) : prisma.comment.findManyAndCount({ ...feedQuery, where }),
    [[], 0] as [CommentForFeed[], number],
  ],
])

const outcomes = await Astro.locals.banners.try(
  'Failed to load experience outcomes',
  async () =>
    new Map(
      (await currentExperienceStates(comments.map((comment) => comment.id))).map((state) => [
        state.commentId,
        state.outcome,
      ])
    ),
  new Map<number, ExperienceOutcome>()
)

const activeService = params.service
  ? services.find(
      (service) =>
        service.slug === params.service || service.name.toLowerCase() === params.service?.toLowerCase()
    )
  : undefined

// Most talked about first, so the panel opens on something worth reading rather
// than on whatever is first alphabetically. All of them are listed; the panel
// scrolls and the search field is there for reaching the tail quickly.
const servicesByActivity = [...services].sort((a, b) => b._count.comments - a._count.comments)

// Reads as a sentence whichever filters are on: "Latest negative comments about
// ChangeNOW reporting blocked funds".
const heading = [
  'Latest',
  params.rated,
  'comments',
  activeService ? `about ${activeService.name}` : null,
  params.issue ? getCommentIssueTypeInfo(params.issue).filterPhrase : null,
]
  .filter(Boolean)
  .join(' ')

const totalPages = Math.max(1, Math.ceil(totalComments / PAGE_SIZE))

// Grouped by the day they were written, so a reader can see at a glance whether
// a run of reports about one service happened together or over months.
const dayFormatter = new Intl.DateTimeFormat('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
const today = dayFormatter.format(new Date())
const yesterday = dayFormatter.format(new Date(Date.now() - 24 * 60 * 60 * 1000))

function dayLabel(date: Date) {
  const formatted = dayFormatter.format(date)
  return formatted === today ? 'Today' : formatted === yesterday ? 'Yesterday' : formatted
}

// Flat rather than nested, because infinite scroll appends siblings: a heading
// has to be able to arrive with the comments under it. The day the previous page
// ended on rides along in the URL, so a day spanning a page boundary is not
// announced twice.
type FeedItem = { kind: 'comment'; comment: (typeof comments)[number] } | { kind: 'day'; label: string }

// Only the pages that follow one can have had their day announced already. On a
// first page the parameter is someone else's leftover, and honouring it drops
// the heading the feed opens with.
const carriedDay = params.page > 1 ? params.after : undefined

const feedItems = comments.reduce<FeedItem[]>((acc, comment, index) => {
  const label = dayLabel(comment.createdAt)
  const previousLabel =
    index === 0 ? carriedDay : dayLabel(comments[index - 1]?.createdAt ?? comment.createdAt)
  if (label !== previousLabel) acc.push({ kind: 'day', label })
  acc.push({ kind: 'comment', comment })
  return acc
}, [])

const lastComment = comments.at(-1)
const lastDayShown = lastComment ? dayLabel(lastComment.createdAt) : undefined
const nextPageUrl = (() => {
  const url = new URL(Astro.url)
  url.searchParams.set('page', String(params.page + 1))
  if (lastDayShown) url.searchParams.set('after', lastDayShown)
  return `${url.pathname}${url.search}`
})()
---

<BaseLayout
  pageTitle="Latest comments on KYC-free services"
  description="Read the newest user experiences and discussion on no-KYC exchanges, VPNs and services, including reports of requested KYC and blocked funds."
  widthClassName="max-w-5xl"
  ogImage={{
    template: 'generic',
    title: 'Latest comments',
    description: 'The newest user experiences and discussion across KYC-free services',
    icon: 'ri:chat-3-line',
  }}
  htmx
>
  <div>
    <h1 class="font-title text-2xl font-bold text-white first-letter:uppercase sm:text-3xl">{heading}</h1>
    <p class="mt-1 mb-4 text-sm text-day-400">
      What people are saying about KYC-free services right now.
      {totalComments > 0 && ` ${totalComments.toLocaleString()} comments.`}
    </p>
    {
      /* Scrolls sideways on a narrow screen rather than stacking into a wall of
        pills, and every pill is a link so none of this needs scripting. */
    }
    <div class="-mx-1 mb-2 flex items-center gap-1 overflow-x-auto px-1 pb-1">
      <FilterPill
        href={filterUrl({ rated: undefined, issue: undefined })}
        label="All"
        icon="ri:stack-line"
        active={!params.rated && !params.issue}
      />

      <span class="mx-1 h-4 w-px shrink-0 bg-night-500" aria-hidden="true"></span>

      {
        experienceSentiments.map((sentiment) => {
          const rated = sentiment.slug
          return (
            <FilterPill
              href={filterUrl({ rated: params.rated === rated ? undefined : rated })}
              label={sentiment.shortLabel}
              accessibleLabel={`${sentiment.label} experiences`}
              icon={sentiment.icon}
              color={sentiment.color}
              active={params.rated === rated}
            />
          )
        })
      }

      <span class="mx-1 h-4 w-px shrink-0 bg-night-500" aria-hidden="true"></span>

      {
        commentIssueTypes.map((issue) => (
          <FilterPill
            href={filterUrl({ issue: params.issue === issue.value ? undefined : issue.value })}
            label={issue.filterLabel}
            accessibleLabel={`Comments ${issue.filterPhrase}`}
            icon={issue.icon}
            color="red"
            active={params.issue === issue.value}
          />
        ))
      }

      <span class="mx-1 h-4 w-px shrink-0 bg-night-500" aria-hidden="true"></span>
    </div>

    <div class="mb-5 flex flex-wrap items-center gap-2">
      <ServicePicker
        services={services}
        suggested={servicesByActivity}
        selected={params.service}
        keep={{
          rated: params.rated,
          issue: params.issue,
        }}
        clearHref={filterUrl({ service: undefined })}
      />
      {
        !hasDefaultFilters && (
          <a href="/comments" class="text-sm text-day-500 hover:text-day-200 hover:underline">
            Clear all
          </a>
        )
      }
    </div>

    <p
      class="mb-5 flex items-start gap-2 rounded-lg border border-day-500/10 bg-yellow-900/50 px-3 py-2 text-sm text-yellow-400"
    >
      <Icon name="ri:information-line" class="mt-0.5 size-4 shrink-0" />
      <span>Comments are public once approved. Moderation is light. Do not trust, verify.</span>
    </p>

    {
      feedItems.length === 0 ? (
        <p class="rounded-lg border border-night-600 bg-night-800/40 p-6 text-center text-day-400">
          No comments match these filters.
        </p>
      ) : (
        <ol class="flex flex-col gap-3">
          {feedItems.map((item, i) => (
            <li
              data-hx-comment-item
              class={item.kind === 'day' ? 'mt-3 first:mt-0' : ''}
              {...(i === feedItems.length - 1 && params.page < totalPages
                ? {
                    'hx-get': nextPageUrl,
                    'hx-trigger': 'revealed',
                    'hx-swap': 'afterend',
                    'hx-select': '[data-hx-comment-item]',
                    'hx-indicator': '#infinite-scroll-indicator',
                  }
                : {})}
            >
              {item.kind === 'day' ? (
                <h2 class="font-title text-sm font-bold tracking-wide text-day-400 uppercase">
                  {item.label}
                </h2>
              ) : (
                <CommentFeedCard comment={item.comment} outcome={outcomes.get(item.comment.id)} />
              )}
            </li>
          ))}
        </ol>
      )
    }

    <div class="mt-8 flex justify-center no-js:hidden" id="infinite-scroll-indicator">
      <div class="flex items-center gap-2 opacity-0 transition-opacity duration-500 htmx-request:opacity-100">
        <Icon name="ri:loader-4-line" class="size-6 animate-spin text-green-500" />
        Loading more comments...
      </div>
    </div>

    <Pagination currentPage={params.page} totalPages={totalPages} class="mt-6 js:hidden" />
  </div>
</BaseLayout>
