---
import { Icon } from 'astro-icon/components'

import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout
  pageTitle="Message sent"
  description="Your message has been queued for moderator review."
  widthClassName="max-w-3xl"
>
  <div class="mt-16 flex flex-col items-center gap-4 text-center">
    <Icon name="ri:mail-check-line" class="size-16 text-green-400" />
    <h1 class="font-title text-3xl font-bold">Message sent</h1>
    <p class="max-w-lg text-day-300">
      Your message is queued. If you left a reply email and your message warrants one, expect an answer
      within a few days.
    </p>
    <div class="mt-4 flex gap-3 text-sm">
      <a href="/" class="rounded-md bg-night-700 px-4 py-2 hover:bg-night-600">Back to home</a>
      <a href="/about" class="rounded-md bg-night-700 px-4 py-2 hover:bg-night-600">About</a>
    </div>
  </div>
</BaseLayout>
