---
import { differenceInCalendarDays } from 'date-fns'

import { getServiceUserRoleInfo } from '../constants/serviceUserRoles'
import { staffBadgeLabel } from '../lib/permissions'

import BadgeSmall from './BadgeSmall.astro'
import Tooltip from './Tooltip.astro'

import type { CommentBadgeFields } from '../lib/commentsWithReplies'

type Props = { comment: CommentBadgeFields; serviceSlug: string }
const { comment, serviceSlug } = Astro.props
const { author } = comment
if (!author) return null
const staffLabel = staffBadgeLabel(author)
const affiliations = author.serviceAffiliations.filter((item) => item.service.slug === serviceSlug)
const isTeam = author.admin || !!staffLabel || affiliations.length > 0
const accountAgeDays = differenceInCalendarDays(comment.createdAt, author.createdAt)
const newAccount = !isTeam && accountAgeDays < 30
const onlyPost = !isTeam && !comment.parentId && author._count.comments === 1
if (!isTeam && !newAccount && !onlyPost) return null
---

<div class="flex flex-wrap items-center gap-1.5">
  {author.admin && <BadgeSmall icon="ri:shield-star-line" color="green" text="Admin" inlineIcon />}
  {
    !author.admin && staffLabel && (
      <BadgeSmall icon="ri:shield-line" color="teal" text={staffLabel} inlineIcon />
    )
  }
  {
    affiliations.map((item) => (
      <BadgeSmall
        icon={getServiceUserRoleInfo(item.role).icon}
        color="cyan"
        text={`${item.service.name} team`}
        inlineIcon
      />
    ))
  }
  {
    newAccount && (
      <Tooltip
        size="sm"
        text={
          accountAgeDays < 1
            ? 'Account created the same day.'
            : `Account was ${accountAgeDays.toString()} ${accountAgeDays === 1 ? 'day' : 'days'} old.`
        }
      >
        <BadgeSmall icon="ri:user-add-line" color="purple" text="New account" variant="faded" inlineIcon />
      </Tooltip>
    )
  }
  {
    onlyPost && (
      <Tooltip size="sm" text="The author's only post.">
        <BadgeSmall icon="ri:chat-new-line" color="purple" text="Single post" variant="faded" inlineIcon />
      </Tooltip>
    )
  }
</div>
