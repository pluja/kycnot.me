---
import { formatDateShort, type FormatDateShortOptions } from '../lib/timeAgo'

import type { HTMLAttributes } from 'astro/types'

type Props = FormatDateShortOptions &
  Omit<HTMLAttributes<'time'>, keyof FormatDateShortOptions | 'datetime'> & {
    date: Date
  }

const { date, prefix, hourPrecision, daysUntilDate, caseType, hoursShort, ...htmlProps } = Astro.props
const options = { prefix, hourPrecision, daysUntilDate, caseType, hoursShort }
---

<time datetime={date.toISOString()} {...htmlProps}>{formatDateShort(date, options)}</time>
