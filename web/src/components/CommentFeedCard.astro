---
import { Icon } from 'astro-icon/components'

import { getVerificationStatusInfo } from '../constants/verificationStatus'
import { cn } from '../lib/cn'
import { makeCommentUrl } from '../lib/commentsWithReplies'
import { postStaffRole, staffNameClasses } from '../lib/permissions'

import BadgeSmall from './BadgeSmall.astro'
import CommentAuthorBadges from './CommentAuthorBadges.astro'
import ExperienceProblems from './ExperienceProblems.astro'
import Markdown from './Markdown.astro'
import MyPicture from './MyPicture.astro'
import TimeFormatted from './TimeFormatted.astro'
import Tooltip from './Tooltip.astro'
import UserBadge from './UserBadge.astro'

import type { CommentForFeed } from '../lib/commentsWithReplies'
import type { ExperienceOutcome } from '@prisma/client'

type Props = {
  comment: CommentForFeed
  outcome?: ExperienceOutcome
}

const { comment, outcome } = Astro.props
const { service } = comment

const commentUrl = makeCommentUrl({ serviceSlug: service.slug, commentId: comment.id })

const statusInfo = getVerificationStatusInfo(service.verificationStatus)
const replyCount = comment._count.replies
const isPending = comment.status === 'PENDING'
const staffRole = postStaffRole(comment.author)
---

<article
  class={cn(
    'rounded-lg border bg-night-800/40 p-3 sm:p-4',
    isPending ? 'border-yellow-500/40' : 'border-night-600'
  )}
>
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <Tooltip text={`Service status: ${statusInfo.label}. ${statusInfo.description}`} position="right">
      <Icon
        name={statusInfo.icon}
        class={cn('size-4', statusInfo.classNames.icon)}
        aria-label={`Service status: ${statusInfo.label}`}
      />
    </Tooltip>

    <a
      href={`/service/${service.slug}#comments`}
      class="inline-flex items-center gap-2 font-title font-bold text-day-100 hover:underline"
    >
      {
        service.imageUrl && (
          <MyPicture
            src={service.imageUrl}
            alt=""
            width={20}
            height={20}
            class="size-5 shrink-0 rounded-xs"
          />
        )
      }
      {service.name}
    </a>

    {isPending && <BadgeSmall icon="ri:hourglass-line" color="yellow" text="Pending review" inlineIcon />}

    <a href={commentUrl} class="ms-auto shrink-0 text-xs text-day-500 hover:text-day-300 hover:underline">
      <TimeFormatted date={comment.createdAt} hourPrecision />
    </a>
  </div>

  <div class="prose prose-sm mt-2 max-w-none text-pretty prose-invert">
    <Markdown content={comment.content} linkRel={['ugc', 'nofollow', 'noopener']} />
  </div>

  <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-day-500">
    <UserBadge user={comment.author} class={cn(staffRole && staffNameClasses[staffRole])} />
    <CommentAuthorBadges comment={comment} serviceSlug={service.slug} />
    {
      replyCount > 0 && (
        <a href={commentUrl} class="inline-flex items-center gap-0.5 hover:text-day-300">
          <Icon name="ri:chat-1-line" class="size-3" />
          {replyCount} {replyCount === 1 ? 'reply' : 'replies'}
        </a>
      )
    }
    {outcome && <ExperienceProblems issues={comment.issues} outcome={outcome} />}
  </div>
</article>
