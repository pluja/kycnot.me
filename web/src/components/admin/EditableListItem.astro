---
import { cn } from '../../lib/cn'

import type { AstroChildren } from '../../lib/astro'

type Props = {
  id: string
  class?: string
  borderClass?: string
  children?: AstroChildren
}

const { id, class: className, borderClass = 'border-night-600' } = Astro.props
---

<div
  class={cn('rounded-md border bg-night-800 p-3', borderClass, className)}
  data-editable-item
>
  <input type="checkbox" id={`edit-${id}`} class="peer/edit sr-only" data-edit-toggle />

  <div class="flex items-start justify-between gap-3">
    <div class="grow space-y-1">
      <slot name="header" />
    </div>
    <div class="flex shrink-0 items-center gap-1.5">
      <slot name="actions" />
    </div>
  </div>

  <div class="mt-3 hidden space-y-3 rounded-md border border-night-500 bg-night-700 p-3 peer-checked/edit:block">
    <slot name="edit" />
  </div>
</div>
