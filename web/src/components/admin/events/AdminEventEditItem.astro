---
import { actions } from 'astro:actions'

import { eventToKind } from '../../../lib/eventKind'
import BadgeSmall from '../../BadgeSmall.astro'
import Button from '../../Button.astro'
import EventCard from '../../events/EventCard.astro'
import InputSubmitButton from '../../InputSubmitButton.astro'
import InputText from '../../InputText.astro'
import InputTextArea from '../../InputTextArea.astro'
import Tooltip from '../../Tooltip.astro'
import DeleteConfirmButton from '../DeleteConfirmButton.astro'
import EditToggleButton from '../EditToggleButton.astro'
import IncidentFields from '../services/edit/IncidentFields.astro'

import EventTimingFields from './EventTimingFields.astro'

import type { Prisma } from '@prisma/client'

type Props = {
  event: Prisma.EventGetPayload<{
    include: {
      createdBy: { select: { name: true; displayName: true } }
      updatedBy: { select: { name: true; displayName: true } }
      incident: true
    }
  }>
  updateInputErrors: Record<string, string[] | undefined>
  /// Appended to every action so the page returns to this section after a POST.
  sectionHash: string
  /// Purging a soft-deleted event is irreversible, so it stays admin-only.
  isAdmin: boolean
}

const { event, updateInputErrors, sectionHash, isAdmin } = Astro.props

const itemId = `event-${event.id.toString()}`
const editedBy = event.updatedBy ?? event.createdBy
---

<EventCard event={event} faded={event.deletedAt !== null}>
  <Fragment slot="badges">
    {
      event.incident && (
        <BadgeSmall
          text={`${event.incident.state === 'RESOLVED' ? 'Resolved' : 'Active'} incident`}
          variant="faded"
          color={event.incident.state === 'RESOLVED' ? 'green' : 'red'}
          icon="ri:alarm-warning-line"
        />
      )
    }
    {
      event.deletedAt ? (
        <BadgeSmall text="Deleted" variant="faded" color="red" icon="ri:delete-bin-line" />
      ) : (
        !event.visible && <BadgeSmall text="Hidden" variant="faded" color="gray" icon="ri:eye-off-line" />
      )
    }
  </Fragment>

  <Fragment slot="actions">
    {
      event.deletedAt ? (
        <>
          <Tooltip text="Restore">
            <form method="POST" action={`${actions.admin.event.restore}${sectionHash}`} class="contents">
              <input type="hidden" name="eventId" value={event.id} />
              <Button
                type="submit"
                variant="faded"
                size="sm"
                color="success"
                icon="ri:arrow-go-back-line"
                iconOnly
                label="Restore"
              />
            </form>
          </Tooltip>
          {isAdmin && (
            <DeleteConfirmButton
              action={`${actions.admin.event.purge}${sectionHash}`}
              id={itemId}
              label="Permanently delete"
            >
              <input type="hidden" name="eventId" value={event.id} />
            </DeleteConfirmButton>
          )}
        </>
      ) : (
        <>
          <Tooltip text={event.visible ? 'Hide' : 'Show'}>
            <form method="POST" action={`${actions.admin.event.toggle}${sectionHash}`} class="contents">
              <input type="hidden" name="eventId" value={event.id} />
              <Button
                type="submit"
                variant="faded"
                size="sm"
                icon={event.visible ? 'ri:eye-off-line' : 'ri:eye-line'}
                iconOnly
                label={event.visible ? 'Hide' : 'Show'}
              />
            </form>
          </Tooltip>
          {event.incident && event.incident.state !== 'RESOLVED' && (
            <Tooltip text="Resolve incident (sets resolved now)">
              <form method="POST" action={`${actions.admin.event.resolve}${sectionHash}`} class="contents">
                <input type="hidden" name="eventId" value={event.id} />
                <Button
                  type="submit"
                  variant="faded"
                  size="sm"
                  color="success"
                  icon="ri:check-double-line"
                  iconOnly
                  label="Resolve incident"
                />
              </form>
            </Tooltip>
          )}
          <EditToggleButton for={itemId} />
          <DeleteConfirmButton action={`${actions.admin.event.delete}${sectionHash}`} id={itemId}>
            <input type="hidden" name="eventId" value={event.id} />
          </DeleteConfirmButton>
        </>
      )
    }
  </Fragment>

  <Fragment slot="meta">
    {
      editedBy && (
        <p class="mt-1.5 text-2xs text-day-600">
          {event.updatedBy ? 'Last edited by' : 'Created by'} {editedBy.displayName ?? editedBy.name}
        </p>
      )
    }
  </Fragment>

  <Fragment slot="footer">
    <input type="checkbox" id={`edit-${itemId}`} class="peer/edit sr-only" />
    <div
      class="mt-3 hidden space-y-3 rounded-md border border-night-500 bg-night-700 p-3 peer-checked/edit:block"
    >
      <form method="POST" action={`${actions.admin.event.update}${sectionHash}`} class="space-y-3">
        <input type="hidden" name="eventId" value={event.id} />

        <InputText
          label="Title"
          name="title"
          inputProps={{ required: true, value: event.title }}
          error={updateInputErrors.title}
        />

        <InputTextArea
          label="Content"
          name="content"
          inputProps={{ required: true, rows: 3 }}
          value={event.content}
          error={updateInputErrors.content}
          description="Markdown supported. The first paragraph is used as the summary in banners and lists, so lead with the point."
        />

        <EventTimingFields
          startedAt={event.startedAt}
          endedAt={event.endedAt}
          errors={updateInputErrors}
        />

        <InputText
          label="Source URL"
          name="source"
          inputProps={{ type: 'url', value: event.source }}
          error={updateInputErrors.source}
        />

        <IncidentFields
          kind={eventToKind(event.class, event.sentiment)}
          incident={event.incident}
          errors={updateInputErrors}
        />

        <InputSubmitButton label="Update" icon="ri:save-line" hideCancel />
      </form>
    </div>
  </Fragment>
</EventCard>
