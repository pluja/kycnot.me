---
import { Icon } from 'astro-icon/components'
import { actions } from 'astro:actions'

import { getIncidentSeverityInfo } from '../../../constants/incidentSeverities'
import BadgeSmall from '../../BadgeSmall.astro'
import Button from '../../Button.astro'
import EventCard from '../../events/EventCard.astro'
import MyPicture from '../../MyPicture.astro'
import Tooltip from '../../Tooltip.astro'

import type { IncidentSeverity, IncidentState } from '@prisma/client'
import type { ComponentProps } from 'astro/types'

type Props = {
  event: Omit<ComponentProps<typeof EventCard>['event'], 'incident'> & {
    visible: boolean
    deletedAt: Date | null
    incident: { state: IncidentState; severity: IncidentSeverity } | null
    service: { name: string; slug: string; imageUrl: string | null }
  }
  now?: Date
}

const { event, now = new Date() } = Astro.props

const severityInfo = event.incident ? getIncidentSeverityInfo(event.incident.severity) : null
const timelineHref = `/admin/events/${encodeURIComponent(event.service.slug)}`
const editHref = event.class === 'CHANGE' ? timelineHref : `${timelineHref}#event-${event.id.toString()}`
const isDeleted = event.deletedAt !== null
---

<EventCard event={event} now={now} titleHref={editHref} faded={isDeleted} headingLevel="h2">
  <Fragment slot="badges">
    {
      severityInfo && (
        <BadgeSmall
          text={severityInfo.label}
          icon={severityInfo.icon}
          color={severityInfo.color}
          variant="faded"
        />
      )
    }
    {isDeleted && <BadgeSmall text="Deleted" icon="ri:delete-bin-line" color="red" variant="faded" />}
    {
      !isDeleted && !event.visible && (
        <BadgeSmall text="Hidden" icon="ri:eye-off-line" color="gray" variant="faded" />
      )
    }
  </Fragment>

  <Fragment slot="actions">
    {
      !isDeleted && (
        <Tooltip text={event.visible ? 'Hide from the public site' : 'Show on the public site'}>
          <form method="POST" action={actions.admin.event.toggle} class="contents">
            <input type="hidden" name="eventId" value={event.id} />
            <Button
              type="submit"
              variant="faded"
              size="sm"
              icon={event.visible ? 'ri:eye-off-line' : 'ri:eye-line'}
              iconOnly
              label={event.visible ? 'Hide' : 'Show'}
            />
          </form>
        </Tooltip>
      )
    }

    {
      event.incident && event.incident.state !== 'RESOLVED' && !isDeleted && (
        <Tooltip text="Mark this incident resolved as of now">
          <form method="POST" action={actions.admin.event.resolve} class="contents">
            <input type="hidden" name="eventId" value={event.id} />
            <Button
              type="submit"
              variant="faded"
              size="sm"
              color="success"
              icon="ri:check-double-line"
              iconOnly
              label="Resolve incident"
            />
          </form>
        </Tooltip>
      )
    }

    <Tooltip text="Open in the service timeline">
      <Button
        as="a"
        href={editHref}
        variant="faded"
        size="sm"
        icon="ri:edit-line"
        iconOnly
        label="Edit event"
      />
    </Tooltip>

    <Tooltip text="View on the public site">
      <a
        href={`/service/${encodeURIComponent(event.service.slug)}#event-${event.id.toString()}`}
        target="_blank"
        rel="noopener"
        aria-label="View on the public site"
        class="flex size-7 items-center justify-center rounded-md text-day-400 transition-colors hover:bg-night-700 hover:text-day-100"
      >
        <Icon name="ri:external-link-line" class="size-4" />
      </a>
    </Tooltip>
  </Fragment>

  <Fragment slot="meta">
    <a
      href={timelineHref}
      class="mt-1.5 inline-flex items-center gap-1.5 text-xs text-day-400 transition-colors hover:text-day-200"
    >
      <MyPicture
        src={event.service.imageUrl}
        fallback="service"
        alt=""
        class="size-4 shrink-0 rounded-xs object-contain"
        width={16}
        height={16}
      />
      {event.service.name}
    </a>
  </Fragment>
</EventCard>
