---
import { Icon } from 'astro-icon/components'

import { getCaseIssueTypeInfo } from '../../../constants/caseIssueTypes'
import { getCaseStatusInfo } from '../../../constants/caseStatus'
import BadgeSmall from '../../BadgeSmall.astro'
import MyPicture from '../../MyPicture.astro'
import TimeFormatted from '../../TimeFormatted.astro'
import Tooltip from '../../Tooltip.astro'

import type { CaseIssueType, CaseStatus } from '@prisma/client'

type Props = {
  caseRow: {
    id: number
    title: string
    status: CaseStatus
    issueType: CaseIssueType
    amountText: string | null
    createdAt: Date
    occurredAt: Date | null
    incidentId: number | null
    service: { name: string; slug: string; imageUrl: string | null }
    reportedBy: { name: string } | null
    _count: { evidence: number; updates: number; participants: number }
  }
}

const { caseRow } = Astro.props

const statusInfo = getCaseStatusInfo(caseRow.status)
const issueInfo = getCaseIssueTypeInfo(caseRow.issueType)

const counts = [
  { icon: 'ri:attachment-2', value: caseRow._count.evidence, label: 'evidence items' },
  { icon: 'ri:chat-3-line', value: caseRow._count.updates, label: 'conversation posts' },
  { icon: 'ri:group-line', value: caseRow._count.participants, label: 'participants' },
]
---

<a
  href={`/admin/cases/${caseRow.id.toString()}`}
  class="block rounded-lg border border-night-600 bg-night-800 p-3 transition-colors hover:border-night-400"
>
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <BadgeSmall text={statusInfo.label} variant="faded" color={statusInfo.color} icon={statusInfo.icon} />
    <BadgeSmall text={issueInfo.label} variant="faded" color="gray" icon={issueInfo.icon} />
    {
      caseRow.incidentId !== null && (
        <BadgeSmall text="Linked to incident" variant="faded" color="red" icon="ri:link" />
      )
    }
    {caseRow.amountText && <span class="text-xs text-day-400">{caseRow.amountText}</span>}
  </div>

  <p class="mt-1 font-semibold text-pretty wrap-anywhere text-day-100">{caseRow.title}</p>

  <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-day-500">
    <span class="inline-flex items-center gap-1.5 text-day-400">
      <MyPicture
        src={caseRow.service.imageUrl}
        fallback="service"
        alt=""
        class="size-4 shrink-0 rounded-xs object-contain"
        width={16}
        height={16}
      />
      {caseRow.service.name}
    </span>

    <span>Reported <TimeFormatted date={caseRow.createdAt} /></span>

    {
      caseRow.occurredAt && (
        <span>
          Happened <TimeFormatted date={caseRow.occurredAt} />
        </span>
      )
    }

    {caseRow.reportedBy && <span>by @{caseRow.reportedBy.name}</span>}

    <span class="ms-auto flex items-center gap-2.5">
      {
        counts.map((count) => (
          <Tooltip text={`${count.value.toString()} ${count.label}`} position="top">
            <span class="inline-flex items-center gap-1">
              <Icon name={count.icon} class="size-3.5" />
              {count.value}
            </span>
          </Tooltip>
        ))
      }
    </span>
  </div>
</a>
