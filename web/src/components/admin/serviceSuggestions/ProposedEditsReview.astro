---
import { Icon } from 'astro-icon/components'
import { actions } from 'astro:actions'

import { isListingCheckFieldId, listingCheckFieldLabels } from '../../../constants/listingCheckFields'
import { cn } from '../../../lib/cn'
import BadgeSmall from '../../BadgeSmall.astro'
import Markdown from '../../Markdown.astro'
import BeforeAfter from '../../serviceSuggestions/BeforeAfter.astro'
import KycLevelPill from '../../serviceSuggestions/KycLevelPill.astro'
import ProposalApplyBar from '../../serviceSuggestions/ProposalApplyBar.astro'
import ProposalPanel from '../../serviceSuggestions/ProposalPanel.astro'
import ProposalRow from '../../serviceSuggestions/ProposalRow.astro'

import AttributeProposalRows from './AttributeProposalRows.astro'
import ListingCheckRows from './ListingCheckRows.astro'
import TosReviewProposalRow from './TosReviewProposalRow.astro'

import type { Prisma } from '@prisma/client'

type Attribute = Prisma.AttributeGetPayload<{
  select: {
    id: true
    title: true
    description: true
    category: true
    type: true
    privacyPoints: true
    trustPoints: true
  }
}>

type Suggestion = Prisma.ServiceSuggestionGetPayload<{
  select: { id: true; status: true; proposedEdits: true }
}>

type Service = Prisma.ServiceGetPayload<{
  select: { id: true; description: true; kycLevel: true; kycPolicyMd: true; tosReview: true }
}>

type Props = {
  suggestion: Suggestion
  service: Service
  attributes: Attribute[]
  class?: string
}

const { suggestion, service, attributes, class: className } = Astro.props

const proposedEdits = suggestion.proposedEdits

// A description review carries only the description; the scan rows stay out.
const kycPolicy = proposedEdits?.kycPolicy ?? null
const proposedTosReview = proposedEdits?.tosReview ?? null
const proposedAttributes = proposedEdits?.attributes ?? { add: [], remove: [] }
const isDescriptionOnly = !!proposedEdits && !kycPolicy && !proposedTosReview

// Whether the level is still open, which is not the same as whether it differs
// from the record: a level a reviewer already turned down still differs, and
// offering it again pre-ticked is how a declined change gets applied by accident.
const kycLevelFingerprint = kycPolicy?.levelFingerprint ?? null
const kycLevelChanged = !!kycLevelFingerprint
const kycLevelDeclined = !!kycPolicy && !kycLevelFingerprint && kycPolicy.inferredLevel !== service.kycLevel
// An empty text is never offered: clearing the notes is an edit-form job, not
// a box a reviewer can tick through.
const kycNotesFingerprint = kycPolicy?.notesFingerprint ?? null
const kycPolicyChanged =
  !!kycNotesFingerprint && !!kycPolicy?.notesMd && kycPolicy.notesMd !== (service.kycPolicyMd ?? '')
const descriptionFingerprint = proposedEdits?.description?.fingerprint ?? null
const descriptionChanged =
  !!descriptionFingerprint &&
  !!proposedEdits?.description?.text &&
  proposedEdits.description.text !== service.description
const addCount = proposedAttributes.add.length
const removeCount = proposedAttributes.remove.length
const warningCount = proposedEdits?.warnings.length ?? 0
const isActionable = suggestion.status === 'PENDING' || suggestion.status === 'UNDER_REVIEW'
const currentTosReview = service.tosReview
const tosSummaryChanged =
  !!proposedTosReview && (currentTosReview?.summary ?? '') !== proposedTosReview.summary
const tosHighlightsChanged =
  !!proposedTosReview &&
  JSON.stringify(currentTosReview?.highlights ?? []) !== JSON.stringify(proposedTosReview.highlights)
const tosReviewChanged =
  !!proposedTosReview && (tosSummaryChanged || tosHighlightsChanged || !currentTosReview)

const warningSeverityIcons = {
  info: { icon: 'ri:information-line', className: 'text-blue-400' },
  warning: { icon: 'ri:alert-line', className: 'text-yellow-400' },
  alert: { icon: 'ri:error-warning-line', className: 'text-red-400' },
} as const

const attributeTitle = (attributeId: number) =>
  attributes.find((attribute) => attribute.id === attributeId)?.title ?? `Attribute #${String(attributeId)}`

// Only proposals the reviewer can actually decide on get a chip in the summary.
const summaryItems = [
  tosReviewChanged && {
    name: 'acceptTosReview',
    value: 'on',
    icon: 'ri:file-list-3-line',
    label: 'ToS review',
    detail: `${String(proposedTosReview.highlights.length)} highlights`,
  },
  kycLevelChanged && {
    name: 'acceptKycLevel',
    value: 'on',
    icon: 'ri:shield-user-line',
    label: 'KYC level',
    detail: `${String(service.kycLevel)} → ${String(kycPolicy?.inferredLevel)}`,
  },
  kycPolicyChanged && {
    name: 'acceptKycPolicy',
    value: 'on',
    icon: 'ri:file-shield-2-line',
    label: 'KYC notes',
    detail: 'rewritten',
  },
  descriptionChanged && {
    name: 'acceptDescription',
    value: 'on',
    icon: 'ri:file-text-line',
    label: 'Description',
    detail: 'rewritten',
  },
  ...(isDescriptionOnly ? [] : (proposedEdits?.listingChecks ?? [])).map((check) => ({
    name: 'listingFields',
    value: check.field,
    icon: 'ri:scales-3-line',
    label: isListingCheckFieldId(check.field) ? listingCheckFieldLabels[check.field] : check.field,
    detail: check.found,
  })),
  ...(isDescriptionOnly ? [] : proposedAttributes.add).map((proposal) => ({
    name: 'attributeAddIds',
    value: proposal.attributeId,
    icon: 'ri:add-circle-line',
    label: attributeTitle(proposal.attributeId),
    detail: '',
  })),
  ...(isDescriptionOnly ? [] : proposedAttributes.remove).map((proposal) => ({
    name: 'attributeRemoveIds',
    value: proposal.attributeId,
    icon: 'ri:indeterminate-circle-line',
    label: attributeTitle(proposal.attributeId),
    detail: '',
  })),
].filter((item) => !!item)
---

{
  proposedEdits && (
    <ProposalPanel
      title="Proposed changes"
      description={`${isDescriptionOnly ? 'Description review' : 'Deep scan'} · suggestion #${String(suggestion.id)}`}
      class={className}
    >
      <Fragment slot="badges">
        {!isDescriptionOnly && (
          <BadgeSmall
            color={kycLevelChanged ? 'orange' : 'gray'}
            text={kycLevelChanged ? 'KYC change' : 'KYC unchanged'}
            icon={kycLevelChanged ? 'ri:exchange-line' : 'ri:checkbox-circle-line'}
          />
        )}
        {(addCount > 0 || removeCount > 0) && (
          <BadgeSmall color="blue" text={`${addCount + removeCount} attributes`} icon="ri:price-tag-3-line" />
        )}
        {warningCount > 0 && (
          <BadgeSmall color="yellow" text={`${warningCount} warnings`} icon="ri:alert-line" />
        )}
      </Fragment>

      <form method="POST" action={actions.admin.service.deepScan.apply} class="mt-4 space-y-4">
        <input type="hidden" name="suggestionId" value={suggestion.id} />

        <ul class="divide-y divide-night-600 rounded-md border border-night-600 bg-night-800">
          {proposedTosReview && (
            <TosReviewProposalRow
              currentTosReview={currentTosReview}
              proposedTosReview={proposedTosReview}
              changed={tosReviewChanged}
              isActionable={isActionable}
            />
          )}

          {kycPolicy && (
            <ProposalRow
              icon="ri:shield-user-line"
              label="KYC level"
              checkbox={{
                name: 'acceptKycLevel',
                value: 'on',
                checked: kycLevelChanged,
                disabled: !isActionable || !kycLevelChanged,
              }}
            >
              <Fragment slot="badges">
                {kycLevelDeclined ? (
                  <BadgeSmall color="gray" text="Previously declined" icon="ri:indeterminate-circle-line" />
                ) : (
                  !kycLevelChanged && (
                    <BadgeSmall color="gray" text="No change" icon="ri:checkbox-circle-line" />
                  )
                )}
              </Fragment>

              {/* A disabled checkbox is not submitted, so without this the server
                  cannot tell "left unticked" from "never offered" and would record
                  a decline the reviewer never made. */}
              {isActionable && kycLevelFingerprint && (
                <input type="hidden" name="kycLevelFingerprint" value={kycLevelFingerprint} />
              )}
              <BeforeAfter>
                <KycLevelPill slot="before" level={service.kycLevel} />
                <KycLevelPill slot="after" level={kycPolicy.inferredLevel} />
              </BeforeAfter>
              {!!kycPolicy.rationale && <p class="mt-2 text-day-400">{kycPolicy.rationale}</p>}
            </ProposalRow>
          )}

          {kycPolicy && (
            <ProposalRow
              icon="ri:file-shield-2-line"
              label="KYC policy notes"
              checkbox={{
                name: 'acceptKycPolicy',
                value: 'on',
                checked: kycPolicyChanged,
                disabled: !isActionable || !kycPolicyChanged,
              }}
            >
              <Fragment slot="badges">
                {kycPolicyChanged ? (
                  <BadgeSmall
                    color="orange"
                    text={service.kycPolicyMd ? 'Text update' : 'New notes'}
                    icon="ri:file-edit-line"
                  />
                ) : (
                  <BadgeSmall color="gray" text="No change" icon="ri:checkbox-circle-line" />
                )}
              </Fragment>

              {isActionable && kycPolicyChanged && (
                <input type="hidden" name="kycNotesFingerprint" value={kycNotesFingerprint} />
              )}
              {kycPolicyChanged && (
                <BeforeAfter beforeLabel="Current notes" afterLabel="Proposed notes">
                  {service.kycPolicyMd && (
                    <div slot="before" class="prose prose-sm max-w-none text-day-400 prose-invert">
                      <Markdown content={service.kycPolicyMd} />
                    </div>
                  )}
                  <div slot="after" class="prose prose-sm max-w-none text-day-200 prose-invert">
                    <Markdown content={kycPolicy.notesMd} />
                  </div>
                </BeforeAfter>
              )}
            </ProposalRow>
          )}

          <ProposalRow
            icon="ri:file-text-line"
            label="Description"
            checkbox={{
              name: 'acceptDescription',
              value: 'on',
              checked: descriptionChanged,
              disabled: !isActionable || !descriptionChanged,
            }}
          >
            <Fragment slot="badges">
              {descriptionChanged ? (
                <BadgeSmall color="orange" text="Text update" icon="ri:file-edit-line" />
              ) : (
                <BadgeSmall color="gray" text="No change" icon="ri:checkbox-circle-line" />
              )}
            </Fragment>

            {isActionable && descriptionChanged && (
              <input type="hidden" name="descriptionFingerprint" value={descriptionFingerprint} />
            )}
            {descriptionChanged && proposedEdits.description && (
              <>
                <BeforeAfter>
                  <Fragment slot="before">{service.description}</Fragment>
                  <Fragment slot="after">{proposedEdits.description.text}</Fragment>
                </BeforeAfter>
                {proposedEdits.description.reasons.length > 0 && (
                  <p class="mt-2 text-xs text-day-500">{proposedEdits.description.reasons.join('. ')}.</p>
                )}
              </>
            )}
          </ProposalRow>

          {!isDescriptionOnly && (
            <ListingCheckRows checks={proposedEdits.listingChecks ?? []} isActionable={isActionable} />
          )}

          {!isDescriptionOnly && (
            <AttributeProposalRows
              add={proposedAttributes.add}
              remove={proposedAttributes.remove}
              attributes={attributes}
              isActionable={isActionable}
            />
          )}
        </ul>

        {warningCount > 0 && (
          <details class="rounded-md border border-yellow-500/20 bg-yellow-500/5 p-3">
            <summary class="cursor-pointer list-none">
              <div class="inline-flex items-center gap-2 font-title text-sm font-semibold text-yellow-100">
                <Icon name="ri:alert-line" class="size-4 text-yellow-400" />
                Review {warningCount} warning{warningCount === 1 ? '' : 's'}
              </div>
            </summary>
            <ul class="mt-3 space-y-2">
              {proposedEdits.warnings.map((warning) => {
                const severityInfo = warningSeverityIcons[warning.severity]
                return (
                  <li class="flex items-start gap-3 rounded-sm border border-night-600 bg-night-900 p-3 text-sm">
                    <Icon
                      name={severityInfo.icon}
                      class={cn('mt-0.5 size-4 shrink-0', severityInfo.className)}
                    />
                    <div class="min-w-0 flex-1">
                      <div class="font-semibold text-day-100">{warning.title}</div>
                      <div class="prose prose-sm mt-1 max-w-none text-pretty text-day-400 prose-invert">
                        <Markdown content={warning.bodyMd} />
                      </div>
                    </div>
                  </li>
                )
              })}
            </ul>
          </details>
        )}

        {summaryItems.length === 0 && (
          <div class="rounded-md border border-night-600 bg-night-800 p-3 text-sm text-day-400">
            No direct service-record changes were proposed. Warnings and ToS evidence remain available for
            review.
          </div>
        )}

        {isActionable ? (
          <ProposalApplyBar
            items={summaryItems}
            note="Unticked proposals are declined and not proposed again until the page they came from changes."
            emptyButton={
              summaryItems.length > 0
                ? { label: 'Decline all', icon: 'ri:close-line' }
                : { label: 'Close as reviewed', icon: 'ri:check-double-line', color: 'gray' }
            }
            discardButton={{
              formaction: actions.admin.service.deepScan.dismiss,
              tooltip:
                'Close this proposal without applying or remembering anything. The next scan may propose the same again.',
            }}
          />
        ) : (
          <div class="rounded-md border border-night-600 bg-night-800 p-3 text-sm text-day-400">
            This suggestion is {suggestion.status.toLowerCase().replace('_', ' ')} and can no longer be
            applied from this panel.
          </div>
        )}
      </form>
    </ProposalPanel>
  )
}
