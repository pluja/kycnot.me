---
import BadgeSmall from '../../BadgeSmall.astro'
import Markdown from '../../Markdown.astro'
import BeforeAfter from '../../serviceSuggestions/BeforeAfter.astro'
import ProposalRow from '../../serviceSuggestions/ProposalRow.astro'

import TosHighlightList from './TosHighlightList.astro'

import type { MarkdownString } from '../../../lib/markdown'

type TosReview = {
  summary: MarkdownString
  highlights: {
    title: string
    content: MarkdownString
    rating: 'negative' | 'neutral' | 'positive'
    evidence?: string
    sourceUrl?: string
  }[]
}

type Props = {
  currentTosReview: TosReview | null
  proposedTosReview: TosReview
  changed: boolean
  isActionable: boolean
}

const { currentTosReview, proposedTosReview, changed, isActionable } = Astro.props
---

<ProposalRow
  icon="ri:file-list-3-line"
  label="Publish this ToS review"
  checkbox={{ name: 'acceptTosReview', value: 'on', checked: changed, disabled: !isActionable || !changed }}
>
  <Fragment slot="badges">
    {
      currentTosReview ? (
        <BadgeSmall
          color={changed ? 'orange' : 'gray'}
          text={changed ? 'Changed' : 'Same as current'}
          icon={changed ? 'ri:arrow-left-right-line' : 'ri:checkbox-circle-line'}
        />
      ) : (
        <BadgeSmall color="blue" text="No current review" icon="ri:information-line" />
      )
    }
  </Fragment>

  <p class="mb-3 text-xs text-day-500">The public ToS summary and highlights on the service page.</p>
  <BeforeAfter beforeLabel="Current published" afterLabel="Scan result">
    {
      currentTosReview && (
        <div slot="before" class="prose prose-sm max-w-none text-day-400 prose-invert">
          {currentTosReview.summary ? (
            <Markdown content={currentTosReview.summary} />
          ) : (
            <p class="italic">(empty summary)</p>
          )}
        </div>
      )
    }
    <div slot="after" class="prose prose-sm max-w-none text-day-200 prose-invert">
      <Markdown content={proposedTosReview.summary} />
    </div>
    {currentTosReview && <TosHighlightList slot="before-details" highlights={currentTosReview.highlights} />}
    <TosHighlightList slot="after-details" highlights={proposedTosReview.highlights} />
  </BeforeAfter>
</ProposalRow>
