---
import { Icon } from 'astro-icon/components'
import { differenceInDays } from 'date-fns'

import { cn } from '../../../lib/cn'
import BadgeSmall from '../../BadgeSmall.astro'
import TimeFormatted from '../../TimeFormatted.astro'
import Tooltip from '../../Tooltip.astro'


import type {
  CommentIssueType,
  CommentStatus,
  PrivateProofStatus,
  RatingMuteReason,
} from '@prisma/client'
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'div'> & {
  comment: {
    id: number
    rating: number | null
    ratingActive: boolean
    ratingMuted: boolean
    ratingMuteReason: RatingMuteReason | null
    ratingWeight: number
    ratingTrustLabel: string | null
    ratingTrustReason: string | null
    status: CommentStatus
    privateProof: string | null
    privateProofStatus: PrivateProofStatus | null
    issues: CommentIssueType[]
    author: {
      createdAt: Date
      lastLoginAt: Date
      totalKarma: number
      verified: boolean
      spammer: boolean
      _count: { comments: number }
    }
  }
}

const { comment, class: className, ...htmlProps } = Astro.props

const accountAgeDays = differenceInDays(new Date(), comment.author.createdAt)
const accountAgeLabel = accountAgeDays === 0 ? 'today' : `${accountAgeDays.toLocaleString()}d old`
const commentCount = comment.author._count.comments
const commentCountLabel = `${commentCount.toLocaleString()} ${commentCount === 1 ? 'comment' : 'comments'}`
const ratingInfluence = Math.round(comment.ratingWeight * 100)
const ratingCounts =
  comment.rating !== null &&
  !comment.ratingMuted &&
  comment.ratingActive &&
  (comment.status === 'APPROVED' || comment.status === 'VERIFIED') &&
  comment.ratingWeight > 0

const issueLabels: Record<CommentIssueType, string> = {
  KYC_REQUESTED: 'KYC requested',
  FUNDS_BLOCKED: 'Funds blocked',
}

const muteReasonLabels: Record<RatingMuteReason, string> = {
  AUTHOR_AFFILIATED: 'Author affiliated',
  AUTHOR_LOW_TRUST: 'Author low trust',
  SUSPICIOUS_PATTERN: 'Suspicious pattern',
  TEMPLATE_SPAM: 'Template spam',
  CONFLICT_OF_INTEREST: 'Conflict of interest',
  MODERATOR_DISCRETION: 'Moderator discretion',
}

const proofTextClass: Record<PrivateProofStatus, string> = {
  APPROVED: 'text-green-400',
  REJECTED: 'text-red-400',
  PENDING: 'text-purple-300',
  WITHDRAWN: 'text-day-500',
}

// Color only the alarming author signals so the eye lands on what should move
// a decision (new account, negative karma, first-timer). Everything else stays
// neutral.
const karmaClass =
  comment.author.totalKarma < 0
    ? 'text-red-400 font-medium'
    : comment.author.totalKarma >= 25
      ? 'text-lime-400'
      : 'text-day-300'
const ageClass = accountAgeDays < 7 ? 'text-purple-300' : 'text-day-300'
const countClass = commentCount <= 1 ? 'text-yellow-300' : 'text-day-300'

const labelClass = 'w-12 shrink-0 text-[10px] font-semibold tracking-wide text-day-600 uppercase'
const dotClass = 'text-day-700'
---

<div {...htmlProps} class:list={['space-y-1.5 text-xs', className]}>
  <!-- Author: trust signals, ordered by how much each should move a decision. -->
  <div class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
    <span class={labelClass}>Author</span>
    <Tooltip text="Author karma (trust score)">
      <span class={karmaClass}>{comment.author.totalKarma.toLocaleString()} karma</span>
    </Tooltip>
    <span class={dotClass}>·</span>
    <Tooltip text={`Account created ${comment.author.createdAt.toLocaleString()}`}>
      <span class={ageClass}>{accountAgeLabel}</span>
    </Tooltip>
    <span class={dotClass}>·</span>
    <span class={countClass}>{commentCountLabel}</span>
    {
      comment.author.verified && (
        <BadgeSmall icon="ri:verified-badge-fill" color="cyan" text="Verified" inlineIcon />
      )
    }
    {comment.author.spammer && <BadgeSmall icon="ri:spam-2-fill" color="red" text="Spammer" inlineIcon />}
    <span class={dotClass}>·</span>
    <Tooltip text={`Last login ${comment.author.lastLoginAt.toLocaleString()}`}>
      <span class="text-day-500">seen <TimeFormatted date={comment.author.lastLoginAt} hourPrecision /></span>
    </Tooltip>
  </div>

  <!-- This review: how the rating is treated, then the claims flagged on it. -->
  <div class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
    <span class={labelClass}>Review</span>
    {
      comment.rating !== null ? (
        <>
          <span
            class={cn(
              'flex items-center gap-0.5',
              ratingCounts ? 'text-yellow-400' : 'text-zinc-500 line-through decoration-zinc-600'
            )}
            title={`User rating: ${comment.rating}/5`}
          >
            {Array.from({ length: 5 }).map((_, i) => (
              <Icon name={i < (comment.rating ?? 0) ? 'ri:star-fill' : 'ri:star-line'} class="size-3.5" />
            ))}
            <span class="ml-0.5 text-[11px] font-medium">{comment.rating}/5</span>
          </span>
          <Tooltip text={comment.ratingTrustReason ?? 'Rating trust'}>
            <span class="text-[11px] text-day-500">
              {ratingCounts ? (
                <>
                  counts · weight <span class="text-day-200">{comment.ratingWeight.toFixed(2)}</span> ·{' '}
                  {ratingInfluence}% influence
                </>
              ) : (
                <>
                  not counted
                  {comment.ratingMuted && comment.ratingMuteReason
                    ? ` · ${muteReasonLabels[comment.ratingMuteReason]}`
                    : comment.ratingTrustReason
                      ? ` · ${comment.ratingTrustReason}`
                      : ''}
                </>
              )}
            </span>
          </Tooltip>
        </>
      ) : (
        <span class="text-day-500">No rating</span>
      )
    }
    {
      comment.issues.map((issue) => (
        <>
          <span class={dotClass}>·</span>
          <span class="flex items-center gap-0.5 text-red-400" title="Issue flagged on this review">
            <Icon name="ri:alert-line" class="size-3" />
            {issueLabels[issue]}
          </span>
        </>
      ))
    }
    {
      comment.privateProof && (
        <>
          <span class={dotClass}>·</span>
          <span
            class={cn(
              'flex items-center gap-0.5',
              comment.privateProofStatus ? proofTextClass[comment.privateProofStatus] : 'text-purple-300'
            )}
            title="Private proof of usage attached to this review"
          >
            <Icon name="ri:key-2-line" class="size-3" />
            proof {comment.privateProofStatus?.toLowerCase() ?? 'pending'}
          </span>
        </>
      )
    }
  </div>
</div>
