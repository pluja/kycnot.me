---
import FormSection from '../../../FormSection.astro'
import FormSubSection from '../../../FormSubSection.astro'
import JobCard from './JobCard.astro'
import ProposedEditsReview from '../../serviceSuggestions/ProposedEditsReview.astro'

import type { Prisma } from '@prisma/client'

type Attribute = Prisma.AttributeGetPayload<{
  select: {
    id: true
    title: true
    description: true
    category: true
    type: true
    privacyPoints: true
    trustPoints: true
  }
}>

type Suggestion = Prisma.ServiceSuggestionGetPayload<{
  select: { id: true; status: true; createdAt: true; proposedEdits: true }
}>

type ScanJob = Prisma.ServiceScanJobGetPayload<{
  select: { id: true; kind: true; createdAt: true; claimedAt: true; processedAt: true; error: true }
}>

type Service = Prisma.ServiceGetPayload<{
  select: {
    id: true
    description: true
    kycLevel: true
    kycPolicyMd: true
    tosUrls: true
    serviceUrls: true
    tosReview: true
  }
}>

type Props = {
  service: Service
  scanJob: ScanJob | null
  descriptionJob: ScanJob | null
  pendingSuggestion: Suggestion | null
  attributes: Attribute[]
  id?: string
}

const { service, scanJob, descriptionJob, pendingSuggestion, attributes, id = 'tasks' } = Astro.props

const proposedEdits = pendingSuggestion?.proposedEdits ?? null
const sectionHash = `#${id}`
---

<FormSection title="Tasks" id={id}>
  <FormSubSection
    title="Jobs"
    subtitle="Each job proposes edits for a person to review. Nothing is published on its own."
  >
    <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
      <JobCard
        serviceId={service.id}
        kind="DEEP_SCAN"
        job={scanJob}
        title="Deep scan"
        description="Reads the terms and linked legal pages. Proposes the KYC level, attributes, KYC notes and warnings."
        icon="ri:sparkling-2-line"
        action="Run scan"
        blocker={service.tosUrls.length === 0 ? 'Add a ToS URL in the details first.' : null}
        resultHref={pendingSuggestion ? `#${id}-review` : null}
        sectionId={id}
      />
      <JobCard
        serviceId={service.id}
        kind="DESCRIPTION"
        job={descriptionJob}
        title="Description review"
        description="Reads the front page only. Proposes a description that follows the editorial rule."
        icon="ri:quill-pen-line"
        action="Review"
        blocker={service.serviceUrls.length === 0 ? 'Add a service URL in the details first.' : null}
        resultHref={pendingSuggestion ? `#${id}-review` : null}
        sectionId={id}
      />
    </div>
  </FormSubSection>

  {
    !!proposedEdits && !!pendingSuggestion && (
      <FormSubSection title="Proposed edits awaiting review" id={`${id}-review`} class="scroll-mt-24">
        <ProposedEditsReview
          suggestion={pendingSuggestion}
          service={service}
          attributes={attributes}
          title="Deep scan proposed edits"
          compactHeader
          actionHash={sectionHash}
        />
      </FormSubSection>
    )
  }
</FormSection>
