---
import { proposalJobKind } from '../../../../lib/scanJobs'
import FormSection from '../../../FormSection.astro'
import FormSubSection from '../../../FormSubSection.astro'
import JobCard from './JobCard.astro'

import type { Prisma, ServiceScanJobKind } from '@prisma/client'

type Suggestion = Prisma.ServiceSuggestionGetPayload<{
  select: { id: true; proposedEdits: true }
}>

type ScanJob = Prisma.ServiceScanJobGetPayload<{
  select: {
    id: true
    kind: true
    createdAt: true
    claimedAt: true
    processedAt: true
    error: true
  }
}>

type Props = {
  service: Prisma.ServiceGetPayload<{ select: { id: true; tosUrls: true; serviceUrls: true } }>
  scanJob: ScanJob | null
  descriptionJob: ScanJob | null
  pendingSuggestions: Suggestion[]
  id?: string
}

const { service, scanJob, descriptionJob, pendingSuggestions, id = 'tasks' } = Astro.props

const pendingFor = (kind: ServiceScanJobKind) =>
  pendingSuggestions.find((s) => s.proposedEdits && proposalJobKind(s.proposedEdits) === kind) ?? null
---

<FormSection title="Tasks" id={id}>
  <FormSubSection
    title="Jobs"
    subtitle="Each job proposes edits for a person to review. A job cannot run again until its proposal is reviewed or dismissed."
  >
    <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
      <JobCard
        serviceId={service.id}
        kind="DEEP_SCAN"
        job={scanJob}
        title="Deep scan"
        description="Reads the terms and linked legal pages. Proposes the KYC level, attributes, KYC notes and warnings."
        icon="ri:sparkling-2-line"
        action="Run scan"
        blocker={service.tosUrls.length === 0 ? 'Add a ToS URL in the details first.' : null}
        pendingSuggestion={pendingFor('DEEP_SCAN')}
        sectionId={id}
      />
      <JobCard
        serviceId={service.id}
        kind="DESCRIPTION"
        job={descriptionJob}
        title="Description review"
        description="Reads the front page only. Proposes a description that follows the editorial rule."
        icon="ri:quill-pen-line"
        action="Review"
        blocker={service.serviceUrls.length === 0 ? 'Add a service URL in the details first.' : null}
        pendingSuggestion={pendingFor('DESCRIPTION')}
        sectionId={id}
      />
    </div>
  </FormSubSection>
</FormSection>
