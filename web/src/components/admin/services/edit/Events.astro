---
import { Icon } from 'astro-icon/components'

import { cn } from '../../../../lib/cn'
import FormSection from '../../../FormSection.astro'
import AdminEventEditItem from '../../events/AdminEventEditItem.astro'
import EventCreateForm from '../../events/EventCreateForm.astro'

import type { Prisma } from '@prisma/client'

type Props = {
  serviceId: number
  /// Null on a page whose own heading already says "events".
  title?: string | null
  events: Prisma.EventGetPayload<{
    include: {
      createdBy: { select: { name: true; displayName: true } }
      updatedBy: { select: { name: true; displayName: true } }
      incident: true
    }
  }>[]
  createInputErrors: Record<string, string[] | undefined>
  updateInputErrors: Record<string, string[] | undefined>
  id?: string
}

const {
  serviceId,
  events,
  createInputErrors,
  updateInputErrors,
  id = 'events',
  title = 'Events',
} = Astro.props

const isAdmin = Astro.locals.user?.admin ?? false
const sectionHash = `#${id}`

const sortedEvents = [...events].sort((a, b) => b.startedAt.getTime() - a.startedAt.getTime())
// Listing edits are auto-recorded and outnumber curated entries many times over,
// so they stay behind a disclosure.
const curatedEvents = sortedEvents.filter((event) => event.class !== 'CHANGE')
const changeEvents = sortedEvents.filter((event) => event.class === 'CHANGE')
---

<FormSection title={title ?? undefined} id={id} class={cn('scroll-mt-24', title === null && 'mt-0')}>
  <EventCreateForm
    serviceId={serviceId}
    inputErrors={createInputErrors}
    sectionHash={sectionHash}
    open={events.length === 0}
    id={`${id}-new`}
  />

  {
    events.length === 0 ? (
      <p class="mt-3 rounded-xl border border-night-600 bg-night-800 p-6 text-center text-day-300">
        No events yet.
      </p>
    ) : (
      <>
        {curatedEvents.length > 0 && (
          <div class="mt-3 space-y-2">
            {curatedEvents.map((event) => (
              <AdminEventEditItem
                event={event}
                updateInputErrors={updateInputErrors}
                sectionHash={sectionHash}
                isAdmin={isAdmin}
              />
            ))}
          </div>
        )}

        {changeEvents.length > 0 && (
          <details class="group/changes mt-3">
            <summary class="flex w-fit cursor-pointer list-none items-center gap-2 py-1 text-sm text-day-500 transition-colors hover:text-day-300 [&::-webkit-details-marker]:hidden">
              <Icon name="ri:pencil-line" class="size-4 shrink-0" />
              Listing edits ({changeEvents.length})
              <Icon
                name="ri:arrow-down-s-line"
                class="size-4 shrink-0 transition-transform group-open/changes:rotate-180"
              />
            </summary>
            <div class="mt-2 space-y-2">
              {changeEvents.map((event) => (
                <AdminEventEditItem
                  event={event}
                  updateInputErrors={updateInputErrors}
                  sectionHash={sectionHash}
                  isAdmin={isAdmin}
                />
              ))}
            </div>
          </details>
        )}
      </>
    )
  }
</FormSection>
