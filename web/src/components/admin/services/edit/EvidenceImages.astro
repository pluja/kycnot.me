---
import { Icon } from 'astro-icon/components'
import { actions } from 'astro:actions'

import FormSection from '../../../FormSection.astro'
import FormSubSection from '../../../FormSubSection.astro'
import InputImageFile from '../../../InputImageFile.astro'
import InputSubmitButton from '../../../InputSubmitButton.astro'
import LightboxImage from '../../../LightboxImage.astro'
import TimeFormatted from '../../../TimeFormatted.astro'
import DeleteConfirmButton from '../../DeleteConfirmButton.astro'

import type { ImageFileInfo } from '../../../../lib/fileStorage'

type Props = {
  serviceId: number
  evidenceImages: ImageFileInfo[]
  addInputErrors: Record<string, string[] | undefined>
  id?: string
}

const { serviceId, evidenceImages, addInputErrors, id = 'evidence-images' } = Astro.props
const addImageSectionId = `${id}-add`
const sectionHash = `#${id}`
const addImageSectionHash = `#${addImageSectionId}`
const watermarkId = `${id}-watermark`
---

<FormSection title="Evidence Images" id={id}>
  <FormSubSection title={`Existing Evidence Images (${evidenceImages.length})`}>
    {
      evidenceImages.length === 0 ? (
        <p class="rounded-xl border border-night-600 bg-night-800 p-6 text-center text-day-300">
          No evidence images yet.
        </p>
      ) : (
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
          {evidenceImages.map((image, index) => (
            <div class="group relative rounded-md border border-night-600 bg-night-800 p-2">
              <LightboxImage src={image.url} alt="Evidence image" />
              <div class="absolute top-1 right-1 flex opacity-0 transition-opacity group-hover:opacity-100 focus-within:opacity-100 has-checked:opacity-100">
                <DeleteConfirmButton
                  action={`${actions.admin.service.evidenceImage.delete}${sectionHash}`}
                  id={`evidence-image-${index.toString()}`}
                  label="Delete image"
                >
                  <input type="hidden" name="fileUrl" value={image.url} />
                </DeleteConfirmButton>
              </div>

              <div class="mt-2 space-y-1">
                <p class="text-xs text-day-500">
                  <TimeFormatted date={image.date} hourPrecision />
                </p>
                <input
                  type="text"
                  readonly
                  value={`![Evidence](${image.url})`}
                  class="w-full cursor-text rounded-sm border bg-night-700 p-1.5 font-mono text-xs text-day-200 select-all"
                />
              </div>
            </div>
          ))}
        </div>
      )
    }
  </FormSubSection>
  <FormSubSection title="Add New Evidence Image" id={addImageSectionId}>
    <form
      method="POST"
      action={`${actions.admin.service.evidenceImage.add}${addImageSectionHash}`}
      class="space-y-4"
      enctype="multipart/form-data"
    >
      <input type="hidden" name="serviceId" value={serviceId} />
      <InputImageFile
        label="Upload Image"
        name="imageFile"
        description="Upload an evidence image."
        error={addInputErrors.imageFile}
        required
      />
      <div class="flex items-center gap-3 rounded-lg border border-night-400 bg-night-600 p-3">
        <input
          type="checkbox"
          id={watermarkId}
          name="watermark"
          value="true"
          checked
          class="size-4 rounded-sm border-zinc-600 bg-zinc-800 text-blue-500 focus:ring-blue-500"
        />
        <label for={watermarkId} class="flex items-center gap-2 text-sm text-day-200">
          <Icon name="ri:drop-line" class="size-4 text-day-400" />
          Apply KYCNOT.ME watermark to the image
        </label>
      </div>
      <InputSubmitButton label="Add Image" icon="ri:add-line" hideCancel />
    </form>
  </FormSubSection>
</FormSection>
