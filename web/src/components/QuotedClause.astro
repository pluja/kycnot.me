---
import { cn } from '../lib/cn'
import { safeHttpUrl } from '../lib/exchange/safeUrl'

type Props = {
  quote?: string | null
  sourceUrl?: string | null
  class?: string
}

const { quote, sourceUrl, class: className } = Astro.props
// Model-authored, over text the service publishes, so the scheme is not ours
// to trust.
const safeSource = safeHttpUrl(sourceUrl)
---

{
  quote && (
    <details class={cn('mt-1 text-xs text-day-400', className)}>
      <summary class="cursor-pointer select-none hover:text-day-200">Quoted clause</summary>
      <blockquote class="mt-1 border-l-2 border-l-night-600 ps-2 text-pretty italic">{quote}</blockquote>
      {safeSource && (
        <a
          href={safeSource}
          rel="nofollow noopener noreferrer"
          class="mt-1 inline-block break-all hover:underline"
        >
          {safeSource}
        </a>
      )}
    </details>
  )
}
