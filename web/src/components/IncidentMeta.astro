---
import { Icon } from 'astro-icon/components'

import { safeHttpUrl } from '../lib/exchange/safeUrl'

type Props = {
  amountText: string | null
  source: string | null
}

const { amountText, source } = Astro.props
const safeSource = safeHttpUrl(source)
---

{
  (amountText || safeSource) && (
    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-day-800/60 pt-2.5 text-xs text-day-500">
      {amountText && (
        <span class="inline-flex items-center gap-1">
          <Icon name="ri:coins-line" class="size-3.5" />
          {amountText}
        </span>
      )}
      {safeSource && (
        <a
          href={safeSource}
          target="_blank"
          rel="nofollow noopener"
          class="ml-auto inline-flex items-center gap-1 text-blue-400 hover:underline"
        >
          Source
          <Icon name="ri:external-link-line" class="size-3" />
        </a>
      )}
    </div>
  )
}
