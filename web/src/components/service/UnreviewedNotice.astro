---
import { Icon } from 'astro-icon/components'
---

<p
  class="flex items-start gap-2 rounded-lg border border-yellow-500/30 bg-yellow-500/5 px-3 py-2 text-sm text-day-300"
>
  <Icon name="ri:question-line" class="mt-0.5 size-4 shrink-0 text-yellow-300" aria-hidden="true" />
  <span>
    <span class="me-2 font-title text-xs font-bold tracking-wider text-yellow-300 uppercase"
      >Community listing</span
    >
    Our team only did a basic check for spam and eligibility, not an in-depth review. Use with caution.
    <a
      href="/docs/listings#community-contributed"
      class="ms-1 whitespace-nowrap underline decoration-day-600 underline-offset-2 hover:text-day-100"
    >
      What this means
    </a>
  </span>
</p>
