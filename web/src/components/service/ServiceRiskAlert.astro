---
import { Icon } from 'astro-icon/components'
import { format } from 'date-fns'

import { getIncidentSeverityInfo } from '../../constants/incidentSeverities'
import { cn } from '../../lib/cn'
import { firstParagraph } from '../../lib/strings'

import type { IncidentSeverity } from '@prisma/client'

type Props = {
  event: {
    id: number
    title: string
    content: string
    startedAt: Date
    display: { icon: string; label: string }
    incident: { severity: IncidentSeverity; occurredAt: Date } | null
  }
  /// Other open incidents and warnings, beyond the one shown.
  moreIncidents: number
  moreWarnings: number
}

const { event, moreIncidents, moreWarnings } = Astro.props

const severityInfo = event.incident ? getIncidentSeverityInfo(event.incident.severity) : null

// An ongoing update is worth surfacing but is not an alarm, and a low-severity
// incident should not shout as loudly as a critical one. Severity drives the
// colour so the page never cries wolf.
const tone = severityInfo?.classNames ?? {
  text: 'text-yellow-300',
  border: 'border-yellow-500/30',
  borderHover: 'hover:border-yellow-500/45',
  bgHover: 'hover:bg-yellow-500/10',
  bg: 'bg-yellow-500/5',
}

const since = format(event.incident ? event.incident.occurredAt : event.startedAt, 'MMM yyyy')
const label = severityInfo
  ? `${severityInfo.label} severity · unresolved since ${since}`
  : `${event.display.label} · ongoing since ${since}`

const lead = firstParagraph(event.content)

const count = (n: number, noun: string) => `${String(n)} ${noun}${n === 1 ? '' : 's'}`
const more = [
  moreIncidents > 0 && count(moreIncidents, 'incident'),
  moreWarnings > 0 && count(moreWarnings, 'warning'),
]
  .filter(Boolean)
  .join(' and ')

// One action, named for where it goes: the card itself, or the section when
// there is more than one thing open.
const action = more
  ? { href: event.incident ? '#incidents' : '#events', text: 'See all open issues' }
  : { href: `#event-${event.id.toString()}`, text: event.incident ? 'See the incident' : 'See the warning' }
---

{/* One destination, so the whole banner is the target: the action link is stretched over it. */}
<aside
  class={cn(
    'group/alert relative rounded-lg border px-4 py-3 transition-colors duration-300',
    tone.border,
    tone.borderHover,
    tone.bgHover,
    tone.bg
  )}
  aria-label={`${label}: ${event.title}`}
>
  <p class={cn('flex items-center gap-2 font-title text-xs font-bold tracking-wider uppercase', tone.text)}>
    <Icon name={severityInfo?.icon ?? event.display.icon} class="size-4 shrink-0" />
    {label}
  </p>

  <p class="mt-1.5 font-title text-base font-bold text-balance text-white">{event.title}</p>

  <p class="mt-1 line-clamp-2 text-sm text-day-300">{lead}</p>

  <p class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
    <a
      href={action.href}
      class={cn(
        'inline-flex items-center gap-1 font-medium underline underline-offset-4 after:absolute after:inset-0',
        tone.text
      )}
    >
      {action.text}
      <Icon name="ri:arrow-down-line" class="size-4" />
    </a>
    {more && <span class="text-day-400">Plus {more} still open.</span>}
  </p>
</aside>
