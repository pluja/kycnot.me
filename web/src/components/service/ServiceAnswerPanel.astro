---
import { Icon } from 'astro-icon/components'

import { kycLevels, type getKycLevelInfo } from '../../constants/kycLevels'
import { cn } from '../../lib/cn'
import { markdownToInlineHtml } from '../../lib/markdown'
import ScoreGauge from '../ScoreGauge.astro'
import Tooltip from '../Tooltip.astro'

import type { ServiceAnswer } from '../../lib/serviceAnswers'

type Props = {
  kyc: ServiceAnswer
  safety: ServiceAnswer
  /** The level badge: the site's own vocabulary, next to the plain-English headline. */
  kycLevel: ReturnType<typeof getKycLevelInfo>
  privacyScore: number
  trustScore: number
  serviceName: string
  /** Nobody has reviewed the listing: the scores are shown, but not vouched for. */
  unverified?: boolean
}

const { kyc, safety, kycLevel, privacyScore, trustScore, serviceName, unverified = false } = Astro.props

const toneClass = {
  good: 'text-green-400',
  caution: 'text-yellow-400',
  bad: 'text-red-400',
  unknown: 'text-day-400',
} as const

// Enough to name what matters; the full list sits in the attributes below.
const SHOWN_CAVEATS = 3

const questions = [
  {
    label: 'KYC policy',
    icon: 'ri:fingerprint-line',
    level: kycLevel,
    score: privacyScore,
    scoreLabel: 'Privacy',
    dim: unverified,
    unreviewedBadge: false,
    ...kyc,
    detailHtml: kyc.detailMd ? await markdownToInlineHtml(kyc.detailMd) : null,
  },
  {
    label: `Is ${serviceName} safe?`,
    icon: 'ri:shield-keyhole-line',
    level: null,
    score: trustScore,
    scoreLabel: 'Trust',
    dim: unverified,
    unreviewedBadge: unverified,
    ...safety,
    detailHtml: null,
  },
]
---

<section aria-label="Summary">
  <div class="grid gap-px rounded-lg border border-night-600 bg-night-600 sm:grid-cols-2">
    {
      questions.map((question) => (
        <div class="bg-night-800 p-4 first:rounded-t-[7px] last:rounded-b-[7px] sm:first:rounded-l-[7px] sm:first:rounded-tr-none sm:last:rounded-r-[7px] sm:last:rounded-bl-none">
          {/* The gauge shares the row with the titles only, so the text below runs full width. */}
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              {/* The level and its tooltip sit beside the heading, not inside it, so the outline stays clean. */}
              <div class="flex flex-wrap items-center gap-x-1.5 font-title text-xs font-bold tracking-wider text-day-300 uppercase">
                <h2 class="flex items-center gap-x-1.5">
                  <Icon name={question.icon} class="size-4" />
                  {question.label}
                </h2>
                {question.level && (
                  <>
                    <span class="text-day-600" aria-hidden="true">
                      ·
                    </span>
                    <Tooltip
                      text={`Level ${String(question.level.value)} of ${String(kycLevels.length - 1)}. ${question.level.description}`}
                      position="top"
                      class="inline-flex"
                    >
                      <span class="inline-flex items-center gap-1">
                        <Icon name={question.level.icon} class="size-3.5" />
                        {question.level.shortName} KYC
                      </span>
                    </Tooltip>
                  </>
                )}
                {question.unreviewedBadge && (
                  <>
                    <span class="text-day-600" aria-hidden="true">
                      ·
                    </span>
                    <Tooltip
                      text="Submitted by a user. The attributes and the score are as submitted; nobody from KYCnot.me has checked them yet."
                      position="top"
                      class="inline-flex"
                    >
                      <a
                        href="/about#listing-statuses"
                        class="inline-flex items-center gap-1 text-yellow-300"
                      >
                        <Icon name="ri:question-line" class="size-3.5" />
                        Not reviewed
                      </a>
                    </Tooltip>
                  </>
                )}
              </div>
              <p class={cn('mt-1.5 font-title text-sm font-bold sm:text-base', toneClass[question.tone])}>
                {question.answer}
              </p>
            </div>
            <ScoreGauge
              as="a"
              href="#scores"
              role="link"
              aria-label={`${String(Math.round(question.score))} ${question.scoreLabel} score out of 100${question.dim ? ', unverified' : ''}. See the attributes behind it.`}
              score={question.score}
              label={question.scoreLabel}
              size="md"
              theme="muted"
              glow={!question.dim}
              showInfo
              class={cn('-mt-1.5 -mb-6 shrink-0', question.dim && 'opacity-60 saturate-50')}
            />
          </div>
          {question.detailHtml ? (
            <p
              class="mt-1.5 text-sm text-day-300 [&_strong]:font-semibold [&_strong]:text-day-100"
              set:html={question.detailHtml}
            />
          ) : (
            question.detail && <p class="mt-1.5 text-sm text-day-300">{question.detail}</p>
          )}
          {question.incidents && question.incidents.length > 0 && (
            <ul class="mt-2 space-y-1.5 text-sm text-day-300">
              {question.incidents.map((incident) => (
                <li>
                  <a
                    href={incident.href}
                    class="inline-flex gap-1.5 underline decoration-day-700 underline-offset-4 hover:text-day-100 hover:decoration-day-400"
                  >
                    <Icon
                      name={incident.kind === 'warning' ? 'ri:alert-line' : 'ri:alarm-warning-line'}
                      class={cn(
                        'mt-0.5 size-4 shrink-0',
                        incident.kind === 'warning' ? toneClass.caution : toneClass[question.tone]
                      )}
                    />
                    <span>
                      {incident.title}
                      <span class="text-day-500"> · {incident.note}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}
          {question.caveats && question.caveats.length > 0 && (
            <ul class="mt-2 space-y-1 text-sm text-day-300">
              {question.caveats.slice(0, SHOWN_CAVEATS).map((caveat) => (
                <li>
                  <a
                    href={caveat.href}
                    class="inline-flex gap-1.5 underline decoration-day-700 underline-offset-4 hover:text-day-100 hover:decoration-day-400"
                  >
                    <Icon name="ri:alert-line" class="mt-0.5 size-4 shrink-0 text-yellow-400" />
                    <span>{caveat.note?.trim() ? caveat.note : caveat.title}</span>
                  </a>
                </li>
              ))}
              {question.caveats.length > SHOWN_CAVEATS && (
                <li class="pl-5.5">
                  <a href="#attributes" class="text-day-400 underline underline-offset-4 hover:text-day-200">
                    +{question.caveats.length - SHOWN_CAVEATS} more below
                  </a>
                </li>
              )}
            </ul>
          )}
        </div>
      ))
    }
  </div>
</section>
