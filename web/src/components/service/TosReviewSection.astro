---
import { Icon } from 'astro-icon/components'
import { Schema } from 'astro-seo-schema'
import { sortBy } from 'lodash-es'

import { getLegalDocumentKindInfo } from '../../constants/legalDocumentKind'
import { getTosHighlightRatingInfo } from '../../constants/tosHighlightRating'
import { getTosHighlightTopicInfo } from '../../constants/tosHighlightTopic'
import { cn } from '../../lib/cn'
import { safeHttpUrl } from '../../lib/exchange/safeUrl'
import { KYCNOTME_SCHEMA_MINI } from '../../lib/schema'
import { transformCase } from '../../lib/strings'
import { isTosReviewable, normalizeTosHighlightRating, TOS_REVIEW_ANCHOR } from '../../lib/tosHighlights'
import Markdown from '../Markdown.astro'
import QuotedClause from '../QuotedClause.astro'
import TimeFormatted from '../TimeFormatted.astro'

import TosSourceLinks from './TosSourceLinks.astro'

import type { ServiceDetail } from '../../lib/serviceDetail'
import type { ListItem, Review, WithContext } from 'schema-dts'

type Props = {
  service: Pick<
    ServiceDetail,
    'legalRevisions' | 'tosChangedAt' | 'tosReview' | 'tosReviewAt' | 'tosUrls' | 'verificationStatus'
  >
  itemReviewedId: string
  statusLabel: string
}

const { service, itemReviewedId, statusLabel } = Astro.props

const isReviewable = isTosReviewable(service.verificationStatus)

const highlights = sortBy(
  (service.tosReview?.highlights ?? []).map((highlight) => {
    const ratingInfo = getTosHighlightRatingInfo(normalizeTosHighlightRating(highlight.rating))
    const topicInfo = highlight.topic ? getTosHighlightTopicInfo(highlight.topic) : null
    return {
      ...highlight,
      ratingInfo,
      // One glyph carries both signals: the topic shapes it, the rating colours
      // it. Naming the topic as well only ever restated the title.
      icon: topicInfo?.icon ?? ratingInfo.icon,
      // Model-authored, and the model reads text the service publishes, so the
      // scheme is not ours to trust.
      safeSourceUrl: safeHttpUrl(highlight.sourceUrl),
    }
  }),
  'ratingInfo.order'
)
---

<h2
  id={TOS_REVIEW_ANCHOR}
  class="mt-6 mb-3 scroll-mt-4 border-b border-day-500 font-title text-lg font-bold text-day-200"
>
  Terms of Service Review
</h2>

{
  !isReviewable ? (
    <div class="my-8 text-center text-day-400">
      <p class="mb-4">Not available on {transformCase(statusLabel, 'lower')} services</p>
      <TosSourceLinks urls={service.tosUrls} class="mt-2" />
    </div>
  ) : service.tosReviewAt === null ? (
    <div class="my-12 text-center text-day-400">
      <p>Not reviewed yet</p>
      <TosSourceLinks urls={service.tosUrls} class="mt-2" />
    </div>
  ) : !service.tosReview ? (
    <div class="my-12 text-center text-day-400">
      <p>Can't analyze ToS with AI</p>
      <p class="mt-1 text-sm text-balance text-day-500">
        Maybe due to captchas, client side rendering, DDoS protections, or non-text format.
      </p>
      <p class="mt-2 text-xs">
        Reviewed <TimeFormatted date={service.tosReviewAt} hourPrecision />
      </p>
      <TosSourceLinks urls={service.tosUrls} class="mt-2" />
    </div>
  ) : (
    <>
      <Schema
        item={
          {
            '@context': 'https://schema.org',
            '@type': 'Review',
            itemReviewed: { '@id': itemReviewedId },
            reviewAspect: 'Terms of Service',
            name: 'Terms of Service Review',
            reviewBody: service.tosReview.summary,
            datePublished: service.tosReviewAt.toISOString(),
            author: KYCNOTME_SCHEMA_MINI,
            positiveNotes: highlights
              .filter((highlight) => highlight.ratingInfo.id === 'positive')
              .map(
                (highlight, i) =>
                  ({
                    '@type': 'ListItem',
                    position: i + 1,
                    name: highlight.title,
                    description: highlight.content,
                  }) satisfies ListItem
              ),
            negativeNotes: highlights
              .filter((highlight) => highlight.ratingInfo.id === 'negative')
              .map(
                (highlight, i) =>
                  ({
                    '@type': 'ListItem',
                    position: i + 1,
                    name: highlight.title,
                    description: highlight.content,
                  }) satisfies ListItem
              ),
          } satisfies WithContext<Review>
        }
      />

      {/* The summary and the counts already sit in the card under the verdict panel. */}
      <div class="grid gap-x-6 gap-y-4 sm:grid-cols-2">
        {highlights.map((highlight) => (
          <div class={cn('border-l-2 ps-3 text-pretty', highlight.ratingInfo.classNames.borderColor)}>
            <h3 class="font-title font-bold">
              <Icon
                name={highlight.icon}
                class={cn(highlight.ratingInfo.classNames.icon, 'me-1 inline-block size-4 align-[-0.15em]')}
              />
              {highlight.title}
            </h3>
            {!!highlight.content && (
              <div class="prose prose-sm max-w-none prose-invert">
                <Markdown content={highlight.content} />
              </div>
            )}
            <QuotedClause quote={highlight.evidence} sourceUrl={highlight.sourceUrl} />
          </div>
        ))}
      </div>

      {service.legalRevisions.length > 0 && (
        <details class="mt-6 rounded-lg bg-night-800 px-3 py-2 sm:px-6 sm:py-4">
          <summary class="cursor-pointer font-title font-bold select-none">
            <Icon name="ri:history-line" class="me-1 inline-block size-4 align-[-0.1em]" />
            Recent changes to the legal documents
          </summary>
          <ul class="mt-3 flex flex-col gap-3">
            {service.legalRevisions.map((revision) => (
              <li class="border-l-2 border-l-night-600 ps-3 text-pretty">
                <p class="text-xs text-day-400">
                  <TimeFormatted date={revision.createdAt} />
                  <span> in the </span>
                  <a
                    href={safeHttpUrl(revision.document.url) ?? undefined}
                    rel="nofollow noopener noreferrer"
                    class="hover:underline"
                  >
                    {getLegalDocumentKindInfo(revision.document.kind).name}
                  </a>
                </p>
                {revision.summary ? (
                  <div class="prose prose-sm prose-invert">
                    <Markdown content={revision.summary} />
                  </div>
                ) : (
                  <p class="text-sm text-day-400">Change recorded without a summary.</p>
                )}
              </li>
            ))}
          </ul>
        </details>
      )}

      {/* The nightly scan sweep (CRON_SCAN_SWEEP_TASK) re-reads the documents; a review is only rewritten when they change, so an old review date is not neglect. */}
      <TosSourceLinks urls={service.tosUrls} class="mt-5 justify-start text-left text-day-400" />
      <p class="mt-1 text-xs text-day-500">
        Reviewed <TimeFormatted date={service.tosReviewAt} hourPrecision prefix={false} />. Checked daily,
        reviewed on changes.
        {service.legalRevisions.length > 0 && service.tosChangedAt !== null && (
          <>
            {' '}
            {service.legalRevisions.length === 1
              ? 'One change'
              : `${String(service.legalRevisions.length)} changes`}{' '}
            recorded, last on <TimeFormatted date={service.tosChangedAt} hourPrecision prefix={false} />.
          </>
        )}
      </p>
      <p class="mt-1 text-xs text-day-500">
        AI-written. Every point quotes the terms, and we check each quote is really there.
      </p>
    </>
  )
}
