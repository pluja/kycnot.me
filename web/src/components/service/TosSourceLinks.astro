---
import { cn } from '../../lib/cn'
import { safeHttpUrl } from '../../lib/exchange/safeUrl'
import { urlDomain } from '../../lib/urls'

type Props = {
  urls: string[]
  class?: string
}

const { urls, class: className } = Astro.props

// These point at the service being reviewed, and some of those are why the
// review exists. Passing our ranking to them is not part of citing them, and a
// stored scheme is not ours to trust however it was validated on the way in.
const links = urls
  .map((url) => ({ href: safeHttpUrl(url), label: urlDomain(url) }))
  .filter((link): link is { href: string; label: string } => !!link.href)
---

{
  links.length > 0 && (
    <p
      class={cn('flex flex-wrap justify-center gap-x-3 gap-y-1 text-center text-xs text-day-400', className)}
    >
      {links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="break-all hover:underline"
        >
          {link.label}
        </a>
      ))}
    </p>
  )
}
