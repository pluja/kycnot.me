---
import { Icon } from 'astro-icon/components'

import { getListingStateInfo, type ListingState } from '../../constants/listingStates'
import { cn } from '../../lib/cn'

type Props = {
  state: ListingState
  class?: string
}

const { state, class: className } = Astro.props
const info = getListingStateInfo(state)
---

<p
  class={cn(
    'flex items-start gap-2 rounded-lg border px-3 py-2 text-sm text-day-300',
    info.classNames.banner,
    className
  )}
>
  <Icon name={info.icon} class={cn('mt-0.5 size-4 shrink-0', info.classNames.icon)} aria-hidden="true" />
  <span>
    <span class={cn('me-2 font-title text-xs font-bold tracking-wider uppercase', info.classNames.title)}
      >{info.title}</span
    >
    {info.description}
    {
      info.learnMoreHref && (
        <a
          href={info.learnMoreHref}
          class="ms-1 whitespace-nowrap underline decoration-day-600 underline-offset-2 hover:text-day-100"
        >
          How listing works
        </a>
      )
    }
  </span>
</p>
