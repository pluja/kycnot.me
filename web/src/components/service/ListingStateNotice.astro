---
import { getListingStateInfo, type ListingState } from '../../constants/listingStates'

import ServiceNotice from './ServiceNotice.astro'

type Props = {
  state: ListingState
  class?: string
}

const { state, class: className } = Astro.props
const info = getListingStateInfo(state)
---

<ServiceNotice
  title={info.title}
  description={info.description}
  icon={info.icon}
  link={info.learnMoreHref ? { href: info.learnMoreHref, text: 'How listing works' } : null}
  classNames={info.classNames}
  class={className}
/>
