---
import { getCommentIssueTypeInfo } from '../constants/commentIssueTypes'
import { getCommentKindInfo } from '../constants/commentKinds'
import { experienceOutcomesByValue, experienceSentimentsByValue } from '../constants/experiences'
import { cn } from '../lib/cn'
import { versionDetails } from '../lib/commentPage'
import { diffWords } from '../lib/textDiff'

import type { CommentIssueType, CommentKind, ExperienceOutcome, ExperienceSentiment } from '@prisma/client'

type Version = { content: string; kind?: CommentKind; experienceData: unknown }
type Props = { before: Version; after: Version }

const { before, after } = Astro.props
const was = versionDetails(before.experienceData)
const now = versionDetails(after.experienceData)
const sentimentLabel = (value: string | null) =>
  value ? experienceSentimentsByValue[value as ExperienceSentiment].label : 'Unclear'
const outcomeLabel = (value: string | null) =>
  value && value !== 'UNSPECIFIED'
    ? experienceOutcomesByValue[value as ExperienceOutcome].label
    : 'Not specified'
const issuesLabel = (issues: string[]) =>
  issues.length
    ? issues.map((issue) => getCommentIssueTypeInfo(issue as CommentIssueType).postLabel).join(', ')
    : 'No problems'
const sentimentClass = (value: string | null) =>
  value ? experienceSentimentsByValue[value as ExperienceSentiment].classNames.text : 'text-day-400'
const changes = [
  before.kind &&
    after.kind &&
    before.kind !== after.kind && {
      field: 'Type',
      from: getCommentKindInfo(before.kind).label,
      to: getCommentKindInfo(after.kind).label,
      toClass: 'text-day-100',
    },
  was.sentiment !== now.sentiment && {
    field: 'Opinion',
    from: sentimentLabel(was.sentiment),
    to: sentimentLabel(now.sentiment),
    toClass: sentimentClass(now.sentiment),
  },
  was.outcome !== now.outcome && {
    field: 'Outcome',
    from: outcomeLabel(was.outcome),
    to: outcomeLabel(now.outcome),
    toClass: 'text-day-100',
  },
  was.issues.join() !== now.issues.join() && {
    field: 'Problems',
    from: issuesLabel(was.issues),
    to: issuesLabel(now.issues),
    toClass: 'text-day-100',
  },
].filter((change) => !!change)
const textChanged = before.content !== after.content
---

<div class="space-y-2">
  {
    changes.length > 0 && (
      <ul class="flex flex-wrap gap-1.5 text-xs">
        {changes.map((change) => (
          <li class="inline-flex flex-wrap items-center gap-1 rounded-md bg-night-900 px-2 py-1">
            <span class="text-day-400">{change.field}:</span>
            <span class="text-day-500 line-through decoration-day-600">{change.from}</span>
            <span aria-hidden="true" class="text-day-600">
              →
            </span>
            <span class="sr-only">changed to</span>
            <span class={cn('font-medium', change.toClass)}>{change.to}</span>
          </li>
        ))}
      </ul>
    )
  }
  {
    textChanged && (
      <p class="rounded-md bg-night-900 px-2.5 py-2 text-sm/relaxed wrap-break-word whitespace-pre-wrap text-day-300">
        {diffWords(before.content, after.content).map((part) =>
          part.type === 'same' ? (
            part.text
          ) : part.type === 'added' ? (
            <ins class="rounded-xs bg-green-500/15 text-green-200 no-underline">{part.text}</ins>
          ) : (
            <del class="rounded-xs bg-red-500/15 text-red-300">{part.text}</del>
          )
        )}
      </p>
    )
  }
</div>
