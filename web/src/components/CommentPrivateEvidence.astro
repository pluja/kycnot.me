---
import { Icon } from 'astro-icon/components'

import { canReadEvidence } from '../lib/experiences'
import { proofTextParts } from '../lib/proofEvidence'

import LightboxImage from './LightboxImage.astro'

import type { CommentPagePrivateEvidence } from '../lib/commentPage'

type Props = { evidence: CommentPagePrivateEvidence }
const { evidence } = Astro.props
if (!canReadEvidence(Astro.locals.user, evidence)) return null
const bodyParts = proofTextParts(evidence.body?.trim() ?? '')
---

<div class="space-y-2">
  {
    bodyParts.length > 0 && (
      <p class="font-mono text-sm wrap-break-word whitespace-pre-wrap">
        {bodyParts.map((part) =>
          part.url ? (
            <a
              href={part.url}
              target="_blank"
              rel="noopener noreferrer"
              referrerpolicy="no-referrer"
              class="inline-flex max-w-full items-center gap-1 break-all text-blue-300 hover:underline"
            >
              {part.text}
              <Icon name="ri:external-link-line" class="size-3.5 shrink-0" />
            </a>
          ) : (
            part.text
          )
        )}
      </p>
    )
  }
  {
    evidence.imagePath && (
      <LightboxImage src={`/comment-evidence/${evidence.id.toString()}`} alt="Proof image" class="w-20" />
    )
  }
</div>
