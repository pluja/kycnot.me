---
import { Schema } from 'astro-seo-schema'
import { tv, type VariantProps } from 'tailwind-variants'

import { cn } from '../lib/cn'
import { KYCNOTME_SCHEMA_MINI } from '../lib/schema'
import { makeScoreGaugeInfo } from '../lib/scoreGauge'
import { transformCase } from '../lib/strings'

import ScoreGaugeArch from './ScoreGaugeArch.astro'

import type { HTMLTag, Polymorphic } from 'astro/types'
import type { Review, WithContext } from 'schema-dts'

const gauge = tv({
  slots: {
    base: 'relative flex aspect-square flex-col items-center justify-start text-white',
    score: 'relative font-bold tracking-tight',
    label: 'relative font-bold tracking-wide uppercase',
    text: 'relative tracking-wide text-current/80',
  },
  // leading-none must sit after the text-* size in each variant, otherwise
  // tailwind-merge drops it (a text size utility also sets its own line-height).
  variants: {
    size: {
      lg: {
        base: 'size-18 2xs:size-24',
        score: 'mt-[25%] mb-1 text-[1.5rem] leading-none 2xs:text-[2rem]',
        label: 'text-base leading-none 2xs:mb-0.5',
        text: 'text-xs leading-none',
      },
      // The square keeps room for the (here hidden) label and text, so a
      // negative bottom margin pulls the empty space out and centers the dial.
      sm: {
        base: '-mb-4 size-11',
        score: 'mt-[28%] text-sm leading-none',
        label: 'hidden',
        text: 'hidden',
      },
    },
    theme: {
      vivid: {},
      muted: {},
    },
  },
  defaultVariants: {
    size: 'lg',
    theme: 'vivid',
  },
})

type Props = Polymorphic<
  VariantProps<typeof gauge> & {
    as: HTMLTag
    score: number
    label: string
    total?: number
    itemReviewedId?: string
    showInfo?: boolean
    children?: never
  }
>

const {
  as: Tag = 'div',
  score,
  label,
  total = 100,
  size,
  theme,
  class: className,
  itemReviewedId,
  showInfo = false,
  ...htmlProps
} = Astro.props

const { text, step, angle, formattedScore } = makeScoreGaugeInfo(score, total)

const muted = theme === 'muted'
const numberColors = {
  vivid: [
    'text-score-saturate-1 text-shadow-glow',
    'text-score-saturate-2 text-shadow-glow',
    'text-score-saturate-3 text-shadow-glow',
    'text-score-saturate-4 text-shadow-glow',
    'text-score-saturate-5 text-shadow-glow',
  ],
  muted: ['text-score-1', 'text-score-2', 'text-score-3', 'text-score-4', 'text-score-5'],
}
const numberColor = step ? numberColors[muted ? 'muted' : 'vivid'][step - 1] : ''
const longNumber = size !== 'sm' && formattedScore.length > 2

const { base, score: scoreSlot, label: labelSlot, text: textSlot } = gauge({ size, theme })
---

{
  !!itemReviewedId && (
    <Schema
      item={
        {
          '@context': 'https://schema.org',
          '@type': 'Review',
          reviewAspect: label,
          name: `${text} ${transformCase(label, 'lower')}`,
          itemReviewed: { '@id': itemReviewedId },
          reviewRating: {
            '@type': 'Rating',
            ratingValue: score,
            worstRating: 0,
            bestRating: total,
          },
          author: KYCNOTME_SCHEMA_MINI,
        } satisfies WithContext<Review>
      }
    />
  )
}

<Tag {...htmlProps} class={base({ class: className })} role={htmlProps.role ?? 'group'}>
  <ScoreGaugeArch step={step} angle={angle} showInfo={showInfo} muted={muted} class="absolute inset-0" />

  <div
    class={scoreSlot({
      class: cn(numberColor, {
        'mr-[0.05em] ml-[-0.025em] text-[1.75rem] leading-[calc(2/1.75)] tracking-[-0.075em]': longNumber,
      }),
    })}
  >
    <span>{formattedScore}</span>
  </div>

  <div class={labelSlot()}>{label}</div>

  <span class={textSlot()}>{text}</span>
</Tag>
