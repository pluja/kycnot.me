<script>
  import htmx from 'htmx.org'

  htmx.config.globalViewTransitions = false
  // The swap page's full HTML (with all currency options) is too large to
  // cache to localStorage on every HTMX-driven navigation; HTMX's default
  // hx-push-url flow was spamming htmx:historyCacheError. Back/forward still
  // works without the cache; HTMX just re-fetches the previous URL.
  htmx.config.historyCacheSize = 0

  // Only fires when ClientRouter is enabled on a page. Scope the walk to
  // <main> so we don't traverse the whole document (was ~31ms of forced
  // reflow on mobile when this ran against document.body).
  document.addEventListener('astro:after-swap', () => {
    htmx.process(document.querySelector('main') ?? document.body)
  })

  window.htmx = htmx
</script>
