---
import { ACCEPTED_IMAGE_TYPES } from '../lib/zodUtils'

type Props = {
  textName: string
  imageName: string
  value: string | undefined
  maxLength: number
  describedBy?: string
}
const { textName, imageName, value, maxLength, describedBy } = Astro.props
---

<div class="flex flex-col gap-2 sm:flex-row sm:items-center">
  <input
    type="text"
    name={textName}
    maxlength={maxLength}
    value={value}
    placeholder="Order ID or order link"
    aria-label="Order ID or order link"
    aria-describedby={describedBy}
    class="h-8 min-w-0 flex-1 rounded-md border border-night-500 bg-night-900 px-2 text-xs text-day-100 placeholder:text-day-500"
  />
  <label class="flex min-w-0 items-center gap-1.5 text-xs text-day-400">
    <span class="shrink-0">or</span>
    <input
      type="file"
      name={imageName}
      accept={ACCEPTED_IMAGE_TYPES.join(',')}
      aria-label="Screenshot"
      class="w-full min-w-0 text-xs text-day-400 file:mr-2 file:h-8 file:cursor-pointer file:rounded-md file:border-0 file:bg-night-600 file:px-2.5 file:text-xs file:text-day-100 sm:w-56"
    />
  </label>
</div>
