---
import { Icon } from 'astro-icon/components'

import { cn } from '../lib/cn'

import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'div'> & {
  // Radio group name, unique on the page.
  name: string
  label: string
  tabs: { id: string; label: string; icon: string; attention?: boolean }[]
  activeTab: string | undefined
  accent: 'green' | 'teal'
}
// CSS-only tabs: each panel shows with group-has-[[data-tab=<id>]:checked] on a shared ancestor.
const { name, label, tabs, activeTab, accent, class: className, ...props } = Astro.props
---

<div {...props} role="radiogroup" aria-label={label} class={cn('flex flex-wrap gap-1', className)}>
  {
    tabs.map((tab) => (
      <label
        class={cn(
          'inline-flex shrink-0 cursor-pointer items-center gap-1.5 rounded-t-md border-b-2 border-transparent px-2.5 py-1.5 text-xs text-day-400 hover:text-day-200 has-checked:bg-night-800 has-checked:text-day-100 has-focus-visible:ring-2 has-focus-visible:ring-blue-500',
          accent === 'green' ? 'has-checked:border-green-400' : 'has-checked:border-teal-400'
        )}
      >
        <input
          type="radio"
          name={name}
          value={tab.id}
          checked={tab.id === activeTab}
          data-tab={tab.id}
          class="sr-only"
        />
        <Icon name={tab.icon} class="size-3.5" />
        {tab.label}
        {tab.attention && (
          <>
            <span class="size-1.5 rounded-full bg-yellow-400" aria-hidden="true" />
            <span class="sr-only">Needs attention</span>
          </>
        )}
      </label>
    ))
  }
</div>
