---
import { Icon } from 'astro-icon/components'
import { Schema } from 'astro-seo-schema'
import { clamp, round, sum } from 'lodash-es'

import { MIN_TRUSTED_RATING_WEIGHT } from '../constants/karmaUnlocks'
import { cn } from '../lib/cn'
import { prisma } from '../lib/prisma'

import Tooltip from './Tooltip.astro'

import type { CommentStatus, Prisma } from '@prisma/client'
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'div'> & {
  serviceId: number
  itemReviewedId: string
  averageUserRating?: number | null
  trustWeightedUserRating?: number | null
  userRatingCount?: number
  trustedUserRatingCount?: number
  userRatingWeight?: number
}

const {
  serviceId,
  itemReviewedId,
  averageUserRating: averageUserRatingFromProps,
  trustWeightedUserRating: trustWeightedUserRatingFromProps,
  userRatingCount: userRatingCountFromProps,
  trustedUserRatingCount: trustedUserRatingCountFromProps,
  userRatingWeight: userRatingWeightFromProps,
  class: className,
  ...htmlProps
} = Astro.props

const approvedCommentStatuses = ['APPROVED', 'VERIFIED'] satisfies CommentStatus[]
const ratingWhere = {
  serviceId,
  ratingActive: true,
  status: {
    in: approvedCommentStatuses,
  },
  parentId: null,
  suspicious: false,
  rating: { not: null },
} satisfies Prisma.CommentWhereInput

const ratingsFromDb = await prisma.comment.groupBy({
  by: ['rating'],
  where: ratingWhere,
  _count: true,
  _sum: {
    ratingWeight: true,
  },
})
const trustedUserRatingCountFromQuery = await prisma.comment.count({
  where: {
    ...ratingWhere,
    ratingWeight: { gte: MIN_TRUSTED_RATING_WEIGHT },
  },
})

const ratings = ([5, 4, 3, 2, 1] as const).map((rating) => ({
  rating,
  count: ratingsFromDb.find((stat) => stat.rating === rating)?._count ?? 0,
  weight: ratingsFromDb.find((stat) => stat.rating === rating)?._sum.ratingWeight ?? 0,
}))

const userRatingCountFromQuery = sum(ratings.map((stat) => stat.count))
const userRatingWeightFromQuery = sum(ratings.map((stat) => stat.weight))
const averageUserRatingFromQuery =
  userRatingCountFromQuery > 0
    ? sum(ratings.map((stat) => stat.rating * stat.count)) / userRatingCountFromQuery
    : null
const trustWeightedUserRatingFromQuery =
  userRatingWeightFromQuery >= MIN_TRUSTED_RATING_WEIGHT
    ? sum(ratings.map((stat) => stat.rating * stat.weight)) / userRatingWeightFromQuery
    : null

if (averageUserRatingFromProps !== undefined) {
  const a = averageUserRatingFromQuery === null ? null : round(averageUserRatingFromQuery, 2)
  const b = averageUserRatingFromProps === null ? null : round(averageUserRatingFromProps, 2)
  if (a !== b) {
    console.error(
      `The averageUserRating of the comments shown is different from the averageUserRating from the database. Service ID: ${serviceId} ratingUi: ${averageUserRatingFromQuery} ratingDb: ${averageUserRatingFromProps}`
    )
  }
}

if (trustWeightedUserRatingFromProps !== undefined) {
  const a = trustWeightedUserRatingFromQuery === null ? null : round(trustWeightedUserRatingFromQuery, 2)
  const b = trustWeightedUserRatingFromProps === null ? null : round(trustWeightedUserRatingFromProps, 2)
  if (a !== b) {
    console.error(
      `The trustWeightedUserRating of the comments shown is different from the trustWeightedUserRating from the database. Service ID: ${serviceId} ratingUi: ${trustWeightedUserRatingFromQuery} ratingDb: ${trustWeightedUserRatingFromProps}`
    )
  }
}

const userRatingCount = userRatingCountFromProps ?? userRatingCountFromQuery
const trustedUserRatingCount = trustedUserRatingCountFromProps ?? trustedUserRatingCountFromQuery
const userRatingWeight = userRatingWeightFromProps ?? userRatingWeightFromQuery
const trustWeightedUserRating =
  userRatingWeight >= MIN_TRUSTED_RATING_WEIGHT
    ? (trustWeightedUserRatingFromProps ?? trustWeightedUserRatingFromQuery)
    : null
---

<div {...htmlProps} class={cn('flex flex-wrap items-center justify-center gap-4', className)}>
  {
    trustWeightedUserRating !== null && (
      <Schema
        item={{
          '@context': 'https://schema.org',
          '@type': 'AggregateRating',
          itemReviewed: { '@id': itemReviewedId },
          ratingValue: round(trustWeightedUserRating, 1),
          bestRating: 5,
          worstRating: 1,
          ratingCount: userRatingCount,
        }}
      />
    )
  }

  <div class="flex flex-col items-center text-center">
    <div class="relative mb-1 text-5xl">
      {trustWeightedUserRating !== null ? round(trustWeightedUserRating, 1).toLocaleString() : '-'}
      <Tooltip
        as="a"
        href="/about#trust-weighted-ratings"
        class="absolute bottom-1 left-full ml-1 inline-flex text-zinc-400 hover:text-zinc-200 focus-visible:text-zinc-200"
        text={`${trustWeightedUserRating !== null ? 'Trust weighted score' : 'Not enough trusted feedback yet'}. Calculated from reviews weighted by private proof, account activity, moderation status, and service affiliation. Low trust reviews have limited score impact.`}
        aria-label={`${trustWeightedUserRating !== null ? 'Trust weighted score' : 'Not enough trusted feedback yet'}. ${userRatingCount.toLocaleString()} ratings, ${trustedUserRatingCount.toLocaleString()} trusted. Learn about trust weighted ratings.`}
      >
        <Icon name="ri:information-line" class="size-4" />
      </Tooltip>
    </div>
    <div class="flex items-center space-x-1">
      {
        ([1, 2, 3, 4, 5] as const).map((rating) => (
          <div
            class="relative size-5"
            style={`--percent: ${clamp((trustWeightedUserRating ?? 0) - (rating - 1), 0, 1) * 100}%`}
          >
            <Icon name="ri:star-line" class="absolute inset-0 size-full text-zinc-500" />
            <Icon
              name="ri:star-fill"
              class="absolute inset-0 size-full text-yellow-400 [clip-path:inset(0_calc(100%_-_var(--percent))_0_0)]"
            />
          </div>
        ))
      }
    </div>
  </div>

  <div class="grid min-w-32 flex-1 grid-cols-[auto_1fr_auto] items-center gap-1">
    {
      ratings.map(({ rating, count }) => {
        const percent = userRatingCount > 0 ? (count / userRatingCount) * 100 : null
        return (
          <>
            <div class="text-center text-xs text-zinc-400" aria-label={`${rating} stars`}>
              {rating.toLocaleString()}
            </div>
            <div class="h-2 flex-1 overflow-hidden rounded-full bg-zinc-700">
              <div class="h-full w-(--percent) bg-yellow-400" style={`--percent: ${percent ?? 0}%`} />
            </div>
            <div class="text-right text-xs text-zinc-400">
              {[<span>{round(percent ?? 0).toLocaleString()}</span>, <span class="text-zinc-500">%</span>]}
            </div>
          </>
        )
      })
    }
  </div>
</div>
