---
import { Icon } from 'astro-icon/components'

import { cn } from '../lib/cn'

type SectionLink = { href: string; text: string }

type Props = {
  title: string
  id?: string
  headingId?: string
  // links go on the right, in order. Explainers into /docs get the info pill, the rest a plain arrow link.
  links?: SectionLink[]
  class?: string
}

const { title, id, headingId, links = [], class: className } = Astro.props

const isInfo = (link: SectionLink) => link.href.startsWith('/docs')
---

<div
  id={id}
  class={cn(
    'mt-6 mb-3 flex scroll-mt-4 flex-wrap items-center justify-between gap-x-3 gap-y-1.5 border-b border-day-500 pb-1',
    className
  )}
>
  <h2 id={headingId} class="font-title text-lg font-bold text-day-100">{title}</h2>
  {
    links.length > 0 && (
      <div class="ml-auto flex shrink-0 items-center gap-2 text-xs leading-none">
        {links.map((link) =>
          isInfo(link) ? (
            <a
              href={link.href}
              class="inline-flex items-center gap-1 rounded-full border border-day-500/20 px-2 py-1 text-day-400 transition-colors hover:border-day-500/40 hover:text-day-100"
            >
              <Icon name="ri:information-line" class="size-3.5" />
              {link.text}
            </a>
          ) : (
            <a
              href={link.href}
              class="inline-flex items-center gap-0.5 text-day-500 transition-colors hover:text-day-200 hover:underline"
            >
              {link.text}
              <Icon name="ri:arrow-right-s-line" class="size-4" />
            </a>
          )
        )}
      </div>
    )
  }
</div>
