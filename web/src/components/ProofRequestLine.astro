---
import { Icon } from 'astro-icon/components'
import { format } from 'date-fns'

import { proofRequestState } from '../lib/proofRequests'

import type { ProofRequestSource } from '@prisma/client'

type Props = {
  request: { source: ProofRequestSource; message: string | null; createdAt: Date; dueAt: Date }
  evidence: Parameters<typeof proofRequestState>[1]
  published: boolean
  // showsMessage is true for the author and moderators, who may read what was asked.
  showsMessage: boolean
  addProofHref: string | null
}
const { request, evidence, published, showsMessage, addProofHref } = Astro.props
const state = proofRequestState(request, evidence)
const asker = request.source === 'SERVICE' ? 'The service disputes this post' : 'A moderator asked for proof'
---

{
  state === 'open' && (
    <div class="mt-1.5 space-y-0.5 text-xs text-day-400">
      <p class="flex flex-wrap items-center gap-x-1.5">
        <Icon name="ri:question-answer-line" class="size-3.5" />
        {`${asker} · answer by ${format(request.dueAt, 'MMM d')}`}
        {addProofHref && (
          <a href={addProofHref} class="text-day-200 underline hover:text-day-100">
            Add proof
          </a>
        )}
      </p>
      {showsMessage && request.message && <p class="pl-5 text-day-300">{request.message}</p>}
    </div>
  )
}
{
  state === 'unanswered' && (
    <p class="mt-1.5 flex items-center gap-1.5 text-xs text-yellow-200/80">
      <Icon name="ri:error-warning-line" class="size-3.5" />
      {published
        ? 'Unproven: no proof given in time when asked. Not counted in the summary.'
        : 'No proof given in time.'}
    </p>
  )
}
