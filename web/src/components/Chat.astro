---
import { isInputError } from 'astro:actions'

import { SUGGESTION_MESSAGE_CONTENT_MAX_LENGTH } from '../actions/serviceSuggestion'
import Button from '../components/Button.astro'
import Tooltip from '../components/Tooltip.astro'
import { cn } from '../lib/cn'
import { baseInputClassNames } from '../lib/formInputs'

import ChatMessages, { type ChatMessage } from './ChatMessages.astro'

import type { ActionInput, AnyAction } from '../lib/astroActions'
import type { ChatConversationType } from '../lib/serverEventsTypes'
import type { HTMLAttributes } from 'astro/types'

export type Props<TAction extends AnyAction | undefined = AnyAction | undefined> =
  HTMLAttributes<'section'> & {
    messages: ChatMessage[]
    title?: string
    userId: number | null
    action: TAction
    formData?: TAction extends AnyAction ? Omit<ActionInput<TAction>, 'content'> : undefined
    conversationType: ChatConversationType
    conversationId: number
    maxLength?: number
  }

const {
  messages,
  title,
  userId,
  action,
  formData,
  conversationType,
  conversationId,
  maxLength = SUGGESTION_MESSAGE_CONTENT_MAX_LENGTH,
  class: className,
  ...htmlProps
} = Astro.props

const result = action ? Astro.getActionResult(action) : undefined
const inputErrors = isInputError(result?.error) ? result.error.fields : {}
---

<div class={cn(className)} {...htmlProps}>
  {!!title && <h3 class="mb-2 text-center font-title text-xl font-bold text-day-200">{title}</h3>}

  <ChatMessages
    id="chat-messages"
    messages={messages}
    userId={userId}
    data-conversation-type={conversationType}
    data-conversation-id={conversationId}
    hx-get={Astro.url.pathname}
    hx-target="#chat-messages"
    hx-select="#chat-messages>*"
    hx-trigger="js:refresh-chat"
  />

  {
    !!action && (
      <>
        <form
          method="POST"
          action={action}
          class="flex items-end gap-2"
          hx-post={`${Astro.url.pathname}${action}`}
          hx-target="#chat-messages"
          hx-select="#chat-messages>*"
          hx-push-url="true"
          {...{ 'hx-on::after-request': 'if(event.detail.successful) this.reset()' }}
        >
          {!!formData &&
            Object.entries(formData).map(([key, value]) => (
              <input type="hidden" name={key} value={String(value)} />
            ))}
          <textarea
            name="content"
            placeholder="Add a message..."
            class={cn(
              baseInputClassNames.input,
              baseInputClassNames.textarea,
              'max-h-64',
              !!inputErrors.content && baseInputClassNames.error
            )}
            required
            maxlength={maxLength}
          />

          <Tooltip text="Send">
            <Button
              type="submit"
              icon="ri:send-plane-fill"
              size="lg"
              color="success"
              class="h-16"
              label="Send"
              iconOnly
            />
          </Tooltip>
        </form>
        {!!inputErrors.content && <div class="text-sm text-red-500">{inputErrors.content}</div>}
      </>
    )
  }
</div>

<script>
  import newChatMessageSound from '../assets/sounds/new-chat-message.mp3'
  const audio = new Audio(newChatMessageSound)

  document.addEventListener('sse:new-chat-message', (event) => {
    const chatMessages = document.getElementById('chat-messages')
    const conversationType = chatMessages?.dataset.conversationType
    const conversationId = chatMessages?.dataset.conversationId
    if (!conversationType || !conversationId) return

    if (conversationType === event.detail.conversationType && Number(conversationId) === event.detail.id) {
      window.htmx?.trigger('#chat-messages', 'js:refresh-chat')
      audio.currentTime = 0
      audio.play()
    }
  })
</script>
