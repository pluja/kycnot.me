---
import { Icon } from 'astro-icon/components'
import { actions } from 'astro:actions'

import { commentRules } from '../constants/commentRules'
import { cn } from '../lib/cn'
import { MODERATOR_REASON_LENGTH } from '../lib/commentLimits'
import { isPublishedComment } from '../lib/experiences'
import { getFormReplay } from '../lib/formReplay'

import Button from './Button.astro'
import FormReplay from './FormReplay.astro'
import InputRichSelect from './InputRichSelect.astro'
import InputText from './InputText.astro'

import type { CommentStatus } from '@prisma/client'
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'section'> & {
  comment: { id: number; status: CommentStatus; humanDecidedAt: Date | null }
  actionPath: string
}
const { comment, actionPath, class: className, ...props } = Astro.props
if (!Astro.locals.userCan('comments:moderate')) return null
const decisions = [
  {
    value: 'APPROVED',
    label: 'Publish',
    description: 'Visible to readers',
    icon: 'ri:eye-line',
    checkedClass: 'has-checked:border-green-500 has-checked:bg-green-500/15 has-checked:text-green-200',
  },
  {
    value: 'PENDING',
    label: 'Hold',
    description: 'Hidden, awaiting review',
    icon: 'ri:pause-circle-line',
    checkedClass: 'has-checked:border-yellow-500 has-checked:bg-yellow-500/15 has-checked:text-yellow-200',
  },
  {
    value: 'REJECTED',
    label: 'Reject',
    description: 'Hidden, not approved',
    icon: 'ri:close-circle-line',
    checkedClass: 'has-checked:border-red-500 has-checked:bg-red-500/15 has-checked:text-red-200',
  },
] as const
const currentDecision = isPublishedComment(comment.status) ? 'APPROVED' : comment.status
const publishFailed = !!Astro.getActionResult(actions.admin.experience.publish)?.error
const replay = getFormReplay(
  publishFailed && Astro.locals.actionFormValues?.commentId === comment.id.toString()
    ? Astro.locals.actionFormValues
    : null
)
const selectedDecision = replay.text('status', currentDecision)
---

<section {...props} class={cn('text-sm', className)}>
  <form
    method="POST"
    action={`${actionPath}${actions.admin.experience.publish}`}
    class="group/decision space-y-3"
  >
    <FormReplay />
    <input type="hidden" name="commentId" value={comment.id} />
    <input type="hidden" name="seenStatus" value={comment.status} />
    <input type="hidden" name="seenDecidedAt" value={comment.humanDecidedAt?.toISOString() ?? ''} />
    <div class="flex flex-wrap items-center gap-2">
      <fieldset class="flex rounded-lg border border-night-500 bg-night-900 p-0.5">
        <legend class="sr-only">Decision for comment #{comment.id}</legend>
        {
          decisions.map((decision) => (
            <label
              title={
                decision.value === currentDecision
                  ? `${decision.description} (current)`
                  : decision.description
              }
              class={cn(
                'flex cursor-pointer items-center gap-1.5 rounded-md border border-transparent px-2.5 py-1 text-sm text-day-300 transition-colors hover:text-day-100 has-focus-visible:ring-2 has-focus-visible:ring-blue-500',
                decision.checkedClass
              )}
            >
              <input
                type="radio"
                name="status"
                value={decision.value}
                checked={decision.value === selectedDecision}
                data-decision={decision.value}
                data-current={decision.value === currentDecision ? '' : undefined}
                required
                class="sr-only"
              />
              <Icon name={decision.icon} class="size-4" />
              <span class="font-medium">{decision.label}</span>
              {decision.value === currentDecision && (
                <>
                  <span class="size-1.5 rounded-full bg-current" aria-hidden="true" />
                  <span class="sr-only">(current decision)</span>
                </>
              )}
            </label>
          ))
        }
      </fieldset>
      <div class="ml-auto flex items-center gap-2">
        <span class="hidden text-xs text-day-500 group-has-[[data-current]:checked]/decision:inline">
          Current decision
        </span>
        <Button
          type="submit"
          label="Save"
          color="success"
          size="sm"
          class="group-has-[[data-current]:checked]/decision:pointer-events-none group-has-[[data-current]:checked]/decision:opacity-50"
        />
      </div>
    </div>
    <div
      class="hidden gap-2 group-has-[:is([data-decision=PENDING],[data-decision=REJECTED]):not([data-current]):checked]/decision:grid sm:grid-cols-2"
    >
      <InputRichSelect
        name="decisionReason"
        label="Reason"
        selectedValue={replay.text('decisionReason', '')}
        options={[
          { value: '', label: 'Choose a reason', description: 'Without one, explain in Details.' },
          ...commentRules.map((rule) => ({
            value: rule.value,
            label: rule.label,
            icon: rule.icon,
            iconClass: rule.penalizes ? 'text-red-400' : undefined,
            description: rule.description,
            tag: rule.penalizes ? 'Counts against trust' : undefined,
          })),
        ]}
      />
      <InputText
        name="reason"
        label="Details"
        description="Required for Other or without a reason. Moderators only."
        inputProps={{
          maxlength: MODERATOR_REASON_LENGTH.max,
          class: 'text-sm',
          value: replay.text('reason', ''),
        }}
      />
    </div>
  </form>
</section>
