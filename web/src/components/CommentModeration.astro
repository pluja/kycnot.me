---
import { Icon } from 'astro-icon/components'

import { communityNotePresets } from '../constants/communityNotePresets'
import { cn } from '../lib/cn'

import AdminCommentContext from './admin/comments/AdminCommentContext.astro'
import TimeFormatted from './TimeFormatted.astro'
import UserBadge from './UserBadge.astro'

import type { ModerationAction, Prisma, RatingMuteReason } from '@prisma/client'
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'div'> & {
  /**
   * When true, drops the outer toggle wrapper and any blocks the embedding
   * parent already renders (author context, AI verdict block, Decide row).
   * Layout becomes a tight grid so it fits inside an expanded admin row.
   */
  compact?: boolean
  comment: Prisma.CommentGetPayload<{
    select: {
      id: true
      status: true
      issues: true
      publicNote: true
      adminNote: true
      authorNote: true
      privateProof: true
      privateProofStatus: true
      rating: true
      ratingActive: true
      ratingMuted: true
      ratingMuteReason: true
      ratingWeight: true
      ratingTrustLabel: true
      ratingTrustReason: true
      aiAction: true
      aiQuality: true
      aiIsSpam: true
      aiIsBrigade: true
      aiBrigadeConfidence: true
      aiReasoning: true
      aiDecidedAt: true
      humanAction: true
      humanDecidedAt: true
      humanDecidedBy: {
        select: {
          name: true
          displayName: true
          picture: true
        }
      }
      author: {
        select: {
          createdAt: true
          lastLoginAt: true
          totalKarma: true
          verified: true
          spammer: true
          _count: {
            select: {
              comments: true
            }
          }
        }
      }
    }
  }>
}

const { comment, compact = false, class: className, ...divProps } = Astro.props

const user = Astro.locals.user

// Only render for admin/moderator users
if (!user || (!user.admin && !user.moderator)) return null

const muteReasonOptions: { value: RatingMuteReason; label: string }[] = [
  { value: 'MODERATOR_DISCRETION', label: 'Moderator discretion' },
  { value: 'AUTHOR_AFFILIATED', label: 'Author affiliated' },
  { value: 'AUTHOR_LOW_TRUST', label: 'Author low trust' },
  { value: 'SUSPICIOUS_PATTERN', label: 'Suspicious pattern' },
  { value: 'TEMPLATE_SPAM', label: 'Template spam' },
  { value: 'CONFLICT_OF_INTEREST', label: 'Conflict of interest' },
]

const humanActionMeta: Record<
  ModerationAction,
  { label: string; icon: string; activeClasses: string; hoverClasses: string }
> = {
  APPROVE: {
    label: 'Approve',
    icon: 'ri:check-line',
    activeClasses: 'border border-green-500/30 bg-green-500/20 text-green-400',
    hoverClasses: 'bg-night-700 hover:bg-green-500/20 hover:text-green-400',
  },
  REJECT: {
    label: 'Reject',
    icon: 'ri:close-line',
    activeClasses: 'border border-red-500/30 bg-red-500/20 text-red-400',
    hoverClasses: 'bg-night-700 hover:bg-red-500/20 hover:text-red-400',
  },
  HOLD: {
    label: 'Hold',
    icon: 'ri:pause-line',
    activeClasses: 'border border-yellow-500/30 bg-yellow-500/20 text-yellow-400',
    hoverClasses: 'bg-night-700 hover:bg-yellow-500/20 hover:text-yellow-400',
  },
}

const aiActionLabels: Record<ModerationAction, string> = {
  APPROVE: 'Approve',
  REJECT: 'Reject',
  HOLD: 'Hold',
}

const aiActionClasses: Record<ModerationAction, string> = {
  APPROVE: 'bg-green-500/20 text-green-300',
  REJECT: 'bg-red-500/20 text-red-300',
  HOLD: 'bg-yellow-500/20 text-yellow-300',
}

const hasAiVerdict = comment.aiDecidedAt !== null || comment.aiAction !== null
---

<div {...divProps} class={cn('text-xs', className)} data-comment-moderation>
  {
    !compact && (
      <>
        <input type="checkbox" id={`mod-toggle-${String(comment.id)}`} class="peer sr-only" />
        <label
          for={`mod-toggle-${String(comment.id)}`}
          class="inline-flex cursor-pointer items-center gap-1 rounded-sm text-day-500 peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500 peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-night-700 hover:text-day-300"
        >
          <Icon name="ri:shield-keyhole-line" class="size-3.5" />
          <span class="text-xs">Moderation</span>
          <Icon
            name="ri:arrow-down-s-line"
            class="size-3.5 transition-transform peer-checked:rotate-180"
          />
        </label>
      </>
    )
  }

  <div
    class={cn(
      compact
        ? 'space-y-2'
        : 'mt-2 hidden rounded-md border border-night-500 bg-night-600 peer-checked:block peer-checked:p-2'
    )}
  >
    {!compact && <AdminCommentContext comment={comment} class="mb-2 border-b border-night-500 pb-2" />}

    {/* AI verdict (read-only). Hidden in compact mode because the embedding row already shows it. */}
    {
      !compact && hasAiVerdict && (
        <div class="mb-2 rounded-sm border border-indigo-500/30 bg-indigo-500/10 px-2 py-1.5">
          <div class="mb-1 flex flex-wrap items-center gap-1.5 text-[10px] text-indigo-300">
            <Icon name="ri:robot-2-line" class="size-3.5" />
            <span class="font-semibold uppercase tracking-wide">AI verdict</span>
            {comment.aiDecidedAt && (
              <span class="text-indigo-400/70">
                <TimeFormatted date={comment.aiDecidedAt} hourPrecision />
              </span>
            )}
          </div>
          <div class="flex flex-wrap items-center gap-1.5 text-[11px]">
            {comment.aiAction && (
              <span class={cn('rounded-sm px-1.5 py-0.5 font-medium', aiActionClasses[comment.aiAction])}>
                {aiActionLabels[comment.aiAction]}
              </span>
            )}
            {typeof comment.aiQuality === 'number' && (
              <span class="rounded-sm bg-night-700 px-1.5 py-0.5 text-day-300">
                Quality {comment.aiQuality}/10
              </span>
            )}
            {comment.aiIsSpam && (
              <span class="rounded-sm bg-red-500/20 px-1.5 py-0.5 text-red-300">Spam</span>
            )}
            {comment.aiIsBrigade && (
              <span class="rounded-sm bg-orange-500/20 px-1.5 py-0.5 text-orange-300">
                Brigade
                {typeof comment.aiBrigadeConfidence === 'number' &&
                  ` · conf ${comment.aiBrigadeConfidence}/5`}
              </span>
            )}
          </div>
          {comment.aiReasoning && (
            <p class="mt-1 text-[11px] leading-snug whitespace-pre-wrap text-day-300">
              {comment.aiReasoning}
            </p>
          )}
        </div>
      )
    }

    {/* Human verdict (read-only) */}
    {
      comment.humanAction && (
        <div class="mb-2 flex flex-wrap items-center gap-1 rounded-sm bg-night-700 px-2 py-1 text-[11px] text-day-400">
          <Icon name="ri:user-settings-line" class="size-3.5 shrink-0" />
          <span>Last moderated</span>
          {comment.humanDecidedBy && (
            <>
              <span>by</span>
              <UserBadge user={comment.humanDecidedBy} size="sm" noLink />
            </>
          )}
          {comment.humanDecidedAt && (
            <>
              <span>at</span>
              <TimeFormatted date={comment.humanDecidedAt} hourPrecision />
            </>
          )}
          <span>as</span>
          <span class={cn('rounded-sm px-1.5 py-0.5 font-medium', aiActionClasses[comment.humanAction])}>
            {aiActionLabels[comment.humanAction]}
          </span>
        </div>
      )
    }

    {/* Moderation action buttons (audit-trailed). Shown in both modes; also
        in compact (admin row), so a moderator can decide without scrolling
        back up to the row's action rail. The effective action falls back
        to status for legacy comments that pre-date humanAction tracking. */}
    <div class="mb-2 flex flex-wrap items-center gap-1 border-b border-night-500 pb-2">
      <span class="mr-1 text-[10px] text-day-500">Decide:</span>
      {
        (['APPROVE', 'REJECT', 'HOLD'] as const).map((act) => {
          const meta = humanActionMeta[act]
          const effectiveAction: ModerationAction | null =
            comment.humanAction ??
            (comment.status === 'APPROVED' || comment.status === 'VERIFIED'
              ? 'APPROVE'
              : comment.status === 'REJECTED'
                ? 'REJECT'
                : comment.status === 'PENDING'
                  ? 'HOLD'
                  : null)
          const isActive = effectiveAction === act
          return (
            <button
              class={cn(
                'inline-flex items-center gap-1 rounded-sm px-1.5 py-0.5 text-xs transition-colors',
                isActive ? meta.activeClasses : meta.hoverClasses
              )}
              data-action="human-action"
              data-value={act}
              data-comment-id={comment.id}
              data-user-id={user.id}
            >
              <Icon name={meta.icon} class="size-3.5" />
              <span>{meta.label}</span>
            </button>
          )
        })
      }

      <div class="h-5 w-px bg-night-500"></div>

      {/* Verify is a mod-direct status elevation, no associated human action */}
      <button
        class={cn(
          'inline-flex items-center gap-1 rounded-sm px-1.5 py-0.5 text-xs transition-colors',
          comment.status === 'VERIFIED'
            ? 'border border-blue-500/30 bg-blue-500/20 text-blue-400'
            : 'bg-night-700 hover:bg-blue-500/20 hover:text-blue-400'
        )}
        data-action="status"
        data-value={comment.status === 'VERIFIED' ? 'APPROVED' : 'VERIFIED'}
        data-comment-id={comment.id}
        data-user-id={user.id}
      >
        <Icon name="ri:verified-badge-line" class="size-3.5" />
        <span>{comment.status === 'VERIFIED' ? 'Unverify' : 'Verify'}</span>
      </button>
    </div>

    {/* Issue toggles. Mods can mark/unmark whether the user flagged KYC
        or funds-blocked problems with the service. Pyworker treats these
        as hard gates, so accuracy matters. */}
    <div class="mb-2 flex flex-wrap items-center gap-1 border-b border-night-500 pb-2">
      <span class="mr-1 text-[10px] text-day-500">Issues:</span>
      {
        (
          [
            { value: 'KYC_REQUESTED', label: 'KYC issue', icon: 'ri:bank-card-line' },
            { value: 'FUNDS_BLOCKED', label: 'Funds blocked', icon: 'ri:lock-line' },
          ] as const
        ).map((issue) => {
          const active = comment.issues.includes(issue.value)
          return (
            <button
              class={cn(
                'inline-flex items-center gap-1 rounded-sm px-1.5 py-0.5 text-xs transition-colors',
                active
                  ? 'border border-red-500/30 bg-red-500/20 text-red-400'
                  : 'bg-night-700 hover:bg-red-500/20 hover:text-red-400'
              )}
              data-action={active ? 'remove-issue' : 'add-issue'}
              data-value={issue.value}
              data-comment-id={comment.id}
              data-user-id={user.id}
              title={active ? 'Click to clear this issue flag' : 'Mark this comment as reporting the issue'}
            >
              <Icon name={issue.icon} class="size-3.5" />
              <span>{active ? issue.label : `Mark ${issue.label}`}</span>
            </button>
          )
        })
      }
    </div>

    {/* Rating controls. Only relevant when this comment has a rating that
        currently counts (or could count) toward the service score.
        Hidden in compact mode because the embedding row's Context panel
        shows the same disable/enable button next to the star rating. */}
    {
      !compact &&
        comment.rating !== null &&
        (comment.status === 'APPROVED' || comment.status === 'VERIFIED') && (
          <div class="mb-2 flex flex-wrap items-center gap-1.5 border-b border-night-500 pb-2">
            <button
              class={cn(
                'inline-flex items-center gap-1 rounded-sm px-1.5 py-0.5 text-xs transition-colors',
                comment.ratingMuted
                  ? 'border border-orange-500/30 bg-orange-500/20 text-orange-400'
                  : 'bg-night-700 hover:bg-orange-500/20 hover:text-orange-400'
              )}
              data-action="rating-mute"
              data-value={(!comment.ratingMuted).toString()}
              data-comment-id={comment.id}
              data-user-id={user.id}
              title="When disabled, this rating no longer counts toward the service score. Pick a reason to determine whether the comment is also visually flagged."
            >
              <Icon name="ri:star-off-line" class="size-3.5" />
              <span>{comment.ratingMuted ? 'Enable rating' : 'Disable rating'}</span>
            </button>

            {comment.ratingMuted && (
              <label class="inline-flex items-center gap-1 text-[10px] text-day-500">
                Reason:
                <select
                  class="rounded-sm border border-night-500 bg-night-700 px-1.5 py-0.5 text-xs outline-hidden focus:ring-1 focus:ring-blue-500"
                  data-action="rating-mute-reason"
                  data-comment-id={comment.id}
                  data-user-id={user.id}
                  title="Suspicious pattern and Template spam additionally collapse and grey out the comment. Other reasons leave the comment displayed normally."
                >
                  {muteReasonOptions.map((opt) => (
                    <option value={opt.value} selected={comment.ratingMuteReason === opt.value}>
                      {opt.label}
                    </option>
                  ))}
                </select>
              </label>
            )}
          </div>
        )
    }

    {/* Rating trust display. Hidden in compact mode (shown in Context panel). */}
    {
      !compact && comment.rating !== null && (
        <div class="mb-2 rounded-sm border border-night-500 bg-night-700 px-1.5 py-1 text-[10px] text-day-400">
          <span class="font-medium text-day-300">Rating trust:</span>{' '}
          {comment.ratingTrustLabel ?? 'Unknown'} · weight {comment.ratingWeight.toFixed(2)}
          {comment.ratingTrustReason && <span> · {comment.ratingTrustReason}</span>}
        </div>
      )
    }

    {/* Notes. In compact mode, three columns side-by-side. */}
    <div class={cn('space-y-1.5', compact && 'md:grid md:grid-cols-3 md:gap-3 md:space-y-0')}>
      <div class="space-y-1">
        <label class="block text-[10px] font-medium text-day-400">
          <Icon name="ri:global-line" class="mr-0.5 inline size-3 align-[-0.15em] text-emerald-400" />
          Public note <span class="text-day-600">(visible to everyone)</span>
        </label>
        <textarea
          rows="2"
          placeholder="Add a context note..."
          class="field-sizing-content w-full resize-y rounded-sm border border-night-500 bg-night-700 px-2 py-1 text-xs leading-snug outline-hidden focus:ring-1 focus:ring-blue-500"
          data-action="public-note"
          data-comment-id={comment.id}
          data-user-id={user.id}>{comment.publicNote ?? ''}</textarea>
        <details class="mt-1">
          <summary class="cursor-pointer text-[10px] text-day-500 hover:text-day-300">
            Presets
          </summary>
          <div class="mt-1 flex flex-wrap gap-1">
            {
              communityNotePresets.map((preset) => (
                <button
                  type="button"
                  class="rounded-sm bg-night-700 px-1.5 py-0.5 text-[10px] text-day-400 transition-colors hover:bg-blue-500/20 hover:text-blue-300"
                  data-public-note-preset={preset}
                  data-comment-id={comment.id}
                >
                  {preset}
                </button>
              ))
            }
          </div>
        </details>
      </div>

      <div class="space-y-1">
        <label class="block text-[10px] font-medium text-day-400">
          <Icon name="ri:shield-keyhole-line" class="mr-0.5 inline size-3 align-[-0.15em] text-amber-400" />
          Admin note <span class="text-day-600">(mods only)</span>
        </label>
        <textarea
          rows="2"
          placeholder="Internal note..."
          class="field-sizing-content w-full resize-y rounded-sm border border-night-500 bg-night-700 px-2 py-1 text-xs leading-snug outline-hidden focus:ring-1 focus:ring-blue-500"
          data-action="admin-note"
          data-comment-id={comment.id}
          data-user-id={user.id}>{comment.adminNote ?? ''}</textarea>
      </div>

      <div class="space-y-1">
        <label class="block text-[10px] font-medium text-day-400">
          <Icon name="ri:user-line" class="mr-0.5 inline size-3 align-[-0.15em] text-sky-400" />
          Author note <span class="text-day-600">(author + mods)</span>
        </label>
        <textarea
          rows="2"
          placeholder="Visible to comment author..."
          class="field-sizing-content w-full resize-y rounded-sm border border-night-500 bg-night-700 px-2 py-1 text-xs leading-snug outline-hidden focus:ring-1 focus:ring-blue-500"
          data-action="author-note"
          data-comment-id={comment.id}
          data-user-id={user.id}>{comment.authorNote ?? ''}</textarea>
      </div>
    </div>
    <div class="space-y-1.5">

      {/* Private proof */}
      {
        comment.privateProof && (
          <div class="mt-3 space-y-1.5 border-t border-night-500 pt-2">
            <div class="flex min-w-0 items-start gap-1.5">
              <span class="shrink-0 text-[10px] text-day-500">Private proof:</span>
              <div class="min-w-0 flex-1 rounded-sm bg-night-700 px-1.5 py-0.5 text-xs break-all">
                {comment.privateProof}
              </div>
            </div>

            <div class="flex items-center gap-1.5">
              <span class="text-[10px] text-day-500">Status:</span>
              <div class="flex gap-1">
                <button
                  class={cn(
                    'inline-flex items-center gap-1 rounded-sm px-1.5 py-0.5 text-xs transition-colors',
                    comment.privateProofStatus === 'APPROVED'
                      ? 'border border-green-500/30 bg-green-500/20 text-green-400'
                      : 'bg-night-700 hover:bg-green-500/20 hover:text-green-400'
                  )}
                  data-action="private-proof-status"
                  data-value="APPROVED"
                  data-comment-id={comment.id}
                  data-user-id={user.id}
                >
                  <Icon name="ri:check-line" class="size-3.5" />
                  <span>Approve</span>
                </button>
                <button
                  class={cn(
                    'inline-flex items-center gap-1 rounded-sm px-1.5 py-0.5 text-xs transition-colors',
                    comment.privateProofStatus === 'REJECTED'
                      ? 'border border-red-500/30 bg-red-500/20 text-red-400'
                      : 'bg-night-700 hover:bg-red-500/20 hover:text-red-400'
                  )}
                  data-action="private-proof-status"
                  data-value="REJECTED"
                  data-comment-id={comment.id}
                  data-user-id={user.id}
                >
                  <Icon name="ri:close-line" class="size-3.5" />
                  <span>Reject</span>
                </button>
                <button
                  class={cn(
                    'inline-flex items-center gap-1 rounded-sm px-1.5 py-0.5 text-xs transition-colors',
                    comment.privateProofStatus === 'PENDING'
                      ? 'border border-blue-500/30 bg-blue-500/20 text-blue-400'
                      : 'bg-night-700 hover:bg-blue-500/20 hover:text-blue-400'
                  )}
                  data-action="private-proof-status"
                  data-value="PENDING"
                  data-comment-id={comment.id}
                  data-user-id={user.id}
                >
                  <Icon name="ri:time-line" class="size-3.5" />
                  <span>Pending</span>
                </button>
                <button
                  class={cn(
                    'inline-flex items-center gap-1 rounded-sm px-1.5 py-0.5 text-xs transition-colors',
                    comment.privateProofStatus === 'WITHDRAWN'
                      ? 'border border-night-400 bg-night-500/50 text-night-300'
                      : 'bg-night-700 hover:bg-night-500/50 hover:text-night-300'
                  )}
                  data-action="private-proof-status"
                  data-value="WITHDRAWN"
                  data-comment-id={comment.id}
                  data-user-id={user.id}
                >
                  <Icon name="ri:arrow-go-back-line" class="size-3.5" />
                  <span>Withdrawn</span>
                </button>
              </div>
            </div>
          </div>
        )
      }
    </div>
  </div>
</div>

<script>
  ////////////////////////////////////////////////////////////
  // Comment moderation controls.                           //
  // Wires buttons, selects and text inputs to the          //
  // comment.moderate action and refreshes on               //
  // status-affecting changes.                              //
  ////////////////////////////////////////////////////////////
  import { actions } from 'astro:actions'

  const BOOLEAN_ACTIONS = new Set(['rating-mute'])
  // Actions that change visible state in ways the local DOM can't easily reconcile.
  const RELOAD_ACTIONS = new Set([
    'status',
    'human-action',
    'rating-mute',
    'rating-mute-reason',
    'private-proof-status',
    'add-issue',
    'remove-issue',
  ])

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('button[data-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const action = btn.getAttribute('data-action')
        const rawValue = btn.getAttribute('data-value')
        const commentId = parseInt(btn.getAttribute('data-comment-id') || '0')

        if (!action || !rawValue || !commentId) return

        const value = BOOLEAN_ACTIONS.has(action) ? rawValue === 'true' : rawValue

        try {
          const { error } = await actions.comment.moderate({
            commentId,
            action: action as any,
            value: value as any,
          })

          if (error) {
            console.error('Error moderating comment:', error)
            return
          }

          if (RELOAD_ACTIONS.has(action)) {
            window.location.reload()
          }
        } catch (error) {
          console.error('Error moderating comment:', error)
        }
      })
    })

    document.querySelectorAll<HTMLSelectElement>('select[data-action]').forEach((select) => {
      select.addEventListener('change', async () => {
        const action = select.getAttribute('data-action')
        const commentId = parseInt(select.getAttribute('data-comment-id') || '0')

        if (!action || !commentId) return

        try {
          const { error } = await actions.comment.moderate({
            commentId,
            action: action as any,
            value: select.value,
          })

          if (error) {
            console.error('Error updating mute reason:', error)
            return
          }

          window.location.reload()
        } catch (error) {
          console.error('Error updating mute reason:', error)
        }
      })
    })

    document.querySelectorAll<HTMLButtonElement>('button[data-public-note-preset]').forEach((button) => {
      button.addEventListener('click', () => {
        const preset = button.getAttribute('data-public-note-preset')
        const moderationRoot = button.closest('[data-comment-moderation]')
        const input = moderationRoot?.querySelector<HTMLInputElement | HTMLTextAreaElement>(
          '[data-action="public-note"]'
        )

        if (!preset || !input) return

        input.value = preset
        input.dispatchEvent(new Event('input', { bubbles: true }))
      })
    })

    document
      .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        'input[data-action], textarea[data-action]'
      )
      .forEach((input) => {
      const action = input.getAttribute('data-action')
      const commentId = parseInt(input.getAttribute('data-comment-id') || '0')

      if (!action || !commentId) return

      let timeout: ReturnType<typeof setTimeout>

      input.addEventListener('input', () => {
        clearTimeout(timeout)
        timeout = setTimeout(async () => {
          try {
            const { error } = await actions.comment.moderate({
              commentId,
              action: action as any,
              value: input.value,
            })

            if (error) {
              console.error('Error updating note:', error)
            }
          } catch (error) {
            console.error('Error updating note:', error)
          }
        }, 500)
      })
    })
  })
</script>
