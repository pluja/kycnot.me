---
import { Icon } from 'astro-icon/components'
import { actions } from 'astro:actions'
import { format } from 'date-fns'

import { getCommentStatusInfo } from '../constants/commentStatus'
import {
  evidenceFindingsByValue,
  findingLabel,
  evidenceKindsByValue,
  experienceSentimentsByValue,
  proofSummariesByValue,
} from '../constants/experiences'
import { authorDisplayName } from '../lib/authorName'
import { cn } from '../lib/cn'
import { makeCommentUrl } from '../lib/commentsWithReplies'
import { canReadComment, isPublishedComment, outcomeLabel } from '../lib/experiences'
import { inlinePanelToggle } from '../lib/inlinePanel'
import { postStaffRole, staffNameClasses } from '../lib/permissions'
import { countsAsProof, publicProofView, shownProofKind } from '../lib/proofEvidence'
import { makeLoginUrl } from '../lib/redirectUrls'
import { actionInPlace } from '../lib/urls'

import AuthorFacts from './AuthorFacts.astro'
import BadgeSmall from './BadgeSmall.astro'
import CommentAuthorBadges from './CommentAuthorBadges.astro'
import CommentNotes from './CommentNotes.astro'
import CommentReplyPreview from './CommentReplyPreview.astro'
import CommentStatusChip from './CommentStatusChip.astro'
import CommentToolPanel from './CommentToolPanel.astro'
import DropdownButton from './DropdownButton.astro'
import ExperienceProblems from './ExperienceProblems.astro'
import Markdown from './Markdown.astro'
import ProofRequestLine from './ProofRequestLine.astro'
import TimeFormatted from './TimeFormatted.astro'
import Tooltip from './Tooltip.astro'
import UserBadge from './UserBadge.astro'

import type { CommentReplyPreviewGroup } from '../lib/commentReplyPreviews'
import type { CommentTool, ThreadComment } from '../lib/commentsWithReplies'
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'article'> & {
  comment: ThreadComment
  highlightedCommentId?: number | null
  serviceSlug: string
  serviceName: string
  preview?: boolean
  replyPreview?: CommentReplyPreviewGroup
  internalNote?: string | null
  canModerate?: boolean
  // readsUnpublished is the section-wide right to read others' unpublished posts, which a moderator keeps on
  // their own replies.
  readsUnpublished?: boolean
  openTool?: Exclude<CommentTool, 'reply'>
}
const {
  comment,
  serviceSlug,
  serviceName,
  highlightedCommentId,
  class: className,
  preview = false,
  replyPreview,
  internalNote,
  canModerate = false,
  readsUnpublished = false,
  openTool,
} = Astro.props
const user = Astro.locals.user
if (!canReadComment(user, comment, readsUnpublished)) return null
const experience = comment.kind === 'EXPERIENCE' ? comment.experience : null
const sentiment = experience?.sentiment
const outcome = experience?.outcome
const latest = experience?.updates[0]
const isAuthor = user?.id === comment.authorId
const staffRole = postStaffRole(comment.author)
const linkTo = (tool?: CommentTool, commentId = comment.id, section?: string) =>
  makeCommentUrl({ serviceSlug, commentId, tool, section })
const url = linkTo()
const toolSlotId = `comment-tools-${comment.id.toString()}`
const toolLink = (tool: Exclude<CommentTool, 'reply'>, section?: string) =>
  inlinePanelToggle({
    url: linkTo(tool, comment.id, section),
    slotId: toolSlotId,
    select: `#comment-tool-${comment.id.toString()}`,
    open: openTool === tool && !section,
  })
const latestEdit = comment.version > 1 ? comment.revisions[0] : undefined
const editedAt = latestEdit ? (latestEdit.decidedAt ?? latestEdit.createdAt) : null
const isStaffReply = !!comment.parentId && !!staffRole
const isServiceTeamReply =
  !!comment.parentId &&
  !!comment.author?.serviceAffiliations.some((item) => item.service.slug === serviceSlug)
const replyToName =
  comment.replyTo && canReadComment(user, comment.replyTo, readsUnpublished)
    ? authorDisplayName(comment.replyTo.author)
    : null
const isRootExperience = comment.kind === 'EXPERIENCE' && !comment.parentId
const unusableProof = comment.evidence.find(
  (item) =>
    !item.removedAt && !item.checks.length && (item.kind === 'TRANSACTION_ID' || item.formatValid === false)
)
const liveEvidence = comment.evidence.filter((item) => !item.removedAt)
// proofBadge shows the post's one proof: to everyone when it counts, to the author until it is checked, and to
// moderators whatever its result.
const [liveProof] = liveEvidence
const proofView = liveProof ? publicProofView(liveProof) : null
const proofFinding = proofView?.state === 'result' ? evidenceFindingsByValue[proofView.finding] : null
const showsProof =
  !!liveProof &&
  isRootExperience &&
  (countsAsProof(liveProof) || canModerate || (isAuthor && !liveProof.checks.length))
const proofBadge = showsProof && {
  label: proofFinding
    ? proofView?.state === 'result' && proofView.finding === 'LEGACY' && !canModerate
      ? 'Proof checked'
      : findingLabel(proofFinding.value, comment.issues)
    : proofSummariesByValue.unchecked.label,
  icon: proofFinding?.icon ?? proofSummariesByValue.unchecked.icon,
  color: proofFinding?.badgeColor ?? ('zinc' as const),
  tooltip: `${evidenceKindsByValue[shownProofKind(liveProof.kind, liveProof.checks[0]?.finding)].label}: ${liveProof.checks[0]?.explanation ?? 'not checked yet'}`,
}
const sentimentInfo = sentiment ? experienceSentimentsByValue[sentiment] : null
const contextItems = [
  experience?.occurredMonth && format(new Date(`${experience.occurredMonth}-01T00:00:00Z`), 'MMM yyyy'),
  outcome && comment.issues.length === 0 && outcomeLabel(outcome),
].filter(Boolean)
const showsProblems = !!outcome && comment.issues.length > 0
const [proofRequest] = comment.proofRequests
---

<article
  id={`comment-${comment.id}`}
  class={cn(
    'group scroll-mt-20 border-b border-night-500 py-5 last:border-b-0',
    (isStaffReply || isServiceTeamReply) && 'rounded-r-md border-b-0 border-l-2 px-3',
    isStaffReply
      ? 'border-l-teal-400 bg-teal-500/10'
      : isServiceTeamReply && 'border-l-cyan-400 bg-cyan-500/5',
    highlightedCommentId === comment.id && 'rounded-md bg-blue-500/5 px-2 outline outline-blue-500/30',
    !isPublishedComment(comment.status) && 'bg-yellow-500/5',
    className
  )}
>
  <header>
    <div class="min-w-0">
      <div class="flex items-start gap-2">
        {!comment.author?.picture && <Icon name="ri:user-line" class="size-5 text-day-300" />}
        <div class="flex min-w-0 flex-wrap items-center gap-x-1 gap-y-1">
          <AuthorFacts
            facts={!comment.parentId && comment.author ? comment.authorTrust : null}
            memberSince={comment.author?.createdAt}
          >
            <UserBadge
              user={comment.author}
              size="md"
              class={cn(
                'font-sans font-medium text-day-100',
                isAuthor && 'text-green-400',
                staffRole && staffNameClasses[staffRole]
              )}
            />
          </AuthorFacts>
          <CommentAuthorBadges comment={comment} serviceSlug={serviceSlug} />
          <span aria-hidden="true" class="text-xs text-day-500">·</span>
          <Tooltip
            size="sm"
            as="a"
            href={url}
            text={format(comment.createdAt, 'PPPpp')}
            class="text-xs text-day-400 hover:text-day-200"
          >
            <TimeFormatted date={comment.createdAt} hourPrecision />
          </Tooltip>
          {
            editedAt && (
              <Tooltip
                size="sm"
                as="a"
                {...toolLink('history')}
                text={`Edited ${format(editedAt, 'PPPpp')}. Click for earlier versions.`}
                class="text-xs text-day-500 hover:text-day-200 hover:underline"
              >
                · edited {format(editedAt, 'MMM d')}
              </Tooltip>
            )
          }
        </div>
      </div>
      {
        replyToName && comment.replyTo && (
          <a
            href={linkTo(undefined, comment.replyTo.id)}
            class="mt-0.5 inline-flex items-center gap-1 text-xs text-day-400 hover:text-day-200"
          >
            <Icon name="ri:reply-line" class="size-3.5" />
            in reply to <span class="font-medium">@{replyToName}</span>
          </a>
        )
      }
      {
        !comment.replyTo && comment.replyTargetDeleted && (
          <span class="mt-0.5 inline-flex items-center gap-1 text-xs text-day-500">
            <Icon name="ri:reply-line" class="size-3.5" />
            Replying to a deleted comment
          </span>
        )
      }
      <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-day-400">
        {
          experience ? (
            <span
              class={cn(
                'inline-flex items-center gap-1 font-medium',
                sentimentInfo?.classNames.text ?? 'text-day-300'
              )}
            >
              <Icon name={sentimentInfo?.icon ?? 'ri:chat-1-line'} class="size-3.5" />
              {sentimentInfo ? `${sentimentInfo.label} experience` : 'Experience'}
            </span>
          ) : (
            !comment.parentId && comment.kind === 'DISCUSSION' && <span>Question or discussion</span>
          )
        }
        {showsProblems && <ExperienceProblems issues={comment.issues} outcome={outcome} />}
        {comment.experienceUpdate && <BadgeSmall text="Author update" color="blue" variant="faded" />}
        {
          experience?.sentimentSource === 'AI' && Astro.locals.userCan('comments:moderate') && (
            <Tooltip size="sm" text="Suggested by AI. The author did not pick one.">
              AI label
            </Tooltip>
          )
        }
        {
          proofBadge && (
            <Tooltip size="sm" text={`${proofBadge.tooltip}\nClick for details.`}>
              <BadgeSmall
                as="a"
                {...toolLink('evidence')}
                class="hover:underline"
                icon={proofBadge.icon}
                color={proofBadge.color}
                variant="faded"
                text={proofBadge.label}
                inlineIcon
              />
            </Tooltip>
          )
        }
      </div>
      {
        proofRequest && (
          <ProofRequestLine
            request={proofRequest}
            evidence={comment.evidence}
            published={isPublishedComment(comment.status)}
            showsMessage={isAuthor || canModerate}
            addProofHref={isAuthor ? linkTo('edit', comment.id, 'proof') : null}
          />
        )
      }
    </div>
  </header>
  {
    !isPublishedComment(comment.status) && (
      <p class="mt-2 border-l-2 border-yellow-400 pl-2 text-xs text-yellow-200">
        Hidden · {getCommentStatusInfo(comment.status).publicLabel}. Only the author and moderators can see
        this comment.
      </p>
    )
  }
  {
    contextItems.length > 0 && (
      <p class="mt-2 flex flex-wrap gap-x-2 text-xs text-day-300">
        {contextItems.map((item, index) => (
          <span>
            {index > 0 && <span class="mr-2 text-day-500">·</span>}
            {item}
          </span>
        ))}
      </p>
    )
  }
  <div data-comment-body class="prose prose-sm mt-2 max-w-[70ch] wrap-break-word text-day-200 prose-invert">
    {
      preview && (comment.content.length > 500 || comment.content.split('\n').length > 6) && (
        <details data-comment-expand class="not-prose">
          <summary class="mt-1 inline-flex w-fit cursor-pointer list-none items-center gap-1 py-1 text-sm font-medium text-day-300 hover:text-day-100 [&::-webkit-details-marker]:hidden">
            <span data-when-closed>Read more</span>
            <span data-when-open>Show less</span>
            <Icon name="ri:arrow-down-s-line" class="size-4 in-open:rotate-180" is:inline />
          </summary>
        </details>
      )
    }
    <div data-comment-text>
      <Markdown content={comment.content} linkRel={['ugc', 'nofollow', 'noopener']} />
    </div>
  </div>
  {
    latest && (
      <p class="mt-3 border-l-2 border-blue-500/50 pl-3 text-sm text-day-300">
        <span class="font-medium text-blue-200">Author update</span>{' '}
        <a class="hover:underline" href={linkTo(undefined, latest.comment.id)}>
          {latest.comment.content.slice(0, 180)}
          {latest.comment.content.length > 180 && '…'}
        </a>
      </p>
    )
  }
  {
    isAuthor && isRootExperience && unusableProof && (
      <p class="mt-2 flex items-start gap-1.5 text-xs text-yellow-200">
        <Icon name="ri:error-warning-line" class="mt-px size-3.5 shrink-0" />
        <span>
          {unusableProof.kind === 'TRANSACTION_ID'
            ? 'Your proof looks like a transaction ID or address, which we cannot match to an order.'
            : "Your proof doesn't look like an order ID for this service."}{' '}
          <a {...toolLink('edit', 'proof')} class="underline hover:text-yellow-100">
            Add your order ID or a screenshot
          </a>
        </span>
      </p>
    )
  }
  <CommentNotes
    commentId={comment.id}
    publicNote={comment.publicNote}
    internalNote={internalNote}
    resolution={comment.resolution}
  />
  {
    comment.sourceCases.map((item) => (
      <a
        class="mt-2 block text-xs text-blue-300 hover:underline"
        href={`/service/${serviceSlug}/case/${item.publicId}`}
      >
        Case: {item.title}
      </a>
    ))
  }
  <footer class="mt-3 flex flex-wrap items-center gap-x-3 text-xs text-day-400">
    {
      isPublishedComment(comment.status) && (
        <a href={linkTo('reply')} class="py-2 text-day-300 hover:underline">
          Reply
        </a>
      )
    }
    {
      isAuthor && isPublishedComment(comment.status) && (
        <a {...toolLink('edit')} class="py-2 text-day-300 hover:underline">
          Edit
        </a>
      )
    }
    {
      isPublishedComment(comment.status) && !isAuthor && (
        <a
          {...(user
            ? toolLink('report')
            : {
                href: makeLoginUrl(new URL(linkTo('report'), Astro.url), {
                  message: 'Log in to report this comment',
                }),
                'data-astro-reload': true,
              })}
          class="py-2 text-day-300 hover:underline"
        >
          Report
        </a>
      )
    }
    {
      user && (
        <DropdownButton
          label="More"
          classNames={{
            button: 'h-8 gap-1 border-transparent bg-transparent px-0 text-xs text-day-300',
            arrow: 'size-3',
          }}
        >
          <form
            method="POST"
            action={actionInPlace(
              actions.notification.preferences.watchComment,
              Astro.url,
              `comment-${comment.id}`
            )}
          >
            <input type="hidden" name="commentId" value={comment.id} />
            <input type="hidden" name="watch" value={comment.isWatchingReplies ? '' : 'true'} />
            <button class="flex w-full items-center gap-2 px-4 py-2 text-left text-sm text-day-300 hover:bg-night-800">
              <Icon name="ri:notification-line" class="size-4" />
              {comment.isWatchingReplies ? 'Unwatch replies' : 'Watch replies'}
            </button>
          </form>
        </DropdownButton>
      )
    }
    {
      canModerate && (
        <a
          {...inlinePanelToggle({
            url: `/admin/comments/moderate/${comment.id.toString()}`,
            slotId: `moderation-${comment.id.toString()}`,
          })}
          class="ml-auto inline-flex min-h-8 items-center gap-1.5 rounded-md px-2 text-teal-300 hover:bg-teal-500/10"
        >
          <CommentStatusChip id={`comment-status-${comment.id}`} status={comment.status} />
          <Icon name="ri:shield-line" class="size-3.5" />
          Moderate
        </a>
      )
    }
  </footer>
  <div
    id={toolSlotId}
    data-inline-panel
    data-follows-url
    data-return-url={url}
    data-open-url={openTool ? linkTo(openTool) : undefined}
  >
    {openTool && <CommentToolPanel comment={comment} serviceSlug={serviceSlug} tool={openTool} />}
  </div>
  {canModerate && <div id={`moderation-${comment.id}`} data-inline-panel />}
  {
    preview && replyPreview && (
      <CommentReplyPreview
        serviceSlug={serviceSlug}
        serviceName={serviceName}
        commentId={comment.id}
        group={replyPreview}
      />
    )
  }
</article>

<style>
  [data-comment-text] :global(p) {
    margin-block: 0.5rem;
  }
  [data-comment-text] > :global(:first-child) {
    margin-top: 0;
  }
  [data-comment-text] > :global(:last-child) {
    margin-bottom: 0;
  }

  [data-comment-body] {
    display: flex;
    flex-direction: column;
  }
  [data-comment-expand] {
    order: 1;
  }
  [data-comment-expand]:not([open]) + [data-comment-text] {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, black calc(100% - 3lh), transparent);
  }
  [data-comment-expand]:not([open]) [data-when-open],
  [data-comment-expand][open] [data-when-closed] {
    display: none;
  }
</style>
