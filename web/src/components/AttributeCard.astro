---
import { Icon } from 'astro-icon/components'

import { cn } from '../lib/cn'
import { formatNumber } from '../lib/numbers'
import { attributeAnchor } from '../lib/serviceAnswers'
import { stripMarkdown } from '../lib/strings'

import Markdown from './Markdown.astro'
import Tooltip from './Tooltip.astro'

import type { getAttributeTypeInfo } from '../constants/attributeTypes'

type Props = {
  attribute: {
    slug: string
    title: string
    description: string
    privacyPoints: number
    trustPoints: number
    /** Per-service detail. Sits under the shared description, never scored. */
    note?: string | null
    typeInfo: ReturnType<typeof getAttributeTypeInfo>
    links: {
      url: string
      label: string
      icon: string
    }[]
  }
}

const { attribute } = Astro.props

const excerpt = stripMarkdown(attribute.description.split('\n')[0] ?? '')

// A per-service note is the more specific of the two, so it becomes the
// collapsed preview and carries a marker: otherwise the only cards worth
// opening look exactly like the ones that are not.
const note = attribute.note?.trim()
const preview = note ?? excerpt

// Privacy then trust, always both, so the columns line up with the group
// totals above them.
const points = [attribute.privacyPoints, attribute.trustPoints]
const formatPoints = (value: number) =>
  formatNumber(value, { roundDigits: 2, showSign: true, removeTrailingZeros: true })
---

{
  /* The anchor sits inside the body: browsers expand a closed details when a fragment inside it is navigated to, which is what a caveat link relies on. */
}
<li
  class="rounded-md has-[:target]:ring-2 has-[:target]:ring-orange-500 has-[:target]:ring-offset-2 has-[:target]:ring-offset-night-800"
>
  <details class="group/attribute">
    <summary
      class={cn(
        'block cursor-pointer rounded-md bg-night-400 p-2 font-title text-sm text-pretty select-none',
        attribute.typeInfo.classNames.container,
        attribute.typeInfo.classNames.text
      )}
    >
      <div class="flex items-center">
        <span class="mr-auto ml-1 min-w-0 truncate font-bold" title={attribute.title}>
          {attribute.title}
        </span>
        {
          points.map((value) => (
            <span
              class={cn(
                'ml-2 min-w-7 text-center text-sm',
                value === 0 ? 'text-current/50' : 'text-current/80'
              )}
            >
              {formatPoints(value)}
            </span>
          ))
        }
      </div>
      {/* Always two lines, so collapsed cards share a height without stretching to the tallest neighbour. */}
      <div class="mt-0.5 flex items-center gap-1 group-open/attribute:hidden">
        {
          note && (
            <Tooltip text="We added a note specific to this service" class="ml-1 inline-flex shrink-0">
              <Icon name="ri:sticky-note-line" class={cn('size-3.5', attribute.typeInfo.classNames.icon)} />
            </Tooltip>
          )
        }
        <p class={cn('line-clamp-1 flex-1 text-xs font-normal text-current/80', !note && 'ml-1')}>
          {preview || '\u00a0'}
        </p>
        <Icon name="ri:arrow-down-s-line" class={cn('size-5 shrink-0', attribute.typeInfo.classNames.icon)} />
      </div>
    </summary>

    <div
      id={attributeAnchor(attribute.slug)}
      class={cn(
        'mx-2 scroll-mt-24 rounded-b-lg border-2 border-t-0 border-night-400 bg-night-400/20 p-3 pt-2 text-xs text-day-300',
        attribute.typeInfo.classNames.subcontainer,
        attribute.typeInfo.classNames.text
      )}
    >
      <div
        class="prose prose-sm text-xs/normal text-pretty text-current prose-invert prose-p:my-1 prose-p:first:mt-0 prose-p:last:mb-0"
      >
        <Markdown content={attribute.description} />
      </div>

      {
        attribute.note && (
          <p class="mt-1.5 border-l-2 border-current/25 pl-2 text-xs/normal text-pretty text-current/90">
            <span class="font-bold">For this service:</span> {attribute.note}
          </p>
        )
      }

      {
        attribute.links.length > 0 && (
          <div class="mt-2 flex flex-row gap-2">
            {attribute.links.map((link) => (
              <a
                href={link.url}
                class={cn(
                  'flex flex-1 items-center justify-center gap-1 rounded-sm px-2 py-1 font-semibold whitespace-nowrap transition-colors',
                  attribute.typeInfo.classNames.button
                )}
              >
                <Icon name={link.icon} class="size-4" />
                {link.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </details>
</li>
