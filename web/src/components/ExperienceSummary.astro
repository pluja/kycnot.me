---
import { Icon } from 'astro-icon/components'
import { format } from 'date-fns'

import { experienceSentiments } from '../constants/experiences'
import { cn } from '../lib/cn'
import { summaryWindowDays, type ExperienceSummaryData, type SentimentCounts } from '../lib/experienceQueries'
import { summaryVerdict, verdictCounts, type VerdictTone } from '../lib/experienceVerdict'
import { formatDaysAgo } from '../lib/timeAgo'

import SentimentBar from './SentimentBar.astro'
import Tooltip from './Tooltip.astro'

type Props = {
  summary: ExperienceSummaryData
  filterUrl: (changes: Record<string, string | undefined>) => string
}
const { summary, filterUrl } = Astro.props
const recent = { period: '90d' }
const { counts, checkedOnly } = verdictCounts(summary)
const verdict = summaryVerdict(summary)
const toneClass = {
  good: 'text-green-300',
  caution: 'text-yellow-300',
  bad: 'text-red-300',
} as const satisfies Record<VerdictTone, string>
const sentimentCounts = experienceSentiments.map((sentiment) => ({
  sentiment,
  count: counts[sentiment.value.toLowerCase() as keyof SentimentCounts],
}))
const proofPhrase =
  checkedOnly && verdict
    ? `Verdict from the ${summary.checked.total.toLocaleString()} of ${summary.total.toLocaleString()} with checked proof`
    : summary.checked.total === 0
      ? 'None with checked proof yet'
      : summary.checked.total < summary.total
        ? `${summary.checked.total.toLocaleString()} of ${summary.total.toLocaleString()} with checked proof`
        : summary.total === 1
          ? 'With checked proof'
          : 'All with checked proof'
---

{
  summary.latestAt && (
    <section
      class="mb-4 rounded-lg border border-night-600 bg-night-800 px-4 py-3"
      aria-labelledby="experience-summary-title"
    >
      {summary.total === 0 ? (
        <p id="experience-summary-title" class="text-sm text-day-400">
          No experiences in the last {summaryWindowDays} days. The latest is from{' '}
          {format(summary.latestAt, 'MMMM yyyy')}.{' '}
          <a href={filterUrl({ period: undefined })} class="text-day-200 underline hover:text-day-100">
            See all experiences
          </a>
        </p>
      ) : (
        <>
          <p id="experience-summary-title" class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
            {verdict && (
              <span class={cn('font-title text-lg font-bold', toneClass[verdict.tone])}>{verdict.label}</span>
            )}
            <span class={cn('text-sm', verdict ? 'text-day-400' : 'text-day-200')}>
              {`${summary.total.toLocaleString()} ${summary.total === 1 ? 'experience' : 'experiences'} in the last ${String(summaryWindowDays)} days`}
              {summary.recentLatestAt && `, latest ${formatDaysAgo(summary.recentLatestAt)}`}
            </span>
          </p>

          <SentimentBar counts={counts} class="mt-2.5" />

          <div class="mt-2 flex flex-wrap items-center justify-between gap-x-6 gap-y-1 text-sm">
            <div class="flex flex-wrap gap-x-4">
              {sentimentCounts.map(({ sentiment, count }) => (
                <a
                  href={filterUrl({ ...recent, sentiment: sentiment.value })}
                  class="text-day-400 hover:text-day-200 hover:underline"
                  rel="nofollow"
                >
                  <span
                    class={cn(
                      'font-semibold tabular-nums',
                      count > 0 ? sentiment.classNames.text : 'text-day-500'
                    )}
                  >
                    {count.toLocaleString()}
                  </span>
                  {` ${sentiment.shortLabel.toLowerCase()}`}
                </a>
              ))}
            </div>
            <Tooltip
              as="a"
              href={filterUrl({ ...recent, evidence: 'checked' })}
              class="inline-flex items-center gap-1 text-xs text-day-400 hover:text-day-200 hover:underline"
              rel="nofollow"
              size="sm"
              text="A moderator checked the proof, usually on the service's own order lookup."
            >
              <Icon name="ri:shield-check-line" class="size-3.5" />
              {proofPhrase}
            </Tooltip>
          </div>
        </>
      )}
    </section>
  )
}
