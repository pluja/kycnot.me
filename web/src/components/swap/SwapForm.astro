---
import { Icon } from 'astro-icon/components'

import { cn } from '../../lib/cn'
import { buildSwapUrl, SWAP_OOB_TARGETS, SWAP_OOB_TARGETS_WITH_AMOUNTS } from '../../lib/exchange/swapUrls'

import SwapCurrencySelect from './SwapCurrencySelect.astro'

import type { SwapFormInput } from '../../components/swap/SwapFormAndResults.astro'
import type { SwapCurrencies } from '../../lib/exchange/swapCurrencies'
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'form'> & {
  input: SwapFormInput
  currencies: SwapCurrencies
  resultsId: string
  /** Send amount to preload on the flipped pair; undefined leaves the form empty. */
  flipSendAmount?: number
  pushUrl?: boolean
}

const { input, currencies, resultsId, flipSendAmount, pushUrl, class: className, ...htmlProps } = Astro.props

// Flip uses hx-vals alone (no hx-include) so a stale receiveAmount in the
// form doesn't trip the zod parser with an empty string.
const flipValues: Record<string, number | string> = {
  from: input.to,
  to: input.from,
  sortBy: input.sortBy,
}
if (flipSendAmount !== undefined) flipValues.sendAmount = flipSendAmount
if (input.approvedOnly) flipValues.approvedOnly = 'true'
const swapHref = buildSwapUrl(input.to, input.from, {
  sendAmount: flipSendAmount,
  sortBy: input.sortBy,
  approvedOnly: input.approvedOnly,
})

const inputClass =
  'min-w-0 flex-1 appearance-none border-0 bg-transparent font-mono text-base font-medium text-white tabular-nums outline-none placeholder:text-day-700 focus:ring-0 focus:outline-none [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none'

const labelClass = 'text-[10px] font-semibold tracking-[0.2em] text-day-500 uppercase'
---

<form
  id="swap-form"
  method="GET"
  action="/swap"
  hx-get="/swap"
  hx-select={`#${resultsId}`}
  hx-target={`#${resultsId}`}
  hx-swap="outerHTML"
  hx-select-oob={SWAP_OOB_TARGETS}
  hx-trigger="input[target.type==='number'] changed delay:500ms"
  hx-push-url={pushUrl ? 'true' : undefined}
  hx-indicator={`#${resultsId}`}
  class={cn('relative', className)}
  {...htmlProps}
>
  <input id="swap-sort-state" type="hidden" name="sortBy" value={input.sortBy} />
  <input
    id="swap-approved-only-state"
    type="hidden"
    name="approvedOnly"
    value={input.approvedOnly ? 'true' : 'false'}
  />

  <div
    class="rounded-xl border border-night-700 bg-night-800 shadow-sm"
  >
    <div class="px-3 py-2.5">
      <label for="swap-send" class={cn(labelClass, 'mb-1 block')}>You send</label>
      <div class="flex items-center gap-3">
        <input
          type="number"
          id="swap-send"
          name="sendAmount"
          value={input.sendAmount}
          placeholder="0.00"
          step="any"
          min="0"
          inputmode="decimal"
          class={inputClass}
        />
        <SwapCurrencySelect
          name="from"
          selected={input.from}
          input={input}
          popular={currencies.popular}
          other={currencies.other}
          byValue={currencies.byValue}
        />
      </div>
    </div>

    <div class="relative flex h-px items-center justify-center bg-night-700/60">
      <a
        id="swap-flip"
        href={swapHref}
        hx-get="/swap"
        hx-vals={JSON.stringify(flipValues)}
        hx-target={`#${resultsId}`}
        hx-select={`#${resultsId}`}
        hx-swap="outerHTML"
        hx-select-oob={SWAP_OOB_TARGETS_WITH_AMOUNTS}
        hx-push-url="true"
        hx-indicator={`#${resultsId}`}
        title="Flip direction"
        aria-label="Swap from and to currencies"
        class="group/flip flex size-8 items-center justify-center rounded-full border border-night-600 bg-night-800 text-day-300 shadow-md transition-all duration-300 hover:rotate-180 hover:border-green-500/40 hover:bg-night-700 hover:text-green-400 hover:shadow-green-500/10"
      >
        <Icon name="ri:arrow-up-down-line" class="size-3.5" />
      </a>
    </div>

    <div class="px-3 py-2.5">
      <label for="swap-receive" class={cn(labelClass, 'mb-1 block')}>You receive</label>
      <div class="flex items-center gap-3">
        <input
          type="number"
          id="swap-receive"
          name="receiveAmount"
          value={input.receiveAmount}
          placeholder="0.00"
          step="any"
          min="0"
          inputmode="decimal"
          class={inputClass}
        />
        <SwapCurrencySelect
          name="to"
          selected={input.to}
          input={input}
          popular={currencies.popular}
          other={currencies.other}
          byValue={currencies.byValue}
        />
      </div>
    </div>
  </div>

  <button
    type="submit"
    class="mt-3 h-10 w-full rounded-lg border border-green-600 bg-green-500 text-sm font-bold text-black transition-colors hover:bg-green-400 js:hidden"
  >
    Compare Rates
  </button>
</form>

<script>
  // Typing in one leg clears the other so the server sees only the side the
  // user meant to submit. Without this, a stale value on the hidden side
  // would mismatch the visible form.
  document.addEventListener('astro:page-load', () => {
    const send = document.querySelector<HTMLInputElement>('#swap-send')
    const receive = document.querySelector<HTMLInputElement>('#swap-receive')
    if (!send || !receive) return
    send.addEventListener('input', () => {
      if (send.value !== '' && receive.value !== '') receive.value = ''
    })
    receive.addEventListener('input', () => {
      if (receive.value !== '' && send.value !== '') send.value = ''
    })
  })
</script>
