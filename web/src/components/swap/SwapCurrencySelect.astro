---
import { Icon } from 'astro-icon/components'

import { cn } from '../../lib/cn'
import { FALLBACK_ICON } from '../../lib/exchange/currencyMapping'

import SwapCurrencyOption from './SwapCurrencyOption.astro'

import type { SwapFormInput } from './SwapFormAndResults.astro'
import type { SwapOption } from '../../lib/exchange/swapCurrencies'
import type { HTMLAttributes } from 'astro/types'

type Props = Omit<HTMLAttributes<'div'>, 'name'> & {
  name: 'from' | 'to'
  selected: string
  input: SwapFormInput
  popular: SwapOption[]
  other: SwapOption[]
  byValue: Map<string, SwapOption>
}

const FALLBACK_OPTION: SwapOption = {
  value: 'btc',
  code: 'BTC',
  network: '',
  name: 'Bitcoin',
  icon: 'cryptocurrency:btc',
  popular: true,
}

const { name, selected, input, popular, other, byValue, class: className, ...htmlProps } = Astro.props

const selectedOption = byValue.get(selected) ?? popular[0] ?? other[0] ?? FALLBACK_OPTION
---

<details
  id={`swap-currency-${name}`}
  data-swap-select
  class={cn('group relative', className)}
  {...htmlProps}
>
  <summary
    class="group/trigger inline-flex shrink-0 cursor-pointer list-none items-center gap-1.5 rounded-full border border-night-600 bg-night-800 py-1 pr-1.5 pl-2 transition-colors hover:border-night-500 [&::-webkit-details-marker]:hidden"
  >
    <Icon name={selectedOption.icon || FALLBACK_ICON} class="size-5 shrink-0" />
    <span class="font-title text-sm font-bold tracking-wide text-white sm:text-base">
      {selectedOption.code}
    </span>
    {
      selectedOption.network && (
        <span
          data-swap-network-badge
          class="rounded-sm bg-night-700 px-1 py-px text-[9px] font-semibold tracking-wider text-day-200 uppercase"
        >
          {selectedOption.network}
        </span>
      )
    }
    <Icon
      name="ri:arrow-drop-down-line"
      class="size-5 shrink-0 text-day-400 transition-transform group-open:rotate-180"
    />
  </summary>

  <!-- Carries the selected pair when JS is off. -->
  <input type="hidden" name={name} value={selectedOption.value} data-swap-select-input />

  <div
    class="absolute top-full right-0 z-50 mt-2 w-72 origin-top-right rounded-xl border border-night-700 bg-night-900 p-2 shadow-2xl shadow-black/60"
  >
    <div class="relative mb-2 no-js:hidden">
      <Icon
        name="ri:search-line"
        class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-day-500"
      />
      <input
        type="search"
        placeholder="Search currency..."
        autocomplete="off"
        spellcheck="false"
        class="w-full rounded-md border border-night-700 bg-night-800 py-2 pr-3 pl-9 text-sm text-white placeholder:text-day-500 focus:border-green-500/40 focus:outline-none"
        data-swap-select-search
        aria-label="Search currencies"
      />
    </div>

    <div class="max-h-64 overflow-y-auto" data-swap-select-list>
      {popular.length > 0 && (
        <div
          class="mb-1 px-2 pt-1 pb-1 text-[10px] font-semibold tracking-[0.15em] text-day-500 uppercase"
          data-swap-select-heading
          data-group="popular"
        >
          Popular
        </div>
      )}
      {
        popular.map((o) => (
          <SwapCurrencyOption
            option={o}
            name={name}
            group="popular"
            selected={selected}
            input={input}
          />
        ))
      }
      {other.length > 0 && (
        <div
          class="mt-2 mb-1 px-2 pt-1 pb-1 text-[10px] font-semibold tracking-[0.15em] text-day-500 uppercase"
          data-swap-select-heading
          data-group="other"
        >
          All
        </div>
      )}
      {
        other.map((o) => (
          <SwapCurrencyOption option={o} name={name} group="other" selected={selected} input={input} />
        ))
      }
      <div
        class="hidden px-3 py-6 text-center text-sm text-day-500"
        data-swap-select-empty
      >
        No currencies match "<span data-swap-select-query></span>"
      </div>
    </div>
  </div>
</details>

<style>
  /* Skip layout + paint for offscreen options; the two 300-500 item lists
     become smooth on weaker devices. 36px is the rendered row height. */
  .swap-select-option {
    content-visibility: auto;
    contain-intrinsic-size: 0 36px;
  }
</style>

