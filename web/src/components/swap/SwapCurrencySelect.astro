---
import { Icon } from 'astro-icon/components'

import { cn } from '../../lib/cn'
import { FALLBACK_ICON } from '../../lib/exchange/currencyMapping'

import SwapCurrencyOption from './SwapCurrencyOption.astro'

import type { SwapFormInput } from './SwapFormAndResults.astro'
import type { SwapOption } from '../../lib/exchange/swapCurrencies'
import type { HTMLAttributes } from 'astro/types'

type Props = Omit<HTMLAttributes<'div'>, 'name'> & {
  name: 'from' | 'to'
  selected: string
  input: SwapFormInput
  popular: SwapOption[]
  other: SwapOption[]
  byValue: Map<string, SwapOption>
}

const FALLBACK_OPTION: SwapOption = {
  value: 'btc',
  code: 'BTC',
  network: '',
  name: 'Bitcoin',
  icon: 'cryptocurrency:btc',
  popular: true,
}

const { name, selected, input, popular, other, byValue, class: className, ...htmlProps } = Astro.props

const selectedOption = byValue.get(selected) ?? popular[0] ?? other[0] ?? FALLBACK_OPTION
---

<details
  id={`swap-currency-${name}`}
  data-swap-select
  class={cn('group relative', className)}
  {...htmlProps}
>
  <summary
    class="group/trigger inline-flex shrink-0 cursor-pointer list-none items-center gap-1.5 rounded-full border border-night-600 bg-night-800 py-1 pr-1.5 pl-2 transition-colors hover:border-night-500 [&::-webkit-details-marker]:hidden"
  >
    <Icon name={selectedOption.icon || FALLBACK_ICON} class="size-5 shrink-0" />
    <span class="font-title text-sm font-bold tracking-wide text-white sm:text-base">
      {selectedOption.code}
    </span>
    {
      selectedOption.network && (
        <span class="rounded-sm bg-night-700 px-1 py-px text-[9px] font-semibold tracking-wider text-day-200 uppercase">
          {selectedOption.network}
        </span>
      )
    }
    <Icon
      name="ri:arrow-drop-down-line"
      class="size-5 shrink-0 text-day-400 transition-transform group-open:rotate-180"
    />
  </summary>

  <!-- Form submit fallback when JS is off; option clicks use full-state URLs. -->
  <input type="hidden" name={name} value={selectedOption.value} data-swap-select-input />

  <div
    class="absolute top-full right-0 z-50 mt-2 w-72 origin-top-right rounded-xl border border-night-700 bg-night-900 p-2 shadow-2xl shadow-black/60"
  >
    <div class="relative mb-2 no-js:hidden">
      <Icon
        name="ri:search-line"
        class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-day-500"
      />
      <input
        type="search"
        placeholder="Search currency..."
        autocomplete="off"
        spellcheck="false"
        class="w-full rounded-md border border-night-700 bg-night-800 py-2 pr-3 pl-9 text-sm text-white placeholder:text-day-500 focus:border-green-500/40 focus:outline-none"
        data-swap-select-search
        aria-label="Search currencies"
      />
    </div>

    <div class="max-h-64 overflow-y-auto" data-swap-select-list>
      {popular.length > 0 && (
        <div
          class="mb-1 px-2 pt-1 pb-1 text-[10px] font-semibold tracking-[0.15em] text-day-500 uppercase"
          data-swap-select-heading
          data-group="popular"
        >
          Popular
        </div>
      )}
      {
        popular.map((o) => (
          <SwapCurrencyOption
            option={o}
            name={name}
            group="popular"
            selected={selected}
            input={input}
          />
        ))
      }
      {other.length > 0 && (
        <div
          class="mt-2 mb-1 px-2 pt-1 pb-1 text-[10px] font-semibold tracking-[0.15em] text-day-500 uppercase"
          data-swap-select-heading
          data-group="other"
        >
          All
        </div>
      )}
      {
        other.map((o) => (
          <SwapCurrencyOption option={o} name={name} group="other" selected={selected} input={input} />
        ))
      }
      <div
        class="hidden px-3 py-6 text-center text-sm text-day-500"
        data-swap-select-empty
      >
        No currencies match "<span data-swap-select-query></span>"
      </div>
    </div>
  </div>
</details>

<style>
  /* Skip layout + paint for offscreen options; the two 300-500 item lists
     become smooth on weaker devices. 36px is the rendered row height. */
  .swap-select-option {
    content-visibility: auto;
    contain-intrinsic-size: 0 36px;
  }
</style>

<script>
  // Progressive enhancement for the <details>-based currency picker:
  // search, keyboard nav, outside-click close, scroll-to-selection.
  document.addEventListener('astro:page-load', () => {
    const roots = document.querySelectorAll<HTMLDetailsElement>('details[data-swap-select]')
    if (roots.length === 0) return

    roots.forEach(wireRoot)

    document.addEventListener('click', (event) => {
      const target = event.target as Node
      roots.forEach((root) => {
        if (root.open && !root.contains(target)) root.open = false
      })
    })
  })

  function wireRoot(root: HTMLDetailsElement) {
    const search = root.querySelector<HTMLInputElement>('[data-swap-select-search]')
    const list = root.querySelector<HTMLElement>('[data-swap-select-list]')

    root.addEventListener('toggle', () => {
      if (!root.open) return
      // Always reopen with the full list so arrow-key browsing works.
      if (search) {
        search.value = ''
        applyFilter(root, '')
      }
      scrollSelectedIntoView(root, list)
      requestAnimationFrame(() => search?.focus())
    })

    if (search) {
      search.addEventListener('input', () => {
        applyFilter(root, search.value)
        if (list) list.scrollTop = 0
      })
    }

    root.addEventListener('keydown', (event) => handleKeydown(root, search, event))
  }

  function handleKeydown(
    root: HTMLDetailsElement,
    search: HTMLInputElement | null,
    event: KeyboardEvent
  ) {
    if (event.key === 'Escape') {
      if (!root.open) return
      event.preventDefault()
      root.open = false
      root.querySelector<HTMLElement>('summary')?.focus()
      return
    }
    if (event.key === 'ArrowDown') {
      event.preventDefault()
      moveFocus(root, 1)
      return
    }
    if (event.key === 'ArrowUp') {
      event.preventDefault()
      moveFocus(root, -1)
      return
    }
    if (event.key === 'Enter' && document.activeElement === search) {
      const first = visibleOptions(root)[0]
      if (first) {
        event.preventDefault()
        first.click()
      }
    }
  }

  function visibleOptions(root: HTMLElement): HTMLAnchorElement[] {
    return Array.from(
      root.querySelectorAll<HTMLAnchorElement>('[data-swap-select-option]:not([hidden])')
    )
  }

  function moveFocus(root: HTMLDetailsElement, direction: 1 | -1) {
    const options = visibleOptions(root)
    if (options.length === 0) return
    const active = document.activeElement as HTMLElement | null
    const currentIdx = active ? options.indexOf(active as HTMLAnchorElement) : -1
    let nextIdx: number
    if (currentIdx === -1) {
      nextIdx = direction > 0 ? 0 : options.length - 1
    } else {
      nextIdx = Math.max(0, Math.min(options.length - 1, currentIdx + direction))
    }
    const next = options[nextIdx]
    if (!next) return
    next.focus({ preventScroll: true })
    next.scrollIntoView({ block: 'nearest' })
  }

  function scrollSelectedIntoView(root: HTMLElement, list: HTMLElement | null) {
    if (!list) return
    const selected = root.querySelector<HTMLAnchorElement>(
      '[data-swap-select-option][aria-current="true"]'
    )
    if (!selected) {
      list.scrollTop = 0
      return
    }
    // 60px offset keeps a couple of rows above the selection visible.
    list.scrollTop = selected.offsetTop - list.offsetTop - 60
  }

  function applyFilter(root: HTMLElement, raw: string) {
    const query = raw.trim().toLowerCase()
    const options = root.querySelectorAll<HTMLAnchorElement>('[data-swap-select-option]')
    const visibleByGroup: Record<string, number> = {}
    options.forEach((option) => {
      const text = option.getAttribute('data-search-text') ?? ''
      const group = option.getAttribute('data-group') ?? ''
      const matches = query === '' || text.includes(query)
      option.hidden = !matches
      if (matches) visibleByGroup[group] = (visibleByGroup[group] ?? 0) + 1
    })
    root.querySelectorAll<HTMLElement>('[data-swap-select-heading]').forEach((heading) => {
      const group = heading.getAttribute('data-group') ?? ''
      heading.hidden = (visibleByGroup[group] ?? 0) === 0
    })
    const totalVisible = Object.values(visibleByGroup).reduce((a, b) => a + b, 0)
    const empty = root.querySelector<HTMLElement>('[data-swap-select-empty]')
    const queryEl = root.querySelector<HTMLElement>('[data-swap-select-query]')
    if (empty) empty.hidden = totalVisible > 0
    if (queryEl) queryEl.textContent = raw.trim()
  }
</script>
