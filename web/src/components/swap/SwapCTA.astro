---
import { Icon } from 'astro-icon/components'

import { cn } from '../../lib/cn'

import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'a'> & {
  heading?: string
  description?: string
}

const {
  heading = 'Compare exchange rates',
  description = 'Find the best rates across privacy-respecting exchanges.',
  class: className,
  ...htmlProps
} = Astro.props
---

<a
  href="/swap"
  class={cn(
    'group flex items-center gap-2.5 rounded-lg border border-green-500/25 bg-green-500/5 px-3.5 py-2 text-sm transition-colors hover:border-green-500/45 hover:bg-green-500/10',
    className
  )}
  {...htmlProps}
>
  <Icon name="ri:swap-line" class="size-4 shrink-0 text-green-500" />
  <span class="font-title font-semibold text-green-400 group-hover:text-green-300">
    {heading}
  </span>
  <span class="min-w-0 flex-1 truncate text-day-400 max-sm:hidden">
    {description}
  </span>
  <Icon
    name="ri:arrow-right-line"
    class="ml-auto size-4 shrink-0 text-green-500/60 group-hover:text-green-400"
  />
</a>
