---
import { VerificationStatus } from '@prisma/client'
import { Icon } from 'astro-icon/components'
import { z } from 'astro:content'

import SwapForm from '../../components/swap/SwapForm.astro'
import SwapPopularPairs from '../../components/swap/SwapPopularPairs.astro'
import SwapResultControls from '../../components/swap/SwapResultControls.astro'
import SwapResultsTable from '../../components/swap/SwapResultsTable.astro'
import { cn } from '../../lib/cn'
import { getAggregatedQuotesWithServices } from '../../lib/exchange/aggregator'
import { getSwapCurrencies } from '../../lib/exchange/swapCurrencies'
import { zodParseQueryParamsStoringErrors } from '../../lib/parseUrlFilters'
import { bump } from '../../lib/stats'

import { formatSwapRate, sortSwapResults } from './swapResultUi'

import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'div'> & {
  highlightSlug?: string
}

const { class: className, highlightSlug, ...htmlProps } = Astro.props

const currencies = await getSwapCurrencies()
if (currencies.degraded) {
  Astro.locals.banners.add({
    uiMessage: 'Currency list unavailable; showing a minimal set.',
    type: 'error',
    origin: 'custom_swap_currencies',
    error: currencies.reason,
  })
}

const coerceToKnownCurrency = (fallback: string) =>
  z
    .string()
    .toLowerCase()
    .default(fallback)
    .transform((v) => (currencies.byValue.has(v) ? v : fallback))

const { data: params } = zodParseQueryParamsStoringErrors(
  {
    from: coerceToKnownCurrency('btc'),
    to: coerceToKnownCurrency('xmr'),
    sendAmount: z.coerce.number().positive().finite().optional(),
    receiveAmount: z.coerce.number().positive().finite().optional(),
    sortBy: z.enum(['rate', 'score', 'kyc']).default('rate'),
    approvedOnly: z
      .string()
      .optional()
      .transform((value) => value === 'true' || value === 'on' || value === '1'),
  },
  Astro
)

const input = (() => {
  const from = params.from === params.to ? (params.to === 'xmr' ? 'btc' : 'xmr') : params.from
  return {
    ...params,
    from,
    sendAmount:
      params.sendAmount !== undefined && params.receiveAmount !== undefined
        ? undefined
        : params.sendAmount === undefined && params.receiveAmount === undefined
          ? from === 'btc'
            ? 0.01
            : 1
          : params.sendAmount,
  }
})()

export type SwapFormInput = typeof input

const parseCompound = (v: string) => {
  const [code = '', network = ''] = v.split('@')
  return {
    value: v,
    code: code.toUpperCase(),
    network: network.toUpperCase(),
    name: code.toUpperCase(),
    icon: '',
    popular: false,
  }
}
const fromOption = currencies.byValue.get(input.from) ?? parseCompound(input.from)
const toOption = currencies.byValue.get(input.to) ?? parseCompound(input.to)

const REQUEST_MAX_WAIT_MS = 6_000

const result = await Astro.locals.banners.try(
  'Error fetching rates',
  async () => {
    const quotes = await getAggregatedQuotesWithServices({
      currencyFrom: fromOption.value,
      currencyTo: toOption.value,
      sendAmount: input.sendAmount,
      receiveAmount: input.receiveAmount,
      maxWaitMs: REQUEST_MAX_WAIT_MS,
    })
    // Bump only inside the success path; banners.try swallows gRPC errors
    // into a [] fallback that would otherwise inflate the counter.
    if (
      fromOption.value &&
      toOption.value &&
      (input.sendAmount !== undefined || input.receiveAmount !== undefined)
    ) {
      void bump({
        kind: 'swap.quote-fetched',
        fromCurrency: fromOption.value,
        toCurrency: toOption.value,
      }).catch(() => null)
    }
    return quotes
  },
  []
)

function isApprovedOrVerified(status: VerificationStatus): boolean {
  return status === VerificationStatus.APPROVED || status === VerificationStatus.VERIFICATION_SUCCESS
}

const filteredResult = input.approvedOnly
  ? result.filter((item) => item.service !== null && isApprovedOrVerified(item.service.verificationStatus))
  : result

const RESULTS_ID = 'swap-results'
const amountSide: 'receive' | 'send' =
  input.receiveAmount !== undefined && input.sendAmount === undefined ? 'receive' : 'send'
const displayResult = sortSwapResults(filteredResult, input.sortBy, amountSide)

const bestResult = displayResult.find((r) => r.quote !== null)
const bestQuote = bestResult?.quote ?? null

function deriveMarketRate(): number | null {
  if (bestQuote?.marketSpreadPercent == null) return null
  const factor = 1 - bestQuote.marketSpreadPercent / 100
  if (!Number.isFinite(factor) || factor <= 0) return null
  return bestQuote.exchangeRate / factor
}
const marketRate = deriveMarketRate()

const showMarketData = bestQuote?.marketSpreadPercent != null
const quotesCount = displayResult.filter((r) => r.quote !== null).length

// After flip, the new send amount equals the old "to" side. Truncate to 2
// decimals (product rule); if that collapses to 0, drop the amount and just
// flip the pair.
function truncateTo2(value: number): number {
  return Math.floor(value * 100) / 100
}

const flipSendAmount = (() => {
  const raw = amountSide === 'send' ? bestQuote?.amountReceived : input.receiveAmount
  if (raw === undefined) return undefined
  const truncated = truncateTo2(raw)
  return truncated > 0 ? truncated : undefined
})()
---

<div {...htmlProps} class={cn('mx-auto max-w-5xl', className)}>
  <div class="mx-auto max-w-xl">
    <SwapPopularPairs
      currentFrom={input.from}
      currentTo={input.to}
      sendAmount={input.sendAmount}
      sortBy={input.sortBy}
      approvedOnly={input.approvedOnly}
      resultsId={RESULTS_ID}
    />

    <SwapForm
      input={input}
      currencies={currencies}
      resultsId={RESULTS_ID}
      flipSendAmount={flipSendAmount}
      class="mt-3"
      pushUrl
    />
  </div>

  <div id={RESULTS_ID} class="relative mt-5" aria-live="polite" aria-busy="false">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-[2px] overflow-hidden rounded-t opacity-0 transition-opacity duration-75 htmx-request:opacity-100"
      aria-hidden="true"
    >
      <div class="swap-progress-sweep h-full w-1/3 rounded-full bg-green-500"></div>
    </div>

    <div class="transition-opacity duration-75 htmx-request:pointer-events-none htmx-request:opacity-60">
      <div class="rounded-lg border border-night-700/50 bg-night-800/30 px-3 py-2 text-sm">
        <div class="flex flex-col gap-2 lg:flex-row lg:items-center lg:justify-between">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <div class="text-day-400">
              <span class="font-semibold text-white tabular-nums">{quotesCount}</span>
              {' '}
              {quotesCount === 1 ? 'quote' : 'quotes'}
            </div>

            {
              showMarketData && marketRate !== null && (
                <div class="text-xs text-day-500">
                  Market{' '}
                  <span class="font-mono font-semibold text-day-200 tabular-nums">
                    {formatSwapRate(marketRate)}
                  </span>{' '}
                  {toOption.code}/{fromOption.code}
                  <span class="text-day-700"> · </span>
                  <a
                    href="https://coinpaprika.com"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-day-600 underline decoration-dotted underline-offset-2 hover:text-day-400"
                  >
                    CoinPaprika
                  </a>
                </div>
              )
            }
          </div>

          <SwapResultControls input={input} resultsId={RESULTS_ID} />
        </div>
      </div>

      <details class="mt-4 px-2">
        <summary
          class="inline-flex cursor-pointer list-none items-center gap-1 text-xs text-day-500 hover:text-day-300"
        >
          <Icon name="ri:information-line" class="size-3.5" />
          What do the icons mean?
        </summary>
        <ul class="mt-2 space-y-1.5 text-xs text-day-400">
          <li class="flex items-start gap-2">
            <Icon name="ri:shield-check-line" class="mt-0.5 size-3.5 shrink-0 text-green-400" />
            <span>
              <strong class="text-day-200">OrangeFren Guarantee</strong>: your trade is protected if this
              provider violates its own stated policies. Read the FAQ below for more information.
            </span>
          </li>
          <li class="flex items-start gap-2">
            <Icon name="ri:scan-line" class="mt-0.5 size-3.5 shrink-0 text-cyan-400" />
            <span>
              <strong class="text-day-200">AML pre-check</strong>: submit your wallet address to the
              provider's support before sending; if they give an OK, no KYC on this swap.
            </span>
          </li>
        </ul>
      </details>

      <SwapResultsTable
        result={displayResult}
        currencyFrom={fromOption}
        currencyTo={toOption}
        amountSide={amountSide}
        highlightSlug={highlightSlug}
        class=""
      />
    </div>
  </div>
</div>

<style>
  .swap-progress-sweep {
    animation: swap-progress-sweep 1.1s ease-in-out infinite;
  }
  @keyframes swap-progress-sweep {
    0% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(420%);
    }
  }
</style>
