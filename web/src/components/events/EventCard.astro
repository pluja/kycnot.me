---
import { Icon } from 'astro-icon/components'

import { getEventOriginInfo } from '../../constants/eventOrigins'
import { cn } from '../../lib/cn'
import { getEventDisplay } from '../../lib/eventKind'
import { safeHttpUrl } from '../../lib/exchange/safeUrl'
import { proseBlocks, stripMarkdown } from '../../lib/strings'
import BadgeSmall from '../BadgeSmall.astro'
import FormatTimeInterval from '../FormatTimeInterval.astro'
import Markdown from '../Markdown.astro'
import Tooltip from '../Tooltip.astro'

import type { DisplayableEvent } from '../../lib/eventKind'
import type { EventOrigin } from '@prisma/client'

type Props = {
  event: DisplayableEvent & {
    id: number
    title: string
    content: string
    source: string | null
    origin: EventOrigin
  }
  now?: Date
  /// Turns the title into a permalink. Needed on lists that are not already on
  /// the owning service page.
  titleHref?: string
  headingLevel?: 'h2' | 'h3'
  /// Muted shell for entries that are no longer live, such as deleted rows.
  faded?: boolean
}

const { event, now = new Date(), titleHref, headingLevel: Heading = 'h3', faded = false } = Astro.props

const display = getEventDisplay(event, now)
const originInfo = getEventOriginInfo(event.origin)
// A listing edit already reads as automated, so the origin chip would only
// repeat the badge next to it.
const showOrigin = originInfo.showOnPublicEntries && display.kind !== 'CHANGE'
const sourceUrl = safeHttpUrl(event.source)

// The lead shows in full; the disclosure exists only when something follows it.
const blocks = proseBlocks(event.content)
const lead = blocks[0] ?? stripMarkdown(event.content)
const hasMore = blocks.length > 1

const proseClass =
  'prose prose-sm max-w-none text-pretty wrap-anywhere text-day-400 prose-invert prose-a:text-current prose-p:my-1 prose-p:first:mt-0 prose-p:last:mb-0'
const headingClass = 'font-title text-base/snug font-semibold text-pretty wrap-anywhere text-white'
---

<article
  id={`event-${event.id.toString()}`}
  class={cn(
    'relative scroll-mt-24 rounded-lg border pl-3',
    faded ? 'border-day-800 bg-night-900 opacity-70' : display.classNames.card
  )}
>
  <span
    class={cn('absolute inset-y-0 left-0 w-1 rounded-l-lg', faded ? 'bg-day-800' : display.classNames.rail)}
    aria-hidden="true"></span>

  <div class="px-3 pt-2.5 pb-3">
    <div class="flex flex-wrap items-start gap-x-2 gap-y-1">
      <div class="flex min-w-0 grow flex-wrap items-center gap-x-2 gap-y-1">
        <Tooltip text={display.description} position="top">
          <BadgeSmall text={display.label} icon={display.icon} color={display.color} variant="faded" />
        </Tooltip>

        <slot name="badges" />

        <FormatTimeInterval
          as="span"
          start={event.startedAt}
          end={event.endedAt}
          now={now}
          class="text-xs text-day-400"
        />

        {
          showOrigin && (
            <Tooltip text={originInfo.description} position="top">
              <span class="inline-flex items-center gap-1 text-2xs tracking-wide text-day-500 uppercase">
                <Icon name={originInfo.icon} class="size-3.5" />
                {originInfo.label}
              </span>
            </Tooltip>
          )
        }
      </div>

      {
        Astro.slots.has('actions') && (
          <div class="-my-0.5 flex shrink-0 items-center gap-0.5 rounded-md bg-night-900/50 p-0.5">
            <slot name="actions" />
          </div>
        )
      }
    </div>

    {
      hasMore ? (
        <details class="group/event">
          {/* Title and lead both sit in the summary, padded out so the whole
              block is one easy tap target. */}
          <summary class="-mx-2 mt-0.5 cursor-pointer list-none rounded-md px-2 py-1.5 transition-colors hover:bg-day-500/5 [&::-webkit-details-marker]:hidden">
            <Heading class={headingClass}>
              {titleHref ? (
                <a href={titleHref} class="transition-colors hover:text-day-200 hover:underline">
                  {event.title}
                </a>
              ) : (
                event.title
              )}
            </Heading>

            <p class="mt-1 text-sm text-pretty wrap-anywhere text-day-400 group-open/event:hidden">{lead}</p>

            <span class="mt-1.5 inline-flex items-center gap-1 text-xs font-medium text-day-400 transition-colors group-hover/event:text-day-200">
              <span class="group-open/event:hidden">Read more</span>
              <span class="hidden group-open/event:inline">Show less</span>
              <Icon
                name="ri:arrow-down-s-line"
                class="size-4 transition-transform group-open/event:rotate-180"
              />
            </span>
          </summary>

          <div class={cn('mt-1', proseClass)}>
            <Markdown content={event.content} linkRel={['nofollow', 'noopener']} />
          </div>
        </details>
      ) : (
        <>
          <Heading class={cn('mt-1', headingClass)}>
            {titleHref ? (
              <a href={titleHref} class="transition-colors hover:text-day-200 hover:underline">
                {event.title}
              </a>
            ) : (
              event.title
            )}
          </Heading>

          <div class={cn('mt-1', proseClass)}>
            <Markdown content={event.content} linkRel={['nofollow', 'noopener']} />
          </div>
        </>
      )
    }

    <slot name="meta" />

    {
      sourceUrl && (
        <a
          href={sourceUrl}
          target="_blank"
          rel="nofollow noopener"
          class="mt-2 inline-flex items-center gap-1 text-xs text-day-400 transition-colors hover:text-day-200 hover:underline"
        >
          <Icon name="ri:external-link-line" class="size-3.5" />
          Source
        </a>
      )
    }

    <slot name="footer" />
  </div>
</article>
