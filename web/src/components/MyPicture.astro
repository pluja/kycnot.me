---
import { Picture } from 'astro:assets'

import defaultServiceImage from '../assets/fallback-service-image.jpg'
import { cn } from '../lib/cn'
import { siteOrigin } from '../lib/urls'

import type { ComponentProps } from 'astro/types'

// Astro's <Picture> requires the `src` to match a `remotePatterns` entry to
// run the WebP transform on a string URL. Database-backed image URLs come
// in as relative `/files/...` paths, so we absolutize them to the canonical
// public origin. No network roundtrip ever happens for these — the custom
// image endpoint at `src/lib/imageEndpoint.ts` short-circuits and reads
// the file from disk via UPLOAD_DIR.

const fallbackImages = {
  service: defaultServiceImage,
} as const satisfies Record<string, typeof defaultServiceImage>

type Props = Omit<ComponentProps<typeof Picture>, 'formats' | 'src'> & {
  src: ComponentProps<typeof Picture>['src'] | null | undefined
  fallback?: keyof typeof fallbackImages
}

const {
  src,
  fallback = undefined as keyof typeof fallbackImages | undefined,
  alt,
  height,
  width,
  pictureAttributes,
  ...props
} = Astro.props

const fallbackImage = fallback ? fallbackImages[fallback] : undefined

const rawSrc = typeof src === 'string' ? src : (src ?? fallbackImage)
const finalSrc = typeof rawSrc === 'string' && rawSrc.startsWith('/') ? `${siteOrigin}${rawSrc}` : rawSrc
// Imported SVGs are trusted build assets that Astro can only emit as SVG, which /_image refuses to serve.
const importedSvg =
  (typeof finalSrc === 'object' || typeof finalSrc === 'function') &&
  'format' in finalSrc &&
  finalSrc.format === 'svg'
    ? finalSrc
    : null
---

{/* eslint-disable @typescript-eslint/no-explicit-any */}
{
  importedSvg ? (
    <img
      src={importedSvg.src}
      alt={alt}
      width={width}
      height={height}
      class={cn('shrink-0', pictureAttributes?.class)}
      {...(props as any)}
    />
  ) : (
    !!finalSrc && (
      <Picture
        src={finalSrc}
        alt={alt}
        formats={typeof finalSrc === 'string' && finalSrc.toLowerCase().endsWith('.svg') ? ['svg'] : ['webp']}
        height={height ? Number(height) * 2 : undefined}
        width={width ? Number(width) * 2 : undefined}
        pictureAttributes={{
          ...pictureAttributes,
          class: cn('shrink-0', pictureAttributes?.class),
        }}
        {...(props as any)}
      />
    )
  )
}
