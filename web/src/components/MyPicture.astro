---
import { Picture } from 'astro:assets'

import defaultServiceImage from '../assets/fallback-service-image.jpg'
import { cn } from '../lib/cn'
import { siteOrigin } from '../lib/urls'

import type { ComponentProps } from 'astro/types'

const fallbackImages = {
  service: defaultServiceImage,
} as const satisfies Record<string, typeof defaultServiceImage>

type Props = Omit<ComponentProps<typeof Picture>, 'formats' | 'src'> & {
  src: ComponentProps<typeof Picture>['src'] | null | undefined
  fallback?: keyof typeof fallbackImages
}

const {
  src,
  fallback = undefined as keyof typeof fallbackImages | undefined,
  height,
  width,
  pictureAttributes,
  ...props
} = Astro.props

const fallbackImage = fallback ? fallbackImages[fallback] : undefined

// Astro's <Picture> only optimizes string srcs when they're full URLs
// matching `remotePatterns` in astro.config.mjs. Relative paths like
// `/files/...` fall through unchanged. Absolutize them so they match
// the `/files/**` remote pattern and get WebP transform + resize.
const rawSrc = typeof src === 'string' ? src : (src ?? fallbackImage)
const finalSrc =
  typeof rawSrc === 'string' && rawSrc.startsWith('/') ? `${siteOrigin}${rawSrc}` : rawSrc

const isSvg =
  (typeof finalSrc === 'string' && finalSrc.toLowerCase().endsWith('.svg')) ||
  (typeof finalSrc === 'object' &&
    finalSrc !== null &&
    'src' in finalSrc &&
    typeof finalSrc.src === 'string' &&
    finalSrc.src.toLowerCase().endsWith('.svg'))
---

{/* eslint-disable @typescript-eslint/no-explicit-any */}
{
  !!finalSrc && (
    <Picture
      src={finalSrc}
      formats={isSvg ? ['svg'] : ['webp']}
      height={height ? Number(height) * 2 : undefined}
      width={width ? Number(width) * 2 : undefined}
      pictureAttributes={{
        ...pictureAttributes,
        class: cn('shrink-0', pictureAttributes?.class),
      }}
      {...(props as any)}
    />
  )
}
