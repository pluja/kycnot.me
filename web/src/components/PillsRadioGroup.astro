---
import { cn } from '../lib/cn'

import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'div'> & {
  name: string
  options: {
    value: HTMLAttributes<'input'>['value']
    label: string
  }[]
  inputProps?: Omit<HTMLAttributes<'input'>, 'checked' | 'class' | 'name' | 'type' | 'value'>
  selectedValue?: string | null
}

const { name, options, selectedValue, inputProps, class: className, ...rest } = Astro.props
---

<div
  class={cn(
    'flex divide-x-2 divide-night-700 overflow-hidden rounded-md bg-night-500 text-[0.6875rem] has-focus-visible:ring-2 has-focus-visible:ring-blue-500 has-focus-visible:ring-offset-2 has-focus-visible:ring-offset-night-700',
    className
  )}
  {...rest}
>
  {
    options.map((option) => (
      <label>
        <input
          type="radio"
          name={name}
          value={option.value}
          checked={selectedValue === option.value}
          class="peer sr-only"
          {...inputProps}
        />
        <span class="inline-block cursor-pointer px-1.5 py-0.5 text-white peer-checked:bg-night-400 peer-checked:text-green-500">
          {option.label}
        </span>
      </label>
    ))
  }
</div>
