---
import { Icon } from 'astro-icon/components'

import { getCaseStatusInfo } from '../../constants/caseStatus'
import { cn } from '../../lib/cn'
import BadgeSmall from '../BadgeSmall.astro'

import type { CaseStatus } from '@prisma/client'

type Props = {
  serviceSlug: string
  cases: { publicId: string; title: string; status: CaseStatus }[]
  /// Muted styling for history that no longer affects the score.
  faded?: boolean
  heading?: string
  class?: string
}

const { serviceSlug, cases, faded = false, heading, class: className } = Astro.props
---

{
  cases.length > 0 && (
    <div class={cn('border-t border-day-800/60 pt-2.5', className)}>
      <p
        class={cn(
          'flex items-center gap-1.5 text-2xs font-semibold tracking-wide uppercase',
          faded ? 'text-day-500' : 'text-day-400'
        )}
      >
        <Icon name="ri:file-list-3-line" class="size-3.5 shrink-0" />
        {heading ??
          (cases.length === 1 ? '1 linked user report' : `${cases.length.toString()} linked user reports`)}
      </p>

      <ul class="mt-1.5 space-y-1">
        {cases.map((caseRow) => {
          const statusInfo = getCaseStatusInfo(caseRow.status)
          return (
            <li>
              <a
                href={`/service/${encodeURIComponent(serviceSlug)}/case/${encodeURIComponent(caseRow.publicId)}`}
                class="group flex items-start gap-1.5 text-xs text-day-400 transition-colors hover:text-day-100"
              >
                <BadgeSmall
                  text={statusInfo.label}
                  icon={statusInfo.icon}
                  color={statusInfo.color}
                  variant="faded"
                  class="mt-0.5 shrink-0"
                />
                <span class="min-w-0 flex-1 wrap-anywhere group-hover:underline">{caseRow.title}</span>
              </a>
            </li>
          )
        })}
      </ul>
    </div>
  )
}
