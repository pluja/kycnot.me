SHELL := /bin/bash
.ONESHELL:
.SHELLFLAGS := -eu -o pipefail -c

# Load .env so POSTGRES_USER / POSTGRES_DATABASE etc. are available both to
# Make's own variable space and to recipe shells (via `export`).
-include .env
export

# Compose service that runs the Astro app (must have prisma + node_modules
# baked into the image). Override on the command line if it ever moves.
WEB_SERVICE ?= astro

# Default backup retention (used by `prune-backups`).
DEFAULT_KEEP ?= 10

.DEFAULT_GOAL := help

# Match Just's default: don't echo every recipe line. Explicit `echo`
# statements in recipes still print, so progress messages still show.
.SILENT:

.PHONY: help import-triggers migrate-deploy migrate-status dump-db dump-db-no-migrations \
        prune-backups import-db db-shell logs

help:  ## List targets
	@awk 'BEGIN{FS=":.*##"} /^[a-zA-Z0-9_-]+:.*##/ {printf "  \033[36m%-24s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

# === Migrations and triggers ===

import-triggers:  ## Apply prisma/triggers/*.sql in short-timeout transactions
	docker compose exec -T $(WEB_SERVICE) sh <<'INNER'
	set -e
	cd /app
	for trigger_file in prisma/triggers/*.sql; do
		echo "Applying $$trigger_file..."
		tmp_file=$$(mktemp)
		{
			echo "BEGIN;"
			echo "SET LOCAL lock_timeout = '5s';"
			echo "SET LOCAL statement_timeout = '60s';"
			cat "$$trigger_file"
			echo "COMMIT;"
		} > "$$tmp_file"
		npx prisma db execute --file "$$tmp_file" --schema=./prisma/schema.prisma
		rm -f "$$tmp_file"
	done
	INNER

migrate-deploy:  ## Apply pending Prisma migrations + triggers. Idempotent.
	echo "Applying pending Prisma migrations..."
	docker compose exec -T $(WEB_SERVICE) sh -c "cd /app && npx prisma migrate deploy"
	echo "Applying triggers..."
	$(MAKE) import-triggers
	echo "Done."

migrate-status:  ## Show pending Prisma migrations against the live DB
	docker compose exec -T $(WEB_SERVICE) sh -c "cd /app && npx prisma migrate status"

# === Database backup ===

dump-db:  ## DB backup including _prisma_migrations (recommended)
	mkdir -p backups
	TIMESTAMP=$$(date +%Y%m%d_%H%M%S)
	OUT="backups/db_backup_$${TIMESTAMP}.dump"
	echo "Creating complete database backup (including _prisma_migrations table)..."
	docker compose exec -T database pg_dump -U $${POSTGRES_USER:-kycnot} -d $${POSTGRES_DATABASE:-kycnot} -c -F c > "$$OUT"
	echo "Verifying dump integrity..."
	cat "$$OUT" | docker compose exec -T database pg_restore --list >/dev/null
	echo "Backup saved: $$OUT ($$(du -h "$$OUT" | cut -f1))"

dump-db-no-migrations:  ## DB backup excluding _prisma_migrations (legacy)
	mkdir -p backups
	TIMESTAMP=$$(date +%Y%m%d_%H%M%S)
	OUT="backups/db_backup_no_migrations_$${TIMESTAMP}.dump"
	echo "Creating database backup (excluding _prisma_migrations table)..."
	docker compose exec -T database pg_dump -U $${POSTGRES_USER:-kycnot} -d $${POSTGRES_DATABASE:-kycnot} -c -F c -T _prisma_migrations > "$$OUT"
	echo "Verifying dump integrity..."
	cat "$$OUT" | docker compose exec -T database pg_restore --list >/dev/null
	echo "Backup saved: $$OUT ($$(du -h "$$OUT" | cut -f1))"

prune-backups:  ## Keep newest N backups (default 10). Usage: make prune-backups N=30
	N=$${N:-$(DEFAULT_KEEP)}
	cd backups 2>/dev/null || { echo "No backups directory."; exit 0; }
	TOTAL=$$(ls -1 db_backup_*.dump 2>/dev/null | wc -l)
	if [ "$$TOTAL" -le "$$N" ]; then
		echo "Have $$TOTAL backups, keep threshold is $$N. Nothing to prune."
		exit 0
	fi
	echo "Pruning to newest $$N of $$TOTAL backups..."
	ls -t db_backup_*.dump | tail -n +$$(($$N + 1)) | xargs -r rm -v

# Import a database backup. Without FILE=..., uses the newest backup. Always
# runs migrate-deploy after restore so any migrations baked into the current
# astro image (but not in the dump) get applied.
#
# Assumes the dump was produced by `dump-db` (includes _prisma_migrations).
# A no-migrations dump leaves the DB in a state where migrate-deploy tries
# to re-apply already-applied migrations; recover with
#   docker compose exec astro npx prisma migrate resolve --applied <name>
import-db:  ## Restore a backup. Usage: make import-db [FILE=backups/x.dump]
	if [ -z "$(FILE)" ]; then
		BACKUP_FILE=$$(find backups/ -name 'db_backup_*.dump' | sort -r | head -n 1)
		if [ -z "$$BACKUP_FILE" ]; then
			echo "Error: No backup files found in the backups directory"
			exit 1
		fi
	else
		BACKUP_FILE="$(FILE)"
		if [ ! -f "$$BACKUP_FILE" ]; then
			echo "Error: Backup file '$$BACKUP_FILE' not found"
			exit 1
		fi
	fi
	echo "Using backup: $$BACKUP_FILE"

	echo "=== STEP 1: PREPARING DATABASE ==="
	docker compose exec -T database psql -U $${POSTGRES_USER:-kycnot} -c "SELECT pg_terminate_backend(pg_stat_activity.pid) FROM pg_stat_activity WHERE pg_stat_activity.datname = '$${POSTGRES_DATABASE:-kycnot}' AND pid <> pg_backend_pid();" postgres
	echo "Dropping and recreating the database..."
	docker compose exec -T database psql -U $${POSTGRES_USER:-kycnot} -c "DROP DATABASE IF EXISTS $${POSTGRES_DATABASE:-kycnot};" postgres
	docker compose exec -T database psql -U $${POSTGRES_USER:-kycnot} -c "CREATE DATABASE $${POSTGRES_DATABASE:-kycnot};" postgres

	echo "=== STEP 2: RESTORING DUMP ==="
	cat "$$BACKUP_FILE" | docker compose exec -T database pg_restore -U $${POSTGRES_USER:-kycnot} -d $${POSTGRES_DATABASE:-kycnot} --no-owner
	echo "Database data restored."

	echo "=== STEP 3: APPLYING PENDING MIGRATIONS ==="
	$(MAKE) migrate-deploy

	echo "=== STEP 4: VERIFY ==="
	$(MAKE) migrate-status || true

	echo "Database import completed successfully!"

# === Utility ===

db-shell:  ## Interactive psql shell against the running database
	docker compose exec -it database psql -U $${POSTGRES_USER:-kycnot} -d $${POSTGRES_DATABASE:-kycnot}

logs:  ## Tail logs. Usage: make logs [SERVICE=astro]
	if [ -z "$(SERVICE)" ]; then
		docker compose logs -f
	else
		docker compose logs -f "$(SERVICE)"
	fi
